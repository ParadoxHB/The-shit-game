task.delay(4, function()
    -- accounts on the always-all-off list (HustlHub_always_off_accounts.txt) never get saved settings loaded into them
    -- and never save anything: no account config, no shared config, no default-on switches. (The Trading picks and the
    -- webhook have their own files and are not part of this.)
    if window.hubNeverOn then
        print("[HustlHub] " .. LocalPlayer.Name .. " is an always-off account: no saved settings are loaded and nothing is saved")
        window.hubSettingsLoaded = true
        return
    end
    -- wait until your pets are in, so pet picks (Enchant Mastery, Leveling) and the switches that use them
    -- load properly instead of starting with nothing picked and switching themselves off
    for _ = 1, 40 do
        local okPets, owned = pcall(getOwnedPets)
        if okPets and type(owned) == "table" and next(owned) ~= nil then break end
        task.wait(0.5)
    end
    local cfgPath = "TapSimHub/" .. window.hubConfigName() .. ".json"
    local hadFile = false
    pcall(function() hadFile = isfile(cfgPath) end)
    local ok, saved = pcall(function() return window:Load(window.hubConfigName()) end)
    if not ok and hadFile then
        task.wait(3)
        ok, saved = pcall(function() return window:Load(window.hubConfigName()) end)
        if not ok then
            -- the file exists but could not be read: never overwrite it with an empty setup
            warn("[HustlHub] Couldn't read the saved config, autosave is off this session so it isn't overwritten:", saved)
            window:Notify({ title = "HustlHub", content = "Couldn't read your saved settings; autosave is off this time so nothing is overwritten.", duration = 8 })
            return
        end
    end
    local err = saved
    if type(saved) ~= "table" then saved = {} end
    if ok then
        print("[HustlHub] Loaded saved settings for", LocalPlayer.Name)
    else
        print("[HustlHub] First run on " .. LocalPlayer.Name .. ": fresh settings (" .. tostring(err) .. ")")
    end
    -- now that the saved dropdown / slider settings are in, turn the default-on switches on
    for _, el in ipairs(window.elements) do
        -- a switch you saved (on or off) wins; the default only applies if nothing was remembered for it
        if el.isToggle and window.hubDefaultOn[el.name] and (window.skipToggles or saved[el.flag] == nil or window.hubNewDefaults[el.name]) then
            pcall(el.Set, el, true)
            task.wait(0.2)
        end
    end
    pcall(function()
        if not isfolder("TapSimHub") then makefolder("TapSimHub") end
        writefile(window.hubVersionFile, "2")
    end)
    window.skipToggles = false
    -- "Hide Menu On Launch": once everything has loaded, slide the menu away
    do
        local hideEl = window.elementsByFlag["Hide Menu On Launch"]
        if hideEl and hideEl.value then
            task.wait(0.5)
            pcall(function() window:Hide() end)
        end
    end
    window.hubSettingsLoaded = true -- (Live sync starts now: see "Live sync across all accounts")
    -- autosave: to this account's own file. In shared mode the shared config is written by the live
    -- sync (only when a setting really changed), so accounts can't overwrite each other's changes.
    local function autosaveName() return window.hubShared and window.hubAccountConfig or window.hubConfigName() end
    configSaving = true
    pcall(function() window:Save(autosaveName()) end)
    while configSaving do
        task.wait(5)
        if configSaving then pcall(function() window:Save(autosaveName()) end) end
    end
end)


---------------------------------------------------------------- Live sync across all accounts
-- Every account with "Use Shared Config" on (the default) shares ALL settings live: every switch,
-- dropdown, slider and text box, plus the rules kept outside the menu (craft rules, keep rules,
-- power rules, egg delete lists: window.hubSync.extras). Change something on any account and every
-- other account copies it within ~2 seconds.
-- How: one file all accounts can read (TapSimHub/LiveSync.json = { rev, from, values, extras }).
-- Every 2s each account (1) applies a newer revision written by another account, or else (2) if you
-- changed something here, merges just THOSE changes into the file. Applying never writes back.
-- v1.2.2 fixes:
--   * switches: only what YOU switch is shared (the library marks clicks as byUser). A switch the
--     script turns off by itself (e.g. Auto Hatch stopping because this account hasn't unlocked the
--     egg's island) stays on this account; it used to switch Auto Hatch off on every account.
--   * Egg / Index Egg on an island this account hasn't unlocked: kept as it is here.
--   * an account only sends what it changed (merged into the shared values), never its whole setup.
do
    local HttpService = game:GetService("HttpService")
    local SYNC_FILE = "TapSimHub/LiveSync.json"
    local me = tostring(LocalPlayer.UserId)
    local SKIP = {
        ["Follow All-Account Commands"] = true, ["All Accounts Switch"] = true, ["All Accounts Setting"] = true,
        ["All Accounts Value"] = true, ["Use Shared Config"] = true,
        -- applies to whichever pet THIS account has picked in Power Rule Pet (not synced), so copying the text would put
        -- the rule on the wrong pet; the finished power rules sync themselves (powerRules extra)
        ["Power Rule: Delete Under"] = true,
    }
    local EGG_FLAGS = { ["Egg"] = true, ["Index Egg"] = true }
    local function skipped(flag)
        return SKIP[flag] or tostring(flag):find("^Switch Slot") ~= nil
    end
    local function enc(v)
        local ok, s = pcall(HttpService.JSONEncode, HttpService, v)
        return ok and s or tostring(v)
    end
    -- switches: the value you (or another account, through sync) last set; the script's own
    -- automatic on / off isn't shared
    local userToggle = {}
    local prevOnToggle = window.onToggle
    window.onToggle = function(el, byUser)
        if byUser and el.flag then userToggle[el.flag] = el.value end
        if prevOnToggle then pcall(prevOnToggle, el, byUser) end
    end
    -- (v1.4.57) switches kept out of saved configs on purpose (Auto Golden Mastery, Auto Progress) but still copied live
    local function liveOnly() return window.liveOnly or {} end
    local function elementFor(flag)
        return (window.elementsByFlag and window.elementsByFlag[flag]) or liveOnly()[flag]
    end
    local function eachElement(fn)
        for flag, el in pairs(window.elementsByFlag or {}) do fn(flag, el) end
        for flag, el in pairs(liveOnly()) do
            if not (window.elementsByFlag and window.elementsByFlag[flag]) then fn(flag, el) end
        end
    end
    local function seedToggles()
        eachElement(function(flag, el)
            if el.isToggle and userToggle[flag] == nil then userToggle[flag] = el.value end
        end)
    end
    -- can this account hatch that egg? (its island unlocked)
    local function eggUsable(value)
        local egg = type(value) == "table" and value[1] or value
        if type(egg) ~= "string" or egg == "" then return true end
        local island = EggWorld.islandOf(egg)
        if not island or island == "Spawn" then return true end
        local d = getReplica() and getReplica().Data
        local unlocked = d and d.Progression and d.Progression.UnlockedIslands
        return type(unlocked) ~= "table" or unlocked[island] == true
    end
    -- everything this account has right now (switches as you set them)
    local function snapshot()
        local values, extras = {}, {}
        eachElement(function(flag, el)
            if not skipped(flag) then
                if el.isToggle and userToggle[flag] ~= nil then values[flag] = userToggle[flag]
                elseif el.syncGet then values[flag] = el.syncGet() -- (a value that isn't the same on every account, e.g. labels with counts)
                else values[flag] = el.value end
            end
        end)
        for name, extra in pairs((window.hubSync and window.hubSync.extras) or {}) do
            local ok, v = pcall(extra.get)
            if ok then extras[name] = v end
        end
        return { values = values, extras = extras }
    end
    -- returns the file's data, or nil when there is no file. The second result is true when the file exists but
    -- couldn't be read (another account was in the middle of writing it): never write from such a read, or the
    -- whole file is replaced by this account's settings and everyone else's latest changes are lost
    local function readSync()
        local text
        for attempt = 1, 4 do
            local exists = false
            local ok, data = pcall(function()
                if not isfile(SYNC_FILE) then return nil end
                exists = true
                text = readfile(SYNC_FILE)
                return HttpService:JSONDecode(text)
            end)
            if not exists then return nil, false end
            if ok and type(data) == "table" and data.rev then return data, false end
            task.wait(0.15)
        end
        -- (v1.4.57) a complete file with junk after it (two accounts wrote at the same moment; found 2026-10-25, it had
        -- stopped all syncing for a day): keep the complete part and write it back. A half-written file has no complete
        -- part, so it still counts as "being written".
        if type(text) == "string" then
            local cut, tries = #text, 0
            while tries < 40 do
                cut = text:sub(1, cut - 1):match(".*()}")
                if not cut then break end
                tries += 1
                local ok, data = pcall(HttpService.JSONDecode, HttpService, text:sub(1, cut))
                if ok and type(data) == "table" and data.rev then
                    pcall(writefile, SYNC_FILE, text:sub(1, cut))
                    print("[HustlHub] Live sync: repaired the shared settings file (" .. (#text - cut) .. " stray characters)")
                    return data, false
                end
            end
        end
        return nil, true
    end
    -- which settings differ between two { values, extras } views (new vs old): { values = {flag = true}, extras = {...} }
    local function diffKeys(new, old)
        local out = { values = {}, extras = {} }
        for _, part in ipairs({ "values", "extras" }) do
            local a = type(new) == "table" and type(new[part]) == "table" and new[part] or {}
            local b = type(old) == "table" and type(old[part]) == "table" and old[part] or {}
            for k, v in pairs(a) do
                if enc(v) ~= enc(b[k]) then out[part][k] = true end
            end
        end
        return out
    end
    local function anyKeys(keys) return next(keys.values) ~= nil or next(keys.extras) ~= nil end
    -- when each setting was last shared, by this account (tick(): every account runs on the same PC clock)
    local myWrites = {}
    local function timeKey(part, k) return (part == "extras" and "x:" or "") .. k end
    -- merge the given settings (all of them when keys is nil, or ones the file doesn't have yet) into the shared
    -- values with the time each was shared, then write a new revision. Returns the revision and what the file now holds.
    local function writeSync(snap, keys, force)
        local current, unreadable = readSync()
        if unreadable and not force then return nil end -- try again next round (the caller keeps its changes pending)
        if unreadable then current = nil end -- (force: the file stayed broken, start it again from this account)
        current = current or {}
        local values = type(current.values) == "table" and current.values or {}
        local extras = type(current.extras) == "table" and current.extras or {}
        local times = type(current.times) == "table" and current.times or {}
        local now = tick()
        local changed = {}
        for flag, v in pairs(snap.values) do
            if not keys or keys.values[flag] or values[flag] == nil then
                values[flag] = v
                if not keys or keys.values[flag] then times[flag] = now myWrites[flag] = now end
                if keys and keys.values[flag] then table.insert(changed, flag) end
            end
        end
        for name, v in pairs(snap.extras) do
            if not keys or keys.extras[name] or extras[name] == nil then
                extras[name] = v
                if not keys or keys.extras[name] then times["x:" .. name] = now myWrites["x:" .. name] = now end
                if keys and keys.extras[name] then table.insert(changed, name) end
            end
        end
        local rev = tostring(os.time()) .. "-" .. me .. "-" .. tostring(math.random(100000, 999999))
        pcall(function()
            if not isfolder("TapSimHub") then makefolder("TapSimHub") end
            local out = HttpService:JSONEncode({ rev = rev, from = me, name = LocalPlayer.Name, t = os.time(),
                values = values, extras = extras, times = times })
            writefile(SYNC_FILE, out)
            -- read it back: another account writing at the same moment can leave a mix of both (v1.4.57)
            task.wait(0.05)
            local okBack, back = pcall(readfile, SYNC_FILE)
            if okBack and back ~= out then
                local okJ, d = pcall(HttpService.JSONDecode, HttpService, back)
                if not (okJ and type(d) == "table" and d.rev) then writefile(SYNC_FILE, out) end
            end
            window:Save("Shared") -- (the shared config a starting account loads)
        end)
        if #changed > 0 then print("[HustlHub] Live sync: shared " .. table.concat(changed, ", ")) end
        return rev, { values = values, extras = extras, times = times }
    end
    -- copy another account's values in (only the ones that differ), then the extras
    local warnedEgg = {}
    -- only = { values = {flag = true}, extras = {...} }: copy just those (nil = everything, for an account's first look)
    local function apply(data, only)
        local changed = 0
        local toggles = {}
        for flag, value in pairs(type(data.values) == "table" and data.values or {}) do
            local el = elementFor(flag)
            -- live-only switches are copied when someone flips them, never on an account's first look (launch)
            if el and el.Set and not skipped(flag) and (not only or only.values[flag]) and (only or not liveOnly()[flag]) then
                if el.isToggle then
                    -- compared with what was last SET here, so a switch the script stopped by itself
                    -- isn't switched straight back on by every sync
                    local mine = userToggle[flag]
                    if mine == nil then mine = el.value end
                    -- (v1.4.59: on an account's first look (launch, only == nil) switches are NOT copied: everything starts OFF)
                    if only and mine ~= (value == true) then table.insert(toggles, { el = el, flag = flag, value = value == true }) end
                elseif el.syncGet and el.syncSet then
                    if enc(el.syncGet()) ~= enc(value) then
                        pcall(el.syncSet, value)
                        changed += 1
                    end
                elseif enc(el.value) ~= enc(value) then
                    if EGG_FLAGS[flag] and not eggUsable(value) then
                        local egg = type(value) == "table" and value[1] or value
                        if not warnedEgg[flag .. tostring(egg)] then
                            warnedEgg[flag .. tostring(egg)] = true
                            print("[HustlHub] Live sync: kept this account's " .. flag .. " (" .. tostring(egg) .. "'s island isn't unlocked here)")
                        end
                    else
                        pcall(el.Set, el, value)
                        changed += 1
                    end
                end
            end
        end
        if #toggles > 0 then task.wait(0.25) end -- settings first, then the switches that use them
        for _, t in ipairs(toggles) do
            t.el.userNext = true t.el.clickNext = true -- (an account switched it by hand: sticky switches like Auto Rainbow follow)
            pcall(t.el.Set, t.el, t.value)
            userToggle[t.flag] = t.value
            changed += 1
        end
        for name, value in pairs(type(data.extras) == "table" and data.extras or {}) do
            local extra = window.hubSync and window.hubSync.extras[name]
            if extra and (not only or only.extras[name]) then
                local ok, current = pcall(extra.get)
                if not ok or enc(current) ~= enc(value) then
                    pcall(extra.set, value)
                    changed += 1
                end
            end
        end
        return changed
    end

    local alive = true
    connections.liveSync = { Disconnect = function() alive = false window.onToggle = prevOnToggle end }
    window.hubLiveSync = { lastFrom = nil, lastAt = nil }
    task.spawn(function()
        -- start once this account's own settings are in
        local t0 = os.clock()
        while alive and not window.hubSettingsLoaded and os.clock() - t0 < 60 do task.wait(0.5) end
        task.wait(1)
        seedToggles()
        local lastRev, base, seen, brokenSince
        while alive do
            pcall(function()
                if not window.hubShared or window.hubFollow == false or window.hubNeverOn then
                    base = nil -- (not sharing, or "Follow All-Account Commands" is off: neither copy nor share; start fresh if it's switched back on)
                    return
                end
                -- Two baselines, compared setting by setting:
                --   base = this account's settings after the last sync  -> what YOU changed here since (mine)
                --   seen = the shared file as this account last saw it  -> what OTHER accounts changed since (theirs)
                -- Only "theirs" is copied in, and a setting changed here wins over the file for that setting.
                -- (Before, a new revision from any account made this one copy EVERY setting from the file, so a switch
                -- you had just turned on, not shared yet, was switched straight back off and logged as your change.
                -- And a revision written between two looks was skipped, so its change never reached this account.)
                local data, unreadable = readSync()
                if unreadable then
                    -- (being written right now: look again next round.) Still broken after ~20 s: nobody is writing it,
                    -- it's damaged, so start it again from this account's settings (it used to wait forever, v1.4.57)
                    brokenSince = brokenSince or os.clock()
                    if os.clock() - brokenSince > 20 + (tonumber(me) or 0) % 7 then
                        brokenSince = nil
                        local rev, view = writeSync(snapshot(), nil, true)
                        if rev then
                            print("[HustlHub] Live sync: the shared settings file was damaged, wrote it again from this account")
                            lastRev, seen, base = rev, view, snapshot()
                        end
                    end
                    return
                end
                brokenSince = nil
                if not base then
                    -- first look: take what the other accounts have (if anything), else share ours
                    if data and data.from ~= me then
                        local n = apply(data)
                        print("[HustlHub] Live sync: copied " .. n .. " settings from " .. tostring(data.name or "another account"))
                        task.wait(1)
                        lastRev, seen = data.rev, data
                    elseif not data then
                        lastRev, seen = writeSync(snapshot(), nil)
                        if not lastRev then return end
                    else
                        lastRev, seen = data.rev, data
                    end
                    base = snapshot()
                    return
                end
                local mine = diffKeys(snapshot(), base)
                if data and data.rev ~= lastRev then
                    lastRev = data.rev
                    local theirs = diffKeys(data, seen)
                    seen = data
                    if data.from ~= me then
                        for _, part in ipairs({ "values", "extras" }) do
                            for k in pairs(mine[part]) do theirs[part][k] = nil end
                        end
                        -- a change of yours that another account's save overwrote (both saved at the same moment): the
                        -- file's time for it is older than when you shared it, so share it again instead of copying it
                        local reshare = { values = {}, extras = {} }
                        if type(data.times) == "table" then
                            for _, part in ipairs({ "values", "extras" }) do
                                for k in pairs(theirs[part]) do
                                    local tk = timeKey(part, k)
                                    if myWrites[tk] and (tonumber(data.times[tk]) or 0) < myWrites[tk] then
                                        theirs[part][k] = nil
                                        reshare[part][k] = true
                                    end
                                end
                            end
                        end
                        local n = anyKeys(theirs) and apply(data, theirs) or 0
                        if n > 0 then
                            print("[HustlHub] Live sync: " .. n .. " change(s) from " .. tostring(data.name or "another account"))
                            window.hubLiveSync.lastFrom, window.hubLiveSync.lastAt = data.name, os.time()
                            task.wait(1) -- let those settings' own callbacks settle before taking the new base
                        end
                        -- the new base: everything as it is now, except your own changes that still need sharing
                        local now = snapshot()
                        for _, part in ipairs({ "values", "extras" }) do
                            for k in pairs(mine[part]) do now[part][k] = base[part][k] end
                        end
                        base = now
                        mine = diffKeys(snapshot(), base)
                        for _, part in ipairs({ "values", "extras" }) do
                            for k in pairs(reshare[part]) do mine[part][k] = true end
                        end
                    end
                end
                -- something changed on THIS account: share just that
                if anyKeys(mine) then
                    local snap = snapshot()
                    local rev, view = writeSync(snap, mine)
                    if rev then -- (nil: the file was mid-write; base stays, so the change is shared next round)
                        lastRev, seen, base = rev, view, snap
                    end
                end
            end)
            task.wait(2)
        end
    end)
end
-- Accounts that do NOT load or keep any data: HustlHub still runs there (menu, Trading tab) but never keeps a switch on,
-- loads no saved / shared config and saves nothing. The list is HustlHub_always_off_accounts.txt in the workspace folder
-- (one username per line); the Config tab has a picker that edits it, and every account re-reads it every 5 seconds, so
-- adding or removing an account there takes effect on that account straight away (removing one: rejoin to load its settings).
do
    local FILE = "HustlHub_always_off_accounts.txt"
    local function readList()
        local names = {}
        pcall(function()
            if isfile and isfile(FILE) then
                for line in tostring(readfile(FILE)):gmatch("[^\r\n]+") do
                    local name = line:gsub("^%s+", ""):gsub("%s+$", "")
                    if name ~= "" and name:sub(1, 1) ~= "#" then table.insert(names, name) end
                end
            end
        end)
        return names
    end
    local function contains(names, who)
        for _, n in ipairs(names) do if n:lower() == who:lower() then return true end end
        return false
    end
    local function writeList(names)
        pcall(function()
            writefile(FILE, "# One username per line. HustlHub runs on these accounts (menu, trading) but loads no settings, saves nothing and never keeps a switch on.\n"
                .. table.concat(names, "\n") .. (#names > 0 and "\n" or ""))
        end)
    end

    window.hubNeverOn = contains(readList(), LocalPlayer.Name)
    local alive = true
    connections.neverOn = { Disconnect = function() alive = false end }
    if window.hubNeverOn then
        print("[HustlHub] " .. LocalPlayer.Name .. " is in HustlHub_always_off_accounts.txt: no settings load, every switch stays off")
    end
    -- keeps every switch off while this account is on the list
    task.spawn(function()
        local t0 = os.clock()
        while alive and window.hubNeverOn and window.hubSettingsLoaded ~= true and os.clock() - t0 < 60 do task.wait(0.5) end
        while alive do
            if window.hubNeverOn then
                for _, el in pairs(window.elementsByFlag or {}) do
                    if type(el) == "table" and el.isToggle and el.value == true then
                        el.userNext = false
                        pcall(el.Set, el, false)
                    end
                end
            end
            task.wait(1.5)
        end
    end)
    -- picks up changes made from any account's menu (or by editing the file)
    task.spawn(function()
        while alive do
            task.wait(5)
            local now = contains(readList(), LocalPlayer.Name)
            if now ~= window.hubNeverOn then
                window.hubNeverOn = now
                print("[HustlHub] " .. LocalPlayer.Name .. (now and " was added to the always-off list: every switch is switched off now"
                    or " was removed from the always-off list: rejoin to load its settings"))
            end
        end
    end)

    -- the picker, in the Config tab: tick the accounts that should not load any data
    pcall(function()
        local cfgTab = window.tabByName["Config"]
        if not cfgTab then return end
        local function options()
            local seen, list = {}, {}
            local function add(name) if not seen[name:lower()] then seen[name:lower()] = true table.insert(list, name) end end
            pcall(function()
                for _, path in ipairs(listfiles("TapSimHub/trade")) do
                    local name = tostring(path):match("roster_([^/\\]+)%.json$")
                    if name then add(name) end
                end
            end)
            for _, name in ipairs(readList()) do add(name) end
            add(LocalPlayer.Name)
            table.sort(list, function(a, b) return a:lower() < b:lower() end)
            return list
        end
        local dropdown
        dropdown = cfgTab:CreateDropdown({
            name = "Accounts That Don't Load Data",
            description = "Tick the accounts that should NOT load or save any settings and never keep a switch on (the menu and the Trading tab still work there). Applies to a running account within about 5 seconds; to load settings again on an account you remove, rejoin it. Lists the accounts running HustlHub right now (plus any already on the list). Saved in HustlHub_always_off_accounts.txt in your workspace folder.",
            options = options(),
            multiSelect = true,
            value = readList(),
            forgetState = true,
            placeholder = "None",
            onOpen = function() dropdown:Refresh(options()) end,
            callback = function(selected)
                writeList(type(selected) == "table" and selected or { selected })
            end,
        })
    end)
end
window:Notify({ title = "HustlHub", content = "Loaded. Right Shift hides / shows the menu. Hover any switch for a description.", duration = 6 })
end
