local PhysicalCfg
pcall(function() PhysicalCfg = require(ReplicatedStorage.Shared.Progression.PhysicalUpgradeConfig) end)
local PhysicalBuyRF = rf("PhysicalUpgradeService", "Purchase")
local function buyDoubleJump()
    local d = data()
    local line = PhysicalCfg and PhysicalCfg.Get("+1 Jump")
    if not (d and line and PhysicalBuyRF) then return false end
    local index = PhysicalCfg.GetOwned(d, line) + 1
    local price = PhysicalCfg.GetPrice(line, index)
    if not price then return false end -- all bought
    if PhysicalCfg.GetLockedIsland(d, line, index) then return false end -- needs the next island first
    if gems(d) < price then return false end
    -- the machine for that level: jump 1 at spawn, jump N on the island that unlocks it
    -- (a model tagged "PhysicalUpgrade" with UpgradeName / Index once loaded, named "double jump machine")
    local function findMachine()
        for _, m in ipairs(CollectionService:GetTagged(PhysicalCfg.Tag or "PhysicalUpgrade")) do
            if m:GetAttribute("UpgradeName") == "+1 Jump" and m:GetAttribute("Index") == index and m:IsDescendantOf(workspace) then return m end
        end
        local island = line.Islands and line.Islands[index]
        local parent = workspace
        if island then
            local folder = workspace:FindFirstChild("Ts2Islands")
            local info = IslandCfg and IslandCfg.Islands[island]
            parent = folder and folder:FindFirstChild(info and info.IslandName or island)
        end
        return parent and parent:FindFirstChild("double jump machine")
    end
    local function machinePos(m)
        local touch = m:FindFirstChild("Touch", true)
        if touch and touch:IsA("BasePart") then return touch.Position end
        local ok, pivot = pcall(function() return m:GetPivot().Position end)
        return ok and pivot or nil
    end
    -- where to go so a far-away machine loads in (spawn's machine / the island's landing spot)
    local KNOWN = { [1] = Vector3.new(-98.673, -516.033, -1679.991), [2] = Vector3.new(-20.383, -57.59, -1755.731) }
    local root = getRoot()
    if not root then return false end
    local home = root.CFrame
    acquireTrip("doubleJump")
    local ok, result = pcall(function()
        local machine = findMachine()
        local pos = machine and machinePos(machine)
        if not pos or pos.Magnitude < 1 then
            local hop = KNOWN[index] or (line.Islands and UNLOCK_SPOTS[line.Islands[index]])
            if not hop then return { Success = false, Reason = "don't know where the machine is" } end
            teleportAndTouch(CFrame.new(hop + Vector3.new(0, 4, 0)))
            task.spawn(function() pcall(function() LocalPlayer:RequestStreamAroundAsync(hop, 3) end) end) -- (can hang: never wait on it)
            task.wait(1)
            machine = findMachine()
            pos = (machine and machinePos(machine)) or KNOWN[index]
            if not pos then return { Success = false, Reason = "machine didn't load" } end
        end
        teleportAndTouch(CFrame.new(pos + Vector3.new(0, 4, 5), pos))
        task.wait(0.3)
        return safeInvoke(PhysicalBuyRF, { ["Upgrade"] = "+1 Jump", ["Index"] = index })
    end)
