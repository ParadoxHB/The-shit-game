local function openEggs(d)
    local unlocked = d.Progression and d.Progression.UnlockedIslands or {}
    local list = {}
    for name, cfg in pairs(LaunchEggConfig or {}) do
        if type(cfg) == "table" and cfg.Price and cfg.Pets and EggWorld.exists(name)
            and (not cfg.Island or unlocked[cfg.Island] == true) then
            table.insert(list, { name = name, price = eggPrice(d, name) })
        end
    end
    table.sort(list, function(a, b) return a.price < b.price end)
    return list
