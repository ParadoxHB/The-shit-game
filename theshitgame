local function craftGolden(myRun)
    local d = data()
    local byName = {}
    for id, pet in pairs(d.Pets.Owned) do
        if canUseFor(pet, "Normal") then
            byName[pet.Name] = byName[pet.Name] or {}
            table.insert(byName[pet.Name], id)
        end
    end
    local ids
    for _, list in pairs(byName) do
        if #list >= 6 then ids = table.move(list, 1, 6, 1, {}) break end
    end
    if not ids then
        -- not 6 of one kind yet: Basic eggs are cheap, hatch until there are
        hatchUntil(myRun, "Basic", function(dd)
            local counts = {}
            for _, pet in pairs(dd.Pets.Owned) do
                if canUseFor(pet, "Normal") then
                    counts[pet.Name] = (counts[pet.Name] or 0) + 1
                    if counts[pet.Name] >= 6 then return true end
                end
            end
            return false
        end, "Hatching Basic eggs for 6 of the same pet (golden quest)")
        return
    end
    log("Crafting a Golden pet (golden quest)")
    teleportAndTouch(GOLDEN_MACHINE_CF)
    task.wait(0.6)
    local state = machineState.Golden
    if state then state.waiting, state.failReason = true, nil end
    for _, id in ipairs(ids) do recentlySent[id] = os.clock() end
    CraftRemote:FireServer({ ["PetIds"] = ids, ["Machine"] = "Golden", ["Action"] = "Craft" })
    local sent = os.clock()
    while state and state.waiting and os.clock() - sent < 8 do task.wait(0.1) end
    if state and state.failReason then log("Golden craft failed: " .. tostring(state.failReason)) task.wait(2) end
end

