        if type(result) ~= "table" or result.Forced == true then return end
        hatchWaiting = false
        if not hatchRunning then return end

        if result.Success == true then
            hatchWaitReason = nil
            return
        elseif result.Error == "RateLimited" or (result.Error == "TooFar" and chestTripActive) then
            hatchRateLimited = true -- just retry shortly (for TooFar: we're back from the chest soon)
        elseif hatchPersistent and WAIT_HATCH_ERRORS[result.Error] then
            hatchWaitReason = FATAL_HATCH_ERRORS[result.Error] -- keep trying (slower)
        elseif hatchPersistent and result.Error == "TooFar" then
            hatchWaitReason = FATAL_HATCH_ERRORS.TooFar -- keep trying (Golden Mastery moves back to the egg on this)
        elseif FATAL_HATCH_ERRORS[result.Error] then
            hatchStopReason = FATAL_HATCH_ERRORS[result.Error]
        end
    end)
else
    warn("[HustlHub] EggHatchResult not found, hatching will use a fixed wait")
end

-- Same rule the game uses for its auto-hatch: 8 if you have the x8 pass (or an OctoHatch
-- boost) and can afford it, otherwise 3, otherwise 1
local EggPricing, BoostFormula, LaunchEggConfig
pcall(function()
    EggPricing = require(ReplicatedStorage.Shared.Pets.EggPricing)
    BoostFormula = require(ReplicatedStorage.Shared.Items.BoostFormula)
    LaunchEggConfig = require(ReplicatedStorage.Shared.Pets.LaunchEggConfig)
end)

local lastHatchCount
local function pickHatchCount(egg)
    local count = 3
    pcall(function()
        local data = getReplica().Data
        local config = LaunchEggConfig[egg]
        local coins = data.Currencies.Coins or 0
        local canOcto = data.Monetization.Gamepasses.x8Egg == true or BoostFormula.HasType(data, "OctoHatch")
        if canOcto and EggPricing.GetTotal(data, egg, config.Price, 8) <= coins then
            count = 8
        elseif EggPricing.GetTotal(data, egg, config.Price, 3) <= coins then
            count = 3
        else
            count = 1
        end
    end)
    if count ~= lastHatchCount then
        print("[HustlHub] Hatching", count, "eggs at a time")
        lastHatchCount = count
    end
    return count
end

