-- 6 ids of the weakest kind of normal pet you have 6 spare copies of
local function weakestSix(d)
    local byName = {}
    for id, pet in pairs(d.Pets and d.Pets.Owned or {}) do
        if canUseFor(pet, "Normal") and not tostring(pet.Rarity or ""):find("Secret") and not recentlySent[id] then
            byName[pet.Name] = byName[pet.Name] or {}
            table.insert(byName[pet.Name], id)
        end
    end
    local best, bestPower
    for _, ids in pairs(byName) do
        if #ids >= 6 then
            local ok, p = pcall(function() return H.PetPower.Get(d.Pets.Owned[ids[1]]) end)
            p = ok and tonumber(p) or math.huge
            if not bestPower or p < bestPower then best, bestPower = ids, p end
        end
    end
    if not best then
        -- no 6 of a kind (accounts that delete most hatches keep few pets; g0nz_0026 had 4 Elegance): the kind with
        -- the most copies, at least 3, as a chance craft (checked live: 4 pets = 63%; a failed craft uses them up)
        for _, ids in pairs(byName) do
            if #ids >= 3 and (not best or #ids > #best) then best = ids end
        end
    end
    return best and table.move(best, 1, math.min(6, #best), 1, {}) or nil
end
