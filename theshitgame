---------------- Keep the egg's menu open while hatching
-- The game's EggController closes the egg menu (pets + chances, secret pity bar, auto-delete
-- picks) after every hatch and while its auto-hatch is on, until you walk away. Its two local
-- functions are reached through its RenderStepped loop: clearBillboard (closes the menu) and the
-- menu builder (always calls clearBillboard first, then builds). While hatching next to the egg,
-- closing is skipped (except when the game rebuilds it), and the menu is reopened if it's gone.
-- The game keeps the pity bar and auto-delete picks up to date by itself while the menu is open.
do
    local keepMenu = true
    local building = 0
    local clearOriginal, buildOriginal, buildMenu, clearFn
    local function menuFor(egg)
        local gui = LocalPlayer:FindFirstChild("PlayerGui")
        return gui and gui:FindFirstChild("TS2_" .. egg .. "_EggBillboard", true)
    end
    local function nearOurEgg()
        local egg = selectedEgg and EggsFolder:FindFirstChild(selectedEgg)
        local root = getRoot()
        if not (egg and root) then return nil end
        local ok, pos = pcall(function() return egg:GetPivot().Position end)
        if ok and (pos - root.Position).Magnitude <= 30 then return egg end
        return nil
    end
    local function keeping()
        return keepMenu and hatchRunning and nearOurEgg() ~= nil
    end

    local ok, err = pcall(function()
        assert(getconnections and hookfunction and debug.getupvalues, "executor lacks getconnections / hookfunction / debug.getupvalues")
        for _, c in ipairs(getconnections(RunService.RenderStepped)) do
            local fn = c.Function
            local okSrc, source = pcall(debug.info, fn, "s")
            if fn and okSrc and type(source) == "string" and source:find("EggController") then
                local ups = debug.getupvalues(fn)
                for _, v in pairs(ups) do
                    if type(v) == "function" and select(2, pcall(debug.info, v, "n")) == "clearBillboard" then clearFn = v end
                end
                if clearFn then
                    for _, v in pairs(ups) do
                        if type(v) == "function" and v ~= clearFn then
                            local okUp, isBuilder = pcall(function()
                                return #debug.getupvalues(v) > 20 and debug.getupvalue(v, 1) == clearFn
                            end)
                            if okUp and isBuilder then buildMenu = v end
                        end
                    end
                    break
                end
            end
        end
        assert(clearFn and buildMenu, "couldn't find the egg menu functions")
        buildOriginal = hookfunction(buildMenu, function(...)
            building += 1
            local results = table.pack(pcall(buildOriginal, ...))
            building -= 1
            if not results[1] then error(results[2], 0) end
            return table.unpack(results, 2, results.n)
        end)
        clearOriginal = hookfunction(clearFn, function(...)
            if building == 0 and keeping() and selectedEgg and menuFor(selectedEgg) then
                return -- keep it open while hatching here
            end
            return clearOriginal(...)
        end)
    end)
    if ok then
        print("[HustlHub] Egg menu: stays open while hatching")
    else
        warn("[HustlHub] Egg menu can't be kept open:", err)
    end

    local alive = true
    connections.keepEggMenu = { Disconnect = function()
        alive = false
        keepMenu = false
        -- put the game's own functions back (so a re-run can find them again)
        if clearOriginal then pcall(hookfunction, clearFn, clearOriginal) end
        if buildOriginal then pcall(hookfunction, buildMenu, buildOriginal) end
    end }
    -- reopen it if it got closed (e.g. you arrived after a hatch already closed it)
    if ok then
        task.spawn(function()
            while alive do
                task.wait(0.3)
                if keeping() and not menuFor(selectedEgg) then
                    local egg = nearOurEgg()
                    if egg then pcall(buildMenu, egg) end
                end
            end
        end)
    end

    hatchTab:CreateToggle({
        name = "Show Egg Menu While Hatching",
        description = "Keeps the egg's menu open while you hatch next to it, so you can see its pets, the secret pity bar and your auto-delete picks (and change them).",
        value = true,
        callback = function(value) keepMenu = value end,
    })
end

