-- require() with a time limit, so a hanging require can't stop the rest of the script
local function timedRequire(module, seconds)
    local result, done = nil, false
    task.spawn(function()
        local ok, r = pcall(require, module)
        if ok then result = r end
        done = true
    end)
    local start = os.clock()
    while not done and os.clock() - start < (seconds or 3) do task.wait() end
    return result
end

