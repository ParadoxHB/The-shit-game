---------------- pet quality: rarity, crafting up, deleting what you don't use
local IndexCatalogMod, PetCatalogMod
pcall(function() IndexCatalogMod = require(ReplicatedStorage.Shared.Pets.PetIndexCatalog) end)
pcall(function() PetCatalogMod = require(ReplicatedStorage.Shared.Pets.OriginalPetCatalog) end)
local RARITY_RANK = { Basic = 1, Common = 2, Rare = 3, Epic = 4, Legendary = 5, Mythical = 6, Godly = 7, Secret = 8, Exclusive = 8, Leaderboard = 8 }
local function rarityRank(name)
    local rarity
    if IndexCatalogMod and IndexCatalogMod.Rarity then
        local ok, r = pcall(IndexCatalogMod.Rarity, name)
        if ok and type(r) == "string" then rarity = r end
    end
    if not rarity then
        local entry = PetCatalogMod and PetCatalogMod[name]
        rarity = entry and entry.Rarity
    end
    return RARITY_RANK[rarity or "Common"] or 6 -- unknown names are some special rarity: treat as rare-ish
end
local deleteWeak = true -- the "Delete Weak Pets" switch below
-- the weakest pet on your team (nil while the team isn't full: then nothing counts as "not used")
local function weakestEquipped(d)
    local limit = tonumber(d.Pets.EquipLimit) or 4
    local weakest, count = nil, 0
    for _, id in pairs(d.Pets.Equipped or {}) do
        local pet = d.Pets.Owned[id]
        if type(pet) == "table" then
            count += 1
            local p = power(pet)
            if not weakest or p < weakest then weakest = p end
        end
    end
    if count < limit then return nil end
    return weakest
end
-- what this pet would be worth one tier up
local NEXT_TIER = { Normal = "Golden", Golden = "Diamond" }
local function powerAsTier(pet, tier)
    local copy = table.clone(pet)
    copy.Tier = tier
    return power(copy)
end
-- craft rules from the Main tab ("Craft Pets Up To") still apply
local RULE_RANK = { ["Don't Craft"] = 0, Golden = 1, Diamond = 2, Rainbow = 3 }
local TIER_RANK = { Golden = 1, Diamond = 2 }
local function ruleAllows(name, tier)
    local rule = hatchCraft.rules and hatchCraft.rules[name]
    return not rule or (RULE_RANK[rule] or 0) >= TIER_RANK[tier]
end

-- one craft at a machine (Golden at spawn, Diamond in the Crystal Cave)
local MACHINE_SPOTS = {
    Golden = GOLDEN_MACHINE_CF,
    Diamond = window.hubMachineSpots.Diamond[1], -- Crystal Cave
}
local function craftAt(machineKey, ids)
    teleportAndTouch(MACHINE_SPOTS[machineKey])
    task.wait(0.6)
    local state = machineState[machineKey]
    if state then state.waiting, state.failReason = true, nil end
    for _, id in ipairs(ids) do recentlySent[id] = os.clock() end
    CraftRemote:FireServer({ ["PetIds"] = ids, ["Machine"] = machineKey, ["Action"] = "Craft" })
    local sent = os.clock()
    while state and state.waiting and os.clock() - sent < 8 do task.wait(0.1) end
    if state and state.failReason then
        for _, id in ipairs(ids) do recentlySent[id] = nil end
        log(machineKey .. " craft failed: " .. tostring(state.failReason))
        task.wait(2)
        return false
    end
    return true
end

-- craft a set whose next tier would beat your weakest team pet (6 Normal -> Golden, 5 Golden ->
-- Diamond, guaranteed). Returns true if it crafted something.
local function upgradePets(d)
    local weakest = weakestEquipped(d) or 0
    local groups = {}
    for id, pet in pairs(d.Pets.Owned) do
        local nextTier = type(pet) == "table" and NEXT_TIER[pet.Tier or "Normal"]
        if nextTier and canUseFor(pet, pet.Tier or "Normal") and not (recentlySent[id] and os.clock() - recentlySent[id] < 3) then
            local key = tostring(pet.Name) .. "|" .. (pet.Tier or "Normal")
            groups[key] = groups[key] or { pet = pet, next = nextTier, ids = {} }
            table.insert(groups[key].ids, id)
        end
    end
    local best, bestPower
    for _, g in pairs(groups) do
        local need = g.next == "Golden" and 6 or 5
        if #g.ids >= need and ruleAllows(g.pet.Name, g.next) then
            local p = powerAsTier(g.pet, g.next)
            if p > weakest and (not bestPower or p > bestPower) then best, bestPower = g, p end
        end
    end
    if not best then return false end
    local need = best.next == "Golden" and 6 or 5
    log(string.format("Better pets: crafting a %s %s", best.next, tostring(best.pet.Name)))
    local ok = craftAt(best.next, table.move(best.ids, 1, need, 1, {}))
    equipBest(true)
    return ok
end

-- delete pets you don't use: weaker than everyone on your team, not worth crafting up, and not
-- locked, equipped, in a saved team, under a craft rule, Diamond / Rainbow, or Legendary and up
local function cleanUpPets(d)
    if not (deleteWeak and PetActionRE) then return 0 end
    local weakest = weakestEquipped(d)
    if not weakest then return 0 end
    local inTeam = {}
    for _, team in pairs(type(d.PetTeams) == "table" and d.PetTeams or {}) do
        for _, id in pairs(type(team) == "table" and team or {}) do inTeam[id] = true end
    end
    local equipped = {}
    for _, id in pairs(d.Pets.Equipped or {}) do equipped[id] = true end
    -- how many of each kind there are (kinds that can still make a useful craft are kept)
    local counts = {}
    for _, pet in pairs(d.Pets.Owned) do
        if type(pet) == "table" then
            local key = tostring(pet.Name) .. "|" .. tostring(pet.Tier or "Normal")
            counts[key] = (counts[key] or 0) + 1
        end
    end
    local junk = {}
    for id, pet in pairs(d.Pets.Owned) do
        local tier = type(pet) == "table" and (pet.Tier or "Normal")
        if tier and (tier == "Normal" or tier == "Golden") and not equipped[id] and not pet.Equip
            and pet.Locked ~= true and pet.Frozen == nil and not inTeam[id]
            and not (hatchCraft.rules and hatchCraft.rules[pet.Name])
            and rarityRank(pet.Name) < RARITY_RANK.Legendary and power(pet) < weakest then
            local nextTier = NEXT_TIER[tier]
            local usefulCraft = nextTier and ruleAllows(pet.Name, nextTier) and powerAsTier(pet, nextTier) > weakest
                and (counts[tostring(pet.Name) .. "|" .. tier] or 0) >= (nextTier == "Golden" and 3 or 2) -- a set is on its way
            if not usefulCraft then table.insert(junk, id) end
        end
    end
    for i = 1, #junk, 50 do
        PetActionRE:FireServer({ ["Action"] = "Delete", ["PetIds"] = table.move(junk, i, math.min(i + 49, #junk), 1, {}) })
        task.wait(0.3)
    end
    if #junk > 0 then print("[HustlHub] Auto Progress: deleted " .. #junk .. " weak pets you weren't using") end
    return #junk
end

-- "good" pets from an egg: Epic or better (or the best rarity that egg has, if it has no Epic)
local function goodPetsFrom(d, egg)
    local cfg = LaunchEggConfig and LaunchEggConfig[egg]
    local bestRank = 0
    for name in pairs(cfg and cfg.Pets or {}) do bestRank = math.max(bestRank, rarityRank(name)) end
    local want = math.min(RARITY_RANK.Epic, bestRank)
    local count = 0
    for _, pet in pairs(d.Pets.Owned) do
        if type(pet) == "table" and cfg and cfg.Pets and cfg.Pets[pet.Name] ~= nil and rarityRank(pet.Name) >= want then count += 1 end
    end
    return count
end

local function grow(myRun, d)
    local limit = tonumber(d.Pets.EquipLimit) or 4
    -- 1) make the pets you have better, and clear out the ones you don't use
    if upgradePets(d) then return end
    cleanUpPets(d)
    -- 2) the best egg you can afford a few of: hatch it until you have a full team of its
    --    Epic-or-better pets (not just Commons and Rares)
    local target
    for _, egg in ipairs(openEggs(d)) do
        if egg.price * 3 <= coins(d) then target = egg end
    end
    if target and goodPetsFrom(d, target.name) < limit then
        hatchUntil(myRun, target.name, function(dd) return goodPetsFrom(dd, target.name) >= limit end,
            string.format("Better pets: hatching the %s egg for Epic+ pets (%d / %d)", target.name, goodPetsFrom(d, target.name), limit))
        equipBest(true)
        -- storage filled up while hatching: craft / delete, then carry on next round
        if hatchStopReason == FATAL_HATCH_ERRORS.StorageFull then
            local dd = data()
            if not upgradePets(dd) then cleanUpPets(dd) end
        end
        return
    end
    if not rebirth(d) then
        log(string.format("Growing: %s / %s rebirths", tostring(d.Statistics.Rebirths), tostring(rebirthGoal)))
        if hubState.ensureBestIsland then pcall(hubState.ensureBestIsland) end
        task.wait(2)
    end
end

---------------- one round
local stuckStep, stuckSince, skippedUntil = nil, 0, {}
local function round(myRun)
    local d = data()
    if not d then task.wait(2) return end
    claimQuests(d)
    if buyDoubleJump() then return end -- each double jump helps climb to the next island
    -- 1) the tutorial
    local step
    pcall(function() step = OnboardingConfig and OnboardingConfig.DeriveStep(d) end)
    -- a tutorial step that hasn't moved for 10 minutes (e.g. something the hub can't do) is set
    -- aside for 10 minutes, so the quests and islands still get done, then tried again
    if step and step.Id ~= stuckStep then stuckStep, stuckSince = step.Id, os.clock() end
    if step and os.clock() - stuckSince > 600 then
        skippedUntil[step.Id] = os.clock() + 600
        stuckSince = os.clock() + 600
        print("[HustlHub] Auto Progress: tutorial step " .. tostring(step.Id) .. " is stuck, working on quests / islands for a while")
    end
    if step and not (skippedUntil[step.Id] and os.clock() < skippedUntil[step.Id]) then
        log("Tutorial step: " .. tostring(step.Id))
        doTutorialStep(myRun, d, step)
        return
    end
    -- the end goal: enough rebirths -> AFK on the last egg (nothing else moves you around then)
    if (tonumber(d.Statistics.Rebirths) or 0) >= rebirthGoal and afk(myRun, d) then return end
    equipBest()
    local island, info = nextIsland(d)
    -- 2) climb up to every island you haven't unlocked (free, and each one has a bigger tap boost)
    if island and walkIn(myRun, island) then return end
    -- 3) quests
    local quest = openQuest(d)
    if quest and quest.kind == "egg" then
        hatchUntil(myRun, quest.egg, quest.done, quest.desc)
        if hatchStopReason == FATAL_HATCH_ERRORS.IslandLocked and island then reachIsland(myRun, data(), island, info) end
        return
    elseif quest and quest.kind == "golden" then
        craftGolden(myRun)
        return
    end
    -- 4) the grind (islands are only jumped onto, step 2 above; while that's on a break, keep growing): better pets -> more rebirths -> better pets, then AFK on the last egg
    grow(myRun, d)
end

