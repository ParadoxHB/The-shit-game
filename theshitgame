do -- own scope (keeps the top level under Luau's 200-local limit)
    -- Golden mastery grind: hatch the Basic egg at max speed, craft its pets into Golden,
    -- then delete those new Golden Basic pets so storage never fills up.
    local masteryTab = window:CreateTab({ name = "Mastery" })

    local PetRemote = Remotes.PetService.RE.PetActionRequested
    local MASTERY_EGG = "Basic"
    local BASIC_PETS = { Doggy = true, Kitty = true, Bunny = true } -- from the game's LaunchEggConfig

    local masteryRunning = false
    window.hubBusy["Auto Golden Mastery"] = function() return masteryRunning end
    local masteryRunId = 0
    local masteryPetsPerCraft = 6

    local function isFromBasicEgg(pet)
        if pet.SourceEgg ~= nil then
            return pet.SourceEgg == MASTERY_EGG
        end
        return BASIC_PETS[pet.Name] == true
    end

    masteryTab:CreateSection({ name = "Golden Mastery" })
    for _, text in ipairs({ "Golden Mastery Pets Per Craft", "Auto Golden Mastery" }) do
        outlineLabel(text, GOLD)
    end

    masteryTab:CreateSlider({
        name = "Golden Mastery Pets Per Craft",
        description = "6 = 100% chance",
        range = { 1, 6 },
        increment = 1,
        value = 6,
        callback = function(value)
            masteryPetsPerCraft = value
        end,
    })

    local function stopMastery()
        if not masteryRunning then return end
        masteryRunning = false
        masteryRunId += 1
        stopHatching()
        CraftTeam.stop("Mastery") -- your own team back
    end
    connections.mastery = { Disconnect = stopMastery }

    -- The egg and machine are too far apart to use both from one spot, so the run alternates:
    --   HATCH trip: stand at the Basic egg and hatch until there are enough pets for a batch of crafts
    --   CRAFT trip: go to the Golden machine, craft every batch back-to-back, delete the results
    local MASTERY_MACHINE_CF = GOLDEN_MACHINE_CF -- the Golden machine
    local ARRIVE_DELAY = 0.25 -- time to settle after a teleport before acting
    local MAX_HATCH_TRIP = 30 -- seconds; safety cap so a slow trip never stalls the loop
    local masteryCraftsPerTrip = 5
    -- Crafted results to delete: Golden, plus the lucky Diamond / Rainbow ("Shiny" in the game's data) rolls
    local MASTERY_DELETE_TIERS = { Golden = true, Diamond = true, Shiny = true }

    masteryTab:CreateSlider({
        name = "Golden Mastery Crafts Per Trip",
        description = "How many crafts to queue up before going to the machine",
        range = { 1, 20 },
        increment = 1,
        value = 5,
        callback = function(value)
            masteryCraftsPerTrip = value
        end,
    })
    outlineLabel("Golden Mastery Crafts Per Trip", GOLD)

    -- Groups usable Normal Basic pets by name: { Doggy = {id, id, ...}, ... }
    local function basicPetsByName(pets)
        local byName = {}
        for id, pet in pairs(pets) do
            local sent = recentlySent[id]
            if canUseFor(pet, "Normal") and isFromBasicEgg(pet) and not (sent and os.clock() - sent < 3) then
                byName[pet.Name] = byName[pet.Name] or {}
                table.insert(byName[pet.Name], id)
            end
        end
        return byName
    end

    local function countBatches(byName)
        local batches = 0
        for _, list in pairs(byName) do
            batches += math.floor(#list / masteryPetsPerCraft)
        end
        return batches
    end

    local function storageNearlyFull()
        local full = false
        pcall(function()
            local data = getReplica().Data
            local count = 0
            for _ in pairs(data.Pets.Owned) do count += 1 end
            full = count >= data.Pets.StorageLimit - 8 -- leave room for one x8 hatch
        end)
        return full
    end

    -- where to stand in front of the Basic egg (same spot Auto Hatch uses)
    local lastEggSpot
    local function eggStandSpot(model)
        local ok, spot = pcall(function()
            local body = model:FindFirstChild("Egg") or model
            local boxCFrame, size
            if body:IsA("BasePart") then
                boxCFrame, size = body.CFrame, body.Size
            else
                boxCFrame, size = body:GetBoundingBox()
            end
            local center = boxCFrame.Position
            local standAt = window.hubEggSpot(center, boxCFrame.LookVector, size)
            return CFrame.lookAt(standAt, Vector3.new(center.X, standAt.Y, center.Z))
        end)
        if ok and spot then lastEggSpot = spot end
        return lastEggSpot
    end

    local masteryToggle
    masteryToggle = masteryTab:CreateToggle({
        forgetState = true, -- never auto-start the deleting grind from a saved config
        liveSync = true, -- (but switching it on / off is copied to following accounts)
        name = "Auto Golden Mastery",
        description = "Hatch Basic egg, craft Golden at the Golden machine, delete the new Golden Basic pets",
        callback = function(value)
            if value and window.hubRefuse("Auto Golden Mastery") then return end
            stopMastery()
            setCraftUiHidden("Mastery", value)
            if not value then return end

            -- Remember every pet you already own: those are never deleted
            local keep = {}
            for id in pairs(getOwnedPets()) do keep[id] = true end

            local egg = EggWorld.load(MASTERY_EGG)
            if not egg then
                window:Notify({ title = "Golden Mastery", content = "Couldn't find workspace.Eggs.Basic.", duration = 5 })
                setCraftUiHidden("Mastery", false)
                pcall(masteryToggle.Set, masteryToggle, false, true)
                return
            end

            masteryRunning = true
            masteryRunId += 1
            local myRun = masteryRunId
            local golden = machineState.Golden
            -- your best Alchemist pets (better craft odds) for the whole run, like the auto crafts
            -- (Crafting tab "Equip Best Alchemist When Crafting"); your team comes back when it stops
            task.spawn(CraftTeam.start, "Mastery")
            local deletedAt = {}
            local crafted, deleted, trips = 0, 0, 0
            local function alive() return masteryRunning and masteryRunId == myRun end
            print("[HustlHub] Golden Mastery started")

            local function deleteNewGoldens()
                local toDelete = {}
                for id, pet in pairs(getOwnedPets()) do
                    local sent = deletedAt[id]
                    if not keep[id] and type(pet) == "table" and MASTERY_DELETE_TIERS[pet.Tier]
                        and isFromBasicEgg(pet) and pet.Locked ~= true and not pet.Equip
                        and not (sent and os.clock() - sent < 3) then
                        table.insert(toDelete, id)
                    end
                end
                for i = 1, #toDelete, 50 do
                    local batch = table.move(toDelete, i, math.min(i + 49, #toDelete), 1, {})
                    local now = os.clock()
                    for _, id in ipairs(batch) do deletedAt[id] = now end
                    PetRemote:FireServer({ ["Action"] = "Delete", ["PetIds"] = batch })
                    deleted += #batch
                end
                if #toDelete > 0 then
                    print("[HustlHub] Mastery: deleted", #toDelete, "crafted Basic pets (total " .. deleted .. ")")
                end
            end

            local function craftOnce(ids)
                local now = os.clock()
                for _, id in ipairs(ids) do recentlySent[id] = now end
                golden.waiting = true
                golden.failReason = nil
                CraftRemote:FireServer({ ["PetIds"] = ids, ["Machine"] = "Golden", ["Action"] = "Craft" })
                local sentAt = os.clock()
                while golden.waiting and os.clock() - sentAt < 10 and alive() do task.wait(0.03) end
                if golden.failReason then
                    print("[HustlHub] Mastery craft rejected:", golden.failReason)
                    for _, id in ipairs(ids) do recentlySent[id] = nil end
                    return false
                end
                crafted += 1
                return true
            end

            task.spawn(function()
                local storageWarned = false
                local lastWaitNote
                while alive() do
                    -- one hatch + craft cycle per trip, so chests / shrine / etc. can't pull you off the egg
                    acquireTrip("mastery")
                    -- acquireTrip marks this as a hub trip (which hides "TooFar"); Mastery needs to see it
                    chestTripActive = false
                    local idle = false
                    local ok, err = pcall(function()
                        if not alive() then return end
                        ---------------- HATCH trip
                        local spot = eggStandSpot(egg)
                        if spot then teleportAndTouch(spot) else teleportTo(egg) end
                        task.wait(ARRIVE_DELAY)
                        if not alive() then return end
                        selectedEgg = MASTERY_EGG
                        -- persistent: "TooFar" / no coins / storage full never end hatching by themselves
                        startHatching(true, true)
                        local tripStart, stuckSince = os.clock(), nil
                        while alive() and hatchRunning do
                            if countBatches(basicPetsByName(getOwnedPets())) >= masteryCraftsPerTrip
                                or storageNearlyFull()
                                or os.clock() - tripStart > MAX_HATCH_TRIP then
                                break
                            end
                            if hatchWaitReason then
                                stuckSince = stuckSince or os.clock()
                                local stuckFor = os.clock() - stuckSince
                                if hatchWaitReason == FATAL_HATCH_ERRORS.TooFar and stuckFor > 3 then
                                    print("[HustlHub] Mastery: too far from the egg, moving back to it")
                                    break
                                end
                                if stuckFor > 2 and countBatches(basicPetsByName(getOwnedPets())) > 0 then
                                    break -- out of coins / storage: craft what we have first
                                end
                                if lastWaitNote ~= hatchWaitReason then
                                    lastWaitNote = hatchWaitReason
                                    print("[HustlHub] Mastery: " .. hatchWaitReason .. ", still trying")
                                end
                            else
                                stuckSince, lastWaitNote = nil, nil
                            end
                            task.wait(0.1)
                        end
                        stopHatching() -- must stop before leaving, or the server answers "TooFar"
                        if not alive() then return end

                        ---------------- CRAFT trip
                        local made = 0
                        if countBatches(basicPetsByName(getOwnedPets())) > 0 then
                            teleportAndTouch(MASTERY_MACHINE_CF)
                            task.wait(ARRIVE_DELAY)
                            local fails = 0
                            while alive() do
                                local ids
                                for _, list in pairs(basicPetsByName(getOwnedPets())) do
                                    if #list >= masteryPetsPerCraft then
                                        ids = table.move(list, 1, masteryPetsPerCraft, 1, {})
                                        break
                                    end
                                end
                                if not ids then break end
                                if craftOnce(ids) then
                                    made += 1
                                    fails = 0
                                else
                                    fails += 1
                                    if fails >= 3 then break end -- try again next trip
                                    task.wait(0.5)
                                end
                            end
                        end
                        deleteNewGoldens()
                        trips += 1
                        print(string.format("[HustlHub] Mastery trip %d: %d crafts (%d total, %d deleted)", trips, made, crafted, deleted))

                        -- storage full of pets Mastery can't use: wait instead of bouncing between spots
                        if made == 0 and storageNearlyFull() then
                            idle = true
                            if not storageWarned then
                                storageWarned = true
                                window:Notify({ title = "Golden Mastery", content = "Pet storage is full. Free some space; it keeps checking.", duration = 6 })
                            end
                        else
                            storageWarned = false
                        end
                    end)
                    releaseTrip("mastery")
                    if not ok then
                        warn("[HustlHub] Mastery error:", err)
                        task.wait(1)
                    end
                    if idle then task.wait(10) end
                    if othersWaitingForTrip() then task.wait(1) end -- let other features take their turn
                end
                stopHatching()
            end)
        end,
    })

    ---------------- Enchant Mastery
    -- Rolls enchants on the pets you pick, over and over, until the price of the next roll reaches the
    -- cost you set. The game prices a roll per pet: 25,000 x 1.015 ^ (rolls that pet has had), so every
    -- roll makes that pet's next one dearer. Each pet is rolled until its next roll costs your limit or
    -- more, then the next pet starts. Rolled by hand at the Enchant machine (stay there).
    masteryTab:CreateSection({ name = "Enchant Mastery" })

    local EMConfig
    pcall(function() EMConfig = require(ReplicatedStorage.Shared.Pets.EnchantConfig) end)
    local EMRemotes = Remotes:FindFirstChild("EnchantService")
    local EMRF = EMRemotes and EMRemotes:FindFirstChild("RF")
    local emPicks = {}        -- set of "Name|Tier" you ticked
    local emLabelKey = {}     -- label -> "Name|Tier"
    local emMaxCost = 1e6
    local emSlots = { [1] = true, [2] = true }
    local emKeepBetter = true
    local emRunning, emRunId = false, 0
    local emStatus, emToggle, emPetDropdown

    local EM_SUFFIX = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, qi = 1e18 }
    local function emParse(text)
        text = tostring(text or ""):gsub(",", ""):gsub("%s", ""):lower()
        if text == "" then return 0 end
        local num, suffix = text:match("^([%d%.e%+%-]+)(%a*)$")
        local n = tonumber(num or "")
        if not n then return nil end
        return n * (EM_SUFFIX[suffix] or 1)
    end
    local function emFormat(n)
        if n < 0 then return "-" .. emFormat(-n) end
        for _, u in ipairs({ { 1e18, "Qi" }, { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }) do
            if n >= u[1] then return string.format("%.3g", n / u[1]) .. u[2] end
        end
        return string.format("%d", math.floor(n))
    end
    local function emClean(v) if v == false or v == "" then return nil end return v end
    local function emSlotCount(pet)
        if EMConfig and EMConfig.GetSlotCount then
            local ok, n = pcall(EMConfig.GetSlotCount, pet)
            if ok and type(n) == "number" then return n end
        end
        return pet.Enchant2 ~= nil and 2 or 1
    end
    local function emRollCount(pet)
        if EMConfig and EMConfig.GetRollCount then
            local ok, n = pcall(EMConfig.GetRollCount, pet)
            if ok and type(n) == "number" then return n end
        end
        return 0
    end
    -- Get the real next-roll price from the game's config for this exact pet.
    -- Use the local roll count as a conservative floor in case the replica is one roll behind.
    -- If the game's price cannot be read, return nil and stop instead of guessing and spending gems.
    local function emPrice(pet, count)
        if type(pet) ~= "table" or not (EMConfig and EMConfig.GetRollPrice) then return nil end
        local ok, actual = pcall(EMConfig.GetRollPrice, pet)
        if not ok or type(actual) ~= "number" or actual ~= actual or actual < 0 then return nil end
        local base = EMConfig.RollPrice or 25000
        local growth = EMConfig.RollPriceGrowth or 1.015
        local estimate = math.round(base * growth ^ math.max(0, count or 0))
        return math.max(actual, estimate)
    end
    local function emRank(name)
        if EMConfig and EMConfig.RankOf then
            local ok, r = pcall(EMConfig.RankOf, name)
            if ok and type(r) == "number" then return r end
        end
        return 0
    end

    -- your pets grouped by pet + version (so the pick stays valid as their enchants change)
    local function emOptions()
        table.clear(emLabelKey)
        local groups, order = {}, {}
        for _, pet in pairs(getOwnedPets()) do
            if type(pet) == "table" and pet.Name and pet.Frozen == nil then
                local key = tostring(pet.Name) .. "|" .. tostring(pet.Tier or "Normal")
                if not groups[key] then groups[key] = { name = pet.Name, tier = pet.Tier or "Normal", n = 0 } table.insert(order, key) end
                groups[key].n += 1
            end
        end
        table.sort(order)
        local options = {}
        for _, key in ipairs(order) do
            local g = groups[key]
            local tier = g.tier ~= "Normal" and (" [" .. (g.tier == "Shiny" and "Rainbow" or g.tier) .. "]") or ""
            local label = g.name .. tier .. (g.n > 1 and (" x" .. g.n) or "")
            emLabelKey[label] = key
            table.insert(options, label)
        end
        return options
    end

    emPetDropdown = masteryTab:CreateDropdown({
        name = "Enchant Mastery Pets",
        description = "The pets to keep rolling (every copy of the pet and version you tick). Each one is rolled until its next roll costs your Max Cost or more.",
        options = emOptions(),
        multiSelect = true,
        optionIcon = function(label)
            local key = emLabelKey[label]
            if not key then return nil end
            local name, tier = key:match("^([^|]*)|([^|]*)")
            return { pet = name, tier = tier }
        end,
        onOpen = function()
            local options = emOptions()
            emPetDropdown:Refresh(options)
            local ticked = {}
            for _, label in ipairs(options) do if emPicks[emLabelKey[label]] then table.insert(ticked, label) end end
            emPetDropdown:Set(ticked, true)
        end,
        forgetState = true,
        callback = function(selected)
            emPicks = {}
            for _, label in ipairs(selected) do
                local key = emLabelKey[label] or (label:gsub(" x%d+$", ""))
                if key then emPicks[key] = true end
            end
        end,
    })
    -- remember the picked pets between runs: saved by pet + version ("Name|Tier"), not by the list's labels
    -- (those carry counts like "x2" that change), and put back once your pets are loaded
    window.elementsByFlag["Enchant Mastery Picks"] = setmetatable({
        Set = function(_, list)
            emPicks = {}
            if type(list) == "table" then
                for _, key in ipairs(list) do emPicks[tostring(key)] = true end
            end
            pcall(function()
                local options = emOptions()
                emPetDropdown:Refresh(options)
                local ticked = {}
                for _, label in ipairs(options) do
                    if emPicks[emLabelKey[label]] then table.insert(ticked, label) end
                end
                emPetDropdown:Set(ticked, true)
            end)
        end,
    }, { __index = function(_, k)
        if k == "value" then
            local keys = {}
            for key in pairs(emPicks) do table.insert(keys, key) end
            table.sort(keys)
            return keys
        end
    end })

    masteryTab:CreateInput({
        name = "Enchant Mastery Max Cost",
        description = "Keep rolling each pet until its NEXT roll would cost this much or more (5000, 250k, 1.5M, 2B...). A roll costs 25,000 x 1.015 per roll that pet has had, so 1M is about 250 rolls per pet and 10M about 400. Default 1M.",
        placeholder = "e.g. 1M",
        callback = function(text)
            local n = emParse(text)
            if not n or n <= 0 then
                window:Notify({ title = "Enchant Mastery", content = "Couldn't read \"" .. tostring(text) .. "\" as a cost.", duration = 4 })
                return
            end
            emMaxCost = n
            local perPet = math.max(0, math.ceil(math.log(n / ((EMConfig and EMConfig.RollPrice) or 25000)) / math.log((EMConfig and EMConfig.RollPriceGrowth) or 1.015)))
            window:Notify({ title = "Enchant Mastery", content = "Max cost " .. emFormat(n) .. ": a fresh pet is rolled about " .. perPet .. " times.", duration = 5 })
        end,
    })
    masteryTab:CreateDropdown({
        name = "Enchant Mastery Slots",
        description = "Which enchant slots to roll. With both ticked, pets that have a second slot alternate between them. Slot 2 only exists on pets that have it.",
        options = { "Slot 1", "Slot 2" },
        multiSelect = true,
        value = { "Slot 1", "Slot 2" },
        callback = function(selected)
            emSlots = {}
            for _, label in ipairs(selected) do emSlots[label == "Slot 2" and 2 or 1] = true end
        end,
    })
    masteryTab:CreateToggle({
        name = "Keep Better Enchant",
        value = true,
        description = "A roll that comes out worse than what the slot already has is thrown away (you still pay for it), so each pet ends on the best enchant it rolled. Off = every roll replaces the old one, like the game's button.",
        callback = function(value) emKeepBetter = value end,
    })
    emStatus = masteryTab:CreateText({ name = "Enchant Mastery Status", text = "Off" })

    local function emStop(text)
        emRunning = false
        emRunId += 1
        if text then pcall(function() emStatus:Set(text) end) end
        pcall(function() emToggle:Set(false, true) end)
    end
    connections.enchantMastery = { Disconnect = function() emRunning = false end }

    emToggle = masteryTab:CreateToggle({
        name = "Auto Enchant Mastery",
        description = "Goes to the Enchant machine and rolls the picked pets until each one's next roll costs your Max Cost or more. Stay at the machine (it brings you back if something moves you). To enchant while hatching, use Auto Enchant (above in this tab) with the game's auto enchant instead.",
        callback = function(value)
            emRunning = false
            emRunId += 1
            if not value then
                pcall(function() emStatus:Set("Off") end)
                return
            end
            if not (EMRF and EMConfig and EMConfig.GetRollPrice) then
                window:Notify({ title = "Enchant Mastery", content = "Couldn't find the game's enchanting.", duration = 4 })
                emStop("Off")
                return
            end
            -- every copy of every ticked pet + version
            local petIds = {}
            for id, pet in pairs(getOwnedPets()) do
                if type(pet) == "table" and pet.Name and pet.Frozen == nil
                    and emPicks[tostring(pet.Name) .. "|" .. tostring(pet.Tier or "Normal")] then
                    table.insert(petIds, id)
                end
            end
            table.sort(petIds)
            if #petIds == 0 then
                window:Notify({ title = "Enchant Mastery", content = "Pick at least one pet first.", duration = 3 })
                emStop("Off")
                return
            end
            if next(emSlots) == nil then
                window:Notify({ title = "Enchant Mastery", content = "Pick at least one slot to roll.", duration = 3 })
                emStop("Off")
                return
            end
            emRunning = true
            local myRun = emRunId
            local function alive() return emRunning and emRunId == myRun end
            local HttpService = game:GetService("HttpService")

            task.spawn(function()
                pcall(function() emStatus:Set("Going to the Enchant machine...") end)
                if not (window.hubEnchantGoTo and window.hubEnchantGoTo()) then
                    window:Notify({ title = "Enchant Mastery", content = "Walk up to the Enchant machine once so the hub remembers where it is, then turn this on again.", duration = 8 })
                    emStop("Walk to the Enchant machine once, then turn this on again")
                    return
                end
                if not alive() then return end
                local startGems
                pcall(function() startGems = getReplica().Data.Currencies.Gems end)
                local function gemsUsed()
                    local text = ""
                    pcall(function()
                        local gems = getReplica().Data.Currencies.Gems
                        if startGems then text = string.format(" | %s gems used", emFormat(startGems - gems)) end
                    end)
                    return text
                end
                local totalRolls, farFails, pricey = 0, 0, 0
                local results = {}

                for index, petId in ipairs(petIds) do
                    if not alive() then return end
                    local pet = getOwnedPets()[petId]
                    if not pet then continue end
                    local startCount = emRollCount(pet)
                    local myRolls, requestId, turn = 0, nil, 0
                    local slot2Open = false
                    local known = {} -- slot -> the enchant we know is on it (replica can lag a roll behind)
                    known[1], known[2] = emClean(pet.Enchant), emClean(pet.Enchant2)
                    local lastName
                    while alive() do
                        pet = getOwnedPets()[petId] or pet
                        local count = math.max(emRollCount(pet), startCount + myRolls)
                        local price = emPrice(pet, count)
                        if price == nil then
                            emStop("Stopped safely: couldn't verify the next enchant price; no more rolls attempted.")
                            window:Notify({ title = "Enchant Mastery stopped", content = "Couldn't verify the next enchant price, so I stopped to protect your gems.", duration = 8 })
                            return
                        end
                        if price >= emMaxCost then
                            pricey += 1
                            table.insert(results, string.format("%s: %d rolls, next costs %s", pet.Name, myRolls, emFormat(price)))
                            break
                        end
                        local eligible = {}
                        for slot = 1, 2 do
                            if emSlots[slot] and (emSlotCount(pet) >= slot or (slot == 2 and slot2Open)) then table.insert(eligible, slot) end
                        end
                        if #eligible == 0 then
                            table.insert(results, pet.Name .. ": skipped (none of the picked slots exist)")
                            break
                        end
                        local slot = eligible[(turn % #eligible) + 1]
                        requestId = requestId or HttpService:GenerateGUID(false)
                        local ok, result = pcall(function()
                            return safeInvoke(EMRF.Enchant, { ["PetId"] = petId, ["Slot"] = slot, ["RequestId"] = requestId })
                        end)
                        if not ok or type(result) ~= "table" then
                            task.wait(0.5)
                        elseif not result.Success then
                            requestId = nil
                            local reason = tostring(result.Reason)
                            if reason == "RateLimited" then
                                task.wait(0.3)
                            elseif reason == "VisitEnchantMachine" then
                                farFails += 1
                                if farFails > 5 or not (window.hubEnchantGoTo and window.hubEnchantGoTo()) then
                                    emStop("Stopped: stand at the Enchant machine")
                                    window:Notify({ title = "Enchant Mastery", content = "Stand at the Enchant machine, then turn it on again.", duration = 6 })
                                    return
                                end
                            elseif reason == "ChoosePendingEnchant" or reason == "EnchantPending" or reason == "ConfirmReplace" then
                                pcall(function()
                                    local state = safeInvoke(EMRF.GetState)
                                    local pending = type(state) == "table" and state.Enchanting and state.Enchanting.Pending
                                    if pending and pending.Token then safeInvoke(EMRF.Resolve, { ["Token"] = pending.Token, ["UseNew"] = true }) end
                                end)
                                task.wait(0.3)
                            elseif reason == "AutoRunning" then
                                pcall(function() safeInvoke(EMRF.AutoStop) end)
                                task.wait(0.3)
                            elseif reason == "InsufficientGems" then
                                emStop("Stopped: not enough gems (" .. totalRolls .. " rolls)" .. gemsUsed())
                                window:Notify({ title = "Enchant Mastery stopped", content = "Not enough gems.", duration = 6 })
                                return
                            else
                                table.insert(results, pet.Name .. ": skipped (" .. reason .. ")")
                                break
                            end
                        else
                            requestId = nil
                            local pending = result.Pending or {}
                            local rolled = pending.Enchant
                            local old = known[slot]
                            local useNew = true
                            if emKeepBetter and old and rolled and emRank(rolled) > 0 and emRank(rolled) < emRank(old) then useNew = false end
                            local resolved
                            if pending.Token then
                                local okR, res = pcall(function()
                                    return safeInvoke(EMRF.Resolve, { ["Token"] = pending.Token, ["UseNew"] = useNew })
                                end)
                                if okR then resolved = res end
                            end
                            if useNew then known[slot] = rolled end
                            if type(resolved) == "table" and resolved.Double then
                                slot2Open = true
                                if known[3 - slot] == nil then known[3 - slot] = resolved.Double end
                            end
                            myRolls += 1
                            totalRolls += 1
                            turn += 1
                            lastName = rolled
                            pcall(function()
                                emStatus:Set(string.format("Pet %d/%d: %s (slot %d)\nRoll %d: %s%s\nNext roll costs %s (limit %s)%s",
                                    index, #petIds, pet.Name, slot, myRolls, tostring(rolled), useNew and "" or " (kept " .. tostring(old) .. ")",
                                    emFormat(emPrice(pet, math.max(emRollCount(pet), startCount + myRolls)) or 0), emFormat(emMaxCost), gemsUsed()))
                            end)
                            task.wait(0.05)
                        end
                    end
                end

                if not alive() then return end
                local summary = string.format("Done: %d rolls, %d pets at the cost limit%s\n%s", totalRolls, pricey, gemsUsed(), table.concat(results, "\n"))
                print("[HustlHub] Enchant Mastery finished:", totalRolls, "rolls |", table.concat(results, " | "))
                window:Notify({ title = "Enchant Mastery", content = "Done: " .. totalRolls .. " rolls on " .. #petIds .. " pets.", duration = 6 })
                emStop(summary)
                pcall(function() emPetDropdown:Refresh(emOptions()) end)
            end)
        end,
    })

end

