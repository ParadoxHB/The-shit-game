        for _, version in ipairs(VERSIONS) do
            local found = 0
            for _, name in ipairs(names) do
                if hasVersion(name, version, index, tiers) then found += 1 end
            end
            table.insert(parts, version .. " " .. found .. "/" .. #names)
        end
        table.insert(lines, egg .. ":  " .. table.concat(parts, "  ·  "))
    end
    progressText:Set(table.concat(lines, "\n"))
end

