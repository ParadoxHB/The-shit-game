-- Put the lists into the GAME's own per-egg auto-delete (the egg's billboard menu), so those pets are
-- deleted the moment they hatch and never even reach your inventory. From the game's EggController /
-- HatchRulesConfig: EggService.AutoDeleteRequested { Egg, Entries = keys }, a key per version:
-- "Name" (Normal), "Name_Golden", "Name_Diamond", "Name_Shiny" (Rainbow); the current list is
-- Data.Eggs.AutoDelete[egg]. Pets you ticked yourself on the egg are kept; only the hub's own
-- picks are added / taken off.
cleanup.AUTO_DELETE_TIERS = { "Normal", "Golden", "Diamond", "Shiny" }
cleanup.applied = {} -- egg -> set of pet names the hub last put on that egg's game list
cleanup.pushEggDelete = function(egg)
    local remote = Remotes.EggService.RE:FindFirstChild("AutoDeleteRequested")
    local eggsData = getReplica() and getReplica().Data and getReplica().Data.Eggs
    if not (remote and eggsData and egg) then return false end
    local want = cleanup.eggDelete[egg] or {}
    local before = cleanup.applied[egg] or want -- (first push after a start: our picks are already ours)
    local function keysOf(name)
        local keys = {}
        for _, tier in ipairs(cleanup.AUTO_DELETE_TIERS) do
            table.insert(keys, tier == "Normal" and name or (name .. "_" .. tier))
        end
        return keys
    end
    local ours, oldOurs = {}, {}
    for name in pairs(want) do for _, k in ipairs(keysOf(name)) do ours[k] = true end end
    for name in pairs(before) do for _, k in ipairs(keysOf(name)) do oldOurs[k] = true end end
    local entries, seen = {}, {}
    for _, key in ipairs(type(eggsData.AutoDelete) == "table" and eggsData.AutoDelete[egg] or {}) do
        -- keep your own ticks; drop the hub's old picks (re-added below if still picked)
        if not oldOurs[key] and not seen[key] then seen[key] = true table.insert(entries, key) end
    end
    for key in pairs(ours) do
        if not seen[key] then seen[key] = true table.insert(entries, key) end
    end
    table.sort(entries)
    local current = type(eggsData.AutoDelete) == "table" and eggsData.AutoDelete[egg] or {}
    local a = table.clone(current) table.sort(a)
    cleanup.applied[egg] = table.clone(want)
    if table.concat(a, ",") == table.concat(entries, ",") then return true end -- already set
    remote:FireServer({ ["Egg"] = egg, ["Entries"] = entries })
    local names = {}
    for name in pairs(want) do table.insert(names, name) end
    table.sort(names)
    print("[HustlHub] Delete By Egg: " .. egg .. " egg now auto-deletes " .. (#names > 0 and table.concat(names, ", ") or "none of the hub's picks") .. " (every version) as they hatch")
    return true
end
cleanup.pushAllEggDelete = function()
    for egg in pairs(cleanup.eggDelete) do pcall(cleanup.pushEggDelete, egg) end
end
