		})
		corner(header, 4)
		local hStroke = stroke(header, o.bordercolor)
		hover(header, o.dropcolor, shade(o.dropcolor, 0.05))

		local selLabel = new("TextLabel", {
			Name = "Selection",
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 8, 0, 0),
