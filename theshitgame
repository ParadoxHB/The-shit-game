---------------------------------------------------------------- Auto Quests
do -- own scope (keeps the top level under Luau's 200-local limit)
-- From the game's QuestController / QuestConfig / NpcQuestController / NpcQuestConfig:
--   * main quests: Data.Quests[id] = { Amount, Completed, Claimed }; done when Completed or
--     Amount >= Goal; quests without AutoClaim are claimed with QuestService.ClaimQuest { Quest = id }
--   * island quest boards are claimed by the server by itself
--   * NPC quests (Boingo's Big Bounce): NpcQuestService.Talk { Line } starts the quest and
--     finishes "Talk" steps; "Collect" steps = walk within 14 studs of each Bounce Core, then
--     NpcQuestService.Collect { Line, Core }. Stat / island steps fill up as you play.
local QuestRF = Remotes:FindFirstChild("QuestService") and Remotes.QuestService:FindFirstChild("RF")
local NpcRF = Remotes:FindFirstChild("NpcQuestService") and Remotes.NpcQuestService:FindFirstChild("RF")
local QuestConfig, NpcQuestConfig
pcall(function() QuestConfig = require(ReplicatedStorage.Shared.Quests.QuestConfig) end)
pcall(function() NpcQuestConfig = require(ReplicatedStorage.Shared.Quests.NpcQuestConfig) end)

local questsOn, questRunId = false, 0
local questStatus
connections.autoQuests = { Disconnect = function() questsOn = false end }

local function setStatus(text) pcall(function() questStatus:Set(text) end) end

-- claim every finished main quest
local function claimMainQuests(data)
    local claimed = 0
    if not (QuestConfig and QuestRF and QuestRF:FindFirstChild("ClaimQuest") and type(data.Quests) == "table") then return 0 end
    for id, entry in pairs(data.Quests) do
        local def = QuestConfig.Definitions and QuestConfig.Definitions[id]
        if def and def.AutoClaim ~= true and type(entry) == "table" and entry.Claimed ~= true
            and (entry.Completed == true or (tonumber(entry.Amount) or 0) >= (def.Goal or 1)) then
            local ok, result = pcall(function() return safeInvoke(QuestRF.ClaimQuest, { ["Quest"] = id }) end)
            if ok and type(result) == "table" and result.Success == true then
                claimed += 1
                print("[HustlHub] Quests: claimed", id, "-", tostring(def.Description))
            else
                print("[HustlHub] Quests: couldn't claim", id, "-", ok and type(result) == "table" and tostring(result.Reason) or tostring(result))
            end
            task.wait(0.3)
        end
    end
    return claimed
end

-- the NPC model for a quest line (any model with the game's InteractableId = the NPC's name)
local function findNpc(npcName)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:GetAttribute("InteractableId") == npcName then return obj end
    end
    return nil
end

-- go somewhere for a moment (shares the hub's teleport-trip lock), then come back
local function tripTo(cf, action)
    local root = getRoot()
    if not root then return nil end
    local home = root.CFrame
    acquireTrip("quests")
    local results = table.pack(pcall(function()
        teleportAndTouch(cf)
        return action()
    end))
    local back = getRoot()
    if back then
        back.AssemblyLinearVelocity = Vector3.zero
        back.CFrame = home
    end
    task.wait(0.3)
    releaseTrip("quests")
    if not results[1] then warn("[HustlHub] Quests trip error:", results[2]) return nil end
    return table.unpack(results, 2, results.n)
end

local retryAt = {} -- "talk|Line" / "core|Line|Core" -> don't try again before this (failed ones)
local function talk(line)
    local key = "talk|" .. line.Id
    if retryAt[key] and os.clock() < retryAt[key] then return false end
    retryAt[key] = os.clock() + 60 -- cleared below when it works
    local ok, result = pcall(function() return safeInvoke(NpcRF.Talk, { ["Line"] = line.Id }) end)
    if ok and type(result) == "table" and result.Success == true then retryAt[key] = nil return true end
    -- maybe it has to be said in person: go to the NPC and try again
    local npc = findNpc(line.Npc)
    if not npc then
        print("[HustlHub] Quests: talk to", line.Npc, "failed and the NPC isn't loaded nearby:", ok and type(result) == "table" and tostring(result.Reason) or tostring(result))
        return false
    end
    local pos = npc:GetPivot().Position
    local done = tripTo(CFrame.new(pos + Vector3.new(0, 3, 5), pos), function()
        local ok2, result2 = pcall(function() return safeInvoke(NpcRF.Talk, { ["Line"] = line.Id }) end)
        return ok2 and type(result2) == "table" and result2.Success == true
    end)
    if done == true then retryAt[key] = nil end
    return done == true
end

-- NPC quest lines: start them, collect their cores, finish talk steps
local function doNpcQuests(data)
    if not (NpcQuestConfig and NpcRF and NpcQuestConfig.Lines) then return end
    for _, line in pairs(NpcQuestConfig.Lines) do
        if not questsOn then return end
        local entry = NpcQuestConfig.GetEntry(data, line.Id)
        if entry == nil then
            if window.hubTutorialDone(data) and talk(line) then
                print("[HustlHub] Quests: started", line.Title)
            end
        elseif entry.Done ~= true then
            local step = NpcQuestConfig.CurrentStep(line, entry)
            if step and step.Kind == "Talk" then
                if talk(line) then print("[HustlHub] Quests:", line.Title, "-", step.Title) end
            elseif step and step.Kind == "Collect" then
                for _, core in ipairs(NpcQuestConfig.OpenCores(line, entry)) do
                    if not questsOn then return end
                    local key = "core|" .. line.Id .. "|" .. tostring(core.Id)
                    if retryAt[key] and os.clock() < retryAt[key] then continue end
                    retryAt[key] = os.clock() + 60 -- a core that didn't work waits a minute
                    setStatus(line.Title .. ": collecting " .. tostring(core.Id))
                    local got = tripTo(CFrame.new(core.Position + Vector3.new(0, 3, 0)), function()
                        task.wait(0.3)
                        local ok, result = pcall(function()
                            return safeInvoke(NpcRF.Collect, { ["Line"] = line.Id, ["Core"] = core.Id })
                        end)
                        return ok and type(result) == "table" and result.Success == true
                    end)
                    print("[HustlHub] Quests:", line.Title, "core", core.Id, got and "collected" or "not collected")
                end
            elseif step then
                setStatus(string.format("%s: %s (fills up as you play)", line.Title, tostring(step.Title)))
            end
        end
    end
end

automationTab:CreateSection({ name = "Quests" })
automationTab:CreateToggle({
    name = "Auto Quests",
    description = "Claims every finished quest, starts and finishes NPC quests (talks to the NPC, collects Bounce Cores around spawn and comes back). Tap / hatch / island steps fill up as you play.",
    callback = function(value)
        questsOn = value
        questRunId += 1
        if not value then setStatus("Off") return end
        local myRun = questRunId
