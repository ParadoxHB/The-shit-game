-- 1) Log file: every [HustlHub] line is also written (with the time) to TapSimHub_log.txt in your
--    executor's workspace folder, so you can see what happened while you were away.
local LOG_FILE = "TapSimHub_log.txt"
pcall(function() writefile(LOG_FILE, "=== HustlHub v" .. tostring(getgenv().HustlHubVersion or "?") .. " started " .. os.date("%Y-%m-%d %H:%M:%S") .. " ===\n") end)
local function writeLog(kind, ...)
    local parts = table.pack(...)
    for i = 1, parts.n do parts[i] = tostring(parts[i]) end
    local line = os.date("%H:%M:%S") .. " " .. kind .. " " .. table.concat(parts, " ", 1, parts.n) .. "\n"
    pcall(function()
        if appendfile then appendfile(LOG_FILE, line) end
    end)
end
local print, warn = (function()
-- HustlHub messages are no longer printed to the console. The log file (TapSimHub_log.txt) only gets warnings
-- and the important lines (starting, stopping, finishing, errors), so it stays small even with many accounts.
local LOG_IMPORTANT = { "stopped", "error", "crash", "couldn't", "failed", "finished", "complete", "full", "walked away", "moved away",
    "activity:", "tap count", "hallow boss:" } -- (the activity checker's record goes to the log too)
local function logJoin(...)
    local parts = table.pack(...)
    for i = 1, parts.n do parts[i] = tostring(parts[i]) end
    return table.concat(parts, " ", 1, parts.n)
end
return function(...)
    local lower = logJoin(...):lower()
    for _, word in ipairs(LOG_IMPORTANT) do
        if lower:find(word, 1, true) then
            writeLog("INFO", ...)
            return
        end
    end
end, function(...)
    writeLog("WARN", ...)
end
end)()

