end

-- Waits up to `seconds` for the spot's breakable to show up near where we're standing
local function waitForIslandBreakable(spot, seconds, stillRunning)
    local start = os.clock()
    repeat
        local model = findIslandBreakable(spot)
        if model then return model end
        task.wait(0.25)
    until os.clock() - start > seconds or not stillRunning()
    return nil
end

-- Goes to one island, waits for its breakable, then follows and taps it until it's broken
local function breakIslandSpot(spot, stillRunning)
    teleportAndTouch(spot.cf)
    local model = waitForIslandBreakable(spot, ISLAND_APPEAR_WAIT, stillRunning)
    if not model then
        print("[HustlHub] " .. spot.title .. " didn't appear on " .. spot.island)
        return false
    end

    local function standNextTo()
        local center = breakablePosition(model)
        teleportAndTouch(CFrame.new(center + Vector3.new(5, 2, 0), center))
    end
    standNextTo()

    local start = os.clock() -- was a stray global
    while stillRunning() and model.Parent and model:GetAttribute("BreakableBroken") ~= true
        and os.clock() - start < ISLAND_BREAK_TIMEOUT do
        -- It hops away when hit: follow it
        local root = getRoot()
        if root and (root.Position - breakablePosition(model)).Magnitude > ISLAND_FOLLOW_DISTANCE then
            local center = breakablePosition(model)
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = CFrame.new(center + Vector3.new(5, 2, 0), center)
        end
        clientSequence += 1
        TapRemote:FireServer({ ["Auto"] = false, ["ClientSequence"] = clientSequence })
        task.wait(ISLAND_TAP_INTERVAL)
    end

    local broke = model:GetAttribute("BreakableBroken") == true or model.Parent == nil
    print("[HustlHub] " .. spot.title .. (broke and " broken" or " not broken (timed out)"))
    if broke then task.wait(MINI_AFTER_BREAK) end
    return broke
end

