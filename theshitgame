    local function showTally()
        local counts = tally()
        local names, pets = {}, 0
        for name, t in pairs(counts) do table.insert(names, name) pets += t.total end
        table.sort(names, function(a, b)
            if counts[a].total ~= counts[b].total then return counts[a].total > counts[b].total end
            return a < b
        end)
        local lines = { string.format("%d kinds, %s pets on %d accounts (accounts running HustlHub, updated every 30 s)", #names, commas(pets), #allInventories()) }
        for i, name in ipairs(names) do
            if i > 45 then table.insert(lines, "... and " .. (#names - 45) .. " more kinds") break end
            local t = counts[name]
            local parts = {}
            for _, tier in ipairs({ "Normal", "Golden", "Diamond", "Shiny" }) do
                if t.tiers[tier] then table.insert(parts, commas(t.tiers[tier]) .. " " .. TIER_NAME[tier]) end
            end
            table.insert(lines, string.format("%s: %s  (%s)  on %d account%s", name, commas(t.total), table.concat(parts, " · "), t.accounts, t.accounts == 1 and "" or "s"))
        end
        pcall(function() tallyText:Set(table.concat(lines, "\n")) end)
    end

    -- the in-game Pet Power board (PlayerGui.PetPowerLeaderboard, a SurfaceGui): Podium 1-3, List #4.., Self = you.
    -- Its number is the total power of ALL the pets you own (checked: 521 pets = 1.014e9, board "1B").
    local AMOUNT_SUFFIX = { K = 1e3, M = 1e6, B = 1e9, T = 1e12, QA = 1e15, QI = 1e18, SX = 1e21, SP = 1e24, OC = 1e27, NO = 1e30, DC = 1e33 }
    local function parseAmount(text)
        local num, suf = (tostring(text):gsub(",", "")):match("([%d%.]+)%s*(%a*)")
        num = tonumber(num)
        if not num then return nil end
        if suf == "" then return num end
        local mult = AMOUNT_SUFFIX[suf:upper()]
        return mult and num * mult or nil
    end
    local function readBoard()
        local main
        pcall(function() main = LocalPlayer.PlayerGui.PetPowerLeaderboard.Main end)
        if not main then return nil end
        local rows, seen = {}, {}
        local function add(frame, rankHint)
            local nameL, amtL, rankL = frame:FindFirstChild("Username", true), frame:FindFirstChild("Amount", true), frame:FindFirstChild("Rank", true)
            local rank = tonumber((tostring(rankL and rankL.Text or rankHint or ""):gsub("[^%d]", ""))) or tonumber(rankHint)
            local value = amtL and parseAmount(amtL.Text)
            if rank and value and nameL and not seen[rank] then
                seen[rank] = true
                table.insert(rows, { rank = rank, name = nameL.Text, value = value })
            end
        end
        for _, holder in ipairs({ main:FindFirstChild("Podium"), main:FindFirstChild("List") }) do
            for _, f in ipairs(holder and holder:GetChildren() or {}) do
                if f:IsA("Frame") and tonumber(f.Name) then add(f, f.Name) end
            end
        end
        table.sort(rows, function(a, b) return a.rank < b.rank end)
        local me
        local s = main:FindFirstChild("Self")
        if s then
            local rankL, amtL = s:FindFirstChild("Rank"), s:FindFirstChild("Amount")
            me = { rank = tonumber((tostring(rankL and rankL.Text or ""):gsub("[^%d]", ""))), value = amtL and parseAmount(amtL.Text) }
        end
        return rows, me
    end
    -- where a pet power total would land: the spot of the first listed player it beats, or, below the listed ones, an
    -- estimate between the last listed rank and your own row (the board spreads out roughly evenly on a log scale there)
    local function rankFor(value, rows, me)
        local others = {}
        for _, r in ipairs(rows) do if r.name ~= T.me then table.insert(others, r) end end
        for i, r in ipairs(others) do
            if value >= r.value then return i, true, r end
        end
        local last = others[#others]
        if not last then return nil end
        if me and me.rank and me.value and me.value > 0 and me.rank > #others + 1 and value > me.value and last.value > me.value then
            local f = (math.log(last.value) - math.log(value)) / (math.log(last.value) - math.log(me.value))
            return math.floor(#others + 1 + f * (me.rank - #others - 1) + 0.5), false
        end
        if me and me.rank and me.value and value <= me.value then return me.rank, false end
        return #others + 1, false
    end
    local function showPotential(rows, me)
        local d = getReplica() and getReplica().Data
        if not d then return end
        local limit = tonumber(d.Pets.StorageLimit) or 0
        local powers, mine, mineCount, accounts = {}, 0, 0, 0
        for _, inv in ipairs(allInventories()) do
            accounts += 1
            for _, e in ipairs(inv.pets) do
                local p = tonumber(e[3]) or 0
                table.insert(powers, p)
                if inv.name == T.me then mine += p mineCount += 1 end
            end
        end
        table.sort(powers, function(a, b) return a > b end)
        local best = 0
        for i = 1, math.min(limit, #powers) do best += powers[i] end
        local lines = {}
        if rows and #rows > 0 then
            local top = {}
            for i = 1, math.min(5, #rows) do table.insert(top, "#" .. rows[i].rank .. " " .. rows[i].name .. " " .. fmt(rows[i].value)) end
            table.insert(lines, "Leaderboard (top " .. rows[#rows].rank .. " read): " .. table.concat(top, " · "))
        else
            table.insert(lines, "Leaderboard: not loaded yet (it's the Pet Power board in the world)")
        end
        table.insert(lines, string.format("This account: %s pet power with %s / %s pets%s", fmt(mine), commas(mineCount), commas(limit),
            me and me.rank and (" (board: #" .. me.rank .. ")") or ""))
        table.insert(lines, string.format("Best possible here: %s = your %s strongest pets out of %s on %d account%s (+%s)", fmt(best),
            commas(math.min(limit, #powers)), commas(#powers), accounts, accounts == 1 and "" or "s", fmt(math.max(best - mine, 0))))
        if rows and #rows > 0 then
            local rank, exact, beat = rankFor(best, rows, me)
            if rank then
                table.insert(lines, exact and string.format("That would put you at #%d (just above %s, %s)", rank, beat.name, fmt(beat.value))
                    or string.format("That would put you at about #%d (estimated: below the top %d)", rank, rows[#rows].rank))
            end
        end
        table.insert(lines, "Updated " .. os.date("%H:%M:%S") .. " (re-read whenever the board changes)")
        pcall(function() potentialText:Set(table.concat(lines, "\n")) end)
    end

    task.spawn(function()
        local lastSig, lastFull = nil, 0
        task.wait(5)
        while T.alive and getgenv().HustlHubRun == HH_RUN do
            pcall(function()
                local rows, me = readBoard()
                local sig = ""
                for _, r in ipairs(rows or {}) do sig = sig .. r.rank .. r.name .. r.value .. "|" end
                sig = sig .. tostring(me and me.rank) .. tostring(me and me.value)
                -- the board changed (it updates by itself every so often), or 30 s passed (inventories change too)
                if sig ~= lastSig or os.clock() - lastFull >= 30 then
                    lastSig, lastFull = sig, os.clock()
                    showPotential(rows, me)
                    showTally()
                end
            end)
            task.wait(5)
        end
    end)

    ---------------- Collect Best Pets Here (v1.4.49)
    -- Fills THIS account's storage with the strongest pets of all your accounts in this server (pet power leaderboard):
    -- plan from the shared inventories, then a chain of ordinary trade runs that name exact pets (cfg.idsBySender).
    -- Your locked pets on this account always stay. Weaker pets here are only sent away when room is needed, to the
    -- account whose pets are coming in (if it has space). Frozen pets never move.
    local C = { running = false, stop = false, armedAt = 0, plan = nil }
    -- its own status line (Trading Status is reset to the last run's summary every 2 s while no trade runs, which wiped
    -- the plan straight away); created right under the button below
    local collectText
    local function cstatus(text)
        C.lastText = text
        pcall(function() if collectText then collectText:Set(text) end end)
    end
    local function planCollect()
        local Players = game:GetService("Players")
        local pool, accounts, frozenHere, frozenPower, noIds = {}, {}, 0, 0, {}
        for _, inv in ipairs(allInventories()) do
            if inv.name == T.me or Players:FindFirstChild(inv.name) then
                accounts[inv.name] = { limit = tonumber(inv.limit) or 0, count = #inv.pets }
                for _, e in ipairs(inv.pets) do
                    if tonumber(e[6]) == 1 then
                        if inv.name == T.me then frozenHere += 1 frozenPower += tonumber(e[3]) or 0 end
                    elseif e[4] then
                        table.insert(pool, { power = tonumber(e[3]) or 0, owner = inv.name, id = tostring(e[4]), locked = tonumber(e[5]) == 1 })
                    else
                        noIds[inv.name] = true -- (that account runs an older HustlHub: its pets can't be picked by id)
                    end
                end
            end
        end
        local mine = accounts[T.me]
        if not mine then return nil, "this account's pets aren't read yet" end
        table.sort(pool, function(a, b) return a.power > b.power end)
        local slots = mine.limit - frozenHere
        local chosen, chosenSet = {}, {}
        for _, p in ipairs(pool) do -- your locked pets here first (they stay)
            if p.owner == T.me and p.locked then table.insert(chosen, p) chosenSet[p.id] = true end
        end
        for _, p in ipairs(pool) do
            if #chosen >= slots then break end
            if not chosenSet[p.id] then table.insert(chosen, p) chosenSet[p.id] = true end
        end
        local inBy, order, now, best, nIn = {}, {}, frozenPower, frozenPower, 0
        for _, p in ipairs(pool) do if p.owner == T.me then now += p.power end end
        for _, p in ipairs(chosen) do
            best += p.power
            if p.owner ~= T.me then
                if not inBy[p.owner] then inBy[p.owner] = {} table.insert(order, p.owner) end
                table.insert(inBy[p.owner], p.id) -- (strongest first)
                nIn += 1
            end
        end
        local out = {} -- this account's pets that didn't make it, weakest first (sent away only if room is needed)
        for i = #pool, 1, -1 do
            local p = pool[i]
            if p.owner == T.me and not chosenSet[p.id] and not p.locked then table.insert(out, p.id) end
        end
        table.sort(order, function(a, b) return #inBy[a] > #inBy[b] end)
        -- the trade steps: per account, room first (send it weaker pets) when needed, then its best pets come here
        local steps, freeHere, o, short = {}, mine.limit - mine.count, 1, 0
        for _, owner in ipairs(order) do
            local rem = table.clone(inBy[owner])
            local acc = accounts[owner]
            while #rem > 0 do
                if freeHere <= 0 then
                    local give = math.min(#rem, acc.limit - acc.count, #out - o + 1)
                    if give <= 0 then short += #rem break end
                    local chunk = {}
                    for i = o, o + give - 1 do table.insert(chunk, out[i]) end
                    o += give
                    table.insert(steps, { receiver = owner, sender = T.me, ids = chunk })
                    freeHere += give
                    acc.count += give
                end
                local take = math.min(#rem, freeHere)
                table.insert(steps, { receiver = T.me, sender = owner, ids = table.move(rem, 1, take, 1, {}) })
                for _ = 1, take do table.remove(rem, 1) end
                freeHere -= take
                acc.count -= take
            end
        end
        local older = {}
        for name in pairs(noIds) do table.insert(older, name) end
        return { steps = steps, nIn = nIn, nOut = o - 1, now = now, best = best, short = short, accounts = #order, older = older, limit = mine.limit }
    end
    local function describe(plan)
        local s = string.format("Plan: %d best pets come here from %d account(s), %d weaker pets go out to make room. Pet power %s -> %s (+%s).",
            plan.nIn, plan.accounts, plan.nOut, fmt(plan.now), fmt(plan.best), fmt(math.max(plan.best - plan.now, 0)))
        if plan.short > 0 then s = s .. " " .. plan.short .. " pets can't come (no free room on either side)." end
        if #plan.older > 0 then s = s .. " Not counted (older HustlHub, re-run it there): " .. table.concat(plan.older, ", ") .. "." end
        return s
    end
    -- one step = one ordinary run (receiver + one sender) naming the exact pets; waits until the receiver finishes it
    local function runStep(step, i, n)
        local cur = readJson(CFG_FILE) or {}
        local rev = (tonumber(cur.rev) or 0) + 1
        writeJson(CFG_FILE, { rev = rev, on = true, from = T.me, receiver = step.receiver, senders = { step.sender }, pets = {}, versions = {},
            idsBySender = { [step.sender] = step.ids }, sendEquipped = true, secretsOnly = false, secretsToo = false, collect = true })
        C.progress = string.format("Collecting %d/%d: %s -> %s (%d pets)", i, n, step.sender, step.receiver, #step.ids)
        cstatus(C.progress)
        local deadline = os.clock() + 60 + 45 * math.ceil(#step.ids / 20)
        while T.alive and not C.stop and os.clock() < deadline do
            task.wait(2)
            local f = readJson(CFG_FILE)
            if not f or (tonumber(f.rev) or 0) < rev then return false, "the run was replaced" end
            if f.on == false then return true, tostring(f.summary or "") end
            if (tonumber(f.rev) or 0) > rev + 1 then return false, "another run started" end
        end
        local f = readJson(CFG_FILE) or {}
        if tonumber(f.rev) == rev and f.on then f.on = false f.rev = rev + 1 writeJson(CFG_FILE, f) end -- (stop it)
        return false, C.stop and "stopped" or "timed out"
    end
    local collectBtn
    collectBtn = tradeTab:CreateButton({
        name = "Collect Best Pets Here",
        buttonText = "COLLECT",
        description = "Fills THIS account's storage with the strongest pets of all your accounts in this server (the most pet power for the leaderboard): their best pets are traded here, and weaker pets here are traded away only when room is needed. Your locked pets here always stay; equipped / locked pets on the other accounts are unequipped / unlocked and sent. Press once to see the plan, press again within 6 seconds to start. To stop it, press Stop Collect (pressing COLLECT again only shows the progress). All accounts need HustlHub v1.4.49+.",
        callback = function()
            if C.running then
                -- (v1.4.51) pressing COLLECT again used to STOP it, and people pressed again to see if it was working:
                -- it stopped every run in the first 20 s. Now only the Stop Collect button stops it.
                cstatus((C.progress or "Collect is running.") .. " (It's running: press Stop Collect to stop it.)")
                return
            end
            local plan, err = planCollect()
            if not plan then cstatus("Collect: " .. tostring(err)) return end
            if #plan.steps == 0 then cstatus("Collect: nothing to do. " .. describe(plan)) return end
            if os.clock() - C.armedAt > 6 then
                C.armedAt = os.clock()
                cstatus(describe(plan) .. " Press COLLECT again to start.")
                window:Notify({ title = "Collect Best Pets", content = "Press again within 6 s to start (" .. plan.nIn .. " in, " .. plan.nOut .. " out).", duration = 6 })
                return
            end
            C.armedAt = 0
            C.running, C.stop = true, false
            task.spawn(function()
                -- stop hatching here while pets come in (hatching would fill the room); back on afterwards
                local hatchEl = window.elementsByFlag["Auto Hatch"]
                local hatchWasOn = hatchEl and hatchEl.value
                if hatchWasOn then pcall(window.hubHatchToggle, false) end
                local done, failed = 0, {}
                for i, step in ipairs(plan.steps) do
                    if C.stop or not T.alive then break end
                    local ok, info = runStep(step, i, #plan.steps)
                    if ok then done += 1 else table.insert(failed, step.sender .. " -> " .. step.receiver .. ": " .. info) end
                    print("[HustlHub] Collect step " .. i .. "/" .. #plan.steps .. " " .. step.sender .. " -> " .. step.receiver .. ": " .. tostring(info))
                end
                if hatchWasOn and hatchEl.value then pcall(window.hubHatchToggle, true) end
                C.running = false
                local after = planCollect()
                local result = string.format("Collect finished: %d/%d trade runs done%s.", done, #plan.steps, C.stop and " (stopped)" or "")
                if #failed > 0 then result = result .. " Problems: " .. table.concat(failed, " | ") .. "." end
                if after then result = result .. " Pet power here now " .. fmt(after.now) .. " (best possible " .. fmt(after.best) .. ")." end
                cstatus(result)
                print("[HustlHub] " .. result)
            end)
        end,
    })
    tradeTab:CreateButton({
        name = "Stop Collect",
        buttonText = "STOP",
        description = "Stops Collect Best Pets Here after the trade that's going on right now (the pets already moved stay where they are).",
        callback = function()
            if not C.running then cstatus("Collect isn't running.") return end
            C.stop = true
            cstatus("Collect: stopping after the current trade...")
        end,
    })
    collectText = tradeTab:CreateText({ name = "Collect Status", text = "Press COLLECT to see the plan.", wide = true, textSize = 11 })

    -- put back what was picked last time
    do
        local saved = readJson(PICKS_FILE)
        if saved then
            local function list(v) return type(v) == "table" and v or {} end
            pickReceiver = saved.receiver and { saved.receiver } or {}
            pickSenders = list(saved.senders)
            pickPets, pickVersions = list(saved.pets), list(saved.versions)
            pcall(function() receiverDrop:Set(pickReceiver, true) end)
            pcall(function() sendersDrop:Set(pickSenders, true) end)
            pcall(function() petsDrop:Set(labelsFor(pickPets), true) end)
            pcall(function() versionsDrop:Set(pickVersions, true) end)
            if saved.secretsOnly ~= nil and saved.prefsV == 2 then -- (an older save, from when it was on by default, is ignored: off by default now)
                T.sendLocked = saved.secretsOnly == true
                pcall(function() secretsEl:Set(T.sendLocked, true) end)
            end
            if saved.sendEquipped ~= nil then
                T.sendEquipped = saved.sendEquipped == true
                pcall(function() equippedEl:Set(T.sendEquipped, true) end)
            end
            if saved.secretsToo ~= nil then
                T.secretsToo = saved.secretsToo == true
                pcall(function() secretsTooEl:Set(T.secretsToo, true) end)
            end
        end
        prefsReady = true
    end
end, function(err) warn("[HustlHub] Trading tab failed to load:", err) end)

