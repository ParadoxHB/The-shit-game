	function types:Slider(name, options, callback)
		options = options or {}
		local o = library.options
		local location = options.location or self.flags
		local flag = options.flag or ""
		callback = callback or function() end

		local min = options.min or 0
		local max = options.max or 1
		if max <= min then
			max = min + 1
		end
		local precise = options.precise or false
		local step = options.step

		-- how many decimals the value needs (step 0.05 -> 2, step 1 -> 0)
		local decimals = 0
		if step and step > 0 then
			while decimals < 6 and math.abs(step * 10 ^ decimals - math.floor(step * 10 ^ decimals + 0.5)) > 1e-9 do
				decimals = decimals + 1
			end
		elseif precise then
			decimals = 2
		end

		local function normalize(v)
			v = math.clamp(v, min, max)

			if step and step > 0 then
				v = min + math.floor((v - min) / step + 0.5) * step
				v = math.min(v, max)
			elseif not precise then
				v = math.floor(v + 0.5)
			end

			-- round away floating point noise (0.30000000000000004 -> 0.3)
			return tonumber(string.format("%." .. decimals .. "f", v))
		end

		local function fmt(v)
			return string.format("%." .. decimals .. "f", v)
		end

		local value = normalize(options.default or min)
		location[flag] = value

		local holder = new("Frame", {
			Name = name,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 34),
			LayoutOrder = nextOrder(self),
			Parent = self.container,
		})

		new("TextLabel", {
			Name = "Label",
			Text = name,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -50, 0, 18),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Font = o.font,
			TextSize = o.fontsize,
			TextColor3 = o.textcolor,
			Parent = holder,
		})

		local valueLbl = new("TextLabel", {
			Name = "ValueLabel",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 0),
			Size = UDim2.new(0, 50, 0, 18),
			TextXAlignment = Enum.TextXAlignment.Right,
			Font = o.font,
			TextSize = o.fontsize,
			TextColor3 = o.textcolor,
			Text = fmt(value),
			Parent = holder,
		})

		local track_ = new("Frame", {
			Name = "Track",
			Position = UDim2.new(0, 0, 0, 24),
			Size = UDim2.new(1, 0, 0, 4),
			BackgroundColor3 = o.btncolor,
			BorderSizePixel = 0,
			Parent = holder,
		})
		corner(track_, 2)

		local fill = new("Frame", {
			Name = "Fill",
			Size = UDim2.new(0, 0, 1, 0),
			BackgroundColor3 = o.accent,
			BorderSizePixel = 0,
			Parent = track_,
		})
		corner(fill, 2)
		bindAccent(fill, "BackgroundColor3", function() return library.options.accent end)

		local knob = new("Frame", {
			Name = "Knob",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.new(0, 10, 0, 10),
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			Parent = track_,
		})
		corner(knob, 5)

		local hit = new("TextButton", {
			Name = "Hit",
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 0, 0, 18),
			Size = UDim2.new(1, 0, 0, 16),
			Parent = holder,
		})

		local function render(animate)
			local p = (value - min) / (max - min)
			local t = animate and 0.08 or 0

			tween(fill, {Size = UDim2.new(p, 0, 1, 0)}, t)
			tween(knob, {Position = UDim2.new(p, 0, 0.5, 0)}, t)
			valueLbl.Text = fmt(value)
		end

		render(false)

		local function fromX(x)
			local p = math.clamp((x - hit.AbsolutePosition.X) / math.max(hit.AbsoluteSize.X, 1), 0, 1)
			local v = normalize(min + (max - min) * p)

			if v ~= value then
				value = v
				location[flag] = v
				render(true)
				callback(v)
			end
		end

		local dragging = false

		hit.InputBegan:Connect(function(input)
			if dragging then
				return
			end

			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				fromX(input.Position.X)

				local moveConn, endConn

				moveConn = UIS.InputChanged:Connect(function(i)
					if i.UserInputType == Enum.UserInputType.MouseMovement
						or i.UserInputType == Enum.UserInputType.Touch then
						fromX(i.Position.X)
					end
				end)

				endConn = UIS.InputEnded:Connect(function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1
						or i.UserInputType == Enum.UserInputType.Touch then
						dragging = false
						moveConn:Disconnect()
						endConn:Disconnect()
					end
				end)
			end
		end)

		return {
			Set = function(_, v)
				value = normalize(tonumber(v) or min)
				location[flag] = value
				render(true)
				callback(value)
			end,
			Get = function()
				return value
			end,
		}
	end

	function types:Dropdown(name, options, callback)
		options = options or {}
		local o = library.options
		local location = options.location or self.flags
		local flag = options.flag or ""
		callback = callback or function() end

		local list = copyList(options.list)
		local multi = (options.type or "single") == "multi"
		local searchable = options.search or false
		local dim = Color3.fromRGB(150, 150, 150)

		-- selection state
		local sel = {}
		local single = nil

		if multi then
			if options.default then
				sel = copyList(options.default)
			else
				sel = copyList(list)
			end
		else
			if options.default then
				single = tostring(options.default)
			else
				single = list[1]
			end
		end

		local function isSelected(v)
			if multi then
				return table.find(sel, v) ~= nil
			end

			return single == v
		end

		local function value()
			if multi then
				return copyList(sel)
			end

			return single
		end

		location[flag] = value()

		-- ui
		local row = new("Frame", {
			Name = name,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 26),
			LayoutOrder = nextOrder(self),
			Parent = self.container,
		})

		local header = new("TextButton", {
