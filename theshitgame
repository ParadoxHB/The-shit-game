				LayoutOrder = #self.tabs,
				Parent = self.railList,
			})
			corner(btn, 4)
			new("UIPadding", {PaddingLeft = UDim.new(0, 10), Parent = btn})

			local bar = new("Frame", {
				Name = "Bar",
				BackgroundColor3 = o.accent,
				BorderSizePixel = 0,
				Position = UDim2.new(0, -7, 0.5, -8),
				Size = UDim2.new(0, 3, 0, 16),
				Visible = false,
				Parent = btn,
			})
			corner(bar, 2)

			tab.btn = btn
			tab.bar = bar

			btn.MouseEnter:Connect(function()
				if self.current ~= tab then
					tween(btn, {BackgroundTransparency = 0.5}, 0.1)
				end
			end)
			btn.MouseLeave:Connect(function()
				if self.current ~= tab then
					tween(btn, {BackgroundTransparency = 1}, 0.1)
				end
			end)
			btn.MouseButton1Click:Connect(function()
				self:SelectTab(tab)
			end)

			table.insert(library.hooks, function()
				if not btn.Parent then
					return true
				end

				bar.BackgroundColor3 = library.options.accent

				if self.current == tab then
					btn.TextColor3 = library.options.accent
				end

				return false
			end)
		end

		if not self.current then
			self:SelectTab(tab)
		end

		return tab
	end

	function Hub:SelectTab(tab)
		if library.openDropdown then
			library.openDropdown()
		end

		hideTip()
		self.current = tab

		for _, t in ipairs(self.tabs) do
			for _, e in ipairs(t.rows) do
				e.hover = 0
			end
		end

		for _, t in ipairs(self.tabs) do
			local on = (t == tab)
			t.page.Visible = on

			if t.btn then
				t.btn.BackgroundTransparency = on and 0 or 1
				t.btn.TextColor3 = on and library.options.accent or library.options.textcolor
				t.bar.Visible = on
			end
		end
	end

	-- puts the sidebar tabs in the given order (any tab not listed goes to the end)
	function Hub:ReorderTabs(order)
		local new, used = {}, {}

		for _, n in ipairs(order) do
			local t = self.tabByName[n]

			if t and not used[t] then
				used[t] = true
				table.insert(new, t)
			end
		end

		for _, t in ipairs(self.tabs) do
			if not used[t] then
				table.insert(new, t)
			end
		end

		self.tabs = new

		for i, t in ipairs(new) do
			if t.btn then
				t.btn.LayoutOrder = i
			end
		end
	end

	function Hub:ShowTab(name)
		local tab = self.tabByName[name]

		if tab then
			self:Show()
			self:SelectTab(tab)
		end
	end

	function Hub:TabNames()
		local names = {}

		for _, t in ipairs(self.tabs) do
			table.insert(names, t.name)
		end

		return names
	end

	function Hub:ApplyFilter()
		local q = string.lower(self.query or "")
		local first

		for _, tab in ipairs(self.tabs) do
			local count = 0

			for _, e in ipairs(tab.rows) do
				local vis = true

				if q ~= "" then
					if e.kind == "section" then
						vis = false
					else
						vis = string.find(e.name, q, 1, true) ~= nil or string.find(e.desc, q, 1, true) ~= nil
					end
				end

				if e.row.Visible ~= vis then
					e.row.Visible = vis
				end

				if vis and e.kind ~= "section" then
					count = count + 1
				end
			end

			tab.matchCount = count

			if tab.btn then
				tab.btn.Text = (q ~= "") and (tab.name .. " (" .. count .. ")") or tab.name
				tab.btn.TextTransparency = (q ~= "" and count == 0) and 0.6 or 0
			end

			if q ~= "" and count > 0 and not first then
				first = tab
			end
		end

		if q ~= "" and self.current and self.current.matchCount == 0 and first then
			self:SelectTab(first)
		end
	end

