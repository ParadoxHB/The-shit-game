    ["Follow All-Account Commands"] = true,
}
window.hubDefaultOn = {} -- (v1.4.59: nothing is switched on at launch: every switch starts OFF)
-- switches added to the default list after you first ran this: they apply once even if an older save has them off
window.hubNewDefaults = {}
pcall(function()
    if isfile(window.hubVersionFile) and readfile(window.hubVersionFile) == "1" then
