-- Per-pet rules for the storage-full trip: pick pets, then how far they get crafted
-- (e.g. Crawler -> Rainbow, Cerberus -> Diamond). Saved per account in a file in the workspace.
do
    local HttpService = game:GetService("HttpService")
    local RULES_FILE = "HustlHub_craft_rules_" .. tostring(LocalPlayer.UserId) .. ".json"
    local RULE_OPTIONS = { "Don't Craft", "Golden", "Diamond", "Rainbow" }
    pcall(function()
        if isfile and isfile(RULES_FILE) then
            local saved = HttpService:JSONDecode(readfile(RULES_FILE))
            if type(saved) == "table" then hatchCraft.rules = saved end
        end
    end)
    local function saveRules()
        pcall(function() writefile(RULES_FILE, HttpService:JSONEncode(hatchCraft.rules)) end)
    end

    -- pet names to choose from: everything you own (any tier) + the selected egg's pets
    local function petNames()
        local set, list = {}, {}
        for _, pet in pairs(getOwnedPets()) do
            if type(pet) == "table" and type(pet.Name) == "string" then set[pet.Name] = true end
        end
        local cfg = selectedEgg and LaunchEggConfig and LaunchEggConfig[selectedEgg]
        if cfg and cfg.Pets then for name in pairs(cfg.Pets) do set[name] = true end end
        for name in pairs(hatchCraft.rules) do set[name] = true end
        for name in pairs(set) do table.insert(list, name) end
        table.sort(list)
        return list
    end
    local function label(name)
        local rule = hatchCraft.rules[name]
        return rule and (name .. " (" .. rule .. ")") or name
    end
    local function nameOf(text) return (tostring(text):gsub(" %b()$", "")) end

    local pickedPets = {}
    local rulesText, ruleDropdown, upToDropdown
    local function showRules()
        local parts = {}
        for name, rule in pairs(hatchCraft.rules) do table.insert(parts, name .. " -> " .. rule) end
        table.sort(parts)
        pcall(function() rulesText:Set(#parts > 0 and table.concat(parts, "\n") or "No rules: every pet follows Storage Full Crafts") end)
    end
    local function options()
        local list = {}
        for _, name in ipairs(petNames()) do table.insert(list, label(name)) end
        return list
    end

    ruleDropdown = craftTab:CreateDropdown({
        name = "Craft Rule Pets",
        description = "Pick the pets to set a rule for, then choose how far they get crafted below. The rule shows next to each pet's name.",
        options = options(),
        multiSelect = true,
        forgetState = true,
        optionIcon = function(text) return { pet = nameOf(text), tier = "Normal" } end,
        onOpen = function()
            ruleDropdown:Refresh(options())
            local ticked = {}
            for name in pairs(pickedPets) do table.insert(ticked, label(name)) end
            ruleDropdown:Set(ticked, true)
        end,
        callback = function(selected)
            table.clear(pickedPets)
            for _, text in ipairs(selected) do pickedPets[nameOf(text)] = true end
        end,
    })

    upToDropdown = craftTab:CreateDropdown({
        name = "Craft Pets Up To",
        description = "Sets the rule for the pets picked above: \"Rainbow\" crafts them all the way up, \"Diamond\" stops at Diamond, \"Golden\" stops at Golden, \"Don't Craft\" never crafts them. Pick \"Default\" to remove their rule.",
        options = { "Default", "Don't Craft", "Golden", "Diamond", "Rainbow" },
        forgetState = true,
        callback = function(selected)
            local choice = firstOption(selected)
            if not choice or next(pickedPets) == nil then return end
            for name in pairs(pickedPets) do
                hatchCraft.rules[name] = table.find(RULE_OPTIONS, choice) and choice or nil
            end
            saveRules()
            showRules()
            pcall(function() ruleDropdown:Refresh(options()) end)
            local names = {}
            for name in pairs(pickedPets) do table.insert(names, name) end
            print("[HustlHub] Craft rule:", table.concat(names, ", "), "->", choice)
            task.defer(function() pcall(function() upToDropdown:Set({}, true) end) end) -- ready for the next pick
        end,
    })
    rulesText = craftTab:CreateText({ name = "Craft Rules", text = "", wide = true })
    window.hubCraftMoved.last = #craftTab.rows
    showRules()

    -- shared with every account by "Sync Settings Across All Accounts" (Config tab)
    window.hubSync = window.hubSync or { extras = {} }
    window.hubSync.extras.craftRules = {
        get = function() return hatchCraft.rules end,
        set = function(rules)
            if type(rules) ~= "table" then return end
            hatchCraft.rules = rules
            saveRules()
            showRules()
            pcall(function() ruleDropdown:Refresh(options()) end)
        end,
    }
end

---------------------------------------------------------------- Auto Skill Tree
do -- own scope (keeps the top level under Luau's 200-local limit)
-- From the game's SkillTreeController / SkillTreeConfig / SkillTreeRequirements:
--   * the tree starts at SkillTreeConfig.Origin and branches N / S / NE / NW / SE / SW; "Category"
--     nodes open a sub-tree (SkillTreeConfig[node.Tree]); unlocked names are in Data.SkillTree.Unlocked
--   * an upgrade is ready (the game's own isReadyUpgrade) when the node before it is unlocked, it
--     isn't unlocked yet, it's not a Category / Origin node, you have its Cost in Gems, and no
--     shop / island requirement blocks it
--   * buying = SkillTreeService.Unlock { Name = node.Name }
local SkillTreeConfig, SkillTreeRequirements
pcall(function() SkillTreeConfig = require(ReplicatedStorage.Shared.Progression.SkillTreeConfig) end)
pcall(function() SkillTreeRequirements = require(ReplicatedStorage.Shared.Progression.SkillTreeRequirements) end)
local SkillUnlock = Remotes:FindFirstChild("SkillTreeService") and Remotes.SkillTreeService:FindFirstChild("RF")
    and Remotes.SkillTreeService.RF:FindFirstChild("Unlock")
local DIRECTIONS = { "N", "S", "NE", "NW", "SE", "SW" }

-- every upgrade you could buy right now (walks the tree exactly like the game's counter does)
local function readyUpgrades()
    local replica = getReplica()
    local data = replica and replica.Data
    if not (data and SkillTreeConfig and SkillTreeConfig.Origin) then return {} end
    local unlocked = (type(data.SkillTree) == "table" and type(data.SkillTree.Unlocked) == "table") and data.SkillTree.Unlocked or {}
    local gems = tonumber(data.Currencies and data.Currencies.Gems) or 0
    local ready, seenTrees = {}, { Origin = true }
    local function blocked(node)
        if not SkillTreeRequirements then return false end
        local okShop, shop = pcall(SkillTreeRequirements.GetLockedShop, data, node)
        local okIsland, island = pcall(SkillTreeRequirements.GetLockedIsland, data, node)
        return (okShop and shop ~= nil) or (okIsland and island ~= nil)
    end
    local function walk(node, parentUnlocked)
        if type(node) ~= "table" then return end
        -- buyable: normal upgrades, and tree openers ("Category" nodes like Clicking / Pets / Eggs:
        -- free, but they still have to be unlocked once before anything inside them can be bought)
        local buyable = not node.Origin and (not node.Category or node.Tree ~= nil)
        if parentUnlocked and buyable and unlocked[node.Name] ~= true
            and (tonumber(node.Cost) or 0) <= gems and not blocked(node) then
            table.insert(ready, node)
        end
        local isUnlocked = unlocked[node.Name] == true or node.Origin == true
        local subtree = node.Tree and SkillTreeConfig[node.Tree]
        -- a sub-tree only opens once its opener is unlocked (until then everything inside answers
        -- "SubtreeLocked" / "Open this upgrade tree first!")
        if subtree and not seenTrees[node.Tree] and isUnlocked then
            seenTrees[node.Tree] = true
            walk(subtree, true)
        end
        for _, dir in ipairs(DIRECTIONS) do
            if node[dir] then walk(node[dir], isUnlocked) end
        end
    end
    walk(SkillTreeConfig.Origin, true)
    table.sort(ready, function(a, b) return (tonumber(a.Cost) or 0) < (tonumber(b.Cost) or 0) end) -- cheapest first
    return ready
end

mainTab:CreateSection({ name = "Skill Tree" })
local skillStatus
local skillRunning, skillRunId = false, 0
connections.autoSkillTree = { Disconnect = function() skillRunning = false end }

mainTab:CreateToggle({
    name = "Auto Buy Skill Tree",
    description = "Buys skill tree upgrades with your Gems as soon as you can afford them, cheapest first. Only buys what the game itself shows as ready (the skill before it unlocked, island / shop requirements met).",
    callback = function(value)
        skillRunning = false
        skillRunId += 1
        if not value then
            pcall(function() skillStatus:Set("Off") end)
            return
        end
        if not (SkillUnlock and SkillTreeConfig) then
            window:Notify({ title = "Skill Tree", content = "Couldn't find the game's skill tree.", duration = 4 })
            return
        end
        skillRunning = true
        local myRun = skillRunId
        task.spawn(function()
            local bought, skipUntil = 0, {} -- skipUntil: names the server refused, retried later
            while skillRunning and skillRunId == myRun do
                local ok, err = pcall(function()
                    local now = os.clock()
                    local node
                    for _, candidate in ipairs(readyUpgrades()) do
                        if not skipUntil[candidate.Name] or skipUntil[candidate.Name] < now then node = candidate break end
                    end
                    if not node then
                        pcall(function() skillStatus:Set(string.format("Waiting for Gems... (%d bought)", bought)) end)
                        task.wait(3)
                        return
                    end
                    local result = safeInvoke(SkillUnlock, { ["Name"] = node.Name })
                    if type(result) == "table" and result.Success == true then
                        bought += 1
                        local label = node.DisplayName or node.Name
                        print("[HustlHub] Skill Tree: bought", label, "for", tostring(node.Cost), "gems")
                        pcall(function() skillStatus:Set(string.format("Bought %s (%s gems) | %d bought", label, tostring(node.Cost), bought)) end)
                        task.wait(0.4)
                    else
                        local reason = type(result) == "table" and tostring(result.Reason) or "no answer"
                        print("[HustlHub] Skill Tree: couldn't buy", node.Name, "-", reason)
                        if reason == "RateLimited" or reason == "Locked" or reason == "NotReady" then
                            task.wait(1)
                        else
                            skipUntil[node.Name] = os.clock() + 30 -- try the others first
                            task.wait(0.4)
                        end
                    end
                end)
                if not ok then
                    warn("[HustlHub] Auto Skill Tree error:", err)
                    task.wait(2)
                end
            end
        end)
    end,
})
skillStatus = mainTab:CreateText({ name = "Skill Tree Status", text = "Off" })

end

---------------------------------------------------------------- Crafting machines
-- From the game's MachineConfig:
--   Golden:  takes Normal pets, up to 6 (13/32/40/63/80/100%)
--   Diamond: takes Golden pets, up to 5 (20/40/60/80/100%)
local recentlySent = {} -- id -> time, so a pet isn't re-sent before the inventory updates
local machineState = {} -- machine key -> { waiting, failReason }

local function onCraftResult(result)
    if type(result) ~= "table" then return end
    local state = machineState[result.Machine]
    if not state then return end
    if result.Securing == true then return end -- server is still working on it
    state.waiting = false
    if result.Success ~= true then
        state.failReason = result.Reason or "Machine request failed"
    end
end

if CraftResult then
    connections.craftResult = CraftResult.OnClientEvent:Connect(onCraftResult)
else
    warn("[HustlHub] MachineCraftResult not found, crafting will use a fixed delay")
end

---------------- Hide the game's crafting UI only while an auto-craft is running
-- Two of the game's listeners show the crafting UI:
--   * its MachineCraftResult handler: crafting roll screen, machine animations, craft pop-ups
--   * MachineController's Heartbeat: opens the machine screen when you stand near a machine
-- Each one is wrapped ONCE at startup. The wrapper checks on every call whether an auto-craft
-- toggle is on: if yes it skips, if no it runs the game's code exactly as normal.
-- Nothing is ever paused, so manual crafting can't get stuck hidden.
local hideCraftUiFor = {} -- which autos currently want it hidden
local function craftUiHidden() return next(hideCraftUiFor) ~= nil end

local craftUiHooks = {} -- { fn, original } so they can be put back
local function hookCraftListener(fn)
    for _, h in ipairs(craftUiHooks) do
        if h.fn == fn then return end -- already wrapped
    end
    local original
    original = hookfunction(fn, function(...)
        if craftUiHidden() then return end
        return original(...)
    end)
    table.insert(craftUiHooks, { fn = fn, original = original })
end

local function installCraftUiHooks()
    if not (getconnections and hookfunction) then
        warn("[HustlHub] Executor lacks getconnections/hookfunction, the crafting UI can't be hidden")
        return
    end
    if CraftResult then
        for _, c in ipairs(getconnections(CraftResult.OnClientEvent)) do
            -- Undo the old method in case a previous version left it paused
            pcall(function() c:Enable() end)
            if c.Function and c.Function ~= onCraftResult then
                pcall(hookCraftListener, c.Function)
            end
        end
    end
    for _, c in ipairs(getconnections(RunService.Heartbeat)) do
        local ok, source = pcall(function() return debug.info(c.Function, "s") end)
        if ok and type(source) == "string" and source:find("MachineController") then
            pcall(function() c:Enable() end)
            pcall(hookCraftListener, c.Function)
        end
    end
    print("[HustlHub] Crafting UI hooks installed:", #craftUiHooks)
end
installCraftUiHooks()

local function closeMachineScreens()
    pcall(function()
        local MenuController = require(ReplicatedStorage.Controllers.UI.MenuController)
        for _, menu in ipairs({ "Golden", "Diamond", "Shiny", "Rainbow", "CraftingRoll" }) do
            pcall(function() MenuController:Close(menu) end)
        end
    end)
end

local function setCraftUiHidden(who, hidden)
    local wasHidden = craftUiHidden()
    hideCraftUiFor[who] = hidden or nil
    if craftUiHidden() and not wasHidden then
        closeMachineScreens() -- close anything already open when an auto starts
    end
end

-- On re-run / unload: put the game's original listeners back
connections.craftUi = { Disconnect = function()
    table.clear(hideCraftUiFor)
    for _, h in ipairs(craftUiHooks) do
        pcall(hookfunction, h.fn, h.original)
    end
    table.clear(craftUiHooks)
end }

local function canUseFor(pet, sourceTier)
    return type(pet) == "table"
        and pet.Tier == sourceTier
        and pet.Locked ~= true
        and pet.Frozen == nil
        and not pet.Equip
end

-- Best Alchemist pets while auto-crafting (Alchemist enchant = better craft chance; every pet with
-- it counts, so it fills your pet slots with them). When the first auto craft turns on, your
-- equipped team is remembered and all your best Alchemist pets are swapped in for your weakest ones;
-- when the last auto craft turns off, your old team is put back.
local CraftTeam = { users = {}, enabled = true }
window.hubCraftTeam = CraftTeam -- (Pet Defense, defined earlier in the script, uses it for its Scavenger team)
do
    local EnchantCfg, PetPowerMod
    pcall(function() EnchantCfg = require(ReplicatedStorage.Shared.Pets.EnchantConfig) end)
    pcall(function() PetPowerMod = require(ReplicatedStorage.Shared.Pets.PetPower) end)
    local PetAction = Remotes.PetService.RE.PetActionRequested

    local function equipped()
        local data = getReplica() and getReplica().Data
        local list = {}
        if data and data.Pets and type(data.Pets.Equipped) == "table" then
            for _, id in pairs(data.Pets.Equipped) do
                if type(id) == "string" and data.Pets.Owned[id] then table.insert(list, id) end
            end
        end
        return list
    end
    local function limit()
        local data = getReplica() and getReplica().Data
        return data and tonumber(data.Pets.EquipLimit) or 4
    end
    local function waitChange(before, timeout)
        local start = os.clock()
        repeat task.wait(0.1) until table.concat(equipped(), ",") ~= before or os.clock() - start > (timeout or 1.5)
    end
    local function power(pet)
        if PetPowerMod then
            local ok, v = pcall(PetPowerMod.Get, pet)
            if ok and type(v) == "number" then return v end
        end
        return tonumber(pet.Power) or 0
    end
    -- an enchant's definition, following the game's renames (old "Crafter II" = "Alchemist II",
    -- "Critical" = "Precision", ... via EnchantConfig.Aliases)
    local function enchantDef(name)
        if type(name) ~= "string" or not (EnchantCfg and EnchantCfg.Enchants) then return nil end
        local aliases = EnchantCfg.Aliases
        return EnchantCfg.Enchants[aliases and aliases[name] or name] or EnchantCfg.Enchants[name]
    end
    -- best level of an enchant family on a pet (0 = doesn't have it)
    local function rank(pet, family)
        local best = 0
        for _, slot in ipairs({ "Enchant", "Enchant2" }) do
            local def = enchantDef(pet[slot])
            if def and (def.Family or def.Type) == family then best = math.max(best, def.Rank or 1) end
        end
        return best
    end
    CraftTeam.enchantRank = rank
    CraftTeam.power = power

    -- Crafting: the FIRST pet in a craft decides the crafted pet's power (its affinity / level /
    -- mutation carry over), so every craft leads with its strongest pet. pickSet builds a set from
    -- copies of one pet: the strongest copy leads and the weakest copies fill the rest, so each
    -- craft gets the best leader still available.
    local function powerOfId(owned, id)
        local pet = owned[id]
        return type(pet) == "table" and power(pet) or 0
    end
    function hatchCraft.pickSet(ids, need, machineKey)
        if #ids < need then return nil end
        -- "Best Base For Golden Crafts" off: Golden machine crafts just take the first copies found
        if (machineKey == "Golden" and not hatchCraft.smartGold) or (machineKey == "Diamond" and not hatchCraft.smartDiamond) then
            return table.move(ids, 1, need, 1, {})
        end
        local owned = getOwnedPets()
        local sorted = table.clone(ids)
        table.sort(sorted, function(a, b) return powerOfId(owned, a) > powerOfId(owned, b) end)
        local set = { sorted[1] }
        for i = #sorted - need + 2, #sorted do table.insert(set, sorted[i]) end
        return set
    end
    -- every craft request (Crafting tab, storage-full trips, Index, Mastery, Auto Progress) goes
    -- through here: strongest pet first
    local rawCraftRemote = CraftRemote
    CraftRemote = setmetatable({
        FireServer = function(_, args)
            if type(args) == "table" and type(args.PetIds) == "table" and #args.PetIds > 1
                and not (args.Machine == "Golden" and not hatchCraft.smartGold)
                and not (args.Machine == "Diamond" and not hatchCraft.smartDiamond) then
                local owned = getOwnedPets()
                local ids = table.clone(args.PetIds)
                table.sort(ids, function(a, b) return powerOfId(owned, a) > powerOfId(owned, b) end)
                args = table.clone(args)
                args.PetIds = ids
            end
            return rawCraftRemote:FireServer(args)
        end,
    }, { __index = function(_, key) return rawCraftRemote[key] end })

    local function equipOne(id)
        local b = table.concat(equipped(), ",")
        PetAction:FireServer({ ["Action"] = "Equip", ["PetId"] = id })
        waitChange(b)
    end
    local function unequipOne(id)
        local b = table.concat(equipped(), ",")
        PetAction:FireServer({ ["Action"] = "Unequip", ["PetId"] = id })
        waitChange(b)
    end

    -- Best team for an enchant family: optionally the game's own Equip Best for a stat first
    -- (gameMode "Luck" / "Gems" / "Clicks"), then your best pets with the enchant (highest level,
    -- then strongest; as many as your pet slots hold) swapped in for the weakest equipped pets. Returns how many.
    -- quiet = true: no log line unless something actually had to be swapped (for the periodic check)
    function CraftTeam.equipFamily(family, gameMode, quiet)
        -- (v1.4.53) the team for this kind is kept as a game team ("HH Scavenger", "HH Alchemist", ...): when it still holds
        -- your best pets for it, it's ONE switch instead of swapping pet by pet
        local kind = CraftTeam.kindOf and CraftTeam.kindOf(family)
        local owned = getOwnedPets()
        -- the team you have on before this swap becomes the game team "HH Saved" (so putting it back is one switch),
        -- unless what's on is already one of the HH kind teams (that's not "your" team) or this is a periodic re-check
        if not quiet and CraftTeam.rememberAsGameTeam then
            local now, isKindTeam = equipped(), false
            for _, k in ipairs(CraftTeam.KINDS or {}) do
                if CraftTeam.sameSet(now, CraftTeam.gameTeams()[k.team]) then isKindTeam = true end
            end
            if not isKindTeam then pcall(CraftTeam.rememberAsGameTeam) end
        end
        if kind then
            local saved = CraftTeam.gameTeams()[kind.team]
            if type(saved) == "table" and #saved > 0 then
                local best, want = {}, {}
                for id, pet in pairs(owned) do
                    if type(pet) == "table" and pet.Frozen == nil and rank(pet, family) > 0 then table.insert(best, { id = id, rank = rank(pet, family), power = power(pet) }) end
                end
                table.sort(best, function(a, b) if a.rank ~= b.rank then return a.rank > b.rank end return a.power > b.power end)
                for i = 1, math.min(limit(), #best) do want[best[i].id] = true end
                local inTeam = {}
                for _, id in pairs(saved) do inTeam[id] = true end
                local allIn = next(want) ~= nil
                for id in pairs(want) do if not inTeam[id] then allIn = false end end
                if allIn and CraftTeam.useGameTeam(kind.team) then
                    if not quiet then print("[HustlHub] Team: switched to the game team " .. kind.team) end
                    local n = 0 for id in pairs(want) do if table.find(equipped(), id) then n += 1 end end
                    return n
                end
            end
        end
        if gameMode then
            local b = table.concat(equipped(), ",")
            PetAction:FireServer({ ["Action"] = "EquipBest", ["Mode"] = gameMode })
            waitChange(b)
        end
        local candidates = {}
        for id, pet in pairs(owned) do
            if type(pet) == "table" and pet.Frozen == nil then
                local r = rank(pet, family)
                if r > 0 then table.insert(candidates, { id = id, rank = r, power = power(pet) }) end
            end
        end
        if #candidates == 0 then
            if not quiet then print("[HustlHub] Team: none of your pets have the", family, "enchant") end
            return 0
        end
        table.sort(candidates, function(a, b)
            if a.rank ~= b.rank then return a.rank > b.rank end
            return a.power > b.power
        end)
        local slots = limit()
        local chosen, chosenSet = {}, {}
        for i = 1, math.min(slots, #candidates) do -- every pet with it, up to your pet slots
            table.insert(chosen, candidates[i].id)
            chosenSet[candidates[i].id] = true
        end
        -- swap them in for the weakest equipped pets; a second pass catches any the server
        -- hadn't finished (each change waits for the game data to update first)
        local swapped = 0
        for _ = 1, 2 do
            for _, id in ipairs(chosen) do
                local now = equipped()
                if not table.find(now, id) then
                    if #now >= slots then
                        local weakest, weakestPower
                        for _, eid in ipairs(now) do
                            local pet = owned[eid]
                            if not chosenSet[eid] then
                                local p = pet and power(pet) or 0
                                if not weakest or p < weakestPower then weakest, weakestPower = eid, p end
                            end
                        end
                        if weakest then unequipOne(weakest) end
                    end
                    equipOne(id)
                    swapped += 1
                end
            end
            local missing = 0
            local now = equipped()
            for _, id in ipairs(chosen) do if not table.find(now, id) then missing += 1 end end
            if missing == 0 then break end
            task.wait(0.5)
        end
        local have = 0
        local now = equipped()
        for _, id in ipairs(chosen) do if table.find(now, id) then have += 1 end end
        if not quiet or swapped > 0 then
            print(string.format("[HustlHub] Team: %d/%d of your best %s pets equipped (%d have it)", have, #chosen, family, #candidates))
        end
        -- keep it as the game team for next time (one switch then)
        if kind and have == #chosen and (swapped > 0 or not CraftTeam.gameTeams()[kind.team]) then
            pcall(CraftTeam.saveGameTeam, kind.team, kind.focus)
        end
        return have
    end

    -- the team equipped right now (just reads it: Pet Defense calls this every 3 s, so it must not save anything;
    -- "HH Saved" is only written at the start of a swap, in equipFamily)
    function CraftTeam.snapshot() return equipped() end
    -- put a remembered team back (exactly those pets, if you still own them)
    function CraftTeam.restoreTo(saved)
        if not saved then return end
        local now = equipped()
        local a, b = table.clone(now), table.clone(saved)
        table.sort(a); table.sort(b)
        if table.concat(a, ",") == table.concat(b, ",") then return end
        local before = table.concat(now, ",")
        PetAction:FireServer({ ["Action"] = "UnequipAll" })
        waitChange(before)
        local owned = getOwnedPets()
        for _, id in ipairs(saved) do
            if owned[id] and not table.find(equipped(), id) then equipOne(id) end
        end
        print("[HustlHub] Team: put your team back (" .. #saved .. " pets)")
    end

    ---------------- the game's own pet teams (v1.4.53)
    -- PetService.RF: CreatePetTeam {Name, Focus} (saves the pets equipped NOW; Focus = "Clicks" / "Luck" / "Gems"),
    -- UpdatePetTeam {Name} (re-saves the equipped pets), EquipPetTeam {Name} (one call switches the whole team),
    -- DeletePetTeam {Name}. Data.PetTeams[name] = { pet ids }, Data.PetTeamFocus[name] = focus. PetTeamConfig: max 15
    -- teams, 0.5 s between switches, needs Pet Teams from the Gem Upgrades. Errors come back as { Success = false, Reason }.
    local TeamRF = Remotes.PetService.RF
    local function gameTeams()
        local d = getReplica() and getReplica().Data
        return d and type(d.PetTeams) == "table" and d.PetTeams or {}
    end
    local function sameSet(a, b)
        local owned = getOwnedPets()
        local sa, sb = {}, {}
        for _, id in pairs(a or {}) do if owned[id] then table.insert(sa, id) end end
        for _, id in pairs(b or {}) do if owned[id] then table.insert(sb, id) end end
        table.sort(sa) table.sort(sb)
        return #sa > 0 and table.concat(sa, ",") == table.concat(sb, ",")
    end
    local function teamCall(rf, args)
        for attempt = 1, 3 do
            local ok, res = pcall(safeInvoke, rf, args)
            if ok and type(res) == "table" and res.Success then return true, res end
            local why = ok and type(res) == "table" and tostring(res.Reason or res.Error or "") or tostring(res)
            if why ~= "COOLDOWN" and why ~= "Locked" then return false, why end
            task.wait(0.7) -- (the game's 0.5 s team cooldown / busy inventory: try again)
        end
        return false, "COOLDOWN"
    end
    CraftTeam.gameTeams = gameTeams
    -- save the pets equipped right now as that game team (creates it the first time)
    function CraftTeam.saveGameTeam(name, focus)
        if #equipped() == 0 then return false, "NO_PETS_EQUIPPED" end
        if gameTeams()[name] then return teamCall(TeamRF.UpdatePetTeam, { Name = name }) end
        return teamCall(TeamRF.CreatePetTeam, { Name = name, Focus = focus or "Luck" })
    end
    -- switch to a saved game team in one call; true once the game shows exactly its pets equipped
    function CraftTeam.useGameTeam(name)
        local list = gameTeams()[name]
        if type(list) ~= "table" then return false, "TEAM_NOT_FOUND" end
        if sameSet(equipped(), list) then return true end
        local ok, why = teamCall(TeamRF.EquipPetTeam, { Name = name })
        if not ok then return false, why end
        local t0 = os.clock()
        while os.clock() - t0 < 3 and not sameSet(equipped(), gameTeams()[name]) do task.wait(0.1) end
        return sameSet(equipped(), gameTeams()[name]), nil
    end
    CraftTeam.sameSet = sameSet
    -- the team to come back to: kept as the game team "HH Saved", so putting it back is one switch
    CraftTeam.SAVED_TEAM = "HH Saved"
    function CraftTeam.rememberAsGameTeam()
        local now = equipped()
        if #now == 0 or sameSet(gameTeams()[CraftTeam.SAVED_TEAM], now) then return end
        pcall(CraftTeam.saveGameTeam, CraftTeam.SAVED_TEAM, "Luck")
    end
    -- put a remembered team back: one switch when it's the saved game team, otherwise pet by pet as before
    local restorePetByPet = CraftTeam.restoreTo
    function CraftTeam.restoreTo(saved)
        if not saved then return end
        if sameSet(equipped(), saved) then return end
        if sameSet(gameTeams()[CraftTeam.SAVED_TEAM], saved) and CraftTeam.useGameTeam(CraftTeam.SAVED_TEAM) then
            print("[HustlHub] Team: put your team back (game team " .. CraftTeam.SAVED_TEAM .. ")")
            return
        end
        restorePetByPet(saved)
    end
    -- the hub's team kinds, each kept as a game team: the enchant family that makes the team, the game's own Equip
    -- Best mode to start from (if any), the pets' affinity for "best pets", and the team focus
    CraftTeam.KINDS = {
        { kind = "Luck", team = "HH Luck", family = "Lucky", mode = "Luck", affinity = "Luck", focus = "Luck", enchant = "Lucky III" },
        { kind = "Clicks", team = "HH Clicks", family = "Power", mode = "Clicks", affinity = "Clicks", focus = "Clicks", enchant = "Power III" },
        { kind = "Rebirths", team = "HH Rebirths", family = "Renewal", mode = "Clicks", affinity = "Clicks", focus = "Clicks", enchant = "Renewal III" },
        { kind = "Gems", team = "HH Gems", family = "Fortune", mode = "Gems", affinity = "Gems", focus = "Gems", enchant = "Fortune III" },
        { kind = "Scavenger", team = "HH Scavenger", family = "Scavenger", affinity = "Gems", focus = "Gems", enchant = "Scavenger III" },
        { kind = "Alchemist", team = "HH Alchemist", family = "Alchemist", affinity = "Luck", focus = "Luck", enchant = "Alchemist III" },
    }
    function CraftTeam.kindOf(familyOrKind)
        for _, k in ipairs(CraftTeam.KINDS) do
            if k.family == familyOrKind or k.kind == familyOrKind then return k end
        end
        return nil
    end

    -- Crafting tab: when the first auto craft turns on, remember the team and swap in your best
    -- Alchemist pets; when the last one turns off, put the team back
    -- Every auto craft that turns on makes sure your best Alchemist pets are on (not just the first:
    -- your team may have been changed since, e.g. by Equip Best). The team to put back is the one
    -- you had before the FIRST auto craft started.
    function CraftTeam.start(who)
        if not CraftTeam.enabled then return end
        CraftTeam.users[who] = true
        if not CraftTeam.saved then CraftTeam.saved = CraftTeam.snapshot() end -- (equipFamily keeps it as the game team "HH Saved")
        local n = CraftTeam.equipFamily("Alchemist", nil)
        if n > 0 then
            window:Notify({ title = "Crafting", content = "Equipped your " .. n .. " best Alchemist pets. Your team comes back when crafting stops.", duration = 4 })
        end
    end
    -- while any auto craft runs, put the Alchemist pets back if something swapped them out
    local watchAlive = true
    task.spawn(function()
        while watchAlive do
            task.wait(20)
            if CraftTeam.enabled and next(CraftTeam.users) ~= nil then
                pcall(CraftTeam.equipFamily, "Alchemist", nil, true)
            end
        end
    end)
    CraftTeam.stopWatcher = function() watchAlive = false end
    local function restore()
        local saved = CraftTeam.saved
        CraftTeam.saved = nil
        if saved then
            CraftTeam.restoreTo(saved)
            window:Notify({ title = "Crafting", content = "Put your team back.", duration = 3 })
        end
    end
    function CraftTeam.stop(who)
        if not CraftTeam.users[who] then return end
        CraftTeam.users[who] = nil
        if next(CraftTeam.users) ~= nil then return end -- another auto craft is still running
        task.spawn(restore)
    end
    connections.craftTeam = { Disconnect = function()
        table.clear(CraftTeam.users)
        CraftTeam.stopWatcher()
        task.spawn(restore)
    end }
end

local function getPetNamesOfTier(tier)
    local names, seen = {}, {}
    for _, pet in pairs(getOwnedPets()) do
        if type(pet) == "table" and pet.Tier == tier and not seen[pet.Name] then
            seen[pet.Name] = true
            table.insert(names, pet.Name)
        end
    end
    table.sort(names)
    return names
end

-- Multi-pet picker for the crafting machines. Each option reads "Name (count)": count = how many
-- of that pet (in that tier) you could put in the machine right now (not locked, equipped,
-- frozen or just sent). Picks are remembered by pet name, so they survive the counts changing.
local function makePetPicker(tab, dropdownName, tier, description)
    local picker = { names = {} } -- names = set of picked pet names
    local function labelName(label)
        return (tostring(label):match("^(.*) %(%d+%)$")) or tostring(label)
    end
    local function usableCounts()
        local counts = {}
        for id, pet in pairs(getOwnedPets()) do
            local sent = recentlySent[id]
            if canUseFor(pet, tier) and not (sent and os.clock() - sent < 3) then
                counts[pet.Name] = (counts[pet.Name] or 0) + 1
            end
        end
        return counts
    end
    local function buildOptions()
        local counts = usableCounts()
        local options, labelOf = {}, {}
        for _, name in ipairs(getPetNamesOfTier(tier)) do
            local label = name .. " (" .. (counts[name] or 0) .. ")"
            table.insert(options, label)
            labelOf[name] = label
        end
        return options, labelOf
    end

    local options = buildOptions()
    picker.dropdown = tab:CreateDropdown({
        name = dropdownName,
        description = description .. " The number is how many you can craft with right now. Pick as many pets as you like.",
        options = options,
        multiSelect = true,
        optionIcon = function(label) return { pet = labelName(label), tier = tier } end, -- the pet's picture
        onOpen = function() -- fresh list and counts every time you open it
            memoryScanAt = 0 -- (if pets are read from memory, look again)
            picker.refresh(true)
        end,
        callback = function(selected)
            picker.names = {}
            for _, label in ipairs(selected) do picker.names[labelName(label)] = true end
        end,
    })

    local lastOptions = table.concat(options, "|")
    function picker.refresh(force)
        local newOptions, labelOf = buildOptions()
        local key = table.concat(newOptions, "|")
        if not force and key == lastOptions then return #newOptions end
        lastOptions = key
        picker.dropdown:Refresh(newOptions)
        -- show the picks again under their new labels (Refresh drops labels that changed)
        local keep = {}
        for name in pairs(picker.names) do
            if labelOf[name] then table.insert(keep, labelOf[name]) end
        end
        picker.dropdown:Set(keep, true)
        return #newOptions
    end

    -- live sync shares the picked pet NAMES, not the labels: the "(147)" count differs on every account and keeps
    -- changing, so syncing labels made the accounts overwrite each other every couple of seconds
    picker.dropdown.syncGet = function()
        local list = {}
        for name in pairs(picker.names) do table.insert(list, name) end
        table.sort(list)
        return list
    end
    picker.dropdown.syncSet = function(list)
        picker.names = {}
        for _, label in ipairs(type(list) == "table" and list or {}) do picker.names[labelName(label)] = true end
        picker.refresh(true)
    end

    function picker.hasPicks() return next(picker.names) ~= nil end
    function picker.list()
        local list = {}
        for name in pairs(picker.names) do table.insert(list, name) end
        table.sort(list)
        return list
    end
    -- `count` usable pets of ONE picked kind (machines need the same pet), first kind that has enough.
    -- Returns ids, name - or nil plus a status line listing what each picked pet has
    -- With "Craft Every Pet" on, every pet of this tier counts as picked (except ones whose
    -- storage-full craft rule says "Don't Craft"). Each set leads with its strongest copy.
    function picker.pick(count)
        local all = hatchCraft.craftAll
        local byName, names = {}, {}
        for id, pet in pairs(getOwnedPets()) do
            local sent = recentlySent[id]
            local name = type(pet) == "table" and pet.Name or ""
            local wanted = picker.names[name] or (all and hatchCraft.rules[name] ~= "Don't Craft")
            if wanted and canUseFor(pet, tier) and not (sent and os.clock() - sent < 3) then
                if not byName[name] then byName[name] = {} table.insert(names, name) end
                table.insert(byName[name], id)
            end
        end
        table.sort(names)
        local parts = {}
        for _, name in ipairs(all and names or picker.list()) do
            local ids = byName[name] or {}
            if #ids >= count then
                return hatchCraft.pickSet(ids, count, tier == "Normal" and "Golden" or tier == "Golden" and "Diamond" or nil), name
            end
            table.insert(parts, name .. " " .. #ids)
        end
        return nil, table.concat(parts, ", ")
    end

    -- keep the counts current (only redraws when something changed)
    local alive = true
    connections["petPicker_" .. dropdownName] = { Disconnect = function() alive = false end }
    task.spawn(function()
        task.wait(3)
        while alive do
            pcall(picker.refresh)
            task.wait(5)
        end
    end)
    return picker
end

---------------------------------------------------------------- Delete Pets (Hatching tab)
-- Three rules, all optional, applied by "Delete Now" or "Auto Delete":
--   * Delete Every Version Of: every copy of those pets (Normal, Golden, Diamond, Rainbow)
--   * Keep rules: per pet, the versions to keep ("Crawler: only Rainbow"); other versions go,
--     except lower ones that can still be crafted up into a kept one (Keep Crafting Material)
--   * Power rules: per pet, delete one version (e.g. Rainbow) of it under a power you type, and
--     (optionally) leave its lower versions alone
--   * Delete Pets Under Power: anything weaker than the number you type (pets with a power rule skip it)
-- Never deleted: equipped, locked or frozen pets, Secret pets, enchanted pets (unless you switch
-- that protection off) and versions a keep rule keeps.
do
local PetDeleteRE = Remotes.PetService.RE.PetActionRequested
local HttpService = game:GetService("HttpService")
local TIER_LABEL = { Normal = "Normal", Golden = "Golden", Diamond = "Diamond", Shiny = "Rainbow" }
local LABEL_TIER = { Normal = "Normal", Golden = "Golden", Diamond = "Diamond", Rainbow = "Shiny" }
local TIER_RANK = { Normal = 0, Golden = 1, Diamond = 2, Shiny = 3 }
local VERSION_OPTIONS = { "Normal", "Golden", "Diamond", "Rainbow" }
local KEEP_FILE = "HustlHub_keep_rules_" .. tostring(LocalPlayer.UserId) .. ".json"
local POWER_FILE = "HustlHub_power_rules_" .. tostring(LocalPlayer.UserId) .. ".json"
local cleanup = { deleteAll = {}, keep = {}, under = 0, protectEnchanted = true, keepMaterial = true,
    powerRules = {}, powerKeepLower = true } -- powerRules: pet name -> { tier = "Shiny", under = number }
local LaunchPetConfig
pcall(function() LaunchPetConfig = require(ReplicatedStorage.Shared.Pets.LaunchPetConfig) end)
pcall(function()
    if isfile and isfile(KEEP_FILE) then
        local saved = HttpService:JSONDecode(readfile(KEEP_FILE))
        if type(saved) == "table" then
            for name, list in pairs(saved) do
                cleanup.keep[name] = {}
                for _, label in ipairs(list) do cleanup.keep[name][label] = true end
            end
        end
    end
end)
pcall(function()
    if isfile and isfile(POWER_FILE) then
        local saved = HttpService:JSONDecode(readfile(POWER_FILE))
        if type(saved) == "table" then
            for name, rule in pairs(saved) do
                if type(rule) == "table" and TIER_RANK[rule.tier] and type(rule.under) == "number" and rule.under > 0 then
                    cleanup.powerRules[name] = { tier = rule.tier, under = rule.under }
                end
            end
        end
    end
end)
local function savePowerRules()
    pcall(function() writefile(POWER_FILE, HttpService:JSONEncode(cleanup.powerRules)) end)
end
local function saveKeep()
    local out = {}
    for name, set in pairs(cleanup.keep) do
        local list = {}
        for _, label in ipairs(VERSION_OPTIONS) do if set[label] then table.insert(list, label) end end
        out[name] = list
    end
    pcall(function() writefile(KEEP_FILE, HttpService:JSONEncode(out)) end)
end

local function ownedPetNames()
    local names, seen = {}, {}
    for _, pet in pairs(getOwnedPets()) do
        if type(pet) == "table" and pet.Name and not seen[pet.Name] then
            seen[pet.Name] = true
            table.insert(names, pet.Name)
        end
    end
    for name in pairs(cleanup.keep) do if not seen[name] then seen[name] = true table.insert(names, name) end end
    for name in pairs(cleanup.deleteAll) do if not seen[name] then seen[name] = true table.insert(names, name) end end
    for name in pairs(cleanup.powerRules) do if not seen[name] then seen[name] = true table.insert(names, name) end end
    table.sort(names)
    return names
end
local function rarityOf(pet)
    local cfg = LaunchPetConfig and LaunchPetConfig[pet.Name]
    return tostring(pet.Rarity or (cfg and cfg.Rarity) or "Common")
end
local function isProtected(id, pet, equippedSet)
    if pet.Locked == true or pet.Frozen ~= nil or pet.Equip or equippedSet[id] then return true end
    if rarityOf(pet):find("Secret") then return true end
    if cleanup.protectEnchanted then
        local e1, e2 = pet.Enchant, pet.Enchant2
        if (e1 and e1 ~= false and e1 ~= "") or (e2 and e2 ~= false and e2 ~= "") then return true end
    end
    return false
end

-- does this pet fall under its pet's power rule? (the rule's version, and the lower ones if
-- "Keep Lower Variants" is off)
local function powerRuleHits(pet, tier, rule)
    local rank, ruleRank = TIER_RANK[tier] or 0, TIER_RANK[rule.tier] or 0
    if rank > ruleRank or (rank < ruleRank and cleanup.powerKeepLower) then return false end
    local ok, p = pcall(CraftTeam.power, pet)
    return ok and type(p) == "number" and p < rule.under
end

-- what would go, and why (counts per reason)
local function planDeletes()
    local ids, reasons = {}, {}
    local data = getReplica() and getReplica().Data
    local equippedSet = {}
    pcall(function() for _, id in pairs(data.Pets.Equipped) do equippedSet[id] = true end end)
    for id, pet in pairs(getOwnedPets()) do
        if type(pet) == "table" and pet.Name and not isProtected(id, pet, equippedSet) then
            local tier = pet.Tier or "Normal"
            local keep = cleanup.keep[pet.Name]
            local why
            if cleanup.deleteAll[pet.Name] then
                why = "every version of " .. pet.Name
            elseif cleanup.onEggList and cleanup.onEggList(pet.Name) then
                why = "egg delete list"
            elseif cleanup.powerRules[pet.Name] and powerRuleHits(pet, tier, cleanup.powerRules[pet.Name]) then
                why = "power rule"
            elseif keep and next(keep) and not keep[TIER_LABEL[tier] or tier] then
                local material = false
                if cleanup.keepMaterial then
                    for label in pairs(keep) do
                        if (TIER_RANK[LABEL_TIER[label]] or 0) > (TIER_RANK[tier] or 0) then material = true end
                    end
                end
                if not material then why = "keep rule" end
            end
            -- power rule: never touches a version a keep rule keeps
            if not why and cleanup.under > 0 and not cleanup.powerRules[pet.Name]
                and not (keep and keep[TIER_LABEL[tier] or tier]) then
                local ok, p = pcall(CraftTeam.power, pet)
                if ok and type(p) == "number" and p < cleanup.under then why = "under power" end
            end
            if why then
                table.insert(ids, id)
                reasons[why] = (reasons[why] or 0) + 1
            end
        end
    end
    return ids, reasons
end
local function reasonText(reasons)
    local parts = {}
    for why, n in pairs(reasons) do table.insert(parts, n .. " (" .. why .. ")") end
    table.sort(parts)
    return table.concat(parts, ", ")
end
local function deleteIds(ids)
    for i = 1, #ids, 50 do
        PetDeleteRE:FireServer({ ["Action"] = "Delete", ["PetIds"] = table.move(ids, i, math.min(i + 49, #ids), 1, {}) })
        task.wait(0.4)
    end
end

-- "1.5M" / "2b" / "250k" / "1e9" -> number
local SUFFIX = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, qi = 1e18 }
local function parsePower(text)
    text = tostring(text or ""):gsub(",", ""):gsub("%s", ""):lower()
    if text == "" then return 0 end
    local num, suffix = text:match("^([%d%.e%+%-]+)(%a*)$")
    local n = tonumber(num or "")
    if not n then return nil end
    return n * (SUFFIX[suffix] or 1)
end

