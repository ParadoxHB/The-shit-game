})

automationTab:CreateToggle({
    name = "Auto Mine",
    description = "Mines the best blocks your pickaxe can break, sells when the backpack fills. Leaves the mine when turned off.",
    callback = function(value)
        mineRunning = false
        if not value then
            if inMine() then task.spawn(mineCall, "Leave") end
            return
        end
        if not (MiningConfig and MiningWorld and MineSave) then
            window:Notify({ title = "Auto Mine", content = "Couldn't load the game's mining code.", duration = 5 })
            return
        end
        mineRunning = true
        mineRunId += 1
        local myRun = mineRunId
        local function alive() return mineRunning and mineRunId == myRun end

        task.spawn(function()
            while alive() do
                acquireTrip("mine")
                local ok, err = pcall(mineSession, alive)
                if not ok then warn("[HustlHub] Auto Mine error:", err) end
                releaseTrip("mine")
                task.wait(5)
            end
        end)
    end,
})
end

