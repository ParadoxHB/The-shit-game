	local function register(tab, flag, element, forget, live)
		tab.hub.Flags[flag] = element.value
		table.insert(tab.hub.elements, element)

		if not forget then
			tab.hub:Register(flag, element)
		elseif live and flag then
			-- not saved in configs, but copied live between following accounts (see "Live sync across all accounts")
			tab.hub.liveOnly = tab.hub.liveOnly or {}
			tab.hub.liveOnly[flag] = element
		end
