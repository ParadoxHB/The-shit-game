do -- own scope (keeps the top level under Luau's 200-local limit)
-- From the game's TapFormula: your taps are multiplied by the boost of the island the game has you
-- on (Data.Progression.Island; Sky 1.1x ... Shadow Realm 2.5x), so the best boost = being on your
-- highest unlocked island. The game sets that island when you arrive through its portal
-- (IslandService.Travel { Island, Source = "Portal" }). This puts you back on your best island
-- whenever nothing else is moving you around (hatching, crafting trips, Auto Progress actions).
local IslandConfigMod
pcall(function() IslandConfigMod = require(ReplicatedStorage.Shared.Progression.IslandConfig) end)
-- (the remote function itself: RemoteServices.IslandService.RF.Travel; "RF" alone is just its folder)
local TravelRF = Remotes:FindFirstChild("IslandService") and Remotes.IslandService:FindFirstChild("RF")
    and Remotes.IslandService.RF:FindFirstChild("Travel")

local function bestIsland(d)
    local best, bestMult
    local unlocked = d.Progression and d.Progression.UnlockedIslands or {}
    for name, info in pairs(IslandConfigMod and IslandConfigMod.Islands or {}) do
        if unlocked[name] == true and (not bestMult or (info.Multiplier or 1) > bestMult) then best, bestMult = name, info.Multiplier or 1 end
    end
    return best, bestMult
end

-- you walking around yourself (movement keys / joystick, not a hub teleport) pauses this, so you
-- can go wherever you like; it only takes you back after you've stood still for a minute
local MANUAL_PAUSE = 60
local lastManualMove = -math.huge
local lastPos
connections.manualMove = RunService.Heartbeat:Connect(function()
    local root = getRoot()
    local hum = root and root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local hubMoving = tripOwner ~= nil -- hub trips (chests, crafting, climbing...) don't count
    -- walking with your movement keys / joystick
    if hum.MoveDirection.Magnitude > 0.1 and not hubMoving then lastManualMove = os.clock() end
    -- teleporting yourself (Teleport tab, a portal...) while the hub isn't doing anything
    if lastPos and (root.Position - lastPos).Magnitude > 30 and not hubMoving and not hubState.progressBusy then
        lastManualMove = os.clock()
    end
    lastPos = root.Position
end)

local lastTravel, lastIslandNote = 0, nil
hubState.ensureBestIsland = function()
    local replica = getReplica()
    local d = replica and replica.Data
    if not (d and TravelRF) then return false end
    local best, mult = bestIsland(d)
    if not best or d.Progression.Island == best then return true end
    if hatchRunning or tripOwner ~= nil then return false end -- something else is using the character
    if LocalPlayer:GetAttribute("ColosseumActive") == true then return false end -- never leave a Pet Defense round
    if os.clock() - lastManualMove < MANUAL_PAUSE then return false end -- you're walking around yourself
    if os.clock() - lastTravel < 15 then return false end
    lastTravel = os.clock()
    local ok, result = pcall(function() return safeInvoke(TravelRF, { ["Island"] = best, ["Source"] = "Portal" }) end)
    if not (ok and type(result) == "table" and result.Success == true) then
        -- the game may want you at the portal first: go to it and ask again
        local info = IslandConfigMod.Islands[best]
        local portals = workspace:FindFirstChild("Portals") and workspace.Portals:FindFirstChild("Portals")
        local portal = portals and info and portals:FindFirstChild(info.PortalName)
        local part = portal and portal:FindFirstChild("Portal")
        if part and part:IsA("BasePart") then
            teleportAndTouch(part.CFrame * CFrame.new(0, 0, -6))
            ok, result = pcall(function() return safeInvoke(TravelRF, { ["Island"] = best, ["Source"] = "Portal" }) end)
        end
    end
    local good = ok and type(result) == "table" and result.Success == true
    local note = good and ("on " .. best .. " (" .. tostring(mult) .. "x taps)")
        or ("couldn't go to " .. best .. ": " .. tostring(ok and type(result) == "table" and result.Reason or result))
    if note ~= lastIslandNote then lastIslandNote = note print("[HustlHub] Island boost: " .. note) end
    return good
end

local keepOn, keepRunId = false, 0
local jumpOn, jumpRunId = false, 0
connections.keepIsland = { Disconnect = function() keepOn = false jumpOn = false end }

automationTab:CreateToggle({
    name = "Keep Best Island Boost",
    description = "Your taps get the boost of the island you're on (up to 2.5x on the top one). This keeps you on your highest unlocked island, and takes you back there after hatching, crafting trips and other features are done. Walking or teleporting somewhere yourself pauses it: it only brings you back after you've stood still for a minute.",
    callback = function(value)
