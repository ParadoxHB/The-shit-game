	function Tab:CreateSlider(o)
		local lib = library.options
		local name = o.name
		local flag = o.flag or name
		local range = o.range or {0, 100}
		local step = o.increment or 1
		local suffix = o.suffix or ""
		local row = makeRow(self, name, o.description, 40, "slider")
		rowLabel(row, name, 70)

		local element = {value = math.clamp(o.value or range[1], range[1], range[2])}

		local valueLbl = new("TextLabel", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 0),
			Size = UDim2.new(0, 70, 0, 22),
			TextXAlignment = Enum.TextXAlignment.Right,
			Font = lib.font,
			TextSize = lib.fontsize,
			TextColor3 = lib.textcolor,
			Text = "",
			Parent = row,
		})

		local trackBar = new("Frame", {
			Name = "Track",
			Position = UDim2.new(0, 10, 0, 28),
			Size = UDim2.new(1, -20, 0, 6),
			BackgroundColor3 = lib.btncolor,
			BorderSizePixel = 0,
			Parent = row,
		})
		corner(trackBar, 2)

		local fill = new("Frame", {
			Name = "Fill",
			Size = UDim2.new(0, 0, 1, 0),
			BackgroundColor3 = lib.accent,
			BorderSizePixel = 0,
			Parent = trackBar,
		})
		corner(fill, 2)
		bindAccent(fill, "BackgroundColor3", function() return library.options.accent end)

		local knob = new("Frame", {
			Name = "Knob",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.new(0, 14, 0, 14),
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			Parent = trackBar,
		})
		corner(knob, 5)

		local hit = new("TextButton", {
			Name = "Hit",
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 4, 0, 20),
			Size = UDim2.new(1, -8, 0, 20),
			ZIndex = 3,
			Parent = row,
		})

		local function snap(v)
			v = math.floor((v - range[1]) / step + 0.5) * step + range[1]
			v = math.clamp(v, range[1], range[2])
			return tonumber(string.format("%.4f", v))
		end

		local function show(animate)
			local v = element.value
			local p = range[2] == range[1] and 0 or (v - range[1]) / (range[2] - range[1])
			local t = animate and 0.08 or 0
			valueLbl.Text = ((v % 1 == 0) and tostring(v) or string.format("%.2f", v)) .. suffix
			tween(fill, {Size = UDim2.new(p, 0, 1, 0)}, t)
			tween(knob, {Position = UDim2.new(p, 0, 0.5, 0)}, t)
		end

		element.value = snap(element.value)
		show(false)

		local flags = self.hub.Flags

		function element:Set(value, skipCallback)
			element.value = snap(tonumber(value) or element.value)
			flags[flag] = element.value
			show(true)

			if not skipCallback and o.callback then
				task.spawn(o.callback, element.value, false)
			end
		end

		local dragging = false

		local function fromX(x)
			local p = math.clamp((x - trackBar.AbsolutePosition.X) / math.max(trackBar.AbsoluteSize.X, 1), 0, 1)
			return snap(range[1] + (range[2] - range[1]) * p)
		end

		local function apply(x)
			local v = fromX(x)

			if v ~= element.value then
				element.value = v
				self.hub.Flags[flag] = v
				show(true)

				if o.callback then
					task.spawn(o.callback, v, true)
				end
			end
		end

		hit.InputBegan:Connect(function(input)
			if dragging then
				return
			end

			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				apply(input.Position.X)

				local moveConn, endConn

				moveConn = UIS.InputChanged:Connect(function(i)
					if i.UserInputType == Enum.UserInputType.MouseMovement
						or i.UserInputType == Enum.UserInputType.Touch then
						apply(i.Position.X)
					end
				end)

				endConn = UIS.InputEnded:Connect(function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1
						or i.UserInputType == Enum.UserInputType.Touch then
						dragging = false
						moveConn:Disconnect()
						endConn:Disconnect()
						self.hub.Flags[flag] = element.value

						if o.callback then
							task.spawn(o.callback, element.value, false)
						end
					end
				end)
			end
		end)

		register(self, flag, element, o.forgetState)
		return element
	end

	function Tab:CreateDropdown(o)
		local lib = library.options
		local name = o.name or "Choose"
		local flag = o.flag or name
		local multi = o.multiSelect == true
		local row = makeRow(self, name, o.description, 28, "dropdown")
		rowLabel(row, name, 190)

		local element = {options = o.options or {}, value = {}}

		if type(o.value) == "table" then
			element.value = table.clone(o.value)
		elseif o.value ~= nil then
			element.value = {o.value}
		end

		local header = new("TextButton", {
			Name = "Header",
			Text = "",
			AutoButtonColor = false,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -6, 0.5, 0),
			Size = UDim2.new(0, 180, 0, 20),
			BackgroundColor3 = lib.dropcolor,
			ZIndex = 3,
			Parent = row,
		})
		corner(header, 4)
		local headerHover = 0
		header.MouseEnter:Connect(function() headerHover = headerHover + 1 end)
		header.MouseLeave:Connect(function() headerHover = math.max(headerHover - 1, 0) end)
		local hStroke = stroke(header, lib.bordercolor)
		hover(header, lib.dropcolor, shade(lib.dropcolor, 0.05))

		local selLabel = new("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 6, 0, 0),
			Size = UDim2.new(1, -22, 1, 0),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Font = lib.font,
			TextSize = lib.fontsize - 1,
			TextColor3 = lib.textcolor,
			Text = "",
			ZIndex = 4,
			Parent = header,
		})

		local arrow = new("TextLabel", {
			Text = "v",
			BackgroundTransparency = 1,
			Position = UDim2.new(1, -16, 0, 0),
			Size = UDim2.new(0, 14, 1, 0),
			Font = lib.font,
			TextSize = lib.fontsize - 1,
			TextColor3 = lib.textcolor,
			ZIndex = 4,
			Parent = header,
		})

		local function show()
			local text, dim

			if #element.value == 0 then
				text, dim = o.placeholder or "Nothing picked", true
			elseif #element.value == 1 then
				text = tostring(element.value[1])
			else
				text = #element.value .. " picked"
			end

			selLabel.Text = text
			selLabel.TextColor3 = dim and Color3.fromRGB(150, 150, 150) or lib.textcolor
		end

		local flags = self.hub.Flags

		local function fire()
			flags[flag] = element.value

			if o.callback then
				task.spawn(o.callback, table.clone(element.value))
			end
		end

		-- the popup lives in the overlay so scrolling pages never clip it
		local popup, popupConn, scrollConn, rebuild
		local hoverCount = 0
		local closeDrop

		local function popupItems()
			local list = {}

			for _, opt in ipairs(element.options) do
				table.insert(list, tostring(opt))
			end

			return list
		end

		local function openDrop()
			if o.onOpen then
				local okOpen, errOpen = pcall(o.onOpen)

				if not okOpen then
					warn("[HustlHub] Dropdown refresh failed:", errOpen)
				end
			end

			if library.openDropdown then
				library.openDropdown()
			end

			hideTip()

			local scale = library.scaleObj and library.scaleObj.Scale or 1
			local absPos, absSize = header.AbsolutePosition, header.AbsoluteSize
			local width = math.max(absSize.X / scale, 240)
			local searchable = #element.options > 7
			local searchH = (searchable or multi) and 26 or 0

			popup = new("Frame", {
				Name = "DropPopup",
				BackgroundColor3 = lib.bgcolor,
				BorderSizePixel = 0,
				Size = UDim2.new(0, width, 0, 60),
				ZIndex = 100010,
				Active = true,
				Parent = library.overlay,
			})
			corner(popup, 5)
			local pStroke = stroke(popup, library.options.accent, 1)
			bindAccent(pStroke, "Color", function() return library.options.accent end)

			local searchBox
			if searchable then
				searchBox = new("TextBox", {
					Name = "Search",
					Text = "",
					PlaceholderText = "Search...",
					PlaceholderColor3 = lib.placeholdercolor,
					ClearTextOnFocus = false,
					BackgroundColor3 = lib.btncolor,
					TextColor3 = lib.textcolor,
					Font = lib.font,
					TextSize = lib.fontsize - 1,
					TextXAlignment = Enum.TextXAlignment.Left,
					Position = UDim2.new(0, 4, 0, 3),
					Size = UDim2.new(1, multi and -100 or -8, 0, 20),
					ZIndex = 100011,
					Parent = popup,
				})
				corner(searchBox, 3)
				new("UIPadding", {PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), Parent = searchBox})
			end

			local scroll = new("ScrollingFrame", {
				Name = "Items",
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Position = UDim2.new(0, 0, 0, searchH),
				Size = UDim2.new(1, 0, 1, -searchH),
				CanvasSize = UDim2.new(),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollBarThickness = 3,
				ScrollingDirection = Enum.ScrollingDirection.Y,
				Active = true,
				ZIndex = 100011,
				Parent = popup,
			})
			new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll})

			local items = {}
			local emptyLbl = new("TextLabel", {
				Text = "Nothing here yet",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, ITEM_H),
				Font = lib.font,
				TextSize = lib.fontsize - 1,
				TextColor3 = Color3.fromRGB(150, 150, 150),
				Visible = false,
				ZIndex = 100012,
				Parent = scroll,
			})

			local function isPicked(v)
				return table.find(element.value, v) ~= nil
			end

			local function paint()
				for _, it in ipairs(items) do
					local on = isPicked(it.name)
					it.btn.TextColor3 = on and library.options.accent or lib.textcolor
					it.mark.Text = multi and (on and "x" or "") or (on and "<" or "")
				end
			end

			local function reposition(visibleCount)
				local h = searchH + math.min(math.max(visibleCount, 1) * ITEM_H, 220) + 4
				popup.Size = UDim2.new(0, width, 0, h)
				local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
				local y = absPos.Y + absSize.Y + 3
				local x = math.min(absPos.X + absSize.X - width * scale, vp.X - width * scale - 4)

				if y + h * scale > vp.Y - 4 then
					y = absPos.Y - h * scale - 3
				end

				local lp = toLocal(Vector2.new(math.max(x, 2), math.max(y, 2)))
				popup.Position = UDim2.new(0, lp.X, 0, lp.Y)
			end

			local function applyFilter()
				local q = searchBox and string.lower(searchBox.Text) or ""
				local shown = 0

				for _, it in ipairs(items) do
					local vis = q == "" or string.find(string.lower(it.name), q, 1, true) ~= nil
					it.btn.Visible = vis

					if vis then
						shown = shown + 1
					end
				end

				emptyLbl.Visible = shown == 0
				reposition(shown)
			end

			for i, v in ipairs(popupItems()) do
				local btn = new("TextButton", {
					Name = "Item",
					Text = v,
					AutoButtonColor = false,
					BackgroundColor3 = lib.btncolor,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					TextColor3 = lib.textcolor,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
					Font = lib.font,
					TextSize = lib.fontsize - 1,
					Size = UDim2.new(1, 0, 0, ITEM_H),
					LayoutOrder = i,
					ZIndex = 100012,
					Parent = scroll,
				})
				new("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 22), Parent = btn})

				local mark = new("TextLabel", {
					BackgroundTransparency = 1,
					Position = UDim2.new(1, 18, 0, 0),
					Size = UDim2.new(0, 16, 1, 0),
					Font = Enum.Font.GothamBold,
					TextSize = lib.fontsize - 2,
					TextColor3 = library.options.accent,
					Text = "",
					ZIndex = 100013,
					Parent = btn,
				})

				btn.MouseEnter:Connect(function()
					tween(btn, {BackgroundTransparency = 0}, 0.06)
				end)
				btn.MouseLeave:Connect(function()
					tween(btn, {BackgroundTransparency = 1}, 0.06)
				end)

				btn.MouseButton1Click:Connect(function()
					local current = element.options[i]
					current = current ~= nil and current or v
					local idx = table.find(element.value, current)

					if multi then
						if idx then
							table.remove(element.value, idx)
						else
							table.insert(element.value, current)
						end

						paint()
						show()
						fire()
					else
						element.value = {current}
						show()
						closeDrop()
						fire()
					end
				end)

				items[i] = {btn = btn, name = v, mark = mark}
			end

			if multi then
				local function bulk(text, xOff, fn)
					local b = new("TextButton", {
						Text = text,
						AutoButtonColor = false,
						BackgroundColor3 = lib.btncolor,
						TextColor3 = lib.textcolor,
						Font = lib.font,
						TextSize = lib.fontsize - 2,
						Position = UDim2.new(1, xOff, 0, 3),
						Size = UDim2.new(0, 44, 0, 20),
						ZIndex = 100011,
						Parent = popup,
					})
					corner(b, 3)
					hover(b, lib.btncolor, shade(lib.btncolor, 0.1))
					b.MouseButton1Click:Connect(fn)
				end

				bulk("All", -92, function()
					local q = searchBox and string.lower(searchBox.Text) or ""
					for _, it in ipairs(items) do
						if (q == "" or string.find(string.lower(it.name), q, 1, true)) and not isPicked(it.name) then
							table.insert(element.value, it.name)
						end
					end
					paint()
					show()
					fire()
				end)

				bulk("None", -46, function()
					local q = searchBox and string.lower(searchBox.Text) or ""
					for i = #element.value, 1, -1 do
						local v = tostring(element.value[i])
						if q == "" or string.find(string.lower(v), q, 1, true) then
							table.remove(element.value, i)
						end
					end
					paint()
					show()
					fire()
				end)
			end

			if searchBox then
				searchBox:GetPropertyChangedSignal("Text"):Connect(function()
					applyFilter()
					scroll.CanvasPosition = Vector2.new(0, 0)
				end)
			end

			paint()
			applyFilter()
			tween(arrow, {Rotation = 180}, 0.15)
			tween(hStroke, {Color = library.options.accent}, 0.15)

			hoverCount = 0
			local function watchPop(obj)
				if obj == popup or obj:IsA("GuiButton") or obj:IsA("TextBox") or obj:IsA("ScrollingFrame") then
					obj.MouseEnter:Connect(function() hoverCount = hoverCount + 1 end)
					obj.MouseLeave:Connect(function() hoverCount = math.max(hoverCount - 1, 0) end)
				end
			end
			watchPop(popup)
			for _, d in ipairs(popup:GetDescendants()) do
				watchPop(d)
			end

			popupConn = UIS.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					task.defer(function()
						if popup and hoverCount <= 0 and headerHover <= 0 then
							closeDrop()
						end
					end)
				elseif input.KeyCode == Enum.KeyCode.Escape then
					closeDrop()
				end
			end)

			local c1 = self.page:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
				closeDrop()
			end)
			local c2 = self.hub.root:GetPropertyChangedSignal("Position"):Connect(function()
				closeDrop()
			end)
			scrollConn = {Disconnect = function() c1:Disconnect(); c2:Disconnect() end}

			rebuild = function()
				-- the options changed while the list is open: draw it again
				if popup then
					local keep = searchBox and searchBox.Text or ""
					closeDrop()
					openDrop()
					return keep
				end

				return nil
			end

			library.openDropdown = closeDrop

			if searchBox then
				task.defer(function()
					pcall(function()
						searchBox:CaptureFocus()
					end)
				end)
			end
		end

		closeDrop = function()
			if popupConn then
				popupConn:Disconnect()
				popupConn = nil
			end

			if scrollConn then
				scrollConn:Disconnect()
				scrollConn = nil
			end

			if popup then
				popup:Destroy()
				popup = nil
			end

			rebuild = nil

			if library.openDropdown == closeDrop then
				library.openDropdown = nil
			end

			if arrow.Parent then
				tween(arrow, {Rotation = 0}, 0.15)
				tween(hStroke, {Color = lib.bordercolor}, 0.15)
			end
		end

		header.MouseButton1Click:Connect(function()
			if popup then
				closeDrop()
			else
				openDrop()
			end
		end)

		function element:Set(value, skipCallback)
			if type(value) == "table" then
				element.value = table.clone(value)
			elseif value == nil then
				element.value = {}
			else
				element.value = {value}
			end

			show()

			if rebuild then
				rebuild()
			end

			if not skipCallback then
				fire()
			else
				flags[flag] = element.value
			end
		end

		function element:Refresh(newOptions)
			element.options = newOptions or {}
			local kept = {}

			for _, v in ipairs(element.value) do
				if table.find(element.options, v) then
					table.insert(kept, v)
				end
			end

			element.value = kept
			flags[flag] = kept
			show()
		end

		function element:Add(option)
			table.insert(element.options, option)
		end

		function element:Remove(option)
			local i = table.find(element.options, option)

			if i then
				table.remove(element.options, i)
			end
		end

		show()
		register(self, flag, element, o.forgetState)
		return element
	end

	-- Press C to open / close the developer console. Runs as soon as the library loads.
	do
		local consoleOpen = false

		track(UIS.InputBegan, function(input, gpe)
			if not gpe and input.KeyCode == Enum.KeyCode.C then
				consoleOpen = not consoleOpen

				pcall(function()
					game:GetService("StarterGui"):SetCore("DevConsoleVisible", consoleOpen)
				end)
			end
		end)
	end
end

