-- Heaven (island 8, Oct 24 update): travel there, and buy it if this account hasn't yet (v1.4.52).
-- The game only sells an island while you stand at its portal (workspace.Portals.Portals[PortalName].Portal, at spawn):
-- IslandService.RE.IslandUnlockRequested { Action = "Purchase", Island = name } (the same as Auto Progress does).
window.hubUnlockIsland = function(name)
    local d = getReplica() and getReplica().Data
    if not d then return false, "data not loaded" end
    if d.Progression.UnlockedIslands[name] == true then return true, "already unlocked" end
    local info
    pcall(function() info = require(ReplicatedStorage.Shared.Progression.IslandConfig).Islands[name] end)
    if not info then return false, "unknown island" end
    if (tonumber(d.Currencies.Coins) or 0) < (tonumber(info.Price) or math.huge) then return false, "not enough coins" end
    local unlockRE = Remotes.IslandService.RE:FindFirstChild("IslandUnlockRequested")
    if not unlockRE then return false, "the game's unlock request isn't there" end
    local function portalPart()
        local folder = workspace:FindFirstChild("Portals") and workspace.Portals:FindFirstChild("Portals")
        local model = folder and folder:FindFirstChild(info.PortalName or name)
        local part = model and model:FindFirstChild("Portal")
        return part and part:IsA("BasePart") and part or nil
    end
    local root = getRoot()
    local home = root and root.CFrame
    acquireTrip("islandBuy")
    local ok, done, why = pcall(function()
        local part = portalPart()
        if not part then teleportAndTouch(HUB_SPAWN_CF) task.wait(1.5) part = portalPart() end -- (the portals are at spawn)
        if not part then return false, "couldn't find the " .. name .. " portal" end
        for _, side in ipairs({ 1, -1 }) do
            local at = part.Position + part.CFrame.LookVector * (8 * side) + Vector3.new(0, 2, 0)
            teleportAndTouch(CFrame.lookAt(at, Vector3.new(part.Position.X, at.Y, part.Position.Z)))
            task.wait(0.4)
            pcall(function() unlockRE:FireServer({ ["Action"] = "Purchase", ["Island"] = name }) end)
            local t0 = os.clock()
            while os.clock() - t0 < 4 and getReplica().Data.Progression.UnlockedIslands[name] ~= true do task.wait(0.1) end
            if getReplica().Data.Progression.UnlockedIslands[name] == true then return true end
        end
        return false, "the game didn't unlock it"
    end)
    releaseTrip("islandBuy")
    local back = getRoot()
    if back and home then back.AssemblyLinearVelocity = Vector3.zero back.CFrame = home end
    if not ok then return false, tostring(done) end
    return done == true, why
end
