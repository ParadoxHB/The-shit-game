-- the biggest rebirth button you can afford right now (nil = none)
local function bestRebirth(d)
    if not RebirthCfg then return nil end
    local rebirths = d.Statistics.Rebirths or 0
    for index = rebirthButtonCount(d), 1, -1 do
        local ok, price = pcall(RebirthCfg.GetPrice, RebirthCfg.GetAmountFromIndex(index), rebirths)
        if ok and price <= coins(d) then return index end
