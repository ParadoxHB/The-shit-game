		self.lastNote[tostring(info.title or "")] = tostring(info.content or "")
		self.lastNoteText = tostring(info.title or "") .. ": " .. tostring(info.content or "")
		library:Notify(info.title or self.title, info.content or "", info.duration or 4)
		if self.onNotify then pcall(self.onNotify, info) end
