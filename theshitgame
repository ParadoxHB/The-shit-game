			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Font = o.font,
			TextSize = o.fontsize,
			TextColor3 = o.textcolor,
			Text = name,
			Parent = header,
		})

		local arrow = new("TextLabel", {
			Name = "drop",
			Text = "v",
			BackgroundTransparency = 1,
			Position = UDim2.new(1, -22, 0, 0),
			Size = UDim2.new(0, 20, 1, 0),
			Font = o.font,
			TextSize = o.fontsize,
			TextColor3 = o.textcolor,
			Parent = header,
		})

		local searchH = searchable and 26 or 0

		local drop = new("Frame", {
			Name = "DropContainer",
			BackgroundColor3 = o.bgcolor,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 0, 1, 3),
			Size = UDim2.new(1, 0, 0, 0),
			ClipsDescendants = true,
			Active = true,
			Visible = false,
			Parent = header,
		})
		corner(drop, 4)
		stroke(drop, o.bordercolor)

		local searchBox
		if searchable then
			searchBox = new("TextBox", {
				Name = "Search",
				Text = "",
				PlaceholderText = "Search...",
				PlaceholderColor3 = o.placeholdercolor,
				ClearTextOnFocus = false,
				BackgroundColor3 = o.btncolor,
				TextColor3 = o.textcolor,
				Font = o.font,
				TextSize = o.fontsize,
				TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.new(0, 4, 0, 3),
				Size = UDim2.new(1, -8, 0, 20),
				Parent = drop,
			})
			corner(searchBox, 3)
			new("UIPadding", {PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), Parent = searchBox})
		end

		local scroll = new("ScrollingFrame", {
			Name = "Items",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 0, 0, searchH),
			Size = UDim2.new(1, 0, 1, -searchH),
			CanvasSize = UDim2.new(0, 0, 0, 0),
			ScrollBarThickness = 3,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			Active = true,
			Parent = drop,
		})

		local itemLayout = new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll})
		itemLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			scroll.CanvasSize = UDim2.new(0, 0, 0, itemLayout.AbsoluteContentSize.Y)
		end)

		local emptyLbl = new("TextLabel", {
			Name = "Empty",
			Text = "No results",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, ITEM_H),
			LayoutOrder = 9999,
			Font = o.font,
			TextSize = o.fontsize - 1,
			TextColor3 = dim,
			Visible = false,
			Parent = scroll,
		})

		-- state used by the functions below
		local open = false
		local items = {}
		local visibleCount = 0
		local hoverDrop, hoverHeader = false, false
		local clickConn
		local commit, setOpen

		drop.MouseEnter:Connect(function() hoverDrop = true end)
		drop.MouseLeave:Connect(function() hoverDrop = false end)
		header.MouseEnter:Connect(function() hoverHeader = true end)
		header.MouseLeave:Connect(function() hoverHeader = false end)

		local function targetHeight()
			local n = math.max(visibleCount, 1)
			return searchH + math.min(n * ITEM_H, MAX_LIST) + 4
		end

		local function refreshHeader()
			local text, placeholder

			if multi then
				if #sel == 0 then
					text, placeholder = name, true
				else
					text = table.concat(sel, ", ")
				end
			else
				if single then
					text = single
				else
					text, placeholder = name, true
				end
			end

			selLabel.Text = text
			selLabel.TextColor3 = placeholder and dim or o.textcolor
		end

		local function paintItems()
			for _, it in ipairs(items) do
				tween(it.btn, {TextColor3 = isSelected(it.name) and o.accent or o.textcolor}, 0.1)

				local idx = multi and table.find(sel, it.name)
				it.badge.Text = idx and tostring(idx) or ""
				it.badge.TextColor3 = o.accent
			end
		end

		local function applyFilter()
			local q = searchBox and string.lower(searchBox.Text) or ""
			local shown = 0

			for _, it in ipairs(items) do
				local vis = (q == "") or (string.find(string.lower(it.name), q, 1, true) ~= nil)
				it.btn.Visible = vis

				if vis then
					shown = shown + 1
				end
			end

			visibleCount = shown
			emptyLbl.Visible = (shown == 0)

			if open then
				tween(drop, {Size = UDim2.new(1, 0, 0, targetHeight())}, 0.1)
			end
		end

		local function rebuildItems()
			for _, it in ipairs(items) do
				it.btn:Destroy()
			end

			items = {}

			for i, v in ipairs(list) do
				local btn = new("TextButton", {
					Name = "Item",
					Text = v,
					AutoButtonColor = false,
					BackgroundColor3 = o.btncolor,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					TextColor3 = isSelected(v) and o.accent or o.textcolor,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
					Font = o.font,
					TextSize = o.fontsize - 1,
					Size = UDim2.new(1, 0, 0, ITEM_H),
					LayoutOrder = i,
					Parent = scroll,
				})
				new("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, multi and 26 or 8), Parent = btn})

				-- priority number (multi dropdowns): 1 = first one you ticked
				local badge = new("TextLabel", {
					Name = "Priority",
					Text = "",
					BackgroundTransparency = 1,
					AnchorPoint = Vector2.new(0, 0),
					Position = UDim2.new(1, 4, 0, 0),
					Size = UDim2.new(0, 18, 1, 0),
					TextXAlignment = Enum.TextXAlignment.Right,
					Font = Enum.Font.GothamBold,
					TextSize = o.fontsize - 2,
					TextColor3 = o.accent,
					Parent = btn,
				})

				btn.MouseEnter:Connect(function()
					tween(btn, {BackgroundTransparency = 0}, 0.08)
				end)
				btn.MouseLeave:Connect(function()
					tween(btn, {BackgroundTransparency = 1}, 0.08)
				end)

				btn.MouseButton1Click:Connect(function()
					if multi then
						local idx = table.find(sel, v)

						if idx then
							table.remove(sel, idx)
						else
							table.insert(sel, v)
						end

						commit(true)
					else
						single = v
						commit(true)
						setOpen(false)
					end
				end)

				items[i] = {btn = btn, name = v, badge = badge}
			end

			applyFilter()
		end

		commit = function(fire)
			location[flag] = value()
			refreshHeader()
			paintItems()

			if fire then
				callback(location[flag])
			end
		end

		local closer = function()
			setOpen(false)
		end

		setOpen = function(state)
			if state == open then
				return
			end

			open = state

			if open then
				local prev = library.openDropdown

				if prev and prev ~= closer then
					prev()
				end

				library.openDropdown = closer

				row.ZIndex = 100
				library:BringToFront(self)

				drop.Size = UDim2.new(1, 0, 0, 0)
				drop.Visible = true
				applyFilter()

				tween(arrow, {Rotation = 180}, 0.15)
				tween(hStroke, {Color = o.accent}, 0.15)

				clickConn = UIS.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						local inside = hoverDrop or hoverHeader or pointerInside(drop) or pointerInside(header)

						if not inside then
							setOpen(false)
						end
					end
				end)
			else
				if clickConn then
					clickConn:Disconnect()
					clickConn = nil
				end

				if library.openDropdown == closer then
					library.openDropdown = nil
				end

				tween(drop, {Size = UDim2.new(1, 0, 0, 0)}, 0.12)
				tween(arrow, {Rotation = 0}, 0.15)
				tween(hStroke, {Color = o.bordercolor}, 0.15)

				if searchBox then
					searchBox.Text = ""
				end

				task.delay(0.14, function()
					if not open then
						drop.Visible = false
						row.ZIndex = 1
					end
				end)
			end
		end

		header.MouseButton1Click:Connect(function()
			setOpen(not open)
		end)

		if searchBox then
			searchBox:GetPropertyChangedSignal("Text"):Connect(function()
				applyFilter()
				scroll.CanvasPosition = Vector2.new(0, 0)
			end)
		end

		rebuildItems()
		commit(false)

		table.insert(library.hooks, function()
			if not row.Parent then
				return true
			end

			paintItems()
			return false
		end)

		local api = {Frame = row}

		-- replaces the list. newSel (optional) replaces the selection. Does not fire the callback.
		function api:SetList(newList, newSel)
			local pos = scroll.CanvasPosition
			list = copyList(newList)

			if newSel ~= nil then
				if multi then
					sel = copyList(newSel)
				else
					single = newSel
				end
			end

			rebuildItems()
			commit(false)

			if open then
				task.defer(function()
					scroll.CanvasPosition = pos
				end)
			end
		end

		-- compatibility with the old API: replaces the list, keeps whatever selection still exists
		function api:Refresh(array)
			list = copyList(array)

			if multi then
				local kept = {}

				for _, v in ipairs(sel) do
					if table.find(list, v) then
						table.insert(kept, v)
					end
				end

				sel = kept
			elseif single == nil or not table.find(list, single) then
				single = list[1]
			end

			rebuildItems()
			commit(false)
		end

		function api:Set(v)
			if multi then
				sel = copyList(v)
			else
				single = v
			end

			commit(true)
		end

		function api:Get()
			return value()
		end

		function api:Open()
			setOpen(true)
		end

		function api:Close()
			setOpen(false)
		end

		function api:Destroy()
			setOpen(false)
			row:Destroy()
		end

		return api
	end

	--==================================================================
	-- HUB WINDOW  (added to CynxUI)
	-- Tabs on the left, scrolling pages, hover descriptions, searchable
	-- dropdowns, per-account config save / load.
	-- Offers the same functions the feature code below was written for:
	--   window:CreateTab / tab:CreateToggle, CreateButton, CreateSlider,
	--   CreateDropdown, CreateInput, CreateText, CreateSection ...
	--==================================================================
	local HttpService = game:GetService("HttpService")
	local TextService = game:GetService("TextService")

	local hubs = {}
	local ROW_BG = Color3.fromRGB(30, 30, 30)
	local ROW_HOVER = Color3.fromRGB(40, 40, 40)
	local TIP_DELAY = 0.3
	local tipFrame, tipLabel, tipShownFor, tipHover, tipSince, hoverRow

	local Hub = {}
	Hub.__index = Hub
	local Tab = {}
	Tab.__index = Tab

	local function hideTip()
		if tipFrame then
			tipFrame.Visible = false
		end
		tipShownFor = nil
	end

	local function applyAutoScale()
		if not library.scaleObj then
			return
		end

		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
		local auto = math.clamp(math.min(vp.X / 540, vp.Y / 480), 0.5, 1)
		library.scaleObj.Scale = auto * (library.userScale or 1)
	end

	local function toLocal(screenPos)
		local s = library.scaleObj and library.scaleObj.Scale or 1
		return Vector2.new(screenPos.X / s, screenPos.Y / s)
	end

	local function tipStep()
		if not library.toggled or library.openDropdown then
			if not library.toggled and not hoverRow and not tipShownFor then
				return -- menu hidden and nothing to clean up: do no work at all
			end

			hideTip()
			tipHover = nil
			if hoverRow then
				hoverRow.row.BackgroundColor3 = ROW_BG
				hoverRow = nil
			end
			return
		end

		local mp = UIS:GetMouseLocation()
		local found

		for i = #hubs, 1, -1 do
			local hub = hubs[i]

			if not hub.root.Parent then
				table.remove(hubs, i)
			elseif hub.win.toggled and hub.current then
				for _, e in ipairs(hub.current.rows) do
					if e.hover > 0 and e.row.Visible then
						found = e
						break
					end
				end

				if found then
					break
				end
			end
		end

		if found ~= hoverRow then
			if hoverRow and hoverRow.row.Parent then
				tween(hoverRow.row, {BackgroundColor3 = ROW_BG}, 0.12)
			end

			hoverRow = found

			if found and found.row.Parent then
				tween(found.row, {BackgroundColor3 = ROW_HOVER}, 0.12)
			end
		end

		if found ~= tipHover then
			tipHover = found
			tipSince = os.clock()
			hideTip()
		end

		if not found or not found.text or found.text == "" then
			hideTip()
			return
		end

		if os.clock() - tipSince < TIP_DELAY then
			return
		end

		if tipShownFor ~= found then
			tipShownFor = found
			tipLabel.Text = found.text

			local size = TextService:GetTextSize(found.text, 12, Enum.Font.Gotham, Vector2.new(250, 1000))
			tipFrame.Size = UDim2.new(0, size.X + 16, 0, size.Y + 12)
			tipFrame.Visible = true
		end

		local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
		local fx, fy = tipFrame.AbsoluteSize.X, tipFrame.AbsoluteSize.Y
		local x = mp.X + 16
		local y = mp.Y + 20

		if x + fx > vp.X - 4 then
			x = mp.X - fx - 10
		end

		if y + fy > vp.Y - 4 then
			y = mp.Y - fy - 10
		end

		local lp = toLocal(Vector2.new(math.max(x, 2), math.max(y, 2)))
		tipFrame.Position = UDim2.new(0, lp.X, 0, lp.Y)
	end

	local function hubInit()
		library:Init()

		if library.overlay and library.overlay.Parent then
			return
		end

		table.clear(hubs)
		hoverRow = nil
		local o = library.options

		library.scaleObj = new("UIScale", {Parent = library.container})
		library.overlay = new("Frame", {
			Name = "Overlay",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, 0),
			ZIndex = 100000,
			Active = false,
			Parent = library.container,
		})

		tipFrame = new("Frame", {
			Name = "Tooltip",
			BackgroundColor3 = Color3.fromRGB(18, 18, 18),
			BorderSizePixel = 0,
			Visible = false,
			Size = UDim2.new(0, 200, 0, 30),
			ZIndex = 100001,
			Parent = library.overlay,
		})
		corner(tipFrame, 5)
		local tipStroke = stroke(tipFrame, o.accent, 1)
		bindAccent(tipStroke, "Color", function() return library.options.accent end)

		tipLabel = new("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 8, 0, 6),
			Size = UDim2.new(1, -16, 1, -12),
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextColor3 = Color3.fromRGB(225, 225, 225),
			Text = "",
			ZIndex = 100002,
			Parent = tipFrame,
		})

		applyAutoScale()

		local cam = workspace.CurrentCamera
		if cam then
			track(cam:GetPropertyChangedSignal("ViewportSize"), applyAutoScale)
		end

		local acc = 0
		track(RunService.Heartbeat, function(dt)
			acc = acc + dt

			if acc >= 0.05 then
				acc = 0
				pcall(tipStep)
			end
		end)
	end

	function library:SetUserScale(s)
		library.userScale = math.clamp(tonumber(s) or 1, 0.5, 1.5)
		applyAutoScale()
	end

