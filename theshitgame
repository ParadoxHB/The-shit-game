-- Skip hatch animation: swap the game's hatch renderers for versions that finish instantly.
-- The game's own "done" callbacks still run, so the Hatches panel and the server's
-- secret-pet acknowledgement (SecretAnimationCompleted) keep working.
local PetsModules = ReplicatedStorage.Modules.Client.Pets
local animPatches = {
    { module = "HatchRenderer", methods = {
        -- HatchRenderer:Play(egg, result, onDone, receipt)
        Play = function(_, _, _, onDone) if onDone then task.defer(onDone) end end,
        IsPlaying = function() return false end,
    } },
    { module = "SecretHatchRenderer", methods = {
        -- SecretHatchRenderer:Play(pet, onDone, receipt, options) / :PlayReveal(pet, onDone, receipt)
        Play = function(_, _, onDone) if onDone then task.defer(onDone) end end,
        PlayReveal = function(_, _, onDone) if onDone then task.defer(onDone) end end,
        IsPlaying = function() return false end,
    } },
    { module = "SecretHatchCutscenes", methods = {
        -- SecretHatchCutscenes:Play(pet, onDone(status)) -> started
        Play = function(_, _, onDone) if onDone then task.defer(onDone, "Skipped") end return true end,
        IsPlaying = function() return false end,
    } },
}
local animOriginals = {}

local function setSkipHatchAnimation(skip)
    for _, patch in ipairs(animPatches) do
        local ok, err = pcall(function()
            local mod = require(PetsModules[patch.module])
            animOriginals[patch.module] = animOriginals[patch.module] or {}
            local saved = animOriginals[patch.module]
            for name, replacement in pairs(patch.methods) do
                if saved[name] == nil then saved[name] = mod[name] end
                mod[name] = skip and replacement or saved[name]
            end
        end)
        if not ok then warn("[HustlHub] Couldn't patch " .. patch.module .. ":", err) end
    end
    print("[HustlHub] Hatch animation", skip and "skipped" or "restored")
end
connections.hatchAnimation = { Disconnect = function() setSkipHatchAnimation(false) end }

-- quiet = true skips the game's own auto-hatch (no Hatches panel, no on/off messages)
-- persistent = true: never stops for coins / storage, only when you walk away from the egg
-- returnHome = true (Auto Hatch): if something else moved you (Pet Defense, chests, quests, the
-- island boost...), go back to the egg (hatchCraft.home) instead of hatching from the wrong place
local WALK_AWAY_DISTANCE = 20 -- studs from where hatching started
local WALK_AWAY_GRACE = 1.5   -- seconds you must stay away (so a quick return teleport doesn't count)
local function startHatching(quiet, persistent, returnHome)
    if not quiet then setGameAutoHatch(selectedEgg) end

    hatchRunning = true
    hatchRunId += 1
    hatchStopReason = nil
    hatchPersistent = persistent == true
    hatchWaitReason = nil
    local myRun = hatchRunId
    local startRoot = getRoot()
    local homeCF = returnHome and hatchCraft.home or nil
    local homePos = (homeCF and homeCF.Position) or (startRoot and startRoot.Position)
    local awaySince
    local lastWaitNote
    local lastWalk, lastReturn = -math.huge, 0
    -- where the character was a moment ago (to tell whether something is still moving it around)
    local settlePos, settleSince = nil, os.clock()

    task.spawn(function()
        while hatchRunning and hatchRunId == myRun and getgenv().HustlHubRun == HH_RUN do -- (a replaced copy stops hatching)
            -- Away from the egg because ANOTHER feature took you somewhere (a trip, Pet Defense, the
            -- game...): don't keep firing hatch requests (they all fail "too far"), and only go back
            -- once that feature is done: nothing holds the trip lock, no Pet Defense match, and the
            -- character has stayed put for 3 seconds (features that move you without the trip lock
            -- get to finish first).
            local awayRoot = getRoot()
            local away = homePos and awayRoot and (awayRoot.Position - homePos).Magnitude > WALK_AWAY_DISTANCE
            if away then
                if not settlePos or (awayRoot.Position - settlePos).Magnitude > 3 then
                    settlePos, settleSince = awayRoot.Position, os.clock()
                end
            else
                settlePos = nil
            end
            local othersBusy = tripOwner ~= nil or chestTripActive or LocalPlayer:GetAttribute("ColosseumActive") == true
            -- persistent: stop only when you've walked away yourself (not during a hub trip like chests)
            if persistent and homePos and not chestTripActive then
                local root = getRoot()
                local hum = root and root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.MoveDirection.Magnitude > 0.1 then lastWalk = os.clock() end
                if root and (root.Position - homePos).Magnitude > WALK_AWAY_DISTANCE then
                    if homeCF and os.clock() - lastWalk > 5 then
                        -- you didn't walk off: another feature (or the game) moved you, so go back
                        -- once it's finished with you (see above)
                        awaySince = nil
                        if tripOwner == nil and os.clock() - lastReturn > 5 and not othersBusy
                            and os.clock() - settleSince >= 3
                            and LocalPlayer:GetAttribute("ColosseumActive") ~= true then
                            lastReturn = os.clock()
                            print("[HustlHub] Auto Hatch: you got moved away from the egg, going back")
                            acquireTrip("hatchReturn")
                            pcall(teleportAndTouch, homeCF)
                            releaseTrip("hatchReturn")
                            hatchWaitReason = nil
                        end
                    else
                        awaySince = awaySince or os.clock()
                        if os.clock() - awaySince >= WALK_AWAY_GRACE then
                            hatchStopReason = "You walked away from the egg"
                        end
                    end
                else
                    awaySince = nil
                end
            end
            if not (hatchRunning and hatchRunId == myRun) then break end
            if hatchStopReason then
                window:Notify({ title = "Auto Hatch stopped", content = hatchStopReason, duration = 6 })
                print("[HustlHub] Auto Hatch stopped:", hatchStopReason)
                hatchRunning = false
                setGameAutoHatch(nil)
                if hatchStopReason == "You walked away from the egg" then
                    -- you moved away: pause, keep the switch ON, and go back to the egg once you stand still again
                    window.hubHatchQueued = true
                    window.hubWalkPause = true
                elseif not window.hubFeatureBusy() then
                    -- a real stop (storage full, no coins...). Only Auto Hatch's own run flips its switch, not Index / Mastery's hatching
                    pcall(function() hatchToggle:Set(false, true) end)
                end
                break
            end

            -- still away from the egg (another feature is using you, or we're about to go back):
            -- don't fire hatch requests that can only fail, just wait
            if away and returnHome and homeCF then
                hatchWaitReason = nil
                task.wait(0.5)
                continue
            end

            -- Server said "too fast": back off very briefly, then try again
            if hatchRateLimited then
                hatchRateLimited = false
                task.wait(0.05)
            end
            -- persistent and out of coins / storage: keep trying, once a second
            if hatchWaitReason then
                if lastWaitNote ~= hatchWaitReason then
                    lastWaitNote = hatchWaitReason
                    print("[HustlHub] Auto Hatch: " .. hatchWaitReason .. ", still trying")
                end
                task.wait(1)
            else
                lastWaitNote = nil
            end

            -- Send a request, then wait for the server's answer before sending the next one
            hatchWaiting = true
            HatchRemote:FireServer({
                ["Egg"] = selectedEgg,
                ["Auto"] = false,
                ["Count"] = pickHatchCount(selectedEgg),
            })
            local sentAt = os.clock()
            while hatchWaiting and os.clock() - sentAt < 3 and hatchRunId == myRun do
                RunService.Heartbeat:Wait()
            end
        end
    end)

    -- If the game's auto-hatch switches itself off (e.g. after an error), turn it back on
    -- so the Hatches panel stays open
    task.spawn(function()
        while hatchRunning and hatchRunId == myRun and getgenv().HustlHubRun == HH_RUN do
            task.wait(2)
            if not quiet and hatchRunning and hatchRunId == myRun and gameAutoEgg() ~= selectedEgg then
                setGameAutoHatch(selectedEgg)
            end
        end
    end)
end

