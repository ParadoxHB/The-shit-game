-- Builds the dropdown, slider, refresh button and auto toggle for one machine.
-- getMachine returns the machine's model in workspace (teleported to when the toggle turns on).
local function createMachine(tab, machineKey, sourceTier, maxPets, color, getMachine)
    local state = { waiting = false, failReason = nil }
    machineState[machineKey] = state

    local petsPerCraft = maxPets
    local running = false
    local runId = 0

    tab:CreateSection({ name = machineKey .. " Machine" })
    for _, text in ipairs({
        machineKey .. " Pet",
        machineKey .. " Pets Per Craft",
        "Refresh " .. machineKey .. " Pets",
        "Auto " .. machineKey,
    }) do
        outlineLabel(text, color)
    end

    local picker = makePetPicker(tab, machineKey .. " Pet", sourceTier, "Your " .. sourceTier .. " pets.")

    tab:CreateSlider({
        name = machineKey .. " Pets Per Craft",
        description = "How many pets go into each craft. More pets = higher success chance; the maximum is a guaranteed craft.",
        range = { 1, maxPets },
        increment = 1,
        value = maxPets,
        callback = function(value)
            petsPerCraft = value
        end,
    })

    -- shared with Auto Hatch's "Craft When Storage Is Full" (same picks, same pets per craft)
    state.settings = { picker = picker, perCraft = function() return petsPerCraft end }

    local function refreshPetList()
        memoryScanAt = 0 -- force a fresh memory scan if that's the source
        local count = picker.refresh(true)
        print("[HustlHub]", machineKey, "dropdown:", count, sourceTier, "pet types")
    end

    -- Fill the list again shortly after loading, in case the data wasn't ready yet
    task.delay(3, refreshPetList)

    connections["machine_" .. machineKey] = { Disconnect = function() running = false end }

    tab:CreateToggle({
        name = "Auto " .. machineKey,
        description = "Teleports to the " .. machineKey .. " machine and keeps crafting the selected pets, one kind at a time. Skips locked, frozen and equipped pets, and hides the crafting screens while it runs.",
        callback = function(value)
            running = false
            setCraftUiHidden(machineKey, value)
            if not value then
                CraftTeam.stop(machineKey) -- puts your team back once no auto craft is running
                return
            end
            if not picker.hasPicks() and not hatchCraft.craftAll then
                window:Notify({ title = "Auto " .. machineKey, content = "Pick at least one pet first (or turn on Craft Every Pet).", duration = 3 })
                setCraftUiHidden(machineKey, false)
                return
            end
            CraftTeam.start(machineKey) -- your best Alchemist pets (better craft odds)
            -- Go to the machine first
            local ok, machine = pcall(getMachine)
            if ok and machine then
                if teleportTo(machine) then
                    print("[HustlHub] Teleported to the", machineKey, "machine")
                end
            else
                warn("[HustlHub] " .. machineKey .. " machine not found in workspace")
                window:Notify({ title = "Auto " .. machineKey, content = "Couldn't find the machine to teleport to.", duration = 4 })
            end

            running = true
            runId += 1
            local myRun = runId
            print("[HustlHub] Auto", machineKey, "started with", hatchCraft.craftAll and "every pet" or table.concat(picker.list(), ", "))

            task.spawn(function()
                local lastStatus
                while running and runId == myRun do
                    local ok, err = pcall(function()
                        -- Only craft while standing at this machine and while no trip has you elsewhere. This loop
                        -- teleports to the machine once, at the start; when Auto Hatch takes you back to the egg it
                        -- used to keep firing crafts every second ("You must be near ..."), and during a Craft When
                        -- Storage Is Full trip its requests and refusals mixed with the trip's, which made the trip
                        -- give up with most sets still uncrafted. That trip crafts everything itself.
                        if hatchCraft.tripBusy or tripOwner ~= nil or not window.hubAtMachine(machineKey) then
                            local status = "[HustlHub] Auto " .. machineKey .. " paused: "
                                .. ((hatchCraft.tripBusy or tripOwner ~= nil) and "another trip is running" or "not at the machine")
                            if status ~= lastStatus then print(status) lastStatus = status end
                            task.wait(2)
                            return
                        end
                        -- Read the live inventory each time, so crafted pets are already gone.
                        -- Takes the first picked pet that has enough for a craft.
                        local ids, info = picker.pick(petsPerCraft)

                        if not ids then
                            local status = string.format("[HustlHub] %s waiting for more %s pets: need %d of one kind, have %s",
                                machineKey, sourceTier, petsPerCraft, info ~= "" and info or "none picked")
                            if status ~= lastStatus then
                                print(status)
                                lastStatus = status
                            end
                            task.wait(1)
                            return
                        end
                        lastStatus = nil

                        -- Send the craft, then wait for the server's answer (like the game does)
                        local now = os.clock()
                        for _, id in ipairs(ids) do recentlySent[id] = now end
                        state.waiting = true
                        state.failReason = nil
                        CraftRemote:FireServer({
                            ["PetIds"] = ids,
                            ["Machine"] = machineKey,
                            ["Action"] = "Craft",
                        })
                        local sentAt = os.clock()
                        while state.waiting and os.clock() - sentAt < 10 and runId == myRun do
                            task.wait(0.05)
                        end

                        if state.failReason then
                            print("[HustlHub]", machineKey, "craft rejected:", state.failReason)
                            task.wait(1)
                        else
                            print("[HustlHub] Crafted", machineKey, "with", #ids, info) -- info = the pet's name
                            task.wait(0.2) -- give the inventory a moment to update
                        end
                    end)
                    if not ok then
                        warn("[HustlHub] Auto " .. machineKey .. " error:", err)
                        task.wait(1)
                    end
                end
            end)
        end,
    })
end

