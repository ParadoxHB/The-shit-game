-- HustlHub version (shown in the title bar, the log and the Discord update posts). Bump it with every release.
getgenv().HustlHubVersion = "1.4.60"

-- Accounts that should NOT run HustlHub: put their usernames (one per line) in HustlHub_blocked_accounts.txt in your
-- executor's workspace folder. A listed account stops here, before anything is loaded, built or started.
do
    local Players = game:GetService("Players")
    local lp = Players.LocalPlayer
    local t0 = os.clock()
    while not lp and os.clock() - t0 < 30 do task.wait(0.1) lp = Players.LocalPlayer end
    local blocked = false
    pcall(function()
        if lp and isfile and isfile("HustlHub_blocked_accounts.txt") then
            for line in tostring(readfile("HustlHub_blocked_accounts.txt")):gmatch("[^\r\n]+") do
                local name = line:gsub("^%s+", ""):gsub("%s+$", "")
                if name ~= "" and name:sub(1, 1) ~= "#" and name:lower() == lp.Name:lower() then blocked = true end
            end
        end
    end)
    if blocked then
        print("[HustlHub] Not starting: " .. lp.Name .. " is in HustlHub_blocked_accounts.txt")
        return
    end
end

local HH_RUN = tostring(os.clock()) .. "-" .. tostring(math.random(1000000)) -- this run's id: a newer run replaces older ones that are still waiting to start
getgenv().HustlHubRun = HH_RUN

-- FIRST thing on every run: remove the previous copy (its loops, then every leftover HustlHub window in any place a
-- GUI can live), so running the script again replaces the old menu straight away, not after the game-load wait below.
pcall(function()
    if getgenv().MyGameHubCleanup then
        pcall(getgenv().MyGameHubCleanup)
        getgenv().MyGameHubCleanup = nil
    end
    local places = {}
    pcall(function() if gethui then table.insert(places, gethui()) end end)
    pcall(function() table.insert(places, game:GetService("CoreGui")) end)
    pcall(function()
        local lp = game:GetService("Players").LocalPlayer
        if lp and lp:FindFirstChild("PlayerGui") then table.insert(places, lp.PlayerGui) end
    end)
    for _, place in ipairs(places) do
        for _, child in ipairs(place:GetChildren()) do
            if child.Name == "HustlHub" or child.Name == "CynxHub" or child.Name == "MyGameHub" then pcall(function() child:Destroy() end) end
        end
    end
end)

---------------------------------------------------------------- Wait for the game to fully load
-- The game's Bootstrap sets workspace "IsClientLoaded" = true (stage "Ready") once player data
-- has arrived and every controller has started. Its own client scripts wait on the same flag.
-- Every wait has a time limit and the whole thing is pcall'd, so it can never stop the hub from
-- starting: at worst it starts a bit early. Watch the console for the "[HustlHub] Load:" lines.
do
    local function gameReady()
        if workspace:GetAttribute("IsClientLoaded") == true then return true end
        if workspace:GetAttribute("ClientRuntimeStage") == "Ready" then return true end
        local ok, loaded = pcall(function() return getrenv and getrenv()._G.Loaded end) -- the game's own _G
        return ok and loaded == true
    end
    local function waitUntil(check, seconds)
        local start = os.clock()
        while os.clock() - start < seconds do
            local ok, done = pcall(check)
            if ok and done then return true end
            task.wait(0.25)
        end
        return false
    end

    local ok, err = pcall(function()
        if gameReady() then
            print("[HustlHub] Load: game already loaded")
            return
        end
        print("[HustlHub] Load: waiting for the game to finish loading...")

        waitUntil(function() return game:IsLoaded() end, 60)
        local Players = game:GetService("Players")
        waitUntil(function() return Players.LocalPlayer ~= nil end, 30)
        local LocalPlayer = Players.LocalPlayer

        local LOAD_TIMEOUT = 90 -- seconds; carry on anyway after this
        local lastStage
        local loaded = waitUntil(function()
            local stage = workspace:GetAttribute("ClientRuntimeStage")
            if stage ~= lastStage then
                print("[HustlHub] Load: game stage " .. tostring(stage))
                lastStage = stage
            end
            return gameReady()
        end, LOAD_TIMEOUT)
        if loaded then
            print("[HustlHub] Load: game loaded")
        else
            warn("[HustlHub] Load: game didn't report loaded after " .. LOAD_TIMEOUT .. "s, starting anyway")
        end

        if LocalPlayer then
            waitUntil(function() return LocalPlayer.Character ~= nil end, 20)
        end
        task.wait(1) -- let the game's UI finish building
    end)
    if not ok then warn("[HustlHub] Load: wait skipped (" .. tostring(err) .. ")") end
end

-- a newer run started while this one was still waiting for the game: this one steps aside
if getgenv().HustlHubRun ~= HH_RUN then
    print("[HustlHub] A newer run replaced this one while it was loading")
    return
end

-- Kill the previous copy of this script (UI + loops) if it's still running
if getgenv().MyGameHubCleanup then
    local ok, err = pcall(getgenv().MyGameHubCleanup)
    print("[HustlHub] Old copy cleanup:", ok and "done" or err)
end

print("[HustlHub] Starting...")


---------------------------------------------------------------- Extra waits (auto execute / auto reconnect)
-- Runs on every join, so it is safe to put in your executor's autoexec folder: it waits until the
-- game, your character and the screen have settled, and only then builds the menu and starts features.
do
    local ok, err = pcall(function()
        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")
        local function waitUntil(check, seconds)
            local start = os.clock()
            while os.clock() - start < seconds do
                local okCheck, done = pcall(check)
                if okCheck and done then return true end
                task.wait(0.25)
            end
            return false
        end

        waitUntil(function() return game:IsLoaded() end, 120)
        waitUntil(function() return Players.LocalPlayer ~= nil end, 60)
        local lp = Players.LocalPlayer
        waitUntil(function() return lp:FindFirstChildOfClass("PlayerGui") ~= nil end, 60)
        waitUntil(function() return workspace.CurrentCamera ~= nil end, 30)
        waitUntil(function()
            local char = lp.Character
            return char and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChild("HumanoidRootPart")
        end, 60)

        -- let the frame rate settle (loading screens / streaming make the first seconds laggy)
        local calm, last = 0, os.clock()
        local conn = RunService.Heartbeat:Connect(function()
            local now = os.clock()
            if now - last < 0.07 then calm = calm + 1 else calm = 0 end
            last = now
        end)
        waitUntil(function() return calm >= 30 end, 6)
        conn:Disconnect()
        task.wait(0.3)
    end)
    if not ok then warn("[HustlHub] Load: extra wait skipped (" .. tostring(err) .. ")") end
    print("[HustlHub] Load: game is ready, starting")
end

if getgenv().HustlHubRun ~= HH_RUN then return end -- (replaced by a newer run during these waits too)

--[[
	HUSTLHUB  (CynxUI interface + HustlHub features merged, with Anti-AFK and Texture Delete)
	  * Right Shift hides / shows the menu (or tap the small UI button on the right)
	  * Hover any switch / button for a description. Type in the search box to find a feature.
	  * "Config List" tab: every on/off switch in one place. Settings auto-save per account.
]]
local library: any = {
	count = 0,
	queue = {},
	callbacks = {},
	rainbowtable = {},
	toggled = true,
	binds = {},
	connections = {},
	topZ = 1,
	openDropdown = nil,
	binding = false,
	toggleKey = Enum.KeyCode.RightShift,
	rainbow = false,
	hooks = {},
	glassTargets = {},
	scaleObj = nil,
	notifyHolder = nil,
	notifications = {},
	toastId = 0,
	themeName = "Rainbow",
}

do
	local UIS = game:GetService("UserInputService")
	local TweenService = game:GetService("TweenService")
	local RunService = game:GetService("RunService")
	local CoreGui = game:GetService("CoreGui")
	local LocalPlayer = game:GetService("Players").LocalPlayer

	local GUI_NAME = "HustlHub"
	local WINDOW_W, TITLE_H = 190, 26
	local ITEM_H, MAX_LIST = 20, 150
	local WHITE = Color3.fromRGB(255, 255, 255)

	local defaults = {
		topcolor         = Color3.fromRGB(30, 30, 30),
		titlecolor       = WHITE,
		underlinecolor   = Color3.fromRGB(0, 255, 140),
		accent           = Color3.fromRGB(0, 255, 140),
		bgcolor          = Color3.fromRGB(35, 35, 35),
		boxcolor         = Color3.fromRGB(35, 35, 35),
		btncolor         = Color3.fromRGB(25, 25, 25),
		dropcolor        = Color3.fromRGB(25, 25, 25),
		sectncolor       = Color3.fromRGB(10, 10, 10),
		bordercolor      = Color3.fromRGB(60, 60, 60),
		font             = Enum.Font.Gotham,
		titlefont        = Enum.Font.GothamBold,
		fontsize         = 13,
		titlesize        = 14,
		textcolor        = WHITE,
		titletextcolor   = WHITE,
		placeholdercolor = Color3.fromRGB(140, 140, 140),
		glass            = 0, -- window transparency (0 = solid)
	}

	library.options = setmetatable({}, {__index = defaults})

	local function tween(obj, props, t)
		local tw = TweenService:Create(obj, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
		tw:Play()
		return tw
	end

	local function track(signal, fn)
		local c = signal:Connect(fn)
		table.insert(library.connections, c)
		return c
	end

	local function new(class, props, children)
		local obj = Instance.new(class)
		for k, v in pairs(props or {}) do
			if k ~= "Parent" then
				obj[k] = v
			end
		end
		for _, child in ipairs(children or {}) do
			child.Parent = obj
		end
		if props and props.Parent then
			obj.Parent = props.Parent
		end
		return obj
	end

	local function corner(obj, radius)
		return new("UICorner", {CornerRadius = UDim.new(0, radius or 4), Parent = obj})
	end

	local function stroke(obj, color, thickness)
		return new("UIStroke", {
			Color = color,
			Thickness = thickness or 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = obj,
		})
	end

	local function shade(c, amt)
		return Color3.new(
			math.clamp(c.R + amt, 0, 1),
			math.clamp(c.G + amt, 0, 1),
			math.clamp(c.B + amt, 0, 1)
		)
	end

	local function hover(obj, normal, over)
		obj.MouseEnter:Connect(function()
			tween(obj, {BackgroundColor3 = over}, 0.1)
		end)
		obj.MouseLeave:Connect(function()
			tween(obj, {BackgroundColor3 = normal}, 0.1)
		end)
	end

	local function copyList(t)
		local r = {}
		for i, v in ipairs(t or {}) do
			r[i] = tostring(v)
		end
		return r
	end

	local function pointerInside(obj)
		local p = UIS:GetMouseLocation()
		local pos, size = obj.AbsolutePosition, obj.AbsoluteSize
		return p.X >= pos.X and p.X <= pos.X + size.X and p.Y >= pos.Y and p.Y <= pos.Y + size.Y
	end

	local function nextOrder(self)
		self.count = self.count + 1
		return self.count
	end

	library.themes = {
		Rainbow = Color3.fromRGB(0, 255, 140),
		Emerald = Color3.fromRGB(0, 255, 140),
		Violet  = Color3.fromRGB(168, 85, 247),
		Crimson = Color3.fromRGB(255, 70, 90),
		Ocean   = Color3.fromRGB(56, 189, 248),
		Sunset  = Color3.fromRGB(251, 146, 60),
		Mono    = Color3.fromRGB(235, 235, 235),
	}
	library.themeOrder = {"Rainbow", "Emerald", "Violet", "Crimson", "Ocean", "Sunset", "Mono"}

	local function bindAccent(obj, prop, fn)
		table.insert(library.hooks, function()
			if not obj.Parent then
				return true
			end

			tween(obj, {[prop] = fn()}, 0.25)
			return false
		end)
	end

	local function runHooks()
		for i = #library.hooks, 1, -1 do
			local ok, remove = pcall(library.hooks[i])

			if ok and remove then
				table.remove(library.hooks, i)
			end
		end
	end

	function library:SetTheme(name)
		local color = library.themes[name]

		if not color then
			return
		end

		library.themeName = name
		library.options.accent = color
		library.rainbow = (name == "Rainbow")

		if library.rainbow then
			library.options.underlinecolor = "rainbow"
		else
			library.options.underlinecolor = color

			for _, u in ipairs(library.rainbowtable) do
				if u.Parent then
					tween(u, {BackgroundColor3 = color}, 0.25)
				end
			end
		end

		runHooks()
	end

	-- pct: 0 = solid / dark, 100 = the clear, see-through look
	function library:SetTransparency(pct)
		pct = math.clamp(tonumber(pct) or 0, 0, 100)
		library.options.glass = (pct / 100) * 0.12

		for i = #library.glassTargets, 1, -1 do
			local t = library.glassTargets[i]

			if t.obj.Parent then
				tween(t.obj, {BackgroundTransparency = library.options.glass * t.factor}, 0.2)
			else
				table.remove(library.glassTargets, i)
			end
		end
	end

	-- small slide-in card in the bottom right corner
	function library:Notify(title, text, duration)
		if not library.notifyHolder then
			return
		end

		local o = library.options
		duration = duration or 3.5
		library.toastId = library.toastId + 1

		local wrapper = new("Frame", {
			Name = "Toast",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = library.toastId,
			Parent = library.notifyHolder,
		})

		local card = new("Frame", {
			Name = "Card",
			Position = UDim2.new(0, 280, 0, 0),
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = o.bgcolor,
			BackgroundTransparency = o.glass * 0.4,
			BorderSizePixel = 0,
			Parent = wrapper,
		})
		corner(card, 8)

		local cardStroke = stroke(card, o.accent, 1)
		cardStroke.Transparency = 0.35

		new("UIPadding", {
			PaddingTop = UDim.new(0, 8),
			PaddingBottom = UDim.new(0, 8),
			PaddingLeft = UDim.new(0, 12),
			PaddingRight = UDim.new(0, 12),
			Parent = card,
		})
		new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2), Parent = card})

		new("TextLabel", {
			Text = tostring(title or ""),
			LayoutOrder = 1,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = o.titlefont,
			TextSize = o.fontsize,
			TextColor3 = o.accent,
			Parent = card,
		})

		new("TextLabel", {
			Text = tostring(text or ""),
			LayoutOrder = 2,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = o.font,
			TextSize = o.fontsize - 1,
			TextColor3 = Color3.fromRGB(190, 190, 190),
			Parent = card,
		})

		table.insert(library.notifications, wrapper)

		if #library.notifications > 5 then
			local oldest = table.remove(library.notifications, 1)
			if oldest then
				oldest:Destroy()
			end
		end

		tween(card, {Position = UDim2.new(0, 0, 0, 0)}, 0.3)

		task.delay(duration, function()
			if card.Parent then
				tween(card, {Position = UDim2.new(0, 280, 0, 0)}, 0.25)
			end

			task.delay(0.3, function()
				local idx = table.find(library.notifications, wrapper)
				if idx then
					table.remove(library.notifications, idx)
				end

				if wrapper.Parent then
					wrapper:Destroy()
				end
			end)
		end)
	end

	local function guiParent()
		local ok, p = pcall(function()
			if typeof(gethui) == "function" then
				return gethui()
			end
			return CoreGui
		end)

		if ok and p then
			return p
		end

		return LocalPlayer:WaitForChild("PlayerGui")
	end

	-- library level
	function library:BringToFront(window)
		library.topZ = library.topZ + 1
		window.object.ZIndex = library.topZ
	end

	function library:Init()
		if library.gui and library.gui.Parent then
			return
		end

		local parent = guiParent()

		pcall(function()
			local old = parent:FindFirstChild(GUI_NAME)
			if old then
				old:Destroy()
			end
		end)

		local gui = new("ScreenGui", {
			Name = GUI_NAME,
			ResetOnSpawn = false,
			IgnoreGuiInset = true,
			DisplayOrder = 1000, -- (above any older copy that is somehow still around)
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		})

		pcall(function()
			if syn and syn.protect_gui then
				syn.protect_gui(gui)
			end
		end)

		local okParent = pcall(function()
			gui.Parent = parent
		end)

		if not okParent then
			gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
		end

		library.gui = gui
		library.container = new("Frame", {
			Name = "Container",
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			Active = false,
			Parent = gui,
		})

		-- notification stack (bottom right)
		library.notifyHolder = new("Frame", {
			Name = "Toasts",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -14, 1, -14),
			Size = UDim2.new(0, 250, 1, -28),
			Parent = gui,
		})
		new("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			Padding = UDim.new(0, 6),
			Parent = library.notifyHolder,
		})

		-- on-screen button for devices without a usable keyboard (emulators, phones).
		-- Tap it to hide / show the UI, drag it to move it.
		do
			local o = library.options
			local pressing, moved, basePos, startPos = false, false, nil, nil

			local btn = new("TextButton", {
				Name = "ToggleButton",
				Text = "UI",
				AutoButtonColor = false,
				Size = UDim2.new(0, 40, 0, 40),
				Position = UDim2.new(1, -54, 0.5, -20),
				BackgroundColor3 = o.topcolor,
				BackgroundTransparency = o.glass * 0.83,
				TextColor3 = o.textcolor,
				Font = o.titlefont,
				TextSize = o.titlesize,
				Active = true,
				ZIndex = 50,
				Parent = gui,
			})
			corner(btn, 20)
			table.insert(library.glassTargets, {obj = btn, factor = 0.83})

			local btnStroke = stroke(btn, o.accent, 1.5)
			bindAccent(btnStroke, "Color", function() return library.options.accent end)

			btn.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					pressing = true
					moved = false
					basePos = nil
					startPos = btn.Position

					input.Changed:Connect(function()
						if input.UserInputState == Enum.UserInputState.End then
							pressing = false
						end
					end)
				end
			end)

			-- the first movement after a press only sets the baseline, so a different
			-- coordinate space between press and move events can't count as a drag
			track(UIS.InputChanged, function(input)
				if pressing and (input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch) then
					if not basePos then
						basePos = input.Position
						return
					end

					local d = input.Position - basePos

					if d.Magnitude > 8 then
						moved = true
					end

					if moved then
						btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
					end
				end
			end)

			-- Activated fires for both mouse clicks and touch taps
			btn.Activated:Connect(function()
				if moved then
					moved = false
					return
				end

				library:Toggle()
			end)
		end

		-- Right Shift toggles the UI, keybinds fire their callbacks
		track(UIS.InputBegan, function(input, gpe)
			if gpe then
				return
			end

			if input.KeyCode == library.toggleKey then
				library:Toggle()
				return
			end
		end)

		-- one loop drives every rainbow underline
		track(RunService.Heartbeat, function()
			if not library.rainbow or #library.rainbowtable == 0 then
				return
			end

			local color = Color3.fromHSV((os.clock() * 0.25) % 1, 1, 1)

			for _, obj in ipairs(library.rainbowtable) do
				if obj.Parent then
					obj.BackgroundColor3 = color
				end
			end
		end)
	end

	function library:Toggle(state)
		if state == nil then
			state = not library.toggled
		end

		library.toggled = state
		library.lastToggle = os.clock()

		if library.openDropdown then
			library.openDropdown()
		end

		for i, data in ipairs(library.queue) do
			local w = data.w

			if not state then
				data.p = w.Position
			end

			local p = data.p
			local target = state and p or UDim2.new(p.X.Scale, p.X.Offset, 0, -1500)

			task.delay((i - 1) * 0.03, function()
				if library.toggled == state and w.Parent then
					tween(w, {Position = target}, 0.25)
				end
			end)
		end
	end

	function library:Destroy()
		if library.openDropdown then
			pcall(library.openDropdown)
		end

		for _, c in ipairs(library.connections) do
			pcall(function()
				c:Disconnect()
			end)
		end

		library.connections = {}

		if library.gui then
			library.gui:Destroy()
			library.gui = nil
		end

		library.container = nil
		library.queue = {}
		library.rainbowtable = {}
		library.binds = {}
		library.callbacks = {}
		library.hooks = {}
		library.glassTargets = {}
		library.notifications = {}
		library.notifyHolder = nil
		library.scaleObj = nil
		library.rainbow = false
	end

	-- window
	local types = {}
	types.__index = types

	local function makeDraggable(window, handle)
		local frame = window.object
		local dragging, dragInput, dragStart, startPos = false, nil, nil, nil

		-- keep the title bar where it can be grabbed: below Roblox's own top bar (this UI ignores the top inset, so
		-- at y = 0 the title sits under it and can't be clicked) and never fully off the sides or the bottom
		local function clampPos(x, y)
			local sc = library.scaleObj and library.scaleObj.Scale or 1
			local cam = workspace.CurrentCamera
			local view = cam and cam.ViewportSize or Vector2.new(1280, 720)
			local topInset = 0
			pcall(function() topInset = game:GetService("GuiService"):GetGuiInset().Y end)
			local minY = (topInset + 8) / sc
			local maxY = math.max(minY, view.Y / sc - 60)
			local minX = 60 / sc - frame.AbsoluteSize.X / sc
			local maxX = math.max(minX, view.X / sc - 60 / sc)
			return math.clamp(x, minX, maxX), math.clamp(y, minY, maxY)
		end
		-- rescue: if it ever ends up out of reach (e.g. after a resolution or UI size change), bring it back
		task.spawn(function()
			while frame.Parent do
				task.wait(1.5)
				-- (only while the menu is shown and settled: hiding slides it off the top on purpose)
				if not dragging and library.toggled and os.clock() - (library.lastToggle or 0) > 1.5 then
					pcall(function()
						local p = frame.Position
						local x, y = clampPos(p.X.Offset, p.Y.Offset)
						if math.abs(x - p.X.Offset) > 1 or math.abs(y - p.Y.Offset) > 1 then
							tween(frame, {Position = UDim2.new(p.X.Scale, x, p.Y.Scale, y)}, 0.15)
						end
					end)
				end
			end
		end)

		handle.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = frame.Position
				library:BringToFront(window)

				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)

		handle.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
			end
		end)

		track(UIS.InputChanged, function(input)
			if dragging and input == dragInput then
				local sc = library.scaleObj and library.scaleObj.Scale or 1
				local d = (input.Position - dragStart) / sc
				local x = startPos.X.Offset + d.X
				local y = startPos.Y.Offset + d.Y
				x, y = clampPos(x, y)

				tween(frame, {Position = UDim2.new(startPos.X.Scale, x, startPos.Y.Scale, y)}, 0.06)
			end
		end)
	end

