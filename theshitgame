    ---------------- More alerts (disconnect, finished, storage full, mastery level up)
    webhookTab:CreateSection({ name = "More Alerts" })
    local alertToggles = {}
    local ALERTS = {
        { key = "disconnect", name = "Alert: Disconnected / Kicked", desc = "Posts a message when Roblox disconnects or kicks you (it sends the reason). It does not ping you." },
