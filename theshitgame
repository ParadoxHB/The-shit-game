local function findChestModel(id)
    for _, model in ipairs(CollectionService:GetTagged("TapChest")) do
        if model:GetAttribute("TapChestId") == id and model:IsDescendantOf(workspace) then
            return model
        end
    end
    return nil
end

local function chestReadyAt(id)
    local replica = getReplica()
    local ok, t = pcall(function() return replica.Data.TapChests[id] end)
    return (ok and type(t) == "number") and t or 0
end

-- Teleport to one chest, claim it. Returns true if it paid out.
local function collectChest(id)
    local root = getRoot()
    if not root then return false end

    local model = findChestModel(id)
    if not model and CHEST_ISLANDS[id] then
        -- Not loaded yet: hop to the island (same timing as the star teleport) so it streams in
        teleportAndTouch(CHEST_ISLANDS[id])
        model = findChestModel(id)
    end
    if not model then
        print("[HustlHub] Chest", id, "not found (island locked or not loaded?)")
        return false
    end

    -- Stand right in front of the chest, same timing as the star teleport
    local front = model:GetAttribute("TapChestFront")
    local cf = typeof(front) == "CFrame" and front or model:GetPivot()
    local pos = cf.Position + cf.LookVector * 6 + Vector3.new(0, 3, 0)
    teleportAndTouch(CFrame.lookAt(pos, Vector3.new(cf.Position.X, pos.Y, cf.Position.Z)))

    local ok, result = pcall(function() return safeInvoke(ChestClaim, id) end)
    if ok and type(result) == "table" and result.Success == true then
        print("[HustlHub] Collected chest", id, "for", tostring(result.Coins), "clicks")
        return true
    end
    local reason = ok and type(result) == "table" and result.Reason or tostring(result)
    print("[HustlHub] Chest", id, "claim failed:", reason)
    return false
end

---------------- Mini chests
-- From the game's BreakableConfig: mini chests are "WorldChest" breakables (respawn every 20s,
-- 10 hits). They have no claim request: the server applies your normal taps to the nearest
-- breakable within 14 studs (12 up/down), at most one hit every 0.1s.
-- Timing (raise these if it still moves on too quickly)
local MINI_SWEEP_INTERVAL = 25  -- seconds between sweeps (chests respawn every 20s)
local MINI_SPOT_WAIT = 1.5      -- extra wait at each island so its mini chests load in
local MINI_ARRIVE_WAIT = 0.5    -- extra wait next to a chest before tapping
local MINI_TAP_INTERVAL = 0.15  -- time between taps (server counts at most one hit per 0.1s)
local MINI_TAP_TIMEOUT = 6      -- give up on one chest after this long

-- Spots to hop to so each area's mini chests load in (spawn + every island)
local MINI_CHEST_SPOTS = {
    CFrame.new(-24.850324630737305, -58.352649688720703, -1839.112792968750000),  -- Sky Island
    CFrame.new(-31.774543762207031, 873.229064941406250, -1705.452026367187500),  -- Autumn
    CFrame.new(-131.746444702148438, 2021.040893554687500, -1688.365600585937500), -- Mushroom
    CFrame.new(-90.745613098144531, 3614.135253906250000, -1650.009399414062500),  -- Desert
    CFrame.new(27.495803833007812, 5451.531250000000000, -1668.031616210937500),   -- Crystal Cave
    CFrame.new(-155.740997314453125, 7679.308593750000000, -1646.321777343750000), -- Shadow Realm
}

local function isMiniChest(model)
    if not (model:IsA("Model") and model:IsDescendantOf(workspace)) then return false end
    if model:GetAttribute("BreakableBroken") == true or model:GetAttribute("BreakableDespawned") == true then
        return false
    end
    local owner = model:GetAttribute("BreakableOwner")
    if owner ~= nil and owner ~= LocalPlayer.UserId then return false end -- someone else's
    local kind = model:GetAttribute("BreakableType")
    return kind == "WorldChest" or kind == "Chest" or CollectionService:HasTag(model, "WorldChest")
end

local function findMiniChests()
    local found, seen = {}, {}
    for _, tag in ipairs({ "WorldChest", "Breakable" }) do
        for _, model in ipairs(CollectionService:GetTagged(tag)) do
            if not seen[model] and isMiniChest(model) then
                seen[model] = true
                table.insert(found, model)
            end
        end
    end
    return found
end

-- Teleport next to one mini chest and tap it until it breaks
local function breakMiniChest(model)
    local rest = model:GetAttribute("BreakableRest")
    local center = (typeof(rest) == "CFrame" and rest or model:GetPivot()).Position
    teleportAndTouch(CFrame.new(center + Vector3.new(4, 2, 0), center))
    task.wait(MINI_ARRIVE_WAIT)

    local start = os.clock()
    while model.Parent and model:GetAttribute("BreakableBroken") ~= true
        and os.clock() - start < MINI_TAP_TIMEOUT do
        clientSequence += 1
        TapRemote:FireServer({ ["Auto"] = false, ["ClientSequence"] = clientSequence })
        task.wait(MINI_TAP_INTERVAL)
    end
    local broke = model:GetAttribute("BreakableBroken") == true or model.Parent == nil
    if broke then task.wait(MINI_AFTER_BREAK) end
    return broke
end

-- Breaks every mini chest that's loaded, hopping through spawn and the islands to load the rest
local function sweepMiniChests(stillRunning)
    local done, broken = {}, 0
    local function breakLoaded()
        for _, model in ipairs(findMiniChests()) do
            if not stillRunning() then return end
            if not done[model] then
                done[model] = true
                if breakMiniChest(model) then broken += 1 end
            end
        end
    end

    breakLoaded()
    local spots = table.clone(MINI_CHEST_SPOTS)
    local basicEgg = workspace:FindFirstChild("Eggs") and workspace.Eggs:FindFirstChild("Basic")
    if basicEgg then table.insert(spots, 1, basicEgg:GetPivot() + Vector3.new(0, 4, 8)) end -- spawn
    for _, spot in ipairs(spots) do
        if not stillRunning() then break end
        teleportAndTouch(spot)
        task.wait(MINI_SPOT_WAIT)
        breakLoaded()
    end
    print("[HustlHub] Mini chest sweep: broke", broken)
end

