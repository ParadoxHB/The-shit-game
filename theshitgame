-- same check as the game's index: Normal in Index[name], others in IndexTiers["Name_Tier"]
local function hasVersion(name, version, index, tiers)
    if version == "Normal" then return index[name] == true end
    if version == "Rainbow" then -- "Shiny" in the game's data
