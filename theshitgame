local SHRINE_BLESSINGS = { -- dropdown label -> blessing key
    ["Luck"] = "Luck",
    ["Golden Chance (Golden & Rainbow)"] = "Golden",
    ["Auto Clicker (click speed)"] = "AutoClicker",
}
local SHRINE_ORDER = { "Luck", "Golden Chance (Golden & Rainbow)", "Auto Clicker (click speed)" }
local TIER_NAMES = { "I", "II", "III" }

local selectedBlessingLabel = SHRINE_ORDER[1]
local shrineRunning = false
local shrineRunId = 0
connections.shrine = { Disconnect = function() shrineRunning = false end }

local function currentBlessing()
    return LocalPlayer:GetAttribute("ShrineBlessing")
end

-- Autumn's landing spot (to load the shrine from anywhere) and where the shrine was last seen
local AUTUMN_SPOT = CFrame.new(-30.439, 877.267, -1706.748)
local lastShrineSpot
local function shrineSpot()
    local ok, shrine = pcall(function() return workspace.Ts2Islands.Autumn.Shrine end)
    if not ok or not shrine or not shrine:IsA("Model") then return nil end
    local cf = shrine:GetPivot()
    local pos = cf.Position + cf.LookVector * 10 + Vector3.new(0, 3, 0)
    return CFrame.lookAt(pos, Vector3.new(cf.Position.X, pos.Y, cf.Position.Z))
end

-- Auto Tap, Shrine Blessing and Auto Shrine share the first row of the Main tab (no heading in
