-- (v1.4.54) Pet Defense drops: defeated opponents drop pickups that land near you (Freeze, Bomb, Rush, Heart, Treat;
-- the visual is always a "TreatDrop" part in workspace.Game.WaveDefense, the kind only shows when collected). The game
-- keeps them in ColosseumController's drop table (spawnDrop's first upvalue, keyed by drop id) and collects one with
-- ColosseumService.RF.CollectDrop(id). Checked live: it works from where you stand and answers e.g.
-- { Kind = "Freeze", FreezeUntil = ..., Shift = 3, Score = 413 } or { Kind = "Bomb", Hits = {...} }.
-- While Auto Pet Defense is on and a match runs, every new drop is collected straight away.
do
    local collectRF
    pcall(function() collectRF = Remotes.ColosseumService.RF.CollectDrop end)
    local dropTable, lastLook = nil, 0
    local function findDropTable()
        for _, f in ipairs(getgc(false)) do
            if type(f) == "function" and islclosure(f) then
                local okN, n = pcall(debug.info, f, "n")
                if okN and n == "spawnDrop" then
                    local okS, s = pcall(debug.info, f, "s")
                    if okS and tostring(s):find("ColosseumController") then
                        local okU, ups = pcall(debug.getupvalues, f)
                        if okU and type(ups) == "table" and type(ups[1]) == "table" then return ups[1] end
                    end
                end
            end
        end
        return nil
    end
    local alive = true
    connections.hubDefenseDrops = { Disconnect = function() alive = false end }
    task.spawn(function()
        -- (v1.4.56) keyed by the drop's own table, not its id: ids start again every match, and the old id list
        -- skipped every drop whose id had been seen before.
        local state, counts = setmetatable({}, { __mode = "k" }), {}
        local function landing(e)
            if typeof(e.ground) == "Vector3" then return e.ground end
            if typeof(e.base) == "Vector3" then return e.base end
            return nil
        end
        -- (v1.4.57, user request "actually teleport to all the touch spots") the character goes to every drop: once it
        -- has landed (tossAt, or 0.6 s after it showed up) it teleports onto the spot, collects it there, and moves on to
        -- the next one, oldest first. When none are left it goes back to where it stood in the arena.
        local function landTime(e, st)
            local t = tonumber(e.tossAt)
            if t and t > st.seenAt - 10 and t < st.seenAt + 3 then return t end -- (an os.clock() time, like spawnDrop's)
            return st.seenAt + 0.6
        end
        local function standOn(where)
            local root = getRoot()
            if not (root and where) then return end
            if (root.Position - where).Magnitude > 3 then
                root.AssemblyLinearVelocity = Vector3.zero
                root.CFrame = CFrame.new(where + Vector3.new(0, 3, 0))
            end
        end
        local home -- where the character stood before the first drop of a run of drops
        while alive and getgenv().HustlHubRun == HH_RUN do
            if defenseRunning and collectRF and LocalPlayer:GetAttribute("ColosseumActive") then
                if not dropTable and os.clock() - lastLook > 5 then lastLook = os.clock() dropTable = findDropTable() end
                -- the oldest drop that's still to collect
                local pickId, pickE, pickSt
                for id, e in pairs(dropTable or {}) do
                    if type(e) == "table" then
                        local st = state[e]
                        if not st then st = { tries = 0, seenAt = os.clock() } state[e] = st end
                        if not st.done and st.tries < 25 and (not pickSt or st.seenAt < pickSt.seenAt) then
                            pickId, pickE, pickSt = id, e, st
                        end
                    end
                end
                if pickSt then
                    local root = getRoot()
                    if not home and root then home = root.CFrame end
                    local wait = landTime(pickE, pickSt) - os.clock()
                    if wait > 0 then task.wait(math.min(wait, 1.5)) end
                    standOn(landing(pickE))
                    task.wait(0.1) -- (the game's own pickup check runs while you stand there too)
                    pickSt.tries += 1
                    local ok, res = pcall(safeInvoke, collectRF, pickId)
                    if ok and type(res) == "table" and res.Kind then
                        pickSt.done = true
                        counts[res.Kind] = (counts[res.Kind] or 0) + 1
                    elseif pickSt.tries >= 3 then
                        -- refused 3 times (e.g. a 2nd Rush while one runs): leave it, the game drops it when it expires
                        pickSt.done = true
                    else
                        task.wait(0.3)
                    end
                elseif home then
                    local root = getRoot()
                    if root and (root.Position - home.Position).Magnitude > 3 then
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.CFrame = home
                    end
                    home = nil
                end
            else
                home = nil
                if next(counts) then
                    local parts = {}
                    for k, v in pairs(counts) do table.insert(parts, v .. " " .. k) end
                    print("[HustlHub] Pet Defense: collected drops: " .. table.concat(parts, ", "))
                    table.clear(counts)
                end
            end
            task.wait(0.05)
        end
    end)
end

automationTab:CreateToggle({
