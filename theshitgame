local function eggPetsOwned(d, egg)
    local cfg = LaunchEggConfig and LaunchEggConfig[egg]
    local list = {}
    if not (cfg and cfg.Pets) then return list end
    for id, pet in pairs(d.Pets.Owned) do
        if type(pet) == "table" and cfg.Pets[pet.Name] ~= nil and pet.Frozen == nil then table.insert(list, { id = id, power = power(pet) }) end
    end
    table.sort(list, function(a, b) return a.power > b.power end)
    return list
end
