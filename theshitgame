-- GetReplica() can wait forever if the data isn't ready, so give it a time limit
local cachedReplica
local lastReplicaTry = -math.huge
local function getReplica()
    if cachedReplica or not DataController then return cachedReplica end
    if os.clock() - lastReplicaTry < 30 then return nil end
    lastReplicaTry = os.clock()
    local done, replica = false, nil
    task.spawn(function()
        local ok, r = pcall(function() return DataController:GetReplica() end)
        if ok then replica = r end
        done = true
    end)
    local start = os.clock()
    while not done and os.clock() - start < 2 do task.wait() end
    cachedReplica = replica
    return replica
end

-- Fallback: find the pet table in memory (biggest table of Id -> pet data)
local GUID = "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"
local function isPetEntry(k, v)
    return type(k) == "string" and k:match(GUID) and type(v) == "table"
        and rawget(v, "Name") ~= nil and rawget(v, "Tier") ~= nil
end

local memoryPetTable, memoryScanAt = nil, 0
local function findPetTableInMemory()
    if not getgc then return nil end
    local best, bestCount = nil, 0
    for _, t in ipairs(getgc(true)) do
        if type(t) == "table" then
            pcall(function()
                local k, v = next(t)
                if not isPetEntry(k, v) then return end
                local count = 0
                for key, val in pairs(t) do
                    if isPetEntry(key, val) then count += 1 end
                end
                if count > bestCount then best, bestCount = t, count end
            end)
        end
    end
    return best
end

local petSource
local function getOwnedPets()
    -- 1) The game's own data (always up to date)
    local replica = getReplica()
    local ok, owned = pcall(function() return replica.Data.Pets.Owned end)
    if ok and type(owned) == "table" and next(owned) ~= nil then
        if petSource ~= "game data" then
            petSource = "game data"
            print("[HustlHub] Reading pets from the game's data")
        end
        return owned
    end

    -- 2) Memory search, rescanned at most every 5 seconds
    if not memoryPetTable or os.clock() - memoryScanAt > 5 then
        memoryPetTable = findPetTableInMemory()
        memoryScanAt = os.clock()
    end
    if petSource ~= "memory" then
        petSource = "memory"
        print("[HustlHub] Game data unavailable, reading pets from memory")
    end
    return memoryPetTable or {}
end

