-- How fast you're earning coins (measured every second while Auto Progress runs)
local income, lastCoins, lastCoinsAt = 0, nil, 0
local rebirthPatience = 20 -- seconds: wait for the next rebirth button only if it's this close
local function sampleIncome()
    local d = data()
    if not d then return end
    local now, c = os.clock(), coins(d)
    if lastCoins and c >= lastCoins and now > lastCoinsAt then
        income = income * 0.7 + ((c - lastCoins) / (now - lastCoinsAt)) * 0.3
    end
    lastCoins, lastCoinsAt = c, now
end
-- Rebirth with the biggest button you can afford, unless the next button up is only a few
-- seconds of earning away (then it's worth waiting for: 5x the rebirths). Adapts by itself as
-- your income grows. `any` = the tutorial asked for a rebirth, so any button counts.
local function rebirth(d, any)
    local index = bestRebirth(d)
    if not (index and RebirthRE) then return false end
    if not any and index < rebirthButtonCount(d) then
        local ok, nextPrice = pcall(RebirthCfg.GetPrice, RebirthCfg.GetAmountFromIndex(index + 1), d.Statistics.Rebirths or 0)
        if ok and income > 0 and (nextPrice - coins(d)) / income < rebirthPatience then
            return false -- the next button is almost here
        end
    end
    RebirthRE:FireServer({ ["Index"] = index })
    log("Rebirthing (button " .. index .. ")")
    task.wait(1.6) -- the game's own spacing
    return true
end
-- saving up for `price`: rebirth only while it's still far away (rebirths reset your coins)
local function saveFor(d, price, what)
    if coins(d) >= price then return true end
    -- far away (over ~2 minutes of earning at your current speed): rebirth first to earn faster;
    -- close: just save
    local far
    if income > 0 then far = (price - coins(d)) / income > 120 else far = price > coins(d) * 25 end
    if far and rebirth(d) then
        log("Rebirthed to earn " .. what .. " faster")
    else
        log(string.format("Saving for %s (%s / %s coins)", what, tostring(math.floor(coins(d))), tostring(price)))
        -- just tapping while saving: do it on the island with the biggest tap boost
        if hubState.ensureBestIsland then pcall(hubState.ensureBestIsland) end
        task.wait(2)
    end
    return false
end

local islandTriedAt = {}
local IslandResultRE = re("IslandService", "IslandUnlockResult")
local function unlockIsland(d, name, info)
    if not saveFor(d, info.Price, name) then return end
    if islandTriedAt[name] and os.clock() - islandTriedAt[name] < 20 then
        log("Waiting to try " .. name .. " again")
        task.wait(2)
        return
    end
    islandTriedAt[name] = os.clock()
    log("Unlocking " .. name)
    -- the game only sells a portal while you stand at it (workspace.Portals.Portals[PortalName].Portal)
    local function portalPart()
        local folder = workspace:FindFirstChild("Portals") and workspace.Portals:FindFirstChild("Portals")
        local model = folder and folder:FindFirstChild(info.PortalName or name)
        local part = model and model:FindFirstChild("Portal")
        if part and part:IsA("BasePart") then return part end
        return nil
    end
    local function buy()
        local answer
        local conn = IslandResultRE and IslandResultRE.OnClientEvent:Connect(function(result) answer = result end)
        IslandUnlockRE:FireServer({ ["Action"] = "Purchase", ["Island"] = name })
        local start = os.clock()
        while not answer and os.clock() - start < 4 do task.wait(0.1) end
        if conn then conn:Disconnect() end
        local nowData = data()
        local reason = type(answer) == "table" and (answer.Reason or answer.Error or answer.Message) or answer
        return nowData and nowData.Progression.UnlockedIslands[name] == true, reason
    end
    local root = getRoot()
    local home = root and root.CFrame
    acquireTrip("islandBuy")
    local ok, unlocked, reason = pcall(function()
        local part = portalPart()
        if not part then
            -- the portals are at spawn: go there so they load, then look again
            teleportAndTouch(GOLDEN_SPOT)
            task.wait(1.5)
            part = portalPart()
        end
        if not part then return false, "couldn't find the " .. name .. " portal" end
        -- stand just in front of it (either side), facing it, and buy
        local done, why
        for _, side in ipairs({ 1, -1 }) do
            local at = part.Position + part.CFrame.LookVector * (8 * side) + Vector3.new(0, 2, 0)
            teleportAndTouch(CFrame.lookAt(at, Vector3.new(part.Position.X, at.Y, part.Position.Z)))
            task.wait(0.4)
            done, why = buy()
            if done or not (type(why) == "string" and why:lower():find("near")) then break end
        end
        return done, why
    end)
    local back = getRoot()
    if back and home then back.AssemblyLinearVelocity = Vector3.zero back.CFrame = home end
    task.wait(0.3)
    releaseTrip("islandBuy")
    if ok and unlocked then
        log("Unlocked " .. name .. "!")
    else
        log("Couldn't unlock " .. name .. ": " .. tostring(ok and (reason or "no answer") or unlocked))
    end
end
