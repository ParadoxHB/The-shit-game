---------------------------------------------------------------- Teleport
-- Moves your character next to a model or part (a few studs in front, slightly above)
local function teleportTo(target)
    waitForDefenseRound()
    local char = game:GetService("Players").LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        warn("[HustlHub] Can't teleport: no character")
        return false
    end
    -- An exact spot: go there and stay put until the ground has loaded (no falling under the map)
    if typeof(target) == "CFrame" then
        return teleportAndTouch(target)
    end
    local cf
    if target:IsA("Model") then
        cf = target:GetPivot()
    elseif target:IsA("BasePart") then
        cf = target.CFrame
    else
        local part = target:FindFirstChildWhichIsA("BasePart", true)
        if not part then return false end
        cf = part.CFrame
    end
    local pos = cf.Position + cf.LookVector * 6 + Vector3.new(0, 3, 0)
    root.CFrame = CFrame.lookAt(pos, Vector3.new(cf.Position.X, pos.Y, cf.Position.Z))
    return true
end

