-- 3) Server requests with a time limit. A request the server never answers used to freeze that
--    feature forever (and, mid-trip, every teleport feature with it). Now it gives up after 15s.
local INVOKE_TIMEOUT = 15
-- Where to stand at an egg. The egg sits on a pedestal / platform, so look for that surface FIRST (ray straight down from
-- above, only solid parts, players ignored) at a few spots in front of the egg, nearest first, and stand ON it, a short
-- drop above its top. If there is no platform at egg-base level (some eggs stand on the ground), stand on the ground
-- 4 studs in front. If nothing solid is loaded yet, use the egg-box estimate (the teleport then guarantees footing).
window.hubEggSpot = function(center, look, size)
    local bottom = center.Y - size.Y / 2
    local exclude = {}
    for _, pl in ipairs(game:GetService("Players"):GetPlayers()) do
        if pl.Character then table.insert(exclude, pl.Character) end
    end
    local function surface(pos)
        local ok, hit = pcall(function()
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.RespectCanCollide = true
            params.FilterDescendantsInstances = exclude
            return workspace:Raycast(Vector3.new(pos.X, bottom + 8, pos.Z), Vector3.new(0, -40, 0), params)
        end)
        return ok and hit or nil
    end
    local half = size.Z / 2
    for _, d in ipairs({ half + 1.5, half + 3 }) do
        local pos = center + look * d
        local hit = surface(pos)
        if hit and hit.Position.Y >= bottom - 3 and hit.Position.Y <= bottom + 1.5 then
            -- the hatching platform: its top is PLATFORM_RISE above the ground / pedestal measured here, you stand on it
            window.hubEggPad = { x = pos.X, z = pos.Z, y = hit.Position.Y + 2.5, t = os.clock() }
            return Vector3.new(pos.X, hit.Position.Y + 2.5 + 3.5, pos.Z)
        end
    end
    local pos = center + look * (half + 4)
    local hit = surface(pos)
    if hit then
        window.hubEggPad = { x = pos.X, z = pos.Z, y = hit.Position.Y + 2.5, t = os.clock() }
        return Vector3.new(pos.X, hit.Position.Y + 2.5 + 3.5, pos.Z)
    end
    -- no ground loaded here yet: the platform at about the egg's base level (it holds you, nothing to fall through)
    window.hubEggPad = { x = pos.X, z = pos.Z, y = bottom + 0.5, t = os.clock() }
    return Vector3.new(pos.X, bottom + 0.5 + 3.5, pos.Z)
end
local function safeInvoke(remote, ...)
    local args = table.pack(...)
    local done, ok, result = false, false, nil
    task.spawn(function()
        ok, result = pcall(function() return remote:InvokeServer(table.unpack(args, 1, args.n)) end)
        done = true
    end)
    local start = os.clock()
    while not done and os.clock() - start < INVOKE_TIMEOUT do task.wait() end
    if not done then
        warn("[HustlHub] Server didn't answer " .. tostring(remote.Name) .. " within " .. INVOKE_TIMEOUT .. "s, moving on")
        return nil
    end
    if not ok then error(result, 0) end
    return result
end

