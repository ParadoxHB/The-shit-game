-- The Enchant machine's box (InteractionPoint "Enchant") only exists while that area is loaded, so
-- its position is remembered the first time it's seen (saved to a file, so it survives restarts)
-- and used to teleport there from anywhere.
local ENCHANT_SPOT_FILE = "HustlHub_enchant_spot.txt"
local enchantSpot -- Vector3
pcall(function()
    if isfile and isfile(ENCHANT_SPOT_FILE) then
        local x, y, z = readfile(ENCHANT_SPOT_FILE):match("([%-%d%.]+),([%-%d%.]+),([%-%d%.]+)")
        if x then enchantSpot = Vector3.new(tonumber(x), tonumber(y), tonumber(z)) end
    end
end)
local function findEnchantPoint()
    local root = getRoot()
    local best, bestDist
    for _, point in ipairs(game:GetService("CollectionService"):GetTagged("InteractionPoint")) do
        if point.Name == "Enchant" and point:IsDescendantOf(workspace) then
            local cf = point:IsA("BasePart") and point.CFrame or (point:IsA("Model") and point:GetPivot())
            if cf then
                local d = root and (cf.Position - root.Position).Magnitude or 0
                if not best or d < bestDist then best, bestDist = cf, d end
            end
        end
    end
    return best
end
local function rememberEnchantSpot(pos)
    if enchantSpot and (enchantSpot - pos).Magnitude < 1 then return end
    enchantSpot = pos
    pcall(function() writefile(ENCHANT_SPOT_FILE, string.format("%.2f,%.2f,%.2f", pos.X, pos.Y, pos.Z)) end)
    print("[HustlHub] Auto Enchant: remembered the Enchant machine at", tostring(pos))
end
-- keep an eye out for the machine while you play (cheap: one tag lookup every 5s)
local spotWatcher = true
task.spawn(function()
    while spotWatcher do
        local cf = findEnchantPoint()
        if cf then rememberEnchantSpot(cf.Position) end
        task.wait(5)
    end
end)
local function stopSpotWatcher() spotWatcher = false end

-- teleport into the Enchant machine's box (the game only rolls there)
local function goToEnchantMachine()
    local cf = findEnchantPoint()
    if not cf and enchantSpot then
        -- not loaded: go to the remembered spot, then wait for the box to load in
        teleportAndTouch(CFrame.new(enchantSpot + Vector3.new(0, 3, 0)))
        local start = os.clock()
        repeat task.wait(0.2); cf = findEnchantPoint() until cf or os.clock() - start > 4
    end
    if not cf then return false end
    rememberEnchantSpot(cf.Position)
    teleportAndTouch(CFrame.new(cf.Position)) -- the middle of the box
    return true
end

local enchantToggle
local gameAutoActive = false
local autoConn -- the connection to the game's auto enchant events (this run's)
local function dropAutoConn()
    if autoConn then autoConn:Disconnect() autoConn = nil end
end
local function stopGameAuto() -- only stops an auto enchant this hub started
    dropAutoConn()
    if not gameAutoActive then return end
    gameAutoActive = false
    if EnchantRF and EnchantRF:FindFirstChild("AutoStop") then
        task.spawn(function() pcall(safeInvoke, EnchantRF.AutoStop) end)
    end
end
-- After the game's Auto Enchant stops, it keeps the pet in the enchanter ("Tap Claim to take it
-- back") until it's claimed. Nothing else can roll until then (the server answers "ClaimFirst").
function window.hubEnchantAuto.claimHeldPet()
    local lp = game:GetService("Players").LocalPlayer
    if lp:GetAttribute("EnchantHeldPet") == nil then return false end
    if not (EnchantRF and EnchantRF:FindFirstChild("Claim")) then return false end
    local ok, res = pcall(safeInvoke, EnchantRF.Claim)
    return ok and type(res) == "table" and res.Success == true
end
local function stopEnchant(text)
    stopGameAuto()
    enchantRunning = false
    enchantRunId += 1
    if text then pcall(function() enchantStatus:Set(text) end) end
    pcall(function() enchantToggle:Set(false, true) end)
end
connections.autoEnchant = { Disconnect = function() enchantRunning = false; stopSpotWatcher() end }

enchantToggle = enchantTab:CreateToggle({
    name = "Auto Enchant",
    forgetState = true,
    description = "For each picked pet: saves your Slot targets as the game's Filters and turns on the game's own Auto Enchant switch, so the server rolls (1 gem each) until it hits one of them, then claims the pet back and moves on to the next one. Pets that already have a target are skipped. Goes to the Enchant machine to start each pet; you can hatch meanwhile. Secret enchants can't go in the game's Filters, so a slot with only secret targets (and the Unlock Slot 2 step) is rolled by the hub instead.",
    callback = function(value)
        enchantRunning = false
        enchantRunId += 1
        stopGameAuto()
        if not value then
            pcall(function() enchantStatus:Set("Off") end)
            return
        end
        if not EnchantRF then
            window:Notify({ title = "Auto Enchant", content = "Couldn't find the game's enchanting.", duration = 4 })
            stopEnchant("Off")
            return
        end
        -- re-read the ticked stacks now (includes copies hatched since you picked them, and
        -- whatever you have equipped right now)
        local petIds = {}
        pcall(function()
            petOptions()
            petIds = pickedPetIds()
        end)
        -- (v1.4.53) "Enchant Best Pets" for a team kind lends its own pets for this one run
        if type(window.hubEnchantAuto.overridePets) == "table" then petIds = table.clone(window.hubEnchantAuto.overridePets) end
        if #petIds == 0 then
            window:Notify({ title = "Auto Enchant", content = "Pick at least one pet first.", duration = 3 })
            stopEnchant("Off")
            return
        end
        local allTargets = {}
        for slot = 1, 2 do for name in pairs(slotTargets[slot]) do allTargets[name] = true end end
        if next(allTargets) == nil then
            window:Notify({ title = "Auto Enchant", content = "Pick at least one Slot 1 or Slot 2 target.", duration = 3 })
            stopEnchant("Off")
            return
        end

        enchantRunning = true
        local myRun = enchantRunId
        local targetsList = {}
        for slot = 1, 2 do
            local names = {}
            for name in pairs(slotTargets[slot]) do table.insert(names, name) end
            if #names > 0 then table.insert(targetsList, "slot " .. slot .. ": " .. table.concat(names, " / ")) end
        end
        local function alive() return enchantRunning and enchantRunId == myRun end

        -- Each target is collected until "Amount Per Enchant" pets have it (default: the game's team
        -- max). What your equipped team and the picked pets already have counts from the start.
        -- familyHave[name] = how many have it, activeTargets[name] = name while more are wanted.
        -- (named "family" below for history: it's per enchant now)
        local activeTargets, familyHave = {}, {}
        do
            local counted, team = {}, {}
            pcall(function() for _, id in ipairs(window.hubCraftTeam.snapshot()) do team[id] = true end end)
            for _, id in ipairs(petIds) do team[id] = true end
            local owned = getOwnedPets()
            for name in pairs(allTargets) do familyHave[name] = 0 end
            for id in pairs(team) do
                local pet = owned[id]
                if type(pet) == "table" and not counted[id] then
                    counted[id] = true
                    for _, e in ipairs({ cleanEnchant(pet.Enchant), cleanEnchant(pet.Enchant2) }) do
                        if e and familyHave[e] then familyHave[e] += 1 end
                    end
                end
            end
            for name in pairs(allTargets) do
                if familyHave[name] < window.hubEnchantAuto.wanted(name) then activeTargets[name] = name end
            end
        end
        -- got one more: stop collecting it once there are as many as you asked for
        local function capFamily(name)
            if name and familyHave[name] and familyHave[name] >= window.hubEnchantAuto.wanted(name) then
                activeTargets[name] = nil
                print("[HustlHub] Auto Enchant: have " .. familyHave[name] .. "/" .. window.hubEnchantAuto.wanted(name) .. " " .. name .. ", done with it")
            end
        end
        local function familyStatus()
            local parts = {}
            for name, have in pairs(familyHave) do
                table.insert(parts, string.format("%s %d/%d", name, have, window.hubEnchantAuto.wanted(name)))
            end
            table.sort(parts)
            return table.concat(parts, ", ")
        end
        if next(activeTargets) == nil then
            window:Notify({ title = "Auto Enchant", content = "Your team already has the amount you picked of every target (" .. familyStatus() .. ").", duration = 6 })
            stopEnchant("Nothing to do: " .. familyStatus())
            return
        end
        print("[HustlHub] Auto Enchant:", #petIds, "pets until", table.concat(targetsList, " | "), "|", familyStatus())

        task.spawn(function()
            pcall(function() enchantStatus:Set("Going to the Enchant machine...") end)
            if not hatchRunning and not goToEnchantMachine() then
                -- never seen the machine yet: can't know where to go
                print("[HustlHub] Auto Enchant: don't know where the Enchant machine is yet")
                window:Notify({ title = "Auto Enchant", content = "Walk up to the Enchant machine once so the hub remembers where it is, then turn Auto Enchant on again.", duration = 8 })
                stopEnchant("Walk to the Enchant machine once, then turn this on again")
                return
            end
            if not alive() then return end
            local startGems
            pcall(function() startGems = getReplica().Data.Currencies.Gems end)
            local function gemsUsed()
                local text = ""
                pcall(function()
                    local gems = getReplica().Data.Currencies.Gems
                    if startGems then text = " | " .. window.hubEnchantAuto.formatGems(startGems - gems) .. " gems used" end
                end)
                return text
            end
            local HttpService = game:GetService("HttpService")
            local results = {} -- "Golem: Lucky III (214 rolls)" per pet
            local totalRolls, farFails = 0, 0

            -- one roll of one slot, put on like the game's button does:
            --   "rolled", enchantName, resolveResult | "retry" | "skip", why | "abort" (already stopped)
            local function rollOnce(rollPetId, rollSlot, st)
                local over, price = window.hubEnchantAuto.overCap(getOwnedPets()[rollPetId])
                if over then
                    return "skip", "next roll costs " .. window.hubEnchantAuto.formatGems(price) .. " gems, over your Max Gems Per Roll"
                end
                st.requestId = st.requestId or HttpService:GenerateGUID(false)
                local ok, result = pcall(function()
                    return safeInvoke(EnchantRF.Enchant, { ["PetId"] = rollPetId, ["Slot"] = rollSlot, ["RequestId"] = st.requestId })
                end)
                if not ok or type(result) ~= "table" then
                    task.wait(0.5) -- connection hiccup: try again with the same request id
                    return "retry"
                end
                if not result.Success then
                    st.requestId = nil
                    local reason = tostring(result.Reason)
                    if reason == "RateLimited" then
                        task.wait(0.3)
                        return "retry"
                    elseif reason == "VisitEnchantMachine" then
                        farFails += 1
                        if farFails > 3 or not goToEnchantMachine() then
                            stopEnchant("Stopped: stand at the Enchant machine")
                            window:Notify({ title = "Auto Enchant", content = "Stand at the Enchant machine, then turn it on again.", duration = 6 })
                            return "abort"
                        end
                        return "retry"
                    elseif reason == "ChoosePendingEnchant" or reason == "EnchantPending" or reason == "ConfirmReplace" then
                        pcall(function()
                            local state = safeInvoke(EnchantRF.GetState)
                            local pending = type(state) == "table" and state.Enchanting and state.Enchanting.Pending
                            if pending and pending.Token then safeInvoke(EnchantRF.Resolve, { ["Token"] = pending.Token, ["UseNew"] = true }) end
                        end)
                        task.wait(0.3)
                        return "retry"
                    elseif reason == "AutoRunning" then
                        pcall(function() safeInvoke(EnchantRF.AutoStop) end)
                        task.wait(0.3)
                        return "retry"
                    elseif reason == "ClaimFirst" then
                        window.hubEnchantAuto.claimHeldPet()
                        task.wait(0.3)
                        return "retry"
                    elseif reason == "InsufficientGems" then
                        stopEnchant("Stopped: not enough gems (" .. totalRolls .. " rolls)" .. gemsUsed())
                        window:Notify({ title = "Auto Enchant stopped", content = "Not enough gems.", duration = 6 })
                        return "abort"
                    end
                    return "skip", ({ Frozen = "unavailable", UnknownPet = "gone", InvalidSlot = "no slot 2", Reserved = "being traded" })[reason] or reason
                end
                st.requestId = nil
                local pending = result.Pending or {}
                local resolved
                if pending.Token then
                    local okR, res = pcall(function()
                        return safeInvoke(EnchantRF.Resolve, { ["Token"] = pending.Token, ["UseNew"] = true })
                    end)
                    if okR then resolved = res end
                end
                return "rolled", pending.Enchant, resolved
            end

            -- The game's own Auto Enchant switch for one pet + slot: saves `names` as the game's Filters,
            -- turns its Auto on (hopping to the machine and straight back to your egg while Auto Hatch
            -- runs, so you keep hatching) and waits until the server switches it off again.
            -- stopOnDouble: switch it off as soon as a roll opens slot 2 (Double Enchant).
            --   "stopped", stopInfo, rolls, doubled | "skip", why | "abort" (the whole run is stopped)
            local function runGameAuto(index, petId, pet, slot, names, stopOnDouble)
                local slotKey = slot == 2 and "Enchant2" or "Enchant"
                local label = stopOnDouble and "unlocking slot 2" or ("slot " .. slot)
                window.hubEnchantAuto.claimHeldPet() -- a pet left in the enchanter blocks starting
                local replaceName = cleanEnchant(pet[slotKey])
                if replaceName and not (EnchantConfig.IsProtected and EnchantConfig.IsProtected(replaceName)) then replaceName = nil end
                -- Max Gems Per Roll: don't even start on a pet that's already too expensive
                local over, startPrice = window.hubEnchantAuto.overCap(getOwnedPets()[petId] or pet)
                if over then
                    return "skip", "next roll costs " .. window.hubEnchantAuto.formatGems(startPrice) .. " gems, over your Max Gems Per Roll"
                end
                local startRollCount = 0
                pcall(function() startRollCount = EnchantConfig.GetRollCount(getOwnedPets()[petId] or pet) end)
                local capHit -- set when the game's Auto is switched off because of the gem cap
                local stopInfo, liveRolls, lastEvent, doubled = nil, 0, os.clock(), false
                dropAutoConn()
                local conn
                conn = AutoEventRE.OnClientEvent:Connect(function(info)
                    if type(info) ~= "table" or (info.PetId and info.PetId ~= petId) then return end
                    lastEvent = os.clock()
                    if info.Kind == "Roll" then
                        liveRolls += 1
                        totalRolls += 1
                        -- the server keeps rolling on its own: switch it off once the next roll would
                        -- cost your cap or more (price from the game's formula + the rolls seen so far)
                        local cap = window.hubEnchantAuto.maxCost
                        if cap and cap > 0 and not capHit then
                            local nextPrice = math.round((EnchantConfig.RollPrice or 25000) * (EnchantConfig.RollPriceGrowth or 1.015) ^ (startRollCount + liveRolls))
                            if nextPrice >= cap then
                                capHit = nextPrice
                                print("[HustlHub] Auto Enchant: " .. pet.Name .. "'s next roll costs " .. window.hubEnchantAuto.formatGems(nextPrice) .. ", over your cap: stopping it")
                                task.spawn(function() pcall(safeInvoke, EnchantRF.AutoStop) end)
                            end
                        end
                        if info.Double and not doubled then
                            doubled = true
                            print("[HustlHub] Auto Enchant: Double Enchant on", pet.Name, "- slot 2 opened with", tostring(info.Double))
                            if stopOnDouble then task.spawn(function() pcall(safeInvoke, EnchantRF.AutoStop) end) end
                        end
                        pcall(function()
                            enchantStatus:Set(string.format("Pet %d/%d: %s (%s) - game's Auto is on\nRoll %d: %s%s\nHave: %s",
                                index, #petIds, pet.Name, label, liveRolls, tostring(info.Enchant), gemsUsed(), familyStatus()))
                        end)
                    elseif info.Kind == "Stop" then
                        stopInfo = info
                    end
                end)
                autoConn = conn

                local started, skipWhy = false, nil
                local tries, saveFails, claimFails = 0, 0, 0
                while alive() and not started and not skipWhy do
                    tries += 1
                    local hopping = hatchRunning and hatchCraft.home ~= nil
                    if hopping then acquireTrip("enchant") end -- Auto Hatch won't drag us back mid-hop
                    if hopping and tries == 1 then goToEnchantMachine() end -- the switch only works at the machine
                    local okF, fres = pcall(function() return safeInvoke(EnchantRF.SetFilters, names) end)
                    if okF and type(fres) == "table" and fres.Success then
                        local okS, sres = pcall(function()
                            return safeInvoke(EnchantRF.AutoStart, { ["PetId"] = petId, ["Slot"] = slot, ["Replace"] = replaceName })
                        end)
                        if okS and type(sres) == "table" and sres.Success then
                            started = true
                            gameAutoActive = true
                            print("[HustlHub] Auto Enchant: game's Auto switched ON for", pet.Name, "(" .. label .. ") | Filters:", table.concat(names, ", "))
                        elseif not okS or type(sres) ~= "table" then
                            print("[HustlHub] Auto Enchant: game's Auto didn't answer (" .. tostring(sres) .. "), trying again")
                            task.wait(0.5)
                        else
                            local reason = tostring(sres.Reason)
                            print("[HustlHub] Auto Enchant: game refused to start Auto on", pet.Name, "-", reason)
                            pcall(function()
                                enchantStatus:Set(string.format("Pet %d/%d: %s (%s)\nStarting the game's Auto... (game said: %s)", index, #petIds, pet.Name, label, reason))
                            end)
                            if tries >= 40 then
                                skipWhy = "the game wouldn't start its Auto (last: " .. reason .. ")" -- never loop forever on one pet
                            elseif reason == "RateLimited" then
                                task.wait(0.3)
                            elseif reason == "VisitEnchantMachine" then
                                farFails += 1
                                if farFails > 6 or not goToEnchantMachine() then
                                    if hopping then releaseTrip("enchant") end
                                    conn:Disconnect()
                                    stopEnchant("Stopped: stand at the Enchant machine")
                                    window:Notify({ title = "Auto Enchant", content = "Stand at the Enchant machine, then turn it on again.", duration = 6 })
                                    return "abort"
                                end
                            elseif reason == "ConfirmReplace" then
                                -- the game's switch asks "replace your current enchant?" and then sends that
                                -- enchant as Replace; do the same (this slot is being rerolled anyway)
                                local fresh = getOwnedPets()[petId] or pet
                                replaceName = cleanEnchant(fresh[slotKey])
                                print("[HustlHub] Auto Enchant: confirming replace of", tostring(replaceName), "on", pet.Name)
                                task.wait(0.2)
                            elseif reason == "ChoosePendingEnchant" or reason == "EnchantPending" then
                                pcall(function()
                                    local state = safeInvoke(EnchantRF.GetState)
                                    local pending = type(state) == "table" and state.Enchanting and state.Enchanting.Pending
                                    if pending and pending.Token then safeInvoke(EnchantRF.Resolve, { ["Token"] = pending.Token, ["UseNew"] = true }) end
                                end)
                                task.wait(0.3)
                            elseif reason == "AutoRunning" then
                                pcall(function() safeInvoke(EnchantRF.AutoStop) end)
                                task.wait(0.3)
                            elseif reason == "ClaimFirst" then
                                claimFails += 1
                                if claimFails > 6 then
                                    skipWhy = "couldn't claim the pet in the enchanter"
                                else
                                    if not window.hubEnchantAuto.claimHeldPet() and claimFails >= 3 then
                                        goToEnchantMachine() -- maybe claiming needs you at the machine
                                        window.hubEnchantAuto.claimHeldPet()
                                    end
                                    task.wait(0.3)
                                end
                            elseif reason == "NoFilters" then
                                task.wait(0.5) -- the Filters save hadn't landed yet: save again and retry
                            elseif reason == "InsufficientGems" then
                                if hopping then releaseTrip("enchant") end
                                conn:Disconnect()
                                stopEnchant("Stopped: not enough gems (" .. totalRolls .. " rolls)" .. gemsUsed())
                                window:Notify({ title = "Auto Enchant stopped", content = "Not enough gems.", duration = 6 })
                                return "abort"
                            else
                                skipWhy = ({ Frozen = "unavailable", UnknownPet = "gone", InvalidSlot = "no slot 2", Reserved = "being traded" })[reason] or reason
                            end
                        end
                    else
                        saveFails += 1
                        print("[HustlHub] Auto Enchant: couldn't save the game's Filters (" .. tostring(type(fres) == "table" and fres.Reason or fres) .. ")")
                        if saveFails >= 5 then skipWhy = "couldn't save the game's auto enchant filters" else task.wait(0.5) end
                    end
                    if started and hopping then pcall(teleportAndTouch, hatchCraft.home) end -- back to the egg
                    if hopping then releaseTrip("enchant") end
                end
                if not alive() then conn:Disconnect() return "abort" end
                if skipWhy then
                    conn:Disconnect()
                    return "skip", skipWhy
                end

                pcall(function()
                    enchantStatus:Set(string.format("Pet %d/%d: %s (%s) - game's Auto is on\nHave: %s", index, #petIds, pet.Name, label, familyStatus()))
                end)
                while alive() and not stopInfo do
                    task.wait(0.25)
                    if os.clock() - lastEvent > 45 then
                        stopInfo = { Reason = "Silent" } -- no news from the server for a while
                        pcall(function() safeInvoke(EnchantRF.AutoStop) end)
                    end
                end
                conn:Disconnect()
                gameAutoActive = false
                task.spawn(window.hubEnchantAuto.claimHeldPet) -- take the pet back out of the enchanter
                if not alive() then return "abort" end
                print("[HustlHub] Auto Enchant: game's Auto switched off for", pet.Name, "(" .. label .. ") -", tostring(stopInfo.Reason), tostring(stopInfo.Enchant or ""))
                if stopInfo.Reason == "Gems" then
                    stopEnchant("Stopped: not enough gems (" .. totalRolls .. " rolls)" .. gemsUsed())
                    window:Notify({ title = "Auto Enchant stopped", content = "Not enough gems.", duration = 6 })
                    return "abort"
                end
                if capHit and stopInfo.Reason ~= "Matched" and not (stopOnDouble and doubled) then
                    return "skip", string.format("stopped after %d rolls: next roll costs %s gems, over your Max Gems Per Roll",
                        stopInfo.Rolls or liveRolls, window.hubEnchantAuto.formatGems(capHit))
                end
                return "stopped", stopInfo, stopInfo.Rolls or liveRolls, doubled
            end

            for index, petId in ipairs(petIds) do
                if not alive() then return end
                if next(activeTargets) == nil then break end -- 3 pets have every target: done
                local pet = getOwnedPets()[petId]
                if not pet then
                    table.insert(results, "a pet that's gone (skipped)")
                    continue
                end
                -- "Unlock Slot 2 First": reroll slot 1 until a Double Enchant opens slot 2. Done with the
                -- game's own Auto switch (switched off the moment slot 2 opens), so you keep hatching.
                local slot2Open = false
                if unlockSlot2 and next(slotTargets[2]) ~= nil and slotCount(pet) < 2 then
                    local cur = cleanEnchant(pet.Enchant)
                    if cur and EnchantConfig and EnchantConfig.IsProtected and EnchantConfig.IsProtected(cur) then
                        table.insert(results, pet.Name .. ": left alone (slot 1 has the rare " .. tostring(cur) .. ", not unlocking slot 2)")
                    else
                        -- the game's Auto needs Filters: your slot 1 targets (or slot 2's if slot 1 has none)
                        local unlockNames = {}
                        for s = 1, 2 do
                            if #unlockNames == 0 then
                                for name in pairs(slotTargets[s]) do
                                    if window.hubEnchantAuto.isFilterable(name) then table.insert(unlockNames, name) end
                                end
                            end
                        end
                        local unlockRolls, runs = 0, 0
                        if #unlockNames > 0 and AutoEventRE and EnchantRF:FindFirstChild("AutoStart") then
                            while alive() and not slot2Open and runs < 50 do
                                runs += 1
                                local status, info, autoRolls, doubled = runGameAuto(index, petId, getOwnedPets()[petId] or pet, 1, unlockNames, true)
                                if status == "abort" then return end
                                if status == "skip" then
                                    table.insert(results, pet.Name .. ": skipped (" .. tostring(info) .. ")")
                                    print("[HustlHub] Auto Enchant: skipped", pet.Name, "-", tostring(info))
                                    break
                                end
                                unlockRolls += autoRolls or 0
                                local fresh = getOwnedPets()[petId]
                                if doubled or (fresh and slotCount(fresh) >= 2) then slot2Open = true end
                                -- (stopped on a slot 1 target before slot 2 opened: switch it on again)
                            end
                        else
                            -- no filterable target at all (only secret enchants): roll by hand
                            local st = {}
                            while alive() and not slot2Open do
                                local status, rolled, res = rollOnce(petId, 1, st)
                                if status == "abort" then return end
                                if status == "skip" then
                                    table.insert(results, pet.Name .. ": skipped (" .. tostring(rolled) .. ")")
                                    break
                                end
                                if status == "rolled" then
                                    unlockRolls += 1
                                    totalRolls += 1
                                    local fresh = getOwnedPets()[petId]
                                    if (type(res) == "table" and res.Double) or (fresh and slotCount(fresh) >= 2) then slot2Open = true end
                                    pcall(function()
                                        enchantStatus:Set(string.format("Pet %d/%d: %s\nUnlocking slot 2: roll %d (%s)%s",
                                            index, #petIds, pet.Name, unlockRolls, tostring(rolled), gemsUsed()))
                                    end)
                                end
                                if not slot2Open then task.wait(0.05) end
                            end
                        end
                        if not alive() then return end
                        if slot2Open then
                            table.insert(results, pet.Name .. ": slot 2 opened after " .. unlockRolls .. " rolls")
                            print("[HustlHub] Auto Enchant: slot 2 opened on", pet.Name, "after", unlockRolls, "rolls")
                            pet = getOwnedPets()[petId] or pet
                        end
                    end
                end
                -- slot 1, then slot 2 (if the pet has one and you picked slot 2 targets)
                for slot = 1, 2 do
                local slotKey = slot == 2 and "Enchant2" or "Enchant"
                local slotSet = slotTargets[slot]
                pet = getOwnedPets()[petId] or pet -- fresh: slot 1's run may have opened slot 2 (Double Enchant)
                if next(slotSet) == nil or (slotCount(pet) < slot and not (slot == 2 and slot2Open)) then continue end
                if slotSet[cleanEnchant(pet[slotKey]) or ""] then
                    table.insert(results, pet.Name .. ": already had " .. tostring(pet[slotKey]) .. " (slot " .. slot .. ")")
                    continue
                end
                local wantsAny = false
                for name in pairs(slotSet) do if activeTargets[name] then wantsAny = true end end
                if not wantsAny then continue end -- every target for this slot has enough pets

                -- roll this slot until it lands a target (or something stops the whole run)
                local rolls = 0
                local requestId -- reused after a connection error, like the game does (no double charge)
                local gotIt = false
                local autoHandled = false

                -- the game's own Auto Enchant: save this slot's targets as its Filters, turn its Auto on
                -- for this pet and let the server do the rolling (you can hatch meanwhile). Targets the
                -- Filters can't hold (secret enchants) are left out; only a slot with nothing but
                -- those is rolled by hand below.
                local autoNames
                if AutoEventRE and EnchantRF:FindFirstChild("AutoStart") and EnchantRF:FindFirstChild("SetFilters") then
                    autoNames = {}
                    local skipped = {}
                    for name in pairs(slotSet) do
                        if activeTargets[name] then
                            if window.hubEnchantAuto.isFilterable(name) then
                                table.insert(autoNames, name)
                            else
                                table.insert(skipped, name)
                            end
                        end
                    end
                    if #skipped > 0 and #autoNames > 0 then
                        print("[HustlHub] Auto Enchant: the game's Filters can't hold", table.concat(skipped, ", "), "- using", table.concat(autoNames, ", "))
                    end
                end
                if autoNames and #autoNames > 0 then
                    autoHandled = true
                    local status, stopInfo, autoRolls = runGameAuto(index, petId, pet, slot, autoNames, false)
                    if status == "abort" then return end
                    if status == "skip" then
                        table.insert(results, pet.Name .. ": skipped (" .. tostring(stopInfo) .. ")")
                        print("[HustlHub] Auto Enchant: skipped", pet.Name, "-", tostring(stopInfo))
                    else
                        rolls = autoRolls
                        local reason, rolled = stopInfo.Reason, stopInfo.Enchant
                        if reason == "Matched" then
                            local family = rolled and slotSet[rolled] and activeTargets[rolled]
                            if family then
                                gotIt = true
                                familyHave[family] += 1
                                capFamily(family)
                                table.insert(results, string.format("%s: %s (%d rolls)", pet.Name, tostring(rolled), rolls))
                                print("[HustlHub] Auto Enchant: got", rolled, "on", pet.Name, "after", rolls, "rolls |", familyStatus())
                                window:Notify({ title = "Auto Enchant", content = string.format("Got %s on %s after %d rolls! (%s)", tostring(rolled), pet.Name, rolls, familyStatus()), duration = 6 })
                            else
                                table.insert(results, string.format("%s: %s (%d rolls)", pet.Name, tostring(rolled), rolls))
                            end
                        elseif reason == "Protected" then
                            table.insert(results, pet.Name .. ": already had " .. tostring(rolled) .. " (slot " .. slot .. ")")
                        else
                            table.insert(results, pet.Name .. ": auto enchant stopped (" .. tostring(reason) .. ")")
                        end
                    end
                end

                while alive() and not gotIt and not autoHandled do
                    -- Max Gems Per Roll: stop on this pet once its next roll is too expensive
                    local over, price = window.hubEnchantAuto.overCap(getOwnedPets()[petId] or pet)
                    if over then
                        local msg = string.format("next roll costs %s gems, over your Max Gems Per Roll", window.hubEnchantAuto.formatGems(price))
                        table.insert(results, pet.Name .. ": skipped after " .. rolls .. " rolls (" .. msg .. ")")
                        print("[HustlHub] Auto Enchant: skipped", pet.Name, "-", msg)
                        break
                    end
                    requestId = requestId or HttpService:GenerateGUID(false)
                    local ok, result = pcall(function()
                        return safeInvoke(EnchantRF.Enchant, { ["PetId"] = petId, ["Slot"] = slot, ["RequestId"] = requestId })
                    end)
                    if not ok or type(result) ~= "table" then
                        task.wait(0.5) -- connection hiccup: try again with the same request id
                    elseif not result.Success then
                        requestId = nil
                        local reason = tostring(result.Reason)
                        if reason == "RateLimited" then
                            task.wait(0.3)
                        elseif reason == "VisitEnchantMachine" then
                            farFails += 1
                            if farFails > 3 or not goToEnchantMachine() then
                                stopEnchant("Stopped: stand at the Enchant machine")
                                window:Notify({ title = "Auto Enchant", content = "Stand at the Enchant machine, then turn it on again.", duration = 6 })
                                return
                            end
                        elseif reason == "ChoosePendingEnchant" or reason == "EnchantPending" or reason == "ConfirmReplace" then
                            -- an unfinished roll from before: finish it (keeps the newest), then carry on
                            pcall(function()
                                local state = safeInvoke(EnchantRF.GetState)
                                local pending = type(state) == "table" and state.Enchanting and state.Enchanting.Pending
                                if pending and pending.Token then safeInvoke(EnchantRF.Resolve, { ["Token"] = pending.Token, ["UseNew"] = true }) end
                            end)
                            task.wait(0.3)
                        elseif reason == "AutoRunning" then
                            pcall(function() safeInvoke(EnchantRF.AutoStop) end) -- the game's own auto enchant
                            task.wait(0.3)
                        elseif reason == "ClaimFirst" then
                            window.hubEnchantAuto.claimHeldPet() -- a pet the game's auto enchant left in the enchanter
                            task.wait(0.3)
                        elseif reason == "InsufficientGems" then
                            stopEnchant("Stopped: not enough gems (" .. totalRolls .. " rolls)" .. gemsUsed())
                            window:Notify({ title = "Auto Enchant stopped", content = "Not enough gems.", duration = 6 })
                            print("[HustlHub] Auto Enchant stopped: out of gems after", totalRolls, "rolls")
                            return
                        else
                            -- a problem with this pet only (gone, frozen, traded, no slot 2): next pet
                            local msg = ({ Frozen = "unavailable", UnknownPet = "gone", InvalidSlot = "no slot 2",
                                Reserved = "being traded" })[reason] or reason
                            table.insert(results, pet.Name .. ": skipped (" .. msg .. ")")
                            print("[HustlHub] Auto Enchant: skipped", pet.Name, "-", reason)
                            break
                        end
                    else
                        requestId = nil
                        local pending = result.Pending or {}
                        local rolled = pending.Enchant
                        rolls += 1
                        totalRolls += 1
                        -- put the roll on (same as the game's button), then check it
                        if pending.Token then
                            pcall(function() safeInvoke(EnchantRF.Resolve, { ["Token"] = pending.Token, ["UseNew"] = true }) end)
                        end
                        pcall(function()
                            enchantStatus:Set(string.format("Pet %d/%d: %s (slot %d)\nRoll %d: %s%s\nHave: %s",
                                index, #petIds, pet.Name, slot, rolls, tostring(rolled), gemsUsed(), familyStatus()))
                        end)
                        local family = rolled and slotSet[rolled] and activeTargets[rolled]
                        if family then
                            gotIt = true
                            familyHave[family] += 1
                            capFamily(family) -- 3 of this family now: stop collecting it
                            table.insert(results, string.format("%s: %s (%d rolls)", pet.Name, rolled, rolls))
                            print("[HustlHub] Auto Enchant: got", rolled, "on", pet.Name, "after", rolls, "rolls |", familyStatus())
                            window:Notify({ title = "Auto Enchant", content = string.format("Got %s on %s after %d rolls! (%s)", rolled, pet.Name, rolls, familyStatus()), duration = 6 })
                        end
                    end
                    if not gotIt then task.wait(0.05) end
                end
                end -- (each slot)
            end

            if not alive() then return end
            local summary = "Done | Have: " .. familyStatus() .. gemsUsed() .. "\n" .. table.concat(results, "\n")
            print("[HustlHub] Auto Enchant finished:", familyStatus(), "|", table.concat(results, " | "))
            window:Notify({ title = "Auto Enchant", content = "Went through all picked pets (" .. familyStatus() .. ").", duration = 6 })
            stopEnchant(summary)
            pcall(function() petEnchantDropdown:Refresh(petOptions()) end)
        end)
    end,
})
window.hubEnchantGoTo = goToEnchantMachine -- (Enchant Mastery, in the Enchanting tab, uses it)

-- one Auto Enchant run for given pets and ONE target enchant (both slots), then your own picks and Filters come back
function window.hubEnchantAuto.runFor(petIds, targetName, onDone)
    if enchantRunning then return false, "Auto Enchant is already running" end
    local prev1, prev2 = slotTargets[1], slotTargets[2]
    slotTargets[1], slotTargets[2] = { [targetName] = true }, { [targetName] = true }
    window.hubEnchantAuto.overridePets = petIds
    enchantToggle:Set(true)
    task.spawn(function()
        task.wait(2)
        while enchantRunning do task.wait(1) end
        slotTargets[1], slotTargets[2] = prev1, prev2
        window.hubEnchantAuto.overridePets = nil
        pcall(window.hubEnchantAuto.syncFilters)
        if onDone then pcall(onDone) end
    end)
    return true
end

