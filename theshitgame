			Font = lib.font,
			TextSize = lib.fontsize - 1,
			Parent = row,
		})
		corner(btn, 4)
		local btnStroke = stroke(btn, library.options.accent)
		btnStroke.Transparency = 0.55
		local function tint(a)
			return a:Lerp(Color3.fromRGB(20, 20, 20), 0.72)
		end
		local function base() return tint(library.options.accent) end
		btn.BackgroundColor3 = base()
		btn.Font = lib.titlefont
		bindAccent(btn, "BackgroundColor3", base)
		bindAccent(btnStroke, "Color", function() return library.options.accent end)
		btn.MouseEnter:Connect(function()
			tween(btn, {BackgroundColor3 = base():Lerp(WHITE, 0.14)}, 0.1)
			tween(btnStroke, {Transparency = 0.2}, 0.1)
		end)
		btn.MouseLeave:Connect(function()
			tween(btn, {BackgroundColor3 = base()}, 0.1)
			tween(btnStroke, {Transparency = 0.55}, 0.1)
		end)

		local function fire()
			tween(btnStroke, {Transparency = 0}, 0.05)
			task.delay(0.15, function()
				if btnStroke.Parent then
					tween(btnStroke, {Transparency = 0.55}, 0.2)
				end
			end)

			if o.callback then
				task.spawn(o.callback)
			end
		end

		btn.MouseButton1Click:Connect(fire)
		rowHit(row).MouseButton1Click:Connect(fire)
		btn.ZIndex = 3

		return {Fire = fire}
	end

	function Tab:CreateInput(o)
