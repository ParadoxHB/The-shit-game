    end)

    -- storage full (from the hub's own messages)
    window.onNotify = function(info)
        local text = string.lower(tostring(info.title or "") .. " " .. tostring(info.content or ""))
        if text:find("storage") and text:find("full") then
            window.hubAlert("storage", "Storage full", "**Account:** " .. LocalPlayer.Name .. "\n" .. tostring(info.content or info.title))
        end
    end

    -- storage full: checked straight from your data. (Auto Hatch just waits quietly when storage is full, so the
    -- hub never shows a message for it.) One alert when it fills up, a reminder every 20 minutes while it stays full.
    task.spawn(function()
        local fullSince, lastSent = nil, 0
        while hook.alive do
            task.wait(5)
            if hook.alerts.storage then
                local count, limit = 0, math.huge
                pcall(function()
                    local d = getReplica().Data
                    for _ in pairs(d.Pets.Owned) do count = count + 1 end
                    limit = tonumber(d.Pets.StorageLimit) or math.huge
                end)
                if count >= limit then
                    if not fullSince or os.clock() - lastSent > 1200 then
                        fullSince = fullSince or os.clock()
                        lastSent = os.clock()
                        window.hubAlert("storage", "Storage full",
                            "**Account:** " .. LocalPlayer.Name .. "\n**Pets:** " .. count .. "/" .. limit .. " (hatching waits until you free space)")
                        print("[HustlHub] Webhook: storage full alert for " .. LocalPlayer.Name .. " (" .. count .. "/" .. limit .. ")")
                    end
                elseif count < limit - 20 then
                    fullSince = nil
                end
            end
        end
    end)

    -- puts the file's info on the switches and boxes WITHOUT running their callbacks (they run on their own
    -- thread, so a callback would save the file again and fight the other accounts)
    local function applyInfo(info)
        if type(info.url) == "string" and info.url ~= hook.url then
            hook.url = info.url
            urlInput:Set(info.url, true)
        end
        if type(info.discordId) == "string" and cleanId(info.discordId) ~= hook.discordId then
            hook.discordId = cleanId(info.discordId)
            idInput:Set(hook.discordId, true)
        end
        local alerts = type(info.alerts) == "table" and info.alerts or {}
        for key, tog in pairs(alertToggles) do
            local want = alerts[key] == true
            hook.alerts[key] = want or nil
            if tog.value ~= want then tog:Set(want, true) end
        end
        local wantOn = info.enabled == true
        if wantOn and not enabled and validUrl(hook.url) then task.spawn(setWebhookIcon) end
        enabled = wantOn
        if webhookToggle.value ~= wantOn then webhookToggle:Set(wantOn, true) end
    end

    -- after the startup reset of the switches has run: load the saved info, then keep following the file
    task.spawn(function()
        task.wait(6)
        if not hook.alive then return end
        local info = readInfo()
        fileRev = tonumber(info.rev) or 0
        pcall(applyInfo, info)
        restored = true
        while hook.alive do
            task.wait(2)
            local latest = readInfo()
            local rev = tonumber(latest.rev) or 0
            if rev > fileRev then
                fileRev = rev
                local ok, err = pcall(applyInfo, latest)
                if ok then
                    print("[HustlHub] Webhook: settings updated from " .. tostring(latest.from or "another account")
                        .. " (secret alerts " .. (enabled and "on" or "off") .. ")")
                else
                    warn("[HustlHub] Webhook: couldn't apply the shared settings (" .. tostring(err) .. ")")
                end
            end
        end
    end)

    -- A pet keeps a record of where it came from (pet._uq: MintReason, OwnerCount, OwnerLog = every owner).
    -- A Secret that another player / account traded to you has more than one owner, so it is not announced as a hatch.
    local function cameFromTrade(pet)
        local uq = type(pet) == "table" and pet._uq
        if type(uq) ~= "table" then return false end
        if tostring(uq.MintReason or ""):lower():find("trade") then return true end
        if (tonumber(uq.OwnerCount) or 1) > 1 then return true end
        if type(uq.OwnerLog) == "table" then
            for _, entry in pairs(uq.OwnerLog) do
                if type(entry) == "table" and entry.UserId and entry.UserId ~= LocalPlayer.UserId then return true end
            end
        end
        return false
    end

    -- watch your pets: any Secret that wasn't there before is announced (works for every way of getting one,
    -- except a pet you received in a trade)
    task.spawn(function()
        local known
        local queue = {}
        while hook.alive do
            task.wait(1.5)
            if enabled and validUrl(hook.url) then
                local okPets, owned = pcall(getOwnedPets)
                if okPets and type(owned) == "table" and next(owned) ~= nil then
                    if not known then
                        known = {}
                        for id in pairs(owned) do known[id] = true end
                    else
                        for id, pet in pairs(owned) do
                            if not known[id] then
                                known[id] = true
                                if type(pet) == "table" and petRarity(pet):find("Secret") then
                                    if cameFromTrade(pet) then
                                        print("[HustlHub] Webhook: secret " .. tostring(pet.Name) .. " arrived by trade, not announced")
                                    else
                                        table.insert(queue, pet)
                                    end
                                end
                            end
                        end
                    end
                end
                while #queue > 0 do
                    local pet = table.remove(queue, 1)
                    local ok, err = send(buildPayload(pet, false))
                    print("[HustlHub] Webhook: secret " .. tostring(pet.Name) .. (ok and " sent" or (" failed: " .. tostring(err))))
                    task.wait(1.2)
                end
            else
                known = nil -- start fresh when turned on, so old pets are never announced
                table.clear(queue)
            end
        end
    end)
end

---------------------------------------------------------------- Auto Rebirth (Main tab), back by request (v1.4.36)
-- The game's rebirth buttons (RebirthButtonConfig: how many you've unlocked, per world) cost
-- RebirthConfig.GetPrice(GetAmountFromIndex(i), your rebirths) coins; buying one is
-- RebirthService.RE.RebirthRequested { Index = i }. Checked live: Main world, 16 buttons (x1 ... x30.5B).
do
    local mainTab = window.tabByName["Main"]
    local RebirthCfg, RebirthButtons
    pcall(function() RebirthCfg = require(ReplicatedStorage.Shared.Progression.RebirthConfig) end)
    pcall(function()
        for _, m in ipairs(ReplicatedStorage:GetDescendants()) do
            if m:IsA("ModuleScript") and m.Name == "RebirthButtonConfig" then RebirthButtons = require(m) break end
        end
    end)
    local rebirthRE
    pcall(function() rebirthRE = Remotes.RebirthService.RE.RebirthRequested end)
    if mainTab and RebirthCfg and rebirthRE then
        local BEST = "Best (auto)"
        local R = { on = false, run = 0, pick = BEST, labelIndex = {}, income = 0 }
        connections.hubAutoRebirth = { Disconnect = function() R.on = false end }

        local function data() local rep = getReplica() return rep and rep.Data end
        local function coins(d) return tonumber(d.Currencies and d.Currencies.Coins) or 0 end
        local function buttonCount(d)
            local n = 1
            pcall(function()
                local world = d.Progression.World or "Main"
                n = RebirthButtons.GetOptionCount(RebirthButtons.GetUnlockedCount(d.Upgrades.RebirthButtons or 0, world), world)
            end)
            return math.max(n, 1)
        end
        local function price(d, index)
            local ok, p = pcall(RebirthCfg.GetPrice, RebirthCfg.GetAmountFromIndex(index), d.Statistics.Rebirths or 0)
            return ok and tonumber(p) or math.huge
        end
        local function short(n)
            n = tonumber(n) or 0
            for _, u in ipairs({ { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }) do
                if n >= u[1] then return (string.format("%.1f", n / u[1]):gsub("%.0$", "")) .. u[2] end
            end
            return tostring(math.floor(n))
        end
        local function options()
            local list = { BEST }
            table.clear(R.labelIndex)
            local d = data()
            if d then
                for i = 1, buttonCount(d) do
                    local label = "x" .. short(RebirthCfg.GetAmountFromIndex(i)) .. " Rebirths"
                    R.labelIndex[label] = i
                    table.insert(list, label)
                end
            end
            return list
        end

        mainTab:CreateSection({ name = "Rebirth" })
        local dropdown
        dropdown = mainTab:CreateDropdown({
            name = "Rebirth Button",
            description = "The biggest rebirth button Auto Rebirth may use. \"Best (auto)\" = no limit: it buys the biggest one you can afford (most rebirths per coin). A picked button is the limit: it buys that one when you can afford it, otherwise the biggest one below it you can. Both wait a few seconds if the next bigger one is almost affordable.",
            options = options(),
            value = { BEST },
            onOpen = function() dropdown:Refresh(options()) end,
            callback = function(selected) R.pick = firstOption(selected) or BEST end,
        })
        mainTab:CreateToggle({
            name = "Auto Rebirth",
            description = "Rebirths every 1.5 seconds whenever you can afford the picked button. Works without the game's Auto Rebirth gamepass. Rebirthing resets your coins, so expensive eggs may wait for coins. Pauses while Auto Progress runs (it rebirths by itself).",
            callback = function(value)
                R.on = false
                R.run += 1
                if not value then
                    -- stop owning the team: Equip Best Pets / the hatch code go back to their own pick
                    window.hubTeamSwapActive = nil
                    if R.swapOwnsMode then window.hubEquipBestMode = R.prevMode R.swapOwnsMode = false end
                    pcall(function() if R.teamStatus then R.teamStatus:Set("Off") end end)
                    return
                end
                R.on = true
                R.teamNow = nil
                local myRun = R.run
                task.spawn(function()
                    local lastCoins, lastAt
                    while R.on and R.run == myRun and getgenv().HustlHubRun == HH_RUN do
                        pcall(function()
                            local d = data()
                            if not d then return end
                            local now, c = os.clock(), coins(d)
                            if lastCoins and c >= lastCoins and now > lastAt then
                                R.income = R.income * 0.7 + ((c - lastCoins) / (now - lastAt)) * 0.3 -- (coins per second)
                            end
                            lastCoins, lastAt = c, now
                            if window.hubBusy["Auto Progress"] and window.hubBusy["Auto Progress"]() then return end
                            -- Swap Teams For Rebirth: a Clicks (coins) team while you save up for the button, a Gems team just
                            -- for the rebirth itself, then back to the Clicks team. Secrets are kept off the team.
                            if R.swap and window.hubEquipBestNoSecrets then
                                window.hubTeamSwapActive = true -- (Equip Best Pets stands aside while this runs)
                                if not R.swapOwnsMode then R.prevMode = window.hubEquipBestMode R.swapOwnsMode = true end
                                local target = R.labelIndex[R.pick] or buttonCount(d) -- (Best (auto): the biggest button you have)
                                local cost = price(d, target)
                                local function applyTeam(mode)
                                    if R.teamNow == mode then return end
                                    R.teamNow = mode
                                    window.hubEquipBestMode = mode -- (the hatch code equips this one too, not its own Clicks)
                                    window.hubEquipBestNoSecrets(mode)
                                end
                                local function showTeam(text)
                                    if R.teamText ~= text then
                                        R.teamText = text
                                        pcall(function() if R.teamStatus then R.teamStatus:Set(text) end end)
                                    end
                                end
                                if c >= cost then
                                    showTeam("Gems team: rebirthing with x" .. short(RebirthCfg.GetAmountFromIndex(target)) .. " Rebirths")
                                    applyTeam("Gems")
                                    task.wait(1)
                                    d = data() or d
                                    if coins(d) >= price(d, target) then
                                        rebirthRE:FireServer({ ["Index"] = target })
                                        print("[HustlHub] Auto Rebirth: rebirthed with button " .. target .. " on the Gems team")
                                        lastCoins = nil
                                        task.wait(1.5)
                                    end
                                    applyTeam("Clicks") -- back to earning coins
                                else
                                    applyTeam("Clicks")
                                    showTeam("Clicks team: " .. short(c) .. " / " .. short(cost) .. " coins for x" .. short(RebirthCfg.GetAmountFromIndex(target)) .. " Rebirths")
                                end
                                return
                            end
                            local index
                            local chosen = R.labelIndex[R.pick]
                            if chosen then
                                -- (v1.4.55) the picked button is the BIGGEST one to use, not the only one: it used to wait for
                                -- exactly that button, and with "x6.1B" synced to every account none could ever afford it, so
                                -- nothing rebirthed. Now: the picked button when you can afford it, otherwise the biggest one
                                -- below it that you can (and like Best, wait a few seconds if the next one up is nearly there)
                                local top = math.min(chosen, buttonCount(d))
                                for i = top, 1, -1 do
                                    if price(d, i) <= c then index = i break end
                                end
                                if index and index < top and R.income > 0 and (price(d, index + 1) - c) / R.income < 15 then index = nil end
                            else
                                local count = buttonCount(d)
                                for i = count, 1, -1 do
                                    if price(d, i) <= c then index = i break end
                                end
                                -- the next button up is only a few seconds of earning away: worth waiting for (5x the rebirths)
                                if index and index < count and R.income > 0 and (price(d, index + 1) - c) / R.income < 15 then index = nil end
                            end
                            if index then
                                rebirthRE:FireServer({ ["Index"] = index })
                                print("[HustlHub] Auto Rebirth: rebirthed with button " .. index)
                                lastCoins = nil -- (coins just reset: don't count that as income)
                            end
                        end)
                        task.wait(1.5)
                    end
                end)
            end,
        })
        mainTab:CreateToggle({
            name = "Swap Teams For Rebirth",
            description = "Needs Auto Rebirth on. Saves up on a Clicks (coins) team until you can afford the picked Rebirth Button, switches to a Gems team just for the rebirth (so the rebirth gives more gems), then goes back to the Clicks team. Uses the game's own Equip Best for each team and never puts Secret pets on the team. With \"Best (auto)\" the target is your biggest button. Off by default.",
            callback = function(value)
                R.swap = value
                R.teamNow = nil
                if not value then
                    window.hubTeamSwapActive = nil
                    if R.swapOwnsMode then window.hubEquipBestMode = R.prevMode R.swapOwnsMode = false end
                    pcall(function() if R.teamStatus then R.teamStatus:Set(R.on and "Swap off" or "Off") end end)
                    R.teamText = nil
                end
            end,
        })
        R.teamStatus = mainTab:CreateText({ name = "Rebirth Team Status", text = "Off" })
    end
end

---------------------------------------------------------------- Mastery Levels (Mastery tab): every mastery in your save
do -- own scope (keeps the top level under Luau's 200-local limit)
    local masteryTab = window.tabByName["Mastery"]
    if masteryTab then
        masteryTab:CreateSection({ name = "Mastery Levels" })
        local view = masteryTab:CreateText({ name = "All Masteries", text = "Loading...", textSize = 11 })
        local alive = true
        connections.hubMasteryLevels = { Disconnect = function() alive = false end }

        local function num(v)
            v = tonumber(v) or 0
            if v >= 1e15 then return string.format("%.3g", v) end
            local s = tostring(math.floor(v))
            local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
            return (out:gsub("^,", ""))
        end

        local function pick(t, names)
            for _, n in ipairs(names) do
                if t[n] ~= nil then return t[n] end
            end
            return nil
        end

        -- one entry: a number, or a table with a level (and maybe xp), or a nested group
        local function describe(name, v, depth)
            if type(v) == "number" then
                return tostring(name) .. ": " .. num(v)
            elseif type(v) == "table" then
                local lvl = pick(v, { "Level", "level", "Lvl", "Rank", "Tier" })
                local xp = pick(v, { "XP", "Xp", "xp", "Exp", "Progress", "Points" })
                if type(lvl) == "number" then
                    return tostring(name) .. ": Lv " .. num(lvl) .. (type(xp) == "number" and (" (" .. num(xp) .. " xp)") or "")
                end
                if depth >= 3 then return nil end
                local keys = {}
                for k in pairs(v) do table.insert(keys, k) end
                table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
                local parts = {}
                for _, k in ipairs(keys) do
                    local d = describe(k, v[k], depth + 1)
                    if d then table.insert(parts, d) end
                end
                if #parts == 0 then return nil end
                return tostring(name) .. " - " .. table.concat(parts, "; ")
            elseif type(v) == "string" or type(v) == "boolean" then
                return tostring(name) .. ": " .. tostring(v)
            end
            return nil
        end

        -- every table in your data stored under a key with "mastery" in its name
        local SKIP = { Pets = true, Inventory = true, Quests = true }
        local function collect(tbl, path, out, depth, seen)
            if depth > 4 or seen[tbl] then return end
            seen[tbl] = true
            for k, v in pairs(tbl) do
                if type(k) == "string" and type(v) == "table" then
                    if k:lower():find("mastery") or k:lower():find("masteries") then
                        table.insert(out, { path = path .. k, value = v })
                    elseif not SKIP[k] then
                        collect(v, path .. k .. ".", out, depth + 1, seen)
                    end
                end
            end
        end

        local printedKeys = false
        local dumped = false

        -- The game's own mastery module knows how much xp each level needs. Its function names aren't known
        -- here, so every xp-looking function is tried and the one whose answers fit your real numbers is kept.
        local mods = {}
        local needFn -- function(category, level) -> xp needed for the next level, once found
        local discovered = false
        local function discover()
            discovered = true
            for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
                if d:IsA("ModuleScript") and d.Name:lower():find("mastery") then
                    local ok, m = pcall(require, d)
                    if ok and type(m) == "table" then table.insert(mods, { name = d:GetFullName(), mod = m }) end
                end
            end
        end

        local function candidates()
            local list = {}
            for _, entry in ipairs(mods) do
                for key, fn in pairs(entry.mod) do
                    if type(key) == "string" and type(fn) == "function" then
                        local l = key:lower()
                        if (l:find("xp") or l:find("exp")) and (l:find("need") or l:find("req") or l:find("next") or l:find("to") or l:find("for") or l:find("cost") or l:find("thresh")) then
                            table.insert(list, { name = entry.name .. "." .. key, fn = fn, mod = entry.mod })
                        end
                    end
                end
            end
            return list
        end

        -- try every candidate and call style; keep the first that gives a sensible answer for all your masteries
        local function findNeedFn(samples)
            local styles = {
                function(c, cat, lvl) return c.fn(cat, lvl) end,
                function(c, cat, lvl) return c.fn(cat, lvl + 1) end,
                function(c, cat, lvl) return c.fn(lvl) end,
                function(c, cat, lvl) return c.fn(lvl + 1) end,
                function(c, cat, lvl) return c.fn(lvl, cat) end,
                function(c, cat, lvl) return c.fn(c.mod, cat, lvl) end,
                function(c, cat, lvl) return c.fn(c.mod, lvl) end,
                function(c, cat, lvl) return c.fn(c.mod, cat, lvl + 1) end,
                function(c, cat, lvl) return c.fn(c.mod.Categories[cat], lvl) end,
                function(c, cat, lvl) return c.fn(c.mod.Categories[cat], lvl + 1) end,
                function(c, cat, lvl) return c.fn(lvl, c.mod.Categories[cat]) end,
                function(c, cat, lvl) return c.fn(cat, lvl, 1) end,
                function(c, cat, lvl) return c.fn(lvl - 1) end,
                function(c, cat, lvl) return c.fn(cat, lvl - 1) end,
            }
            for _, c in ipairs(candidates()) do
                for si, style in ipairs(styles) do
                    local fits = #samples > 0
                    for _, s in ipairs(samples) do
                        local ok, v = pcall(style, c, s.cat, s.lvl)
                        if not (ok and type(v) == "number" and v >= s.xp and v > 0 and v < 1e15) then fits = false break end
                    end
                    if fits then
                        print("[HustlHub] Mastery Levels: xp-needed function found: " .. c.name .. " (style " .. si .. ")")
                        return function(cat, lvl)
                            local ok, v = pcall(style, c, cat, lvl)
                            if ok and type(v) == "number" then return v end
                            return nil
                        end
                    end
                end
            end
            return nil
        end

        local function shortXP(n)
            for _, u in ipairs({ { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }) do
                if n >= u[1] then return string.format("%.3g", n / u[1]) .. u[2] end
            end
            return tostring(math.floor(n))
        end
        local lastSeen, gainedTotal, rateSamples = {}, {}, {}
        local function fmtDuration(sec)
            sec = math.floor(sec)
            if sec >= 86400 then return string.format("%dd %dh", sec // 86400, (sec % 86400) // 3600) end
            if sec >= 3600 then return string.format("%dh %dm", sec // 3600, (sec % 3600) // 60) end
            if sec >= 60 then return string.format("%dm %ds", sec // 60, sec % 60) end
            return sec .. "s"
        end
        -- remembers how much xp each mastery gained since the script started, to work out how fast it climbs
        local function track(cat, lvl, xp)
            local last = lastSeen[cat]
            if last then
                local d = 0
                if lvl == last.lvl then
                    d = math.max(xp - last.xp, 0)
                elseif lvl > last.lvl then
                    if needFn then
                        d = math.max((needFn(cat, last.lvl) or 0) - last.xp, 0) + xp
                        for l = last.lvl + 1, math.min(lvl - 1, last.lvl + 5) do d = d + (needFn(cat, l) or 0) end
                    else
                        d = xp
                    end
                end
                gainedTotal[cat] = (gainedTotal[cat] or 0) + d
            end
            lastSeen[cat] = { lvl = lvl, xp = xp }
            local list = rateSamples[cat] or {}
            rateSamples[cat] = list
            local now = os.clock()
            table.insert(list, { t = now, total = gainedTotal[cat] or 0 })
            while #list > 2 and now - list[1].t > 300 do table.remove(list, 1) end
        end
        local function rateOf(cat)
            local list = rateSamples[cat]
            if not list or #list < 2 then return nil end
            local a, b = list[1], list[#list]
            local span = b.t - a.t
            if span < 15 then return nil end
            return (b.total - a.total) / span
        end
        local triedFind = 0
        local reported = false
        local function render()
            local replica = getReplica()
            local data = replica and replica.Data
            if type(data) ~= "table" then return "Waiting for your data" end
            local found = {}
            collect(data, "", found, 0, {})
            table.sort(found, function(a, b) return a.path < b.path end)
            if #found == 0 then
                local keys = {}
                for k in pairs(data) do table.insert(keys, tostring(k)) end
                table.sort(keys)
                if not printedKeys then
                    printedKeys = true
                    print("[HustlHub] Mastery Levels: no mastery table in your data. Top level keys: " .. table.concat(keys, ", "))
                end
                return "No mastery data found in your save (the game may store it under another name). Data keys are in the console."
            end
            -- every mastery entry in your save (relics are not masteries)
            local entries = {}
            for _, root in ipairs(found) do
                for k, v in pairs(root.value) do
                    if k == "Categories" and type(v) == "table" then
                        -- the game keeps each mastery (Clicking, Hatching, ...) inside "Categories"
                        for ck, cv in pairs(v) do entries[tostring(ck)] = cv end
                    elseif not tostring(k):lower():find("relic") then
                        entries[tostring(k)] = v
                    end
                end
            end

            local function levelText(v, cat)
                if type(v) == "table" then
                    local lvl = pick(v, { "Level", "level", "Lvl", "Rank", "Tier" })
                    local xp = pick(v, { "XP", "Xp", "xp", "Exp", "Progress", "Points" })
                    if type(lvl) == "number" then
                        if lvl >= 100 then
                            return "Lv " .. num(lvl) .. " (Max)"
                        end
                        local text = "Lv " .. num(lvl) .. (type(xp) == "number" and (" (" .. num(xp) .. " XP)") or "")
                        if type(xp) == "number" then
                            pcall(track, cat, lvl, xp)
                        end
                        if needFn and type(xp) == "number" then
                            local need = needFn(cat, lvl)
                            if need and need > xp then
                                text = text .. "   " .. shortXP(need - xp) .. " XP Left till " .. num(lvl + 1) .. " Level"
                                local rate = rateOf(cat)
                                if rate and rate > 0 then
                                    text = text .. "   ETA " .. fmtDuration((need - xp) / rate)
                                else
                                    text = text .. "   ETA --"
                                end
                            end
                        end
                        return text
                    end
                    local d = describe("", v, 2)
                    return d and d:gsub("^: ", "") or "-"
                elseif type(v) == "number" then
                    return num(v)
                end
                return tostring(v)
            end

            if not needFn and triedFind < 6 then
                triedFind += 1
                if not discovered then discover() end
                local samples = {}
                for k, v in pairs(entries) do
                    if type(v) == "table" then
                        local lvl = pick(v, { "Level", "level", "Lvl", "Rank", "Tier" })
                        local xp = pick(v, { "XP", "Xp", "xp", "Exp", "Progress", "Points" })
                        if type(lvl) == "number" and type(xp) == "number" and lvl < 100 then
                            table.insert(samples, { cat = k, lvl = lvl, xp = xp })
                        end
                    end
                end
                -- the game's MasteryConfig: each mastery has XPBase and XPExponent, and the xp a level needs is
                -- XPBase * level ^ XPExponent (e.g. Enchanting: 2000 * 62 = 124,000 at level 62)
                local cfg
                for _, entry in ipairs(mods) do
                    if type(entry.mod.Categories) == "table" and type(entry.mod.GetExpRequired) == "function" then
                        cfg = entry.mod
                        break
                    end
                end
                if cfg then
                    needFn = function(cat, lvl)
                        local c = cfg.Categories[cat]
                        if type(c) ~= "table" then return nil end
                        local base, exp = tonumber(c.XPBase), tonumber(c.XPExponent) or 1
                        if not base then return nil end
                        local formula = base * lvl ^ exp
                        -- prefer the game's own function when it agrees with the formula
                        local ok, v = pcall(cfg.GetExpRequired, lvl, base, exp)
                        if ok and type(v) == "number" and math.abs(v - formula) <= formula * 0.01 + 1 then return v end
                        return formula
                    end
                else
                    needFn = findNeedFn(samples)
                end
                if not needFn and triedFind >= 6 and not reported then
                    reported = true
                    local names = {}
                    for _, entry in ipairs(mods) do
                        local keys = {}
                        for key, val in pairs(entry.mod) do table.insert(keys, key .. ":" .. type(val)) end
                        table.insert(names, entry.name .. " {" .. table.concat(keys, ", ") .. "}")
                    end
                    for _, entry in ipairs(mods) do
                        if entry.name:find("MasteryConfig") then
                            local cats = {}
                            for ck, cv in pairs(entry.mod.Categories or {}) do
                                local inner = {}
                                if type(cv) == "table" then
                                    for ik, iv in pairs(cv) do table.insert(inner, tostring(ik) .. "=" .. (type(iv) == "table" and "table" or tostring(iv))) end
                                end
                                table.insert(cats, tostring(ck) .. "{" .. table.concat(inner, ",") .. "}")
                            end
                            print("[HustlHub] Mastery Levels: MasteryConfig MaxLevel=" .. tostring(entry.mod.MaxLevel) .. " Categories: " .. table.concat(cats, " | "))
                            local probes = {}
                            for _, args in ipairs({ { 1 }, { 61 }, { 62 }, { "Enchanting", 61 }, { "Enchanting", 62 }, { entry.mod, 61 }, { entry.mod, "Enchanting", 61 } }) do
                                local ok, v = pcall(entry.mod.GetExpRequired, table.unpack(args))
                                local shown = {}
                                for _, a in ipairs(args) do shown[#shown + 1] = type(a) == "table" and "self" or tostring(a) end
                                table.insert(probes, "(" .. table.concat(shown, ",") .. ")=" .. (ok and tostring(v) or ("error: " .. tostring(v))))
                            end
                            print("[HustlHub] Mastery Levels: GetExpRequired probes: " .. table.concat(probes, " | "))
                        end
                    end
                    print("[HustlHub] Mastery Levels: couldn't find the xp-needed function. Mastery modules: " .. (#names > 0 and table.concat(names, " | ") or "none found"))
                end
            end

            -- the five masteries, always listed (the game only stores one once you have started it)
            local CATS = {
                { "Hatching", function(l) return l:find("hatch") and not l:find("secret") end },
                { "Secret Hatching", function(l) return l:find("secret") end },
                { "Clicking", function(l) return l:find("click") end },
                { "Golden", function(l) return l:find("gold") end },
                { "Enchanting", function(l) return l:find("enchant") end },
            }
            local lines, used = {}, {}
            for _, cat in ipairs(CATS) do
                local foundKey
                for k in pairs(entries) do
                    if not used[k] and cat[2](k:lower()) then foundKey = k break end
                end
                table.insert(lines, cat[1])
                if foundKey then
                    used[foundKey] = true
                    table.insert(lines, "    " .. levelText(entries[foundKey], foundKey))
                else
                    table.insert(lines, "    Lv 0 (not started)")
                end
            end
            -- anything else the game stores
            local extra = {}
            for k in pairs(entries) do
                if not used[k] then table.insert(extra, k) end
            end
            table.sort(extra)
            for _, k in ipairs(extra) do
                table.insert(lines, (k:gsub("(%l)(%u)", "%1 %2")))
                table.insert(lines, "    " .. levelText(entries[k], k))
            end
            if not dumped then
                dumped = true
                local raw = {}
                for _, root in ipairs(found) do
                    for k, v in pairs(root.value) do
                        table.insert(raw, root.path .. "." .. tostring(k) .. " = " .. (type(v) == "table" and "table" or tostring(v)))
                    end
                end
                print("[HustlHub] Mastery Levels: raw mastery data -> " .. table.concat(raw, " | "))
            end
            return table.concat(lines, "\n")
        end

        task.spawn(function()
            task.wait(3)
            local last
            while alive do
                local ok, text = pcall(render)
                text = ok and text or ("Couldn't read mastery data: " .. tostring(text))
                window.hubMasteryTextValue = text
                if text ~= last then -- only touch the label when a number actually moved
                    last = text
                    pcall(function() view:Set(text) end)
                end
                task.wait(1)
            end
        end)
    end
end

---------------------------------------------------------------- Title bar: what the hub is doing right now + next Pet Defense
-- The title bar shows what this account is doing at this moment (the activity checker), e.g.
-- "Hatching Draconic", "Hallow Boss fight", "Hatching Void - waiting: Not enough coins", or
-- "Auto Hatch is ON but not hatching: That egg's island is locked". Every change is recorded with
-- the time: in the log ("[HustlHub] Activity: ...") and in the Misc tab's "Activity Log" card, so
-- you can see what was going on when something didn't happen.
do -- own scope (keeps the top level under Luau's 200-local limit)
    local bar = window.root:FindFirstChild("TitleBar")
    local titleLabel = bar and bar:FindFirstChild("Title")
    local TRIPS = { -- tripOwner -> what that feature is doing
        defense = "Pet Defense", hallowBoss = "Hallow Boss fight", trickOrTreat = "Trick or Treat",
        candyWitch = "Candy Witch jobs", hatchCraft = "Crafting (storage full)", hatchReturn = "Going back to the egg",
        chests = "Collecting chests", islands = "Island breakables", dig = "Digging", quests = "Quests",
        bouncy = "Bouncy Ball course", memoryMatch = "Memory Match", mine = "Mining", shrine = "Shrine blessing",
        mastery = "Golden Mastery", climb = "Climbing to an island", doubleJump = "Buying a double jump",
        islandBuy = "Unlocking an island", enchant = "Enchanting",
        dungeon = "Count Greg's Mansion", goldenJob = "Candy Witch golden job",
    }
    local function version() return "HustlHub v" .. tostring(getgenv().HustlHubVersion or "?") end
    local function autoHatchOn()
        local el = window.elementsByFlag and window.elementsByFlag["Auto Hatch"]
        return el and el.value == true
    end
    -- who last switched Auto Hatch off (you or the script) and when
    local function lastHatchChange()
        for _, entry in ipairs(window.changeLog or {}) do
            if entry.name == "Auto Hatch" then return entry end
        end
        return nil
    end
    -- the one line that says what's going on (the most important thing first)
    local function activity()
        local lp = game:GetService("Players").LocalPlayer
        if lp:GetAttribute("ColosseumActive") == true then return "Pet Defense: in a match" end
        if tripOwner ~= nil then
            local what = TRIPS[tripOwner] or tostring(tripOwner)
            return what .. (hatchRunning and " (hatching paused)" or (autoHatchOn() and " (Auto Hatch waits)" or ""))
        end
        if hatchRunning then
            local egg = tostring(selectedEgg or "?")
            if hatchWaitReason then return "Hatching " .. egg .. " - waiting: " .. tostring(hatchWaitReason) end
            return "Hatching " .. egg
        end
        if autoHatchOn() then
            return "Auto Hatch is ON but not hatching" .. (hatchStopReason and (": " .. tostring(hatchStopReason)) or " (starting / waiting)")
        end
        local busy = window.hubBusyBy and window.hubBusyBy(nil)
        if busy then return "Running: " .. tostring(busy) end
        local change = lastHatchChange()
        if change and change.value == false and not change.byUser and os.time() - (change.t or 0) < 3600 then
            return "Idle - Auto Hatch was switched off by the script" .. (hatchStopReason and (" (" .. tostring(hatchStopReason) .. ")") or "")
        end
        return "Idle"
    end

    -- the record (newest first)
    window.hubActivityLog = {}
    local logCard
    pcall(function()
        local misc = window.tabByName and window.tabByName["Misc"]
        if misc then
            misc:CreateSection({ name = "Activity" })
            logCard = misc:CreateText({ name = "Activity Log", text = "Nothing yet", wide = true })
        end
    end)
    local function record(text)
        table.insert(window.hubActivityLog, 1, { t = os.time(), text = text })
        if #window.hubActivityLog > 40 then table.remove(window.hubActivityLog) end
        print("[HustlHub] Activity: " .. text)
        if logCard then
            local lines = {}
            for i = 1, math.min(15, #window.hubActivityLog) do
                local e = window.hubActivityLog[i]
                table.insert(lines, os.date("%H:%M:%S", e.t) .. "  " .. e.text)
            end
            pcall(function() logCard:Set(table.concat(lines, "\n")) end)
        end
    end

    if titleLabel then
        local alive = true
        connections.hubTitleTimer = { Disconnect = function() alive = false titleLabel.Text = version() end }
        local function clock(secs)
            secs = math.floor(secs)
            if secs >= 3600 then return string.format("%dh %02dm", secs // 3600, (secs % 3600) // 60) end
            return string.format("%dm %02ds", secs // 60, secs % 60)
        end
        task.spawn(function()
            local last, pending, pendingSince
            while alive do
                local now = "?"
                pcall(function() now = activity() end)
                -- record a change once it has held for 2 seconds (no flicker in the record)
                if now ~= last then
                    if now ~= pending then pending, pendingSince = now, os.clock() end
                    if os.clock() - pendingSince >= 2 then
                        last = now
                        record(now)
                    end
                end
                local text = version() .. "  |  " .. (#now > 60 and (now:sub(1, 59) .. "…") or now)
                local readyIn = window.hubDefenseReadyIn
                if readyIn and not now:find("^Pet Defense") then
                    local ok, secs = pcall(readyIn)
                    if ok and type(secs) == "number" then
                        text = text .. "  |  PD " .. (secs > 0 and ("in " .. clock(secs)) or "ready")
                    end
                end
                if titleLabel.Text ~= text then titleLabel.Text = text end
                task.wait(1)
            end
        end)
    end
end

---------------------------------------------------------------- Trading tab (send pets from your accounts to one account)
-- The game's trade protocol (TradingController / TradingService, TradeTokens.MaxPets = 20):
--   TradeRequested:FireServer { Action = "Request", TargetUserId }  -> the other side gets TradeUpdate { Type = "Request", FromUserId }
--   the other side answers { Action = "Respond", Accepted = true }  -> both get TradeUpdate { Type = "Started" }
--   { Action = "Offer", Refs = { { TypeName = "Pet", Amount = 1, Uid = <pet id> }, ... }, Revision = n } (n counts up from 1 per trade)
--   { Action = "Lock", Locked = true } on both sides -> Processing / Securing -> TradeUpdate { Type = "Completed" }
-- All your accounts share a few small files in TapSimHub (like the webhook): the settings (rev, on, receiver, senders,
-- pets, versions) written by whichever account you click on; "turn" (written only by the receiving account, who goes
-- through the senders one at a time); and a roster / status file per account (so nothing is ever written by two accounts).
xpcall(function() -- (a problem in here can never stop the rest of the script loading)
    local RS = ReplicatedStorage
    local HttpService = game:GetService("HttpService")
    local LaunchPetConfig
    pcall(function() LaunchPetConfig = require(RS.Shared.Pets.LaunchPetConfig) end)
    local tradeTab = window:CreateTab({ name = "Trading" })
    local DIR = "TapSimHub/trade"
    local CFG_FILE = DIR .. "/settings.json"
    local TURN_FILE = DIR .. "/turn.json"
    local T = { trade = { active = false }, me = LocalPlayer.Name, myId = LocalPlayer.UserId, cfg = {}, rev = 0, updates = {}, alive = true, statusLine = "Off",
        sendEquipped = false, -- (Send Equipped Pets switch, off by default: picked pets that are equipped / in a team are unequipped and sent)
        sendLocked = false,  -- (Send Secrets Only switch, OFF by default: only Secret pets are sent, locked ones are unlocked first; no other pets)
        secretsToo = false } -- (Send Secrets With Pets switch: every Secret goes in the same trades as the picked pets)
    connections.trading = { Disconnect = function() T.alive = false end }

    local function ensureDir()
        pcall(function()
            if not isfolder("TapSimHub") then makefolder("TapSimHub") end
            if not isfolder(DIR) then makefolder(DIR) end
        end)
    end
    local function readJson(path)
        local value
        pcall(function() if isfile(path) then value = HttpService:JSONDecode(readfile(path)) end end)
        return type(value) == "table" and value or nil
    end
    local function writeJson(path, value)
        ensureDir()
        pcall(function() writefile(path, HttpService:JSONEncode(value)) end)
    end

    -- roster: one small file per account, refreshed every 10 seconds; accounts seen in the last 45 seconds count as online
    local function myRosterFile() return DIR .. "/roster_" .. T.me .. ".json" end
    local function roster()
        local list = {}
        pcall(function()
            for _, path in ipairs(listfiles(DIR)) do
                local name = tostring(path):match("roster_([^/\\]+)%.json$")
                if name then
                    local entry = readJson(path)
                    if entry and entry.id and os.time() - (tonumber(entry.t) or 0) <= 45 then
                        table.insert(list, { name = tostring(entry.name or name), id = entry.id })
                    end
                end
            end
        end)
        table.sort(list, function(a, b) return a.name < b.name end)
        return list
    end
    local function rosterNames(skipName)
        local names = {}
        for _, entry in ipairs(roster()) do
            if entry.name ~= skipName then table.insert(names, entry.name) end
        end
        return names
    end
    local function idOf(name)
        for _, entry in ipairs(roster()) do if entry.name == name then return entry.id end end
        return nil
    end

    ---------------- what to send
    local VERSIONS = { "Normal", "Golden", "Diamond", "Rainbow" }
    ---------------- every account's inventory (v1.4.40)
    -- Each account writes what it owns to trade/inv_<name>.json (pet name, version, power; storage limit) every 30 s, so
    -- the pet list, the tally and the pet power potential below can use the pets of ALL your accounts.
    local PetPowerT
    pcall(function() PetPowerT = require(RS.Shared.Pets.PetPower) end)
    local TIER_NAME = { Normal = "Normal", Golden = "Golden", Diamond = "Diamond", Shiny = "Rainbow" }
    local function petPowerOf(p)
        local ok, v = pcall(function() return PetPowerT.Get(p) end)
        return (ok and tonumber(v)) or tonumber(p.Power) or 0
    end
    local function myInventory()
        local d = getReplica() and getReplica().Data
        if not (d and d.Pets and d.Pets.Owned) then return nil end
        local pets = {}
        for id, p in pairs(d.Pets.Owned) do
            if type(p) == "table" and type(p.Name) == "string" then
                -- { name, version, power, pet id, locked (1/0), frozen (1/0) } (id / locked / frozen since v1.4.49, for Collect Best Pets)
                table.insert(pets, { p.Name, tostring(p.Tier or "Normal"), math.floor(petPowerOf(p)), tostring(id),
                    p.Locked == true and 1 or 0, p.Frozen ~= nil and 1 or 0 })
            end
        end
        return { name = T.me, t = os.time(), limit = tonumber(d.Pets.StorageLimit) or #pets, pets = pets }
    end
    local function writeInventory()
        local inv = myInventory()
        if inv then writeJson(DIR .. "/inv_" .. T.me .. ".json", inv) end
    end
    -- this account (live) + every other account seen in the last 3 minutes
    local function allInventories()
        local list = {}
        local mine = myInventory()
        if mine then table.insert(list, mine) end
        pcall(function()
            for _, path in ipairs(listfiles(DIR)) do
                local name = tostring(path):match("inv_([^/\\]+)%.json$")
                if name and name ~= T.me then
                    local inv = readJson(path)
                    if inv and type(inv.pets) == "table" and os.time() - (tonumber(inv.t) or 0) <= 180 then table.insert(list, inv) end
                end
            end
        end)
        return list
    end
    -- per pet name: total copies over all accounts, per version, and on how many accounts
    local function tally()
        local byName = {}
        for _, inv in ipairs(allInventories()) do
            local seenHere = {}
            for _, e in ipairs(inv.pets) do
                local name, tier = tostring(e[1]), tostring(e[2])
                local t = byName[name] or { total = 0, tiers = {}, accounts = 0 }
                byName[name] = t
                t.total += 1
                t.tiers[tier] = (t.tiers[tier] or 0) + 1
                if not seenHere[name] then seenHere[name] = true t.accounts += 1 end
            end
        end
        return byName
    end
    -- the Pets To Send list: only pets some account owns right now, as "Name (copies on all accounts)"
    local petLabelName = {}
    local function petLabel(name, total) return name .. " (" .. tostring(total) .. ")" end
    local function petNameOptions()
        local counts = tally()
        local names = {}
        for name in pairs(counts) do table.insert(names, name) end
        table.sort(names, function(a, b)
            if counts[a].total ~= counts[b].total then return counts[a].total > counts[b].total end
            return a < b
        end)
        local list = {}
        table.clear(petLabelName)
        for _, name in ipairs(names) do
            local label = petLabel(name, counts[name].total)
            petLabelName[label] = name
            table.insert(list, label)
        end
        return list
    end
    local function labelsFor(names)
        local wanted, out = {}, {}
        for _, n in ipairs(names or {}) do wanted[n] = true end
        for label, name in pairs(petLabelName) do if wanted[name] then table.insert(out, label) end end
        return out
    end
    local function namesFrom(labels)
        local out = {}
        for _, label in ipairs(labels or {}) do
            table.insert(out, petLabelName[label] or (tostring(label):match("^(.-) %(%d+%)$")) or tostring(label))
        end
        return out
    end
    task.spawn(function()
        while T.alive do
            pcall(writeInventory)
            task.wait(30)
        end
    end)

    -- the picked pets this account can send: ids, what was skipped and why ({ equipped = n, locked = n }), and which of
    -- the ids are equipped right now (they're unequipped just before the trade)
    local function isSecret(pet)
        local cfg = LaunchPetConfig and LaunchPetConfig[pet.Name]
        return tostring(pet.Rarity or (cfg and cfg.Rarity) or ""):find("Secret", 1, true) ~= nil
    end
    local function matchingPets()
        local ids, skipped, equippedNow, lockedNow = {}, { equipped = 0, locked = 0, notSecret = 0 }, {}, {}
        -- Collect Best Pets (v1.4.49): the run names exact pets for this account. Send exactly those (still owned):
        -- equipped ones are unequipped and locked ones unlocked first, frozen ones never go
        local explicit = type(T.cfg.idsBySender) == "table" and T.cfg.idsBySender[T.me]
        if type(explicit) == "table" then
            pcall(function()
                local d = getReplica().Data
                local equipped = {}
                for _, id in pairs(d.Pets.Equipped or {}) do equipped[id] = true end
                for _, id in ipairs(explicit) do
                    local pet = d.Pets.Owned[id]
                    if type(pet) == "table" then
                        if pet.Frozen ~= nil then
                            skipped.locked += 1
                        else
                            table.insert(ids, id)
                            if pet.Equip or equipped[id] then equippedNow[id] = true end
                            if pet.Locked == true then lockedNow[id] = true end
                        end
                    end
                end
            end)
            return ids, skipped, equippedNow, lockedNow
        end
        local wantName, wantTier = {}, {}
        -- Send Secrets Only with nothing picked in Pets / Versions = every Secret, any name, any version
        local secretsOnly, sendEquipped, secretsToo = T.cfg.secretsOnly, T.cfg.sendEquipped, T.cfg.secretsToo -- (the options of the account Start was pressed on)
        if secretsOnly == nil then secretsOnly = T.sendLocked end
        if sendEquipped == nil then sendEquipped = T.sendEquipped end
        if secretsToo == nil then secretsToo = T.secretsToo end
        if secretsOnly then secretsToo = false end -- (Send Secrets Only wins: nothing but Secrets)
        local anyName = secretsOnly and #(T.cfg.pets or {}) == 0
        local anyTier = (secretsOnly or secretsToo) and #(T.cfg.versions or {}) == 0 -- (Send Secrets With Pets: no versions picked = every version)
        for _, n in ipairs(T.cfg.pets or {}) do wantName[n] = true end
        for _, v in ipairs(T.cfg.versions or {}) do wantTier[v == "Rainbow" and "Shiny" or v] = true end -- (Rainbow is the "Shiny" tier in the game's data)
        local ok = pcall(function()
            local d = getReplica().Data
            local equipped, inTeam = {}, {}
            for _, id in pairs(d.Pets.Equipped or {}) do equipped[id] = true end
            for _, team in pairs(type(d.PetTeams) == "table" and d.PetTeams or {}) do
                for _, id in pairs(type(team) == "table" and team or {}) do
                    if type(id) == "string" then inTeam[id] = true end
                end
            end
            for id, pet in pairs(d.Pets.Owned) do
                local secret = type(pet) == "table" and isSecret(pet)
                local picked = type(pet) == "table" and (anyName or wantName[pet.Name]) and (anyTier or wantTier[tostring(pet.Tier or "Normal")])
                -- Send Secrets With Pets: every Secret goes too, picked or not, alongside the picked pets
                if type(pet) == "table" and (picked or (secretsToo and secret)) then
                    local isEquipped = pet.Equip or equipped[id] or inTeam[id]
                    if pet.Frozen ~= nil then
                        skipped.locked += 1 -- (frozen pets are never sent)
                    elseif secretsOnly and not secret then
                        skipped.notSecret += 1 -- (Send Secrets Only: nothing but Secrets is sent)
                    elseif pet.Locked == true and not ((secretsOnly or secretsToo) and secret) then
                        skipped.locked += 1 -- (locked pets stay locked unless they are Secrets and Send Secrets Only / With Pets is on)
                    elseif isEquipped and not sendEquipped then
                        skipped.equipped += 1
                    else
                        table.insert(ids, id)
                        if pet.Equip or equipped[id] then equippedNow[id] = true end
                        if pet.Locked == true then lockedNow[id] = true end
                    end
                end
            end
        end)
        if not ok then return {}, skipped, {}, {} end
        return ids, skipped, equippedNow, lockedNow
    end
    local petActionRE
    pcall(function() petActionRE = RS.RemoteServices.PetService.RE.PetActionRequested end)

    ---------------- listening to the game's trade updates
    local tradeRE
    pcall(function() tradeRE = RS.RemoteServices.TradingService.RE end)
    local function fire(payload)
        if not tradeRE then return false end
        return pcall(function() tradeRE.TradeRequested:FireServer(payload) end)
    end
    local function drain() table.clear(T.updates) end
    local function waitFor(types, seconds)
        local deadline = os.clock() + seconds
        while T.alive and os.clock() < deadline do
            for i, u in ipairs(T.updates) do
                if types[u.Type] then table.remove(T.updates, i) return u end
            end
            task.wait(0.2)
        end
        return nil
    end
    local function setStatus(text)
        T.statusLine = text
        pcall(function() if T.statusText then T.statusText:Set(text) end end)
    end

    pcall(function()
        tradeRE.TradeUpdate.OnClientEvent:Connect(function(u)
            if type(u) ~= "table" then return end
            local turn = readJson(TURN_FILE)
            -- receiving account: answer the current sender's request, and lock once they have put pets in
            if T.cfg.on and T.cfg.receiver == T.me and turn and turn.sender then
                local senderId = idOf(turn.sender)
                if u.Type == "Request" and senderId and u.FromUserId == senderId then
                    task.spawn(function()
                        task.wait(0.5)
                        fire({ Action = "Respond", Accepted = true })
                    end)
                    return
                end
            end
            -- what state the current trade is in (the ready-up watcher below uses it)
            local tr = T.trade
            if u.Type == "Started" then
                tr.active, tr.myOffer, tr.otherOffer, tr.lockedAt = true, false, false, nil
            elseif u.Type == "Offer" then
                tr.active = true
                tr.lockedAt = nil -- an offer change un-readies both sides
                if u.UserId == T.myId then tr.myOffer = true else tr.otherOffer = true end
            elseif u.Type == "Completed" or u.Type == "Cancelled" or u.Type == "Denied" or u.Type == "Declined"
                or u.Type == "FailedValidation" or u.Type == "RequestExpired" then
                tr.active, tr.myOffer, tr.otherOffer, tr.lockedAt = false, false, false, nil
            end
            table.insert(T.updates, u)
            if #T.updates > 50 then table.remove(T.updates, 1) end
        end)
    end)

    ---------------- sending (the account whose turn it is)
    local function sendLoop(turnId, receiverId)
        local sent, failures = 0, 0
        T.lastNote = nil
        while T.alive and T.cfg.on do
            local turn = readJson(TURN_FILE)
            if not (turn and turn.sender == T.me and turn.id == turnId) then break end
            local ids, skipped, equippedNow, lockedNow = matchingPets()
            if #ids == 0 then
                if sent == 0 then
                    -- say WHY, here and (through the status file) on the receiving account's Trading Status
                    local why = "none of the picked pets"
                    if skipped.equipped > 0 then why = skipped.equipped .. " picked pets are equipped / in a team (turn on Send Equipped Pets)"
                    elseif skipped.notSecret > 0 then why = skipped.notSecret .. " picked pets are not Secrets (Send Secrets Only is on)"
                    elseif skipped.locked > 0 then why = skipped.locked .. " picked pets are locked or frozen (turn on Send Secrets Only to send locked Secrets)" end
                    T.lastNote = "nothing to send: " .. why
                    setStatus("Nothing to send: " .. why)
                end
                break
            end
            -- equipped pets can't go into a trade and locked pets can't be traded: get EVERY matching pet ready first,
            -- not just the next 20. These used to be fired all at once per batch, and the game drops most of a burst of
            -- PetAction requests, so only one Secret came unlocked and each trade carried a single Secret. Now they go
            -- one by one with a short gap, and any the game missed are sent again, so every trade is filled to 20.
            local function stillMatching(pred)
                local out = {}
                pcall(function()
                    local owned = getReplica().Data.Pets.Owned
                    for _, id in ipairs(ids) do
                        if owned[id] and pred(owned[id], id) then table.insert(out, id) end
                    end
                end)
                return out
            end
            local function fixAll(action, needs)
                if not petActionRE then return end
                for attempt = 1, 3 do
                    local todo = stillMatching(needs)
                    if #todo == 0 then return end
                    if attempt == 1 then setStatus((action == "Unequip" and "Unequipping " or "Unlocking ") .. #todo .. " pets...") end
                    for _, id in ipairs(todo) do
                        if not (T.alive and T.cfg.on) then return end
                        pcall(function() petActionRE:FireServer({ ["Action"] = action, ["PetId"] = id }) end)
                        task.wait(0.35)
                    end
                    -- wait for the game's data to show the change before checking what it missed
                    local deadline = os.clock() + 4
                    while os.clock() < deadline and #stillMatching(needs) > 0 do task.wait(0.25) end
                end
            end
            local equippedIds = {}
            pcall(function()
                for _, id in pairs(getReplica().Data.Pets.Equipped or {}) do equippedIds[id] = true end
            end)
            fixAll("Unequip", function(pet, id) return equippedNow[id] and (pet.Equip or equippedIds[id]) end)
            -- (ToggleLock flips the lock, so it's only ever sent for a pet that is locked right now)
            fixAll("ToggleLock", function(pet, id) return lockedNow[id] and pet.Locked == true end)
            -- whatever still won't unlock is left out; everything else goes, 20 per trade
            local ready = stillMatching(function(pet) return pet.Locked ~= true end)
            if #ready < #ids then print("[HustlHub] Trading:", #ids - #ready, "pets stayed locked, left out") end
            if #ready == 0 then
                setStatus("Couldn't unlock the picked pets")
                T.lastNote = "couldn't unlock the picked pets"
                break
            end
            ids = ready
            local batch = table.move(ids, 1, math.min(20, #ids), 1, {})
            setStatus("Trading " .. #batch .. " pets to " .. tostring(T.cfg.receiver) .. " (" .. sent .. " sent, " .. #ids .. " left)")
            drain()
            fire({ Action = "Request", TargetUserId = receiverId })
            local started = waitFor({ Started = true, Denied = true, Declined = true, Cancelled = true, RequestExpired = true }, 25)
            if not (started and started.Type == "Started") then
                failures += 1
                fire({ Action = "Cancel" })
                if failures >= 3 then setStatus("Gave up: " .. tostring(T.cfg.receiver) .. " didn't accept the trade") break end
                task.wait(8)
            else
                local refs = {}
                for _, id in ipairs(batch) do table.insert(refs, { TypeName = "Pet", Amount = 1, Uid = id }) end
                fire({ Action = "Offer", Refs = refs, Revision = 1 })
                T.trade.active, T.trade.myOffer, T.trade.lockedAt = true, true, nil
                local offered = waitFor({ Offer = true, OfferRejected = true }, 10)
                while offered and offered.Type == "Offer" and offered.UserId ~= T.myId do
                    offered = waitFor({ Offer = true, OfferRejected = true }, 10)
                end
                if offered and offered.Type == "OfferRejected" then
                    failures += 1
                    setStatus("Offer refused: " .. tostring(offered.Message or "unknown reason"))
                    fire({ Action = "Cancel" })
                    if failures >= 3 then break end
                    task.wait(8)
                else
                    task.wait(1)
                    fire({ Action = "Lock", Locked = true })
                    local done = waitFor({ Completed = true, Cancelled = true, Denied = true, FailedValidation = true }, 40)
                    if done and done.Type == "Completed" then
                        sent += #batch
                        failures = 0
                        print("[HustlHub] Trading: sent", #batch, "pets to", T.cfg.receiver, "(" .. sent .. " so far)")
                        task.wait(10) -- (a new request right after a trade is refused: give the game a moment)
                    else
                        failures += 1
                        fire({ Action = "Cancel" })
                        if failures >= 3 then setStatus("Gave up: the trade didn't complete") break end
                        task.wait(8)
                    end
                end
            end
        end
        return sent
    end

    ---------------- the loop every account runs
    local function myStatusFile() return DIR .. "/status_" .. T.me .. ".json" end
    local function inList(list, name)
        for _, v in ipairs(list or {}) do if v == name then return true end end
        return false
    end
    local running = false
    local function coordinate()
        -- receiving account: go through the senders one at a time
        running = true
        local cfg = T.cfg
        local receiverId = T.myId
        local results = {} -- what each sender did, shown at the end on every account
        -- only the senders in THIS server can trade with the receiving account: the others (e.g. a different VIP
        -- server) are skipped straight away instead of being given a turn and waited on
        local Players = game:GetService("Players")
        local here = {}
        for _, sender in ipairs(cfg.senders or {}) do
            if Players:FindFirstChild(sender) then table.insert(here, sender) end
        end
        local away = #(cfg.senders or {}) - #here
        if away > 0 then
            print("[HustlHub] Trading:", away, "sending account(s) aren't in this server, skipped")
            table.insert(results, away .. " not in this server (skipped)")
        end
        for i, sender in ipairs(here) do
            if not (T.alive and T.cfg.on and T.cfg.rev == cfg.rev) then break end
            if not idOf(sender) then table.insert(results, sender .. ": not running HustlHub") end
            if idOf(sender) then
                local turnId = tostring(os.time()) .. "-" .. i
                writeJson(TURN_FILE, { sender = sender, id = turnId, receiverId = receiverId })
                setStatus("Waiting for " .. sender .. " (" .. i .. "/" .. #here .. ")")
                local lastProgress, lastSent = os.clock(), -1
                while T.alive and T.cfg.on and T.cfg.rev == cfg.rev do
                    local status = readJson(DIR .. "/status_" .. sender .. ".json")
                    if status and status.turn == turnId then
                        if status.done then
                            local n = tonumber(status.sent) or 0
                            table.insert(results, sender .. ": " .. (n > 0 and ("sent " .. n) or tostring(status.note or "sent 0")))
                            break
                        end
                        if status.sent ~= lastSent then lastSent, lastProgress = status.sent, os.clock() end
                    end
                    if os.clock() - lastProgress > 240 then
                        setStatus(sender .. " stopped answering, moving on")
                        table.insert(results, sender .. ": stopped answering")
                        break
                    end
                    task.wait(2)
                end
            end
        end
        writeJson(TURN_FILE, {})
        if T.cfg.on and T.cfg.rev == cfg.rev then
            local summary = "Finished: " .. (#results > 0 and table.concat(results, " | ") or "every sender has been through")
            setStatus(summary)
            T.cfg.on = false
            T.cfg.summary = summary
            local file = readJson(CFG_FILE) or {}
            if file.rev == cfg.rev then
                file.on = false
                file.summary = summary -- (every account shows this in Trading Status until the next run)
                file.rev = (tonumber(file.rev) or 0) + 1
                writeJson(CFG_FILE, file)
                T.rev = file.rev
                if T.onToggle then pcall(function() T.onToggle:Set(false, true) end) end
            end
        end
        running = false
    end

    -- ready up whenever it makes sense: the receiving account once the sender has put pets in, the sending account
    -- once its own offer is in; the lock is sent again every 5 seconds until the trade ends (or the offer changes)
    task.spawn(function()
        while T.alive do
            local tr = T.trade
            if T.cfg.on and tr.active then
                local isReceiver = T.cfg.receiver == T.me
                local ready = (isReceiver and tr.otherOffer) or (not isReceiver and inList(T.cfg.senders, T.me) and tr.myOffer)
                if ready and (not tr.lockedAt or os.clock() - tr.lockedAt >= 5) then
                    tr.lockedAt = os.clock()
                    fire({ Action = "Lock", Locked = true })
                end
            end
            task.wait(1)
        end
    end)

    task.spawn(function()
        local lastBeat = 0
        local sendingTurn
        while T.alive do
            if os.clock() - lastBeat >= 10 then
                lastBeat = os.clock()
                writeJson(myRosterFile(), { name = T.me, id = T.myId, t = os.time() })
            end
            local file = readJson(CFG_FILE)
            if file and (tonumber(file.rev) or 0) > T.rev then
                T.rev = tonumber(file.rev) or 0
                -- the running trade (what senders send). Your own picks in the menu are kept apart (pickPets ...): Start
                -- used to send whatever the LAST run had picked, not what the menu showed
                T.cfg = file
                pcall(function() if T.onToggle then T.onToggle:Set(file.on == true, true) end end)
            end
            if T.cfg.on then
                if T.cfg.receiver == T.me and not running then
                    task.spawn(coordinate)
                elseif inList(T.cfg.senders, T.me) then
                    local turn = readJson(TURN_FILE)
                    if turn and turn.sender == T.me and turn.id and sendingTurn ~= turn.id and turn.receiverId then
                        sendingTurn = turn.id
                        task.spawn(function()
                            local sent = sendLoop(turn.id, turn.receiverId)
                            writeJson(myStatusFile(), { turn = turn.id, done = true, sent = sent, note = T.lastNote, t = os.time() })
                            if sent > 0 then setStatus("Done: sent " .. sent .. " pets") end
                        end)
                    end
                end
            elseif not running and T.statusLine ~= (T.cfg.summary or "Off") then
                setStatus(T.cfg.summary or "Off") -- (the last run's result, so you can see what each sender did)
            end
            task.wait(2)
        end
    end)

