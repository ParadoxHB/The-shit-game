-- play the run you're in until it ends (alive() = the switch is still on)
local function playDungeonRun(alive)
    local ctx = dungeonCtx()
    local S = ctx and ctx.Service
    if not S then return end
    local mobs, conns, boss, results = {}, {}, nil, nil
    local candle = {}
    local function on(name, fn)
        local sig = S[name]
        if sig and sig.Connect then table.insert(conns, sig:Connect(function(...) pcall(fn, ...) end)) end
    end
    local function tp(cf)
        local root = getRoot()
        if root then root.AssemblyLinearVelocity = Vector3.zero root.CFrame = cf end
    end
    on("MobState", function(m) if type(m) == "table" and m.Id then mobs[m.Id] = m end end)
    on("MobRemoved", function(r) local id = type(r) == "table" and r.Id or r if id ~= nil then mobs[id] = nil end end)
    on("BossState", function(b) if type(b) == "table" then boss = b end end)
    on("Results", function(r) results = r end)
    on("BlessingOffer", function(o)
        if type(o) ~= "table" or type(o.Choices) ~= "table" or #o.Choices == 0 then return end
        local pick = o.Choices[1]
        for _, want in ipairs(H.D.BLESSINGS) do
            if table.find(o.Choices, want) then pick = want break end
        end
        task.wait(0.4)
        S.BlessingPick:Fire(o.OfferId, pick)
        print("[HustlHub] Mansion: blessing " .. tostring(pick))
    end)
    on("BossAttack", function(a)
        -- the cape sweep: jump just before it lands (Humanoid.Jump, no key press)
        if type(a) == "table" and a.Kind == "Sweep" and tonumber(a.HitAt) then
            task.delay(math.max(0, a.HitAt - now() - 0.35), function()
                local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.Jump = true end
            end)
        end
    end)
    on("Candle", function(c)
        if type(c) ~= "table" then return end
        if c.Kind == "Setup" then
            candle.folder, candle.names = c.Folder, {}
            for _, v in ipairs(type(c.Candles) == "table" and c.Candles or {}) do
                if type(v) == "table" and v.Id then candle.names[v.Id] = v.Name end
            end
        elseif c.Kind == "Hint" and type(c.Order) == "table" then
            candle.order = c.Order
            candle.goAt = (tonumber(c.StartAt) or now()) + #c.Order * (tonumber(c.Step) or 1) + 0.3
        elseif c.Kind == "Wrong" or c.Kind == "Round" then
            candle.order = nil
        end
    end)
    local function wick(id)
        local f = ctx.RunFolder()
        local folder = f and f:FindFirstChild(candle.folder or "Combat")
        local m = folder and candle.names and candle.names[id] and folder:FindFirstChild(candle.names[id])
        local w = m and m:FindFirstChild("Wick")
        return w and w:IsA("BasePart") and w or nil
    end
    local function chests()
        local out = {}
        local f = ctx.RunFolder()
        for _, m in ipairs(f and f:GetDescendants() or {}) do
            if m:IsA("Model") and m:GetAttribute("ChestId") and m:GetAttribute("Opened") ~= true and (tonumber(m:GetAttribute("Hp")) or 1) > 0 then
                table.insert(out, m)
            end
        end
        return out
    end
    local relicsTried = {}
    local function relic()
        for _, m in ipairs(CollectionService:GetTagged("Interactable")) do
            local id = m:IsA("Model") and m:GetAttribute("InteractableId") == "VampireRelic" and m:GetAttribute("RelicId")
            if type(id) == "string" and (relicsTried[id] or 0) < 3 and m:IsDescendantOf(workspace) then
                local found = m:GetAttribute("FoundBy")
                if not (type(found) == "string" and found:find(tostring(LocalPlayer.UserId), 1, true)) then return m, id end
            end
        end
    end

    local curTarget, curChest, lastDoor = nil, nil, 0
    local stats = { rooms = 0 }
    local lastRoom
    local t0 = os.clock()
    while alive() and ctx.InRun() and os.clock() - t0 < 1900 do
        local st = ctx.State() or {}
        if st.RoomIndex ~= lastRoom then lastRoom = st.RoomIndex stats.rooms += 1 table.clear(mobs) curChest = nil end
        -- a Vampire Relic in reach: go and take it
        local rm, rid = relic()
        if rm then
            relicsTried[rid] = (relicsTried[rid] or 0) + 1
            local p = rm:GetPivot().Position
            tp(CFrame.new(p + Vector3.new(0, 3, 4), p))
            task.wait(0.3)
            S.CollectRelic:Fire(rid)
            print("[HustlHub] Mansion: took a Vampire Relic")
            task.wait(0.4)
        end
        -- candle ritual: once the hint has played, step on the candles in its order
        if candle.order and now() >= (candle.goAt or 0) then
            local order = candle.order
            candle.order = nil
            for _, id in ipairs(order) do
                local w = wick(id)
                if w then tp(CFrame.new(w.Position + Vector3.new(0, 3, 0))) end
                task.wait(0.8)
            end
        end
        -- a cleared room: walk through its exit door (the run would move on by itself after ~25 s)
        if st.Phase == "Cleared" and typeof(st.ExitDoor) == "Vector3" and os.clock() - lastDoor > 4 then
            lastDoor = os.clock()
            tp(CFrame.new(st.ExitDoor + Vector3.new(0, 0, -30)))
        end
        -- target: Count Greg's medallion bat > the lowest-numbered monster > a chest (Count Greg himself needs none)
        local target
        if boss and boss.Phase == "Swarm" and boss.MedallionId then
            target = boss.MedallionId
        else
            for id, m in pairs(mobs) do
                if (tonumber(m.Hp) or 1) > 0 and (not target or id < target) then target = id end
            end
        end
        if target ~= curTarget then curTarget = target pcall(function() S.SetTarget:Fire(target) end) end
        if not target and st.Phase ~= "Boss" then
            local c = chests()[1]
            local id = c and c:GetAttribute("ChestId")
            if id ~= curChest then
                curChest = id
                pcall(function() S.ChestTarget:Fire(id) end)
                if c then local p = c:GetPivot().Position tp(CFrame.lookAt(p + Vector3.new(0, 3, 8), p)) end
            end
        end
        clientSequence += 1
        pcall(function() TapRemote:FireServer({ ["Auto"] = false, ["ClientSequence"] = clientSequence }) end)
        task.wait(0.08)
    end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    if type(results) == "table" then
        print(("[HustlHub] Mansion: run over (%s) in %ss"):format(results.Victory == false and "not cleared" or "cleared", tostring(results.Seconds or "?")))
    end
end

