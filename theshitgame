local function teleportAndTouch(cf)
    if getgenv().HustlHubRun ~= HH_RUN then return false end -- a replaced copy never moves you (see HH_RUN)
    waitForDefenseRound()
    -- going to the Golden machine: use its live box if it's loaded (it moves between updates)
    if (cf.Position - GOLDEN_MACHINE_CF.Position).Magnitude < 1 then
        local live = liveGoldenBox()
        if live then cf = live end
    end
    local root = getRoot()
    if not root then
        warn("[HustlHub] Can't teleport: no character")
        return false
    end
    -- Same order as the game's own teleports (TeleportArrivalController): move first, ask for the
    -- area to load in the background (that request can take a while, so it must not block), and
    -- keep the character at the spot until there's floor under it, so it can't fall into the void.
    local player = game:GetService("Players").LocalPlayer
    root.Anchored = false
    root.AssemblyLinearVelocity = Vector3.zero
    root.CFrame = cf
    task.spawn(function()
        pcall(function() player:RequestStreamAroundAsync(cf.Position, 3) end)
    end)
    local holdStart = os.clock()
    while os.clock() - holdStart < 6 and not window.hubFloorBelow(cf.Position, player.Character) do
        root = getRoot()
        if not root then return false end
        root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = cf
        game:GetService("RunService").Heartbeat:Wait()
    end
    root = getRoot()
    if not root then return false end
    window.hubEnsureFloor(cf, player.Character)
    root.AssemblyLinearVelocity = Vector3.zero
    root.CFrame = cf
    -- Small nudge down and back up so the touch fires even if we landed exactly on it
    task.wait(0.1)
    root.CFrame = cf * CFrame.new(0, -1, 0)
    task.wait(0.1)
    root.CFrame = cf
    task.wait(TOUCH_DELAY)
    return true
end

local chestTripActive = false -- while true, Auto Hatch ignores "TooFar" (we'll be right back)

-- Only one teleport trip at a time (chests and island breakables share this)
local tripOwner = nil
local tripWaiters = 0 -- how many features are waiting for a turn (long trips like Auto Mine check this)
local function acquireTrip(who)
    if tripOwner ~= nil and tripOwner ~= who then
        tripWaiters += 1
        while tripOwner ~= nil and tripOwner ~= who do task.wait(0.2) end
        tripWaiters -= 1
    end
    tripOwner = who
    chestTripActive = true
end
local function othersWaitingForTrip()
    return tripWaiters > 0
end
local function releaseTrip(who)
    if tripOwner == who then
        tripOwner = nil
        chestTripActive = false
    end
end
-- Many accounts hatch at the same egg and stand on the same spot. Their avatars collide and shove each other, and the
-- crowd pushed accounts DOWN INTO the island rock ("under the map": seen live, 10 of 16 accounts at one egg stuck about
-- 5.5 studs below the egg base with solid rock above and below, state GettingUp). So:
--   1) other players' avatars never collide with yours (client side only, your character still stands on the floor),
--   2) a watchdog: while Auto Hatch runs and no trip is going, if you ended up 2.5 to 25 studs from where the last
--      teleport put you, you are put straight back (and the floor pad is renewed).
do
    local RunService = game:GetService("RunService")
    local Players = game:GetService("Players")
    connections.hubNoCollide = RunService.Stepped:Connect(function()
        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= Players.LocalPlayer and other.Character then
                for _, part in ipairs(other.Character:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
                end
            end
        end
    end)
    local watching = true
    connections.hubStandWatchdog = { Disconnect = function() watching = false end }
    task.spawn(function()
        while watching do
            task.wait(1.5)
            pcall(function()
                local guard = window.hubStandGuard
                local info = window.hubHatchInfo and window.hubHatchInfo()
                if not guard or window.hubPaused or not (info and info.running) then return end
                if chestTripActive or tripOwner ~= nil or os.clock() - guard.t < 4 then return end
                local root = getRoot()
                if not root then return end
                if guard.pad and not (window.hubFloorPart and window.hubFloorPart.Parent) then
                    window.hubEggPad = { x = guard.pad.x, z = guard.pad.z, y = guard.pad.y, t = os.clock() }
                    window.hubEnsureFloor(guard.cf, Players.LocalPlayer.Character) -- (the platform vanished: build it again)
                end
                local off = (root.Position - guard.cf.Position).Magnitude
                if off > 2.5 and off < 80 then
                    print("[HustlHub] Teleport: moved away from the egg spot (" .. math.floor(off) .. " studs), put back")
                    window.hubEnsureFloor(guard.cf, Players.LocalPlayer.Character)
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.CFrame = guard.cf
                end
            end)
        end
    end)
    -- 3) HipHeight guard. Seen live (g0nz_2360): the character's Humanoid.HipHeight was 0 (normal ~2). With that it can
    --    never stand: it stays in Freefall, hovers about a stud above the ground, slides off any spot and gets put back by
    --    the watchdog again and again ("floating, pushed around, stuck in a loop"). Nothing in HustlHub sets it; the game
    --    leaves it at 0 now and then (probably a mount / jump effect interrupted by a teleport). Setting it back to 2.01
    --    made it stand at once. So: if an R15 HipHeight stays under 0.5 for 2 seconds (and you're not on a seat or the
    --    bouncy ball mount), put the last good value back.
    task.spawn(function()
        local lastGood, lowSince
        while watching do
            task.wait(1)
            pcall(function()
                local ch = Players.LocalPlayer.Character
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                if not hum or hum.RigType ~= Enum.HumanoidRigType.R15 then return end
                if hum.HipHeight >= 0.5 then lastGood, lowSince = hum.HipHeight, nil return end
                if hum.SeatPart or ch:FindFirstChild("BouncyBallMount") then lowSince = nil return end
                lowSince = lowSince or os.clock()
                if os.clock() - lowSince >= 2 then
                    local fix = lastGood or 2
                    hum.HipHeight = fix
                    lowSince = nil
                    print(string.format("[HustlHub] Character: HipHeight was 0 (floating, couldn't stand), put back to %.2f", fix))
                end
            end)
        end
    end)
end
