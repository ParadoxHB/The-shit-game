	local function makeRow(tab, name, desc, height, kind)
		local o = library.options
		local hub = tab.hub

		local row = new("Frame", {
			Name = tostring(name),
			Size = UDim2.new(1, 0, 0, height),
			BackgroundColor3 = ROW_BG,
			BorderSizePixel = 0,
			LayoutOrder = tab:next(),
			Parent = tab.page,
		})
		corner(row, 5)
		local st = stroke(row, o.bordercolor)
		st.Transparency = 1

		local e = {
			hover = 0,
			row = row,
			name = string.lower(tostring(name)),
			desc = string.lower(desc or ""),
			text = desc,
			kind = kind,
			tab = tab,
		}

		local function watch(obj)
			if not (obj:IsA("GuiButton") or obj:IsA("TextBox") or obj == row) then
				return
			end

			obj.MouseEnter:Connect(function()
				e.hover = e.hover + 1
			end)
			obj.MouseLeave:Connect(function()
				e.hover = math.max(e.hover - 1, 0)
			end)
		end

		watch(row)
		row.DescendantAdded:Connect(watch)

		local accentBar
		e.paintAccent = function(color)
			if not accentBar then
				accentBar = new("Frame", {
					Name = "AccentBar",
					BackgroundColor3 = color,
					BorderSizePixel = 0,
					Size = UDim2.new(0, 3, 1, -8),
					Position = UDim2.new(0, 2, 0, 4),
					ZIndex = 3,
					Parent = row,
				})
				corner(accentBar, 2)
			end

			accentBar.BackgroundColor3 = color
			st.Transparency = 0.6
			st.Color = color
		end

		table.insert(tab.rows, e)
		hub.rowsByName[name] = e

		if hub.accents[name] then
			e.paintAccent(hub.accents[name])
		end

		return row, e
	end

	local function rowLabel(row, name, rightPad)
		local o = library.options

		return new("TextLabel", {
