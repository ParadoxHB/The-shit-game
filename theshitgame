-- which versions of a pet are still missing (and wanted)
local function missing(name, index, tiers)
    if not indexRarities[rarityOf(name)] then return {} end
    local m = {}
    for _, version in ipairs(VERSIONS) do
        if indexVersions[version] and not hasVersion(name, version, index, tiers) then m[version] = true end
    end
    return m
end
local function eggDone(egg)
    local index, tiers = indexData()
