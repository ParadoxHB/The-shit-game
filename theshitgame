---------------------------------------------------------------- Auto Dig (digsite)
do -- own scope (keeps the top level under Luau's 200-local limit)
-- From the game's DigController / DigConfig:
--   * stand inside workspace.Ts2Islands.Autumn.Digsite.DigZone
--   * DigService.Begin() starts a dig; each DigService.Hit(id, round.Sequence, serverTime) counts
--     if the moving cursor is inside the target at that time. A miss adds 2 to the hits left.
--   * the cursor follows DigConfig.Cursor(round, time), so we can work out exactly when it's
--     in the target and send the hit at that moment
--   * 10 digs per hour (DigConfig.Allowance on Data.Digging), hits at least 0.16s apart
local DigConfig
pcall(function() DigConfig = require(ReplicatedStorage.Shared.Minigames.DigConfig) end)
local DIG_TARGET_SAFETY = 0.3 -- aim for the middle 60% of the target zone
local DIG_GAME_TIMEOUT = 90   -- give up on one dig after this long

local digRunning = false
local digRunId = 0
connections.dig = { Disconnect = function() digRunning = false end }

local function digRemote(name)
    return Remotes:FindFirstChild("DigService") and Remotes.DigService.RF:FindFirstChild(name)
end

local function digsLeft()
    local replica = getReplica()
    local ok, left, reset = pcall(function()
        return DigConfig.Allowance(replica.Data.Digging, os.time())
    end)
    if ok then return left, reset end
    return 0, 60
end

local function digZoneSpot()
    local ok, zone = pcall(function() return workspace.Ts2Islands.Autumn.Digsite.DigZone end)
    if not ok or not zone then return nil end
    if zone:IsA("BasePart") then
        -- Middle of the zone, just above its floor
        return CFrame.new(zone.Position - Vector3.new(0, zone.Size.Y / 2 - 3, 0))
    end
    return zone:GetPivot() + Vector3.new(0, 3, 0)
end

-- First moment (at or after `earliest`) when the cursor is well inside the target
local function nextHitTime(round, earliest)
    local t = math.max(earliest, round.Epoch + 0.01)
    for i = 0, 800 do
        local candidate = t + i * 0.01
        if math.abs(DigConfig.Cursor(round, candidate) - round.Center) <= round.Width * DIG_TARGET_SAFETY then
            return candidate
        end
    end
    return t
end

-- Plays one full dig. Returns "done", "cooldown" or "failed".
local function playOneDig(stillRunning)
    local Begin, Hit, Cancel = digRemote("Begin"), digRemote("Hit"), digRemote("Cancel")
    if not (Begin and Hit) then return "failed" end

    local ok, state = pcall(function() return safeInvoke(Begin) end)
    if not ok or type(state) ~= "table" then return "failed" end
    if state.Error == "Cooldown" then return "cooldown" end
    if state.Error then
        print("[HustlHub] Dig couldn't start:", state.Error)
        return "failed"
    end

    local id = state.Id
    local lastHit = 0
    local start = os.clock()
    while stillRunning() and os.clock() - start < DIG_GAME_TIMEOUT do
        local round = state.Round
        if type(round) ~= "table" then break end

        local earliest = math.max(workspace:GetServerTimeNow() + 0.05, lastHit + DigConfig.MinHitInterval + 0.01)
        local t = nextHitTime(round, earliest)
        while workspace:GetServerTimeNow() < t do RunService.Heartbeat:Wait() end
        lastHit = t

        local hitOk, result = pcall(function() return safeInvoke(Hit, id, round.Sequence, t) end)
        if not hitOk or type(result) ~= "table" then break end

        if result.Error then
            if result.Error == "NoSession" then break end
            if result.Error ~= "TooSoon" and result.Error ~= "StaleRound" and result.Error ~= "Busy" then
                print("[HustlHub] Dig error:", result.Error)
                break
            end
            -- TooSoon / StaleRound / Busy: just try the same round again
        elseif result.Complete then
            print("[HustlHub] Dig complete:", tostring(result.Reward), "x" .. tostring(result.Amount or 1))
            return "done"
        else
            state = result -- next round
        end
    end

    -- Didn't finish: cancel so the next dig can start cleanly
    if Cancel and id then pcall(function() safeInvoke(Cancel, id) end) end
    return "failed"
end

automationTab:CreateToggle({
    name = "Auto Dig",
    description = "Goes to the Autumn digsite and uses all your digs (10 per hour)",
    callback = function(value)
        digRunning = false
        if not value then return end
        if not DigConfig or not digRemote("Begin") then
            window:Notify({ title = "Auto Dig", content = "Couldn't find the game's dig system.", duration = 5 })
            return
        end
        digRunning = true
        digRunId += 1
        local myRun = digRunId
        local function alive() return digRunning and digRunId == myRun end

        task.spawn(function()
            local lastWaitMsg
            while alive() do
                pcall(function()
                    local left, reset = digsLeft()
                    if left <= 0 then
                        local msg = "[HustlHub] No digs left, more in " .. math.ceil(reset / 60) .. " min"
                        if msg ~= lastWaitMsg then print(msg); lastWaitMsg = msg end
                        return
                    end
                    lastWaitMsg = nil

                    local spot = digZoneSpot()
                    if not spot then
                        print("[HustlHub] Digsite not found (is Autumn loaded/unlocked?)")
                        return
                    end

                    -- One trip: go to the digsite, use every dig, come back
                    acquireTrip("dig")
                    local root = getRoot()
                    if not root then releaseTrip("dig") return end
                    local startCFrame = root.CFrame
                    -- your best Scavenger pets (+Dig loot) while digging, your team back after.
                    -- Same switch as Pet Defense's ("Scavenger Team For Digging & Pet Defense", on by default)
                    local savedTeam
                    if window.hubCraftTeam and window.Flags["Scavenger Team For Pet Defense"] ~= false then
                        savedTeam = window.hubCraftTeam.snapshot()
                        local okTeam, n = pcall(window.hubCraftTeam.equipFamily, "Scavenger", nil)
                        if okTeam and (n or 0) > 0 then print("[HustlHub] Dig: equipped " .. n .. " Scavenger pets for better loot") end
                    end
                    teleportAndTouch(spot)

                    local done, failsInARow = 0, 0
                    local okDig, digErr = pcall(function()
                        while alive() and digsLeft() > 0 do
                            local outcome = playOneDig(alive) -- direct server calls, no dig UI
                            if outcome == "done" then
                                done += 1
                                failsInARow = 0
                            elseif outcome == "cooldown" then
                                break
                            else
                                failsInARow += 1
                                if failsInARow >= 3 then
                                    print("[HustlHub] Digging failed 3 times in a row, trying again later")
                                    break
                                end
                                task.wait(1)
                            end
                            task.wait(0.5)
                        end
                    end)
                    if not okDig then warn("[HustlHub] Dig error:", digErr) end
                    print("[HustlHub] Digsite trip: finished " .. done .. " digs")
                    if savedTeam then pcall(window.hubCraftTeam.restoreTo, savedTeam) end

                    root = getRoot()
                    if root then
                        window.hubReturnTo(startCFrame)
                    end
                    task.wait(0.5)
                    releaseTrip("dig")
                end)
                releaseTrip("dig")
                task.wait(10)
            end
        end)
    end,
})

end

---------------------------------------------------------------- Auto Pop Balloons (Balloon Party event)
do -- own scope (keeps the top level under Luau's 200-local limit)
-- From the game's BalloonPartyEffects / BalloonFlight / WorldEventConfig:
--   * during the Balloon Party world event, balloons spawn near players and float up for ~25s
--   * the server sends each one through BalloonPartyService.Launched { Uid, Origin, Rise, Phase,
--     LaunchedAt, Size, ... } (GetActive returns the ones already flying)
--   * tapping one fires BalloonPartyService.Hit(uid); allowed within 150 studs, 0.1s apart per balloon
--   * sizes take 1 (Small) to 10 (Golden) hits; Popped(uid) when it bursts, then coins/gems
local BalloonService = Remotes:FindFirstChild("BalloonPartyService")
local balloonHit = BalloonService and BalloonService:FindFirstChild("RE") and BalloonService.RE:FindFirstChild("Hit")
local BalloonCfg, BalloonFlight
pcall(function() BalloonCfg = require(ReplicatedStorage.Shared.Admin.WorldEventConfig).Balloon end)
pcall(function() BalloonFlight = require(ReplicatedStorage.Shared.Admin.BalloonFlight) end)
local HIT_RANGE = (BalloonCfg and BalloonCfg.HitRange or 150) - 8 -- a little margin
local HIT_GAP = (BalloonCfg and BalloonCfg.HitCooldown or 0.1) + 0.03
-- the game stops letting you hit a balloon once it has mostly faded out
local HITTABLE_FOR = BalloonCfg and (BalloonCfg.FlightTime + BalloonCfg.FadeTime * 0.8) or 24
local SIZE_FIRST = { Golden = 5, Giant = 4, Big = 3, Medium = 2, Small = 1 } -- best prizes first

local balloons = {} -- uid -> launch data
local function track(data)
    if type(data) == "table" and type(data.Uid) == "string" and typeof(data.Origin) == "Vector3"
        and type(data.LaunchedAt) == "number" then
        balloons[data.Uid] = data
    end
end
local function balloonPosition(b, now)
    local t = now - b.LaunchedAt
    if BalloonFlight then
        local ok, pos = pcall(BalloonFlight.Position, b, t)
        if ok then return pos end
    end
    return b.Origin + Vector3.new(0, (b.Rise or 4) * math.max(t, 0), 0)
end

local balloonEvents = {}
if BalloonService and BalloonService:FindFirstChild("RE") then
    local re = BalloonService.RE
    if re:FindFirstChild("Launched") then table.insert(balloonEvents, re.Launched.OnClientEvent:Connect(track)) end
    if re:FindFirstChild("Popped") then
        table.insert(balloonEvents, re.Popped.OnClientEvent:Connect(function(uid) balloons[uid] = nil end))
    end
end

local balloonRunning, balloonRunId = false, 0
local poppedCount = 0
connections.balloons = { Disconnect = function()
    balloonRunning = false
    for _, c in ipairs(balloonEvents) do c:Disconnect() end
end }

automationTab:CreateToggle({
    name = "Auto Pop Balloons",
    description = "During the Balloon Party event, pops every balloon within reach (150 studs) as fast as the game allows, golden and giant ones first. Waits quietly when there's no party.",
    callback = function(value)
        balloonRunning = false
        balloonRunId += 1
        if not value then return end
        if not balloonHit then
            window:Notify({ title = "Balloons", content = "Couldn't find the game's balloon system.", duration = 5 })
            return
        end
        balloonRunning = true
        local myRun = balloonRunId
        -- balloons that were already flying before the toggle
        pcall(function()
            local active = safeInvoke(BalloonService.RF.GetActive)
            if type(active) == "table" then
                for _, b in pairs(active) do track(b) end
            end
        end)
        task.spawn(function()
            local lastHit = {}
            while balloonRunning and balloonRunId == myRun do
                local ok, err = pcall(function()
                    local root = getRoot()
                    if not root then return end
                    local now = workspace:GetServerTimeNow()
                    local targets = {}
                    for uid, b in pairs(balloons) do
                        local age = now - b.LaunchedAt
                        if age >= HITTABLE_FOR then
                            balloons[uid] = nil
                            lastHit[uid] = nil
                        elseif age > 0.35 and (balloonPosition(b, now) - root.Position).Magnitude <= HIT_RANGE then
                            table.insert(targets, b)
                        end
                    end
                    table.sort(targets, function(a, b) return (SIZE_FIRST[a.Size] or 0) > (SIZE_FIRST[b.Size] or 0) end)
                    local clock = os.clock()
                    for _, b in ipairs(targets) do
                        if clock - (lastHit[b.Uid] or 0) >= HIT_GAP then
                            lastHit[b.Uid] = clock
                            balloonHit:FireServer(b.Uid)
                        end
                    end
                end)
                if not ok then warn("[HustlHub] Auto Pop Balloons error:", err) end
                task.wait(0.05)
            end
        end)
    end,
})
-- count pops (only while the toggle is on) for the log
if BalloonService and BalloonService:FindFirstChild("RE") and BalloonService.RE:FindFirstChild("Rewarded") then
    table.insert(balloonEvents, BalloonService.RE.Rewarded.OnClientEvent:Connect(function()
        if not balloonRunning then return end
        poppedCount += 1
        if poppedCount % 25 == 0 then print("[HustlHub] Balloons popped:", poppedCount) end
    end))
end

end

