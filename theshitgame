		local lastHeight = 0

		-- remembers the last real height so expanding a collapsed window never tweens to 0
		local function contentHeight()
			local y = layout.AbsoluteContentSize.Y / (library.scaleObj and library.scaleObj.Scale or 1)

			if y > 0 then
				lastHeight = y + 10
			end

			return lastHeight
		end

		layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			if window.toggled and not window.animating then
				tween(container, {Size = UDim2.new(1, 0, 0, contentHeight())}, 0.12)
			end
		end)

		toggleBtn.MouseButton1Click:Connect(function()
			window.toggled = not window.toggled
			toggleBtn.Text = window.toggled and "-" or "+"
			window.token = window.token + 1

			local token = window.token

			if library.openDropdown then
				library.openDropdown()
			end

			window.animating = true
			container.ClipsDescendants = true

			if window.toggled then
				container.Visible = true
				tween(container, {Size = UDim2.new(1, 0, 0, contentHeight())}, 0.18)

				task.delay(0.2, function()
					if window.token == token then
						container.ClipsDescendants = false
						window.animating = false
						container.Size = UDim2.new(1, 0, 0, contentHeight())
					end
				end)
			else
				tween(container, {Size = UDim2.new(1, 0, 0, 0)}, 0.18)

