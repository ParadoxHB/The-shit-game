-- The game's Filters (the results its Auto Enchant stops on) can only hold normal enchants:
-- EnchantConfig.IsFilterable is false for secret / granted ones.
window.hubEnchantAuto = { syncId = 0 } -- (a table on window, not new locals: this scope is at the 200-local limit)
function window.hubEnchantAuto.isFilterable(name)
    return EnchantConfig and EnchantConfig.IsFilterable and EnchantConfig.IsFilterable(name) == true
end
-- Picking targets in the hub saves them straight into the game's Filters (both slots together),
-- so the in-game Enchant window's Filters always show what you picked here.
function window.hubEnchantAuto.syncFilters()
    window.hubEnchantAuto.syncId += 1
    local myId = window.hubEnchantAuto.syncId
    task.delay(0.6, function() -- wait for you to finish ticking
        if myId ~= window.hubEnchantAuto.syncId or enchantRunning then return end -- a running Auto Enchant sets its own
        if not (EnchantRF and EnchantRF:FindFirstChild("SetFilters")) then return end
        local names, seen = {}, {}
        for slot = 1, 2 do
            for name in pairs(slotTargets[slot]) do
                if not seen[name] and window.hubEnchantAuto.isFilterable(name) then
                    seen[name] = true
                    table.insert(names, name)
                end
            end
        end
        if #names == 0 then return end -- (never wipes the game's filters just because nothing is picked)
        local ok, res = pcall(safeInvoke, EnchantRF.SetFilters, names)
        if ok and type(res) == "table" and res.Success then
            print("[HustlHub] Auto Enchant: game Filters set to", table.concat(names, ", "))
        else
            print("[HustlHub] Auto Enchant: couldn't save the game's Filters (" .. tostring(type(res) == "table" and res.Reason or res) .. ")")
        end
    end)
end

