---------------------------------------------------------------- Auto Level Pets (Main tab)
-- From the game's ItemInteractionController / TreatXP / PetLevelConfig: feeding a treat is
-- ItemService.UseOnPet { Item, PetId, Amount }. Treats are items with XP (Data.Items.Owned[name] =
-- how many); some give more to certain pets (Golden Apple: golden pets, ...). Pets level up only
-- after you cross the bridge (Progression.BridgeLowered). Each level adds the same share of the
-- pet's power, so the strongest pets gain the most: those are fed first.
do
local UseOnPet = Remotes:FindFirstChild("ItemService") and Remotes.ItemService.RF:FindFirstChild("UseOnPet")
local ItemCatalog, TreatXP, PetLevelConfig
pcall(function() ItemCatalog = require(ReplicatedStorage.Shared.Items.ItemCatalog) end)
pcall(function() TreatXP = require(ReplicatedStorage.Shared.Items.TreatXP) end)
pcall(function() PetLevelConfig = require(ReplicatedStorage.Shared.Pets.PetLevelConfig) end)
local LEVEL_MODES = { "Equipped Pets", "My Strongest Pets" }
local levelMode = LEVEL_MODES[1]
local levelOn, levelRun = false, 0
local levelStatus
local levelTab = window:CreateTab({ name = "Leveling" })
connections.autoLevel = { Disconnect = function() levelOn = false end }

local function treatDef(name)
    if not ItemCatalog then return nil end
    local ok, def = pcall(function() return ItemCatalog.Get(name) end)
    if ok and type(def) == "table" and type(def.XP) == "number" then return def end
    return nil
end
local function maxLevel(pet)
    local ok, n = pcall(PetLevelConfig.GetMaxLevel, pet.Rarity or "Common")
    return ok and n or 50
end

-- one feeding: the pet that gains the most, with the treat that gives it the most XP each
local function feedOnce()
    local data = getReplica() and getReplica().Data
    if not data then return "Waiting for your data" end
    if PetLevelConfig and PetLevelConfig.LevelingUnlocked and not PetLevelConfig.LevelingUnlocked(data) then
        return "Pets start leveling once you cross the bridge"
    end
    -- treats you have
    local treats = {}
    for name, count in pairs(data.Items and data.Items.Owned or {}) do
        local def = (tonumber(count) or 0) > 0 and treatDef(name)
        if def then table.insert(treats, { name = name, count = count, def = def }) end
    end
    if #treats == 0 then return "No treats to feed" end
    -- pets to level, strongest first
    local owned = getOwnedPets()
    local candidates = {}
    if levelMode == "Equipped Pets" then
        for _, id in pairs(data.Pets.Equipped or {}) do
            if owned[id] then table.insert(candidates, id) end
        end
    else
        for id, pet in pairs(owned) do
            if type(pet) == "table" and pet.Frozen == nil then table.insert(candidates, id) end
        end
    end
    local powerOf = {}
    for _, id in ipairs(candidates) do
        local ok, p = pcall(CraftTeam.power, owned[id])
        powerOf[id] = ok and p or 0
    end
    table.sort(candidates, function(a, b) return powerOf[a] > powerOf[b] end)
    for _, id in ipairs(candidates) do
        local pet = owned[id]
        local top = maxLevel(pet)
        if (pet.Level or 1) < top then
            local need = TreatXP.GetXPToLevel(pet, top)
            local best, bestXP
            for _, treat in ipairs(treats) do
                local ok, xp = pcall(TreatXP.Get, treat.def, pet, 1)
                if ok and type(xp) == "number" and (not bestXP or xp > bestXP) then best, bestXP = treat, xp end
            end
            if best and need > 0 then
                local okAmount, amount = pcall(TreatXP.GetAmountFor, best.def, pet, need)
                amount = math.clamp(okAmount and amount or 1, 1, best.count)
                local ok, result = pcall(function()
                    return safeInvoke(UseOnPet, { ["Item"] = best.name, ["PetId"] = id, ["Amount"] = amount })
                end)
                local before = pet.Level or 1
                task.wait(0.6)
                local after = (getOwnedPets()[id] or pet).Level or before
                if ok and type(result) == "table" and result.Success == false then
                    return "Couldn't feed " .. tostring(pet.Name) .. ": " .. tostring(result.Error or result.Reason)
                end
                local msg = string.format("Fed %d %s to %s: level %d -> %d (max %d)", amount, best.name, tostring(pet.Name), before, after, top)
                print("[HustlHub] Auto Level: " .. msg)
                return msg, true
            end
        end
    end
    return "All picked pets are max level"
end

---------------- Level To Target
-- Pick pets by name + version (e.g. "Cerberus [Rainbow] x255") and a level: the pets are equipped (a team at a
-- time) and level up naturally; when a batch is at that level (or its max) the next pets are equipped. The picks, the level
-- and the switch are saved, so it carries on by itself after you rejoin.
local lvlPicks = {}           -- ordered list of "Name|Tier"
local lvlLabelKey = {}        -- label -> "Name|Tier"
local lvlTarget = 50
local lvlOn, lvlRun = false, 0
local lvlSkipUntil = {}       -- pet id -> time before which it is skipped (the server refused it)
local lvlStatus, lvlDropdown
local lvlAlive = true
connections.levelTarget = { Disconnect = function() lvlOn = false; lvlAlive = false end }

local function lvlOptions()
    table.clear(lvlLabelKey)
    local groups, order = {}, {}
    for _, pet in pairs(getOwnedPets()) do
        if type(pet) == "table" and pet.Name and pet.Frozen == nil then
            local key = tostring(pet.Name) .. "|" .. tostring(pet.Tier or "Normal")
            local lv = tonumber(pet.Level) or 1
            local g = groups[key]
            if not g then
                g = { name = pet.Name, tier = pet.Tier or "Normal", n = 0, lo = lv, hi = lv }
                groups[key] = g
                table.insert(order, key)
            end
            g.n += 1
            g.lo, g.hi = math.min(g.lo, lv), math.max(g.hi, lv)
        end
    end
    table.sort(order)
    local options = {}
    for _, key in ipairs(order) do
        local g = groups[key]
        local tier = g.tier ~= "Normal" and (" [" .. (g.tier == "Shiny" and "Rainbow" or g.tier) .. "]") or ""
        local lv = g.lo == g.hi and (" - Lv " .. g.lo) or (" - Lv " .. g.lo .. "-" .. g.hi)
        local label = g.name .. tier .. (g.n > 1 and (" x" .. g.n) or "") .. lv
        lvlLabelKey[label] = key
        table.insert(options, label)
    end
    return options
end

local function lvlSyncDropdown()
    pcall(function()
        local options = lvlOptions()
        lvlDropdown:Refresh(options)
        local ticked = {}
        for _, key in ipairs(lvlPicks) do
            for _, label in ipairs(options) do
                if lvlLabelKey[label] == key then table.insert(ticked, label) end
            end
        end
        lvlDropdown:Set(ticked, true)
    end)
end

