	function library:CreateHub(title, opts)
		opts = opts or {}
		hubInit()

		local o = library.options
		local W = opts.width or 500
		local H = opts.height or 380
		local railW = (opts.rail == false) and 0 or 108

		local win = types.window(title, o)
		local entry = library.queue[#library.queue]
		local pos = UDim2.new(0, opts.x or 15, 0, opts.y or 20)
		entry.p = pos
		win.object.Size = UDim2.new(0, W, 0, TITLE_H)
		tween(win.object, {Position = pos}, 0.45)

		local body = new("Frame", {
			Name = "HubBody",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, H),
			Parent = win.container,
		})

		local hub = setmetatable({
			win = win,
			root = win.object,
			body = body,
			tabs = {},
			tabByName = {},
			Flags = {},
			elements = {},
			elementsByFlag = {},
			rowsByName = {},
			changeLog = {},
			lastNote = {},
			accents = {},
			query = "",
			menuKey = Enum.KeyCode.RightShift,
