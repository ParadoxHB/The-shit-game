end)
-- (v1.4.43) An account that doesn't follow (Config > All Accounts > "Accounts That Follow", or its Follow button) keeps
-- its OWN settings: it doesn't load the shared config at start either (before, it took everyone's settings again on
-- every launch). Its last reported state is in TapSimHub/follow/status_<name>.json. A brand-new account (no state yet)
-- follows the "New Accounts Follow" switch (TapSimHub/follow/new_default.json).
pcall(function()
    local H = game:GetService("HttpService")
    local function j(path)
        local v
        pcall(function() if isfile(path) then v = H:JSONDecode(readfile(path)) end end)
        return type(v) == "table" and v or nil
    end
    local st = j("TapSimHub/follow/status_" .. LocalPlayer.Name .. ".json")
    local nd = j("TapSimHub/follow/new_default.json")
    if st and st.follow ~= nil then
        window.hubStartFollow = st.follow == true
    elseif not st and nd and nd.follow == false then
        window.hubStartFollow = false
        print("[HustlHub] New account: \"New Accounts Follow\" is off, so this account starts with its own settings")
    end
    if window.hubStartFollow == false then window.hubShared = false end
end)
pcall(function()
    local own = "TapSimHub/" .. window.hubAccountConfig .. ".json"
    if window.hubShared and not isfile("TapSimHub/Shared.json") and isfile(own) then
        writefile("TapSimHub/Shared.json", readfile(own))
    end
end)
