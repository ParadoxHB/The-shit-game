automationTab:CreateToggle({
    name = "Auto Collect Chests",
    description = "Big chests when ready, plus a mini chest sweep every 25s",
    callback = function(value)
        chestRunning = false
        if not value then return end
        if not ChestClaim then
            window:Notify({ title = "Chests", content = "Couldn't find TapChestService.Claim.", duration = 5 })
            return
        end
        chestRunning = true
        chestRunId += 1
        local myRun = chestRunId

        task.spawn(function()
            local lastWaitMsg
            local lastMiniSweep = -math.huge
            local function alive() return chestRunning and chestRunId == myRun end
            while alive() do
                pcall(function()
                    local now = workspace:GetServerTimeNow()
                    local ready, nextAt = {}, math.huge
                    for id in pairs(CHEST_ISLANDS) do
                        local at = chestReadyAt(id)
                        if at <= now then table.insert(ready, id) else nextAt = math.min(nextAt, at) end
                    end
                    local doMini = os.clock() - lastMiniSweep >= MINI_SWEEP_INTERVAL

                    if #ready == 0 and not doMini then
                        local msg = "[HustlHub] No big chests ready, next in " .. math.ceil((nextAt - now) / 60) .. " min"
                        if msg ~= lastWaitMsg then print(msg); lastWaitMsg = msg end
                        return
                    end
                    lastWaitMsg = nil

                    -- Trip: big chests that are ready, then the mini chest sweep, then back where we were
                    acquireTrip("chests")
                    local root = getRoot()
                    if not root then releaseTrip("chests") return end
                    local startCFrame = root.CFrame
                    for _, id in ipairs(ready) do
                        if not alive() then break end
                        collectChest(id)
                    end
                    if doMini and alive() then
                        lastMiniSweep = os.clock()
                        sweepMiniChests(alive)
                    end
                    root = getRoot()
                    if root then
                        window.hubReturnTo(startCFrame)
                    end
                    task.wait(0.5)
                    releaseTrip("chests")
                end)
                releaseTrip("chests") -- in case the trip errored (only releases our own lock)
                task.wait(10)
            end
        end)
    end,
})

