        local n = tonumber((tostring(text):gsub("[^%d%.]", "")))
        if n then lvlTarget = math.clamp(math.floor(n), 1, 1000) end
    end,
})

local function lvlPetsOf(key, owned)
    local name, tier = key:match("^(.-)|(.*)$")
    local list = {}
    for id, pet in pairs(owned) do
        if type(pet) == "table" and pet.Name == name and tostring(pet.Tier or "Normal") == tier and pet.Frozen == nil then
            table.insert(list, id)
        end
    end
    table.sort(list)
    return list
end

local lvlPetRE = Remotes:FindFirstChild("PetService") and Remotes.PetService.RE:FindFirstChild("PetActionRequested")
local lvlBatch = {}       -- the pets equipped and being leveled right now
local lvlSavedTeam        -- your team before the first swap, put back when everything is done

-- every pet of every pick that is still under its goal, in your pick order
local function lvlTodo(owned)
    local todo = {}
    for _, key in ipairs(lvlPicks) do
        for _, id in ipairs(lvlPetsOf(key, owned)) do
            local pet = owned[id]
            local goal = math.min(lvlTarget, maxLevel(pet))
            if (pet.Level or 1) < goal and (lvlSkipUntil[id] or 0) <= os.clock() then
                table.insert(todo, id)
            end
        end
    end
    return todo
end

local function lvlEquip(ids)
    if not lvlPetRE then return end
    if not lvlSavedTeam then
        local ok, snap = pcall(CraftTeam.snapshot)
        if ok then lvlSavedTeam = snap end
    end
    lvlPetRE:FireServer({ ["Action"] = "UnequipAll" })
    task.wait(0.5)
    for _, id in ipairs(ids) do
        lvlPetRE:FireServer({ ["Action"] = "Equip", ["PetId"] = id })
        task.wait(0.3)
    end
end

local function lvlOverview()
    local owned = getOwnedPets()
    local lines = {}
    local total, highest = 0, 0
    for _, pet in pairs(owned) do
        if type(pet) == "table" then
            total += 1
            highest = math.max(highest, tonumber(pet.Level) or 1)
        end
    end
    if #lvlPicks == 0 then
        return "You own " .. total .. " pets, the highest is level " .. highest .. ". Pick pets above to see their levels here."
    end
    for _, key in ipairs(lvlPicks) do
        local name, tier = key:match("^(.-)|(.*)$")
        local ids = lvlPetsOf(key, owned)
        local lo, hi, done = math.huge, 0, 0
        for _, id in ipairs(ids) do
            local pet = owned[id]
            local lv = tonumber(pet.Level) or 1
            lo, hi = math.min(lo, lv), math.max(hi, lv)
            if lv >= math.min(lvlTarget, maxLevel(pet)) then done += 1 end
        end
        local shown = name .. (tier ~= "Normal" and (" [" .. (tier == "Shiny" and "Rainbow" or tier) .. "]") or "")
        if #ids == 0 then
            table.insert(lines, shown .. ": none owned")
        else
            table.insert(lines, string.format("%s: %d pets, Lv %d-%d, %d/%d at target", shown, #ids, lo, hi, done, #ids))
        end
    end
    return table.concat(lines, "\n")
end

local function lvlStep()
    local data = getReplica() and getReplica().Data
    if not data then return "Waiting for your data" end
    if PetLevelConfig and PetLevelConfig.LevelingUnlocked and not PetLevelConfig.LevelingUnlocked(data) then
        return "Pets start leveling once you cross the bridge"
    end
    if #lvlPicks == 0 then return "Pick the pets to level first" end
    local busyWith = window.hubBusyBy(nil)
    if busyWith then
        return "Paused while " .. busyWith .. " is running (it changes your team itself)"
    end
    local owned = getOwnedPets()
    local todo = lvlTodo(owned)
    if #todo == 0 then
        if lvlSavedTeam then
            pcall(CraftTeam.restoreTo, lvlSavedTeam)
            lvlSavedTeam = nil
            lvlBatch = {}
            return "All picked pets are at level " .. lvlTarget .. " (or their max). Your team is back."
        end
        return "All picked pets are at level " .. lvlTarget .. " (or their max)"
    end

    -- the batch being leveled: pets of it that still need levels
    local needSet = {}
    for _, id in ipairs(todo) do needSet[id] = true end
    local current = {}
    for _, id in ipairs(lvlBatch) do
        if needSet[id] then table.insert(current, id) end
    end
    if #current == 0 then
        -- the last batch is at the target: equip the next pets
        local size = math.max(tonumber(data.Pets.EquipLimit) or 4, 1)
        current = {}
        for i = 1, math.min(size, #todo) do current[i] = todo[i] end
        lvlBatch = current
        lvlEquip(current)
        return "Equipped " .. #current .. " pets to level next", true
    end
    lvlBatch = current

    -- nothing is fed: the equipped pets level up on their own as you play. Once every pet of this batch is at
    -- the target (or its max), the next pets are equipped.
    local lowest = math.huge
    for _, id in ipairs(current) do
        lowest = math.min(lowest, tonumber(owned[id].Level) or 1)
    end
    return string.format("Leveling %d equipped pets naturally: lowest is level %d, target %d (%d more pets queued)",
        #current, lowest, lvlTarget, math.max(#todo - #current, 0))
end

levelTab:CreateToggle({
    name = "Auto Level To Target",
    description = "Equips your picked pets (as many as your team holds), lets them level up naturally, and when they all reach the Target Level (or their max) equips the next pets. Nothing is fed. Stays on and carries on after you rejoin.",
    callback = function(value)
        lvlOn = value
        lvlRun += 1
        if not value then
            pcall(function() lvlStatus:Set("Off") end)
            if lvlSavedTeam then pcall(CraftTeam.restoreTo, lvlSavedTeam) lvlSavedTeam = nil lvlBatch = {} end
