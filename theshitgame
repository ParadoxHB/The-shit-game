-- From the game's TotemConfig / ItemInteractionController / ActiveTotemController:
--   * ItemService.PlaceTotem { TotemName, Position } puts a totem down (you own Data.Items.Owned[name])
--   * placed totems show up in workspace.Totems as models with TotemName / OwnerId / World attributes
--     and a "RangeRing" part; a totem boosts you while you're within its Range of that ring
--   * max 5 of your own totems out at once ("TotemLimit")
--   * WeatherDialService.CanUse(kind) then .Use(kind), kind "Acid" / "Rain" (AcidDial / RainDial items)
-- Only works while you're hatching (Auto Hatch or Auto Index) and standing at that egg, so totems
-- always land on the egg you're hatching and never somewhere you just passed through.
do -- own scope (keeps the top level under Luau's 200-local limit)
local TotemConfig
pcall(function() TotemConfig = require(ReplicatedStorage.Shared.Items.TotemConfig) end)
local TOTEM_ORDER = { "TotemOfLuck", "TotemOfSecretLuck", "TotemOfHatchSpeed", "TotemOfClicks", "TotemOfRebirths" }
local totemLabel, labelTotem = {}, {} -- item name <-> dropdown label ("Totem of Luck")
for _, name in ipairs(TOTEM_ORDER) do
    local label = TotemConfig and TotemConfig[name] and TotemConfig[name].DisplayName or name
    totemLabel[name], labelTotem[label] = label, name
end
local DIALS = { ["Acid Dial"] = { item = "AcidDial", kind = "Acid" }, ["Rain Dial"] = { item = "RainDial", kind = "Rain" } }

local pickedTotems, pickedDials = {}, {}
local placeRunning, placeRunId = false, 0
local placeAnywhere = false -- "Use Totems & Dials Even When Not Hatching": no egg needed, totems go where you stand
local placeStatus
connections.autoTotems = { Disconnect = function() placeRunning = false end }

local function ownedItem(name)
    local n = 0
    pcall(function() n = tonumber(getReplica().Data.Items.Owned[name]) or 0 end)
    return n
end
local function currentWorld()
    local w
    pcall(function() w = getReplica().Data.Progression.World end)
    return w or "Main"
end
-- your totems of this kind: how many cover pos, how many are out anywhere; plus all your totems out
local MAX_PER_KIND = 3 -- the game lets you have up to 3 of the same totem out at once
local function totemState(totemName, pos)
    local covering, kindOut, mine = 0, 0, 0
    local folder = workspace:FindFirstChild("Totems")
    if not folder then return covering, kindOut, mine end
    local world = currentWorld()
    for _, child in ipairs(folder:GetChildren()) do
        local name, owner, w = child:GetAttribute("TotemName"), child:GetAttribute("OwnerId"), child:GetAttribute("World")
        if owner == LocalPlayer.UserId then
            mine += 1
            if name == totemName then
                kindOut += 1
                if type(w) ~= "string" or w == world then
                    local ring = child:FindFirstChild("RangeRing")
                    local range = TotemConfig and TotemConfig[name] and TotemConfig[name].Range or 12
                    -- a little inside the edge, so you're still covered after small nudges
                    if ring and ring:IsA("BasePart") and (ring.Position - pos).Magnitude <= range - 2 then covering += 1 end
                end
            end
        end
    end
    return covering, kindOut, mine
end
-- the egg you're hatching right now, if you're standing at it
local function hatchingEgg()
    local info = window.hubHatchInfo and window.hubHatchInfo()
    if not (info and info.running and info.egg) then return nil end
    local model = workspace:FindFirstChild("Eggs") and workspace.Eggs:FindFirstChild(info.egg)
    local root = getRoot()
    if not (model and root) then return nil end
    if (model:GetPivot().Position - root.Position).Magnitude > 30 then return nil end -- away (e.g. on a craft trip)
    return info.egg, root
end

