local function fmtPower(n)
    for _, u in ipairs({ { 1e18, "Qi" }, { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }) do
        if n >= u[1] then return string.format("%.3g", n / u[1]) .. u[2] end
    end
    return string.format("%d", math.floor(n))
end
