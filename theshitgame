-- Eggs on other islands aren't in workspace.Eggs until that island streams in, so the egg list
-- comes from the game's egg config (every egg + which island it's on), and EggWorld.load goes
-- and gets an egg's island loaded before anything stands at it.
local EggWorld = {
    -- where the eggs are (from the place files); the rest are found through their island
    EGG_SPOTS = {
        Basic = Vector3.new(5.89, -511.31, -1832.656), Spotted = Vector3.new(-4.905, -511.232, -1821.815),
        Spiked = Vector3.new(-23.029, -511.825, -1707.151), Nimbus = Vector3.new(-96.385, -47.258, -1891.349),
        Sky = Vector3.new(-88.715, -46.622, -1904.324), Cactus = Vector3.new(-202.507, 3632.548, -1862.847),
    },
    -- a spot on the ground of each island (the measured landing spots)
    ISLAND_SPOTS = {
        Spawn = Vector3.new(-50.434, -515.985, -1845.911),
        ["Sky Island"] = Vector3.new(16.619, -58.316, -1795.621),
        Autumn = Vector3.new(-30.439, 873.267, -1706.748),
        Mushroom = Vector3.new(-133.329, 2021.063, -1685.252),
        Desert = Vector3.new(-90.746, 3614.173, -1650.009),
        ["Crystal Cave"] = Vector3.new(30.977, 5451.565, -1664.016),
        ["Shadow Realm"] = Vector3.new(-158.787, 7676.945, -1641.903),
        -- Volcano (new): no measured landing spot yet (its ground wasn't in the place file), so this
        -- is just above its region slab (5, 10965, -1850) and is only used to ask the game to load
        -- the area; the hub never teleports there blind (see UNMEASURED)
        Volcano = Vector3.new(5, 11015, -1850),
        -- Heaven (island 8, Oct 24 update; price 2.5e18 coins, x3.5): its region slab is IslandParts.Heaven at
        -- (-30, 15244, -1910); the "Heaven" egg is there. Same as Volcano: only used to load the area
        Heaven = Vector3.new(-30, 15294, -1910),
    },
    UNMEASURED = { Volcano = true, Heaven = true }, -- islands with no safe landing spot: load by streaming / the game's Travel
}
-- the game's own island travel (lands you safely on the island)
function EggWorld.travel(island)
    local ok, result = pcall(function()
        local rf = Remotes.IslandService.RF:FindFirstChild("Travel")
        return rf and safeInvoke(rf, { ["Island"] = island, ["Source"] = "Portal" })
    end)
    return ok and type(result) == "table" and result.Success == true
end
function EggWorld.config()
    if EggWorld.cfg == nil then
        local ok, mod = pcall(function() return require(ReplicatedStorage.Shared.Pets.LaunchEggConfig) end)
        EggWorld.cfg = ok and type(mod) == "table" and mod or false
    end
    return EggWorld.cfg or nil
end
-- an egg that's in the world: on the spawn island or on one of the islands (old removed eggs and
-- "Test" aren't), or one that's loaded right now
function EggWorld.exists(name)
    if not name then return false end
    if EggsFolder:FindFirstChild(name) then return true end
    local cfg = EggWorld.config()
    local egg = cfg and cfg[name]
    return type(egg) == "table" and egg.Pets ~= nil and name ~= "Test" and (egg.Island ~= nil or egg.Zone == "Spawn")
end
function EggWorld.islandOf(name)
    local cfg = EggWorld.config()
    local egg = cfg and cfg[name]
    return type(egg) == "table" and egg.Island or "Spawn"
end
-- the egg's model with its "Egg" part loaded, going to its island first if it isn't (nil if it can't)
function EggWorld.load(name, quiet)
    local function loaded()
        local model = EggsFolder:FindFirstChild(name)
        return model and model:FindFirstChild("Egg") and model or nil
    end
    if not name then return nil end
    local model = loaded()
    if model then return model end
    local target = EggWorld.EGG_SPOTS[name] or EggWorld.ISLAND_SPOTS[EggWorld.islandOf(name)]
    if not target then return EggsFolder:FindFirstChild(name) end
    -- ask the game to load that area without moving first. In the background: this request can
    -- hang for a very long time, which froze Auto Index on "Loading the ... egg's island"
    task.spawn(function()
        pcall(function() LocalPlayer:RequestStreamAroundAsync(target, 5) end)
    end)
    local t = os.clock()
    while not loaded() and os.clock() - t < 2 do task.wait(0.2) end
    model = loaded()
    if model then return model end
    -- still not there: go to it (near the egg if we know where it is, else onto its island)
    if not quiet then print("[HustlHub] " .. name .. " egg isn't loaded, going to " .. EggWorld.islandOf(name) .. " to load it") end
    local island = EggWorld.islandOf(name)
    if EggWorld.UNMEASURED[island] and not EggWorld.EGG_SPOTS[name] then
        -- no safe spot known: give the stream request longer, then let the game's Travel take us there
        t = os.clock()
        while not loaded() and os.clock() - t < 6 do task.wait(0.25) end
        if not loaded() and not EggWorld.travel(island) and not quiet then
            print("[HustlHub] Couldn't travel to " .. island .. " (is it unlocked?)")
        end
    else
        local offset = EggWorld.EGG_SPOTS[name] and Vector3.new(0, 2, 10) or Vector3.new(0, 4, 0)
        teleportAndTouch(CFrame.new(target + offset))
    end
    t = os.clock()
    while not loaded() and os.clock() - t < 10 do task.wait(0.25) end
    model = loaded()
    if not model and not quiet then print("[HustlHub] Couldn't load the " .. name .. " egg (is " .. EggWorld.islandOf(name) .. " unlocked?)") end
    return model
end

local function getEggNames()
    local names, seen = {}, {}
    local function add(name)
        if not seen[name] and EggWorld.exists(name) then
            seen[name] = true
            table.insert(names, name)
        end
    end
    for _, egg in ipairs(EggsFolder:GetChildren()) do add(egg.Name) end
    for name in pairs(EggWorld.config() or {}) do add(name) end
    -- cheapest first (the order you unlock them in)
    local cfg = EggWorld.config() or {}
    table.sort(names, function(a, b)
        local pa, pb = type(cfg[a]) == "table" and cfg[a].Price or math.huge, type(cfg[b]) == "table" and cfg[b].Price or math.huge
        if pa ~= pb then return pa < pb end
        return a < b
    end)
    return names
end

