-- Tap sequence numbers: the server ignores taps whose ClientSequence is lower than one it has
-- already seen from you in this server (checked live: after re-running the hub its taps started
-- again at 0 and none counted, which is why the Hallow Boss took no damage). So the count carries
-- on from the last run (getgenv), and if the server stops confirming our taps for 3 seconds the
-- count jumps ahead so they're accepted again.
local clientSequence = tonumber(getgenv().HustlHubTapSeq) or 0
do
    local lastAck, lastSentAt, sentSinceAck = os.clock(), 0, 0
    local seenSeq = clientSequence
    pcall(function()
        connections.tapSeqAck = Remotes.TapService.RE.TapResult.OnClientEvent:Connect(function(r)
            if type(r) == "table" and r.ClientSequence and not r.IsAuto then lastAck = os.clock() sentSinceAck = 0 end
        end)
    end)
    task.spawn(function()
        while true do
            task.wait(1)
            if clientSequence ~= seenSeq then -- taps were sent this second
                sentSinceAck += clientSequence - seenSeq
                seenSeq = clientSequence
                lastSentAt = os.clock()
            end
            getgenv().HustlHubTapSeq = clientSequence
            if sentSinceAck > 20 and os.clock() - lastAck > 3 and os.clock() - lastSentAt < 2 then
                clientSequence += 1000000
                seenSeq = clientSequence
                sentSinceAck = 0
                lastAck = os.clock()
                print("[HustlHub] Taps weren't being counted (old sequence numbers), jumped the tap count ahead")
            end
        end
    end)
end


