-- Rayfield has no per-element colors, so we find each element's frame in the GUI
-- (by its label text) and lay a colored outline on top of it.
local pendingOutlines = {} -- label text -> Color3
local outlinesRunning = true
connections.outlines = { Disconnect = function() outlinesRunning = false end }

local function findElementFrame(label)
    -- Walk up from the label to the element's card: the first ancestor with a UIStroke
    -- that's element-sized (not the whole window)
    local node = label.Parent
    while node and node:IsA("GuiObject") do
        if node:FindFirstChildOfClass("UIStroke") and node.AbsoluteSize.Y > 0 and node.AbsoluteSize.Y < 150 then
            return node
        end
        node = node.Parent
    end
    return nil
end

local function addOutline(frame, color)
    if frame:FindFirstChild("HubOutline") then return end
    local overlay = Instance.new("Frame")
    overlay.Name = "HubOutline"
    overlay.BackgroundTransparency = 1
    overlay.Size = UDim2.fromScale(1, 1)
    overlay.ZIndex = frame.ZIndex + 5
    local corner = frame:FindFirstChildOfClass("UICorner")
    if corner then corner:Clone().Parent = overlay end
    local stroke = Instance.new("UIStroke")
    stroke.Color = color
    stroke.Thickness = 1.5
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = overlay
    overlay.Parent = frame
end

local function outlineLabel(text, color)
    if window.Accent then -- game-style menu: it colors the row itself
        window:Accent(text, color)
        return
    end
    pendingOutlines[text] = color
end

