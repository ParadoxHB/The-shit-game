local function bouncyProgress()
    local replica = getReplica()
    local data = replica and replica.Data or {}
    local obby = type(data.BouncyObby) == "table" and data.BouncyObby or {}
    local slime = data.Items and data.Items.Owned and data.Items.Owned.Slime or 0
    return {
        key = obby.Key == true,
        checkpoint = tonumber(obby.Checkpoint) or 0,
        licensed = data.Unlocks and data.Unlocks.BouncyBallLicense == true,
        slime = tonumber(slime) or 0,
    }
end

local function onCourse()
    return LocalPlayer:GetAttribute("BouncyObbyActive") == true
end

-- Finds checkpoint parts (index -> part) and the finish part in the course
local function scanCourse()
    local course = workspace:FindFirstChild("BouncyObby")
    local checkpoints, finish = {}, nil
    if course then
        for _, part in ipairs(course:GetDescendants()) do
            if part:IsA("BasePart") then
                local index = part:GetAttribute("CheckpointIndex")
                if type(index) == "number" then checkpoints[index] = part end
                if part:GetAttribute("Finish") == true then finish = part end
            end
        end
    end
    return checkpoints, finish
end

local function standOn(part)
    teleportAndTouch(part.CFrame + Vector3.new(0, part.Size.Y / 2 + 3, 0))
end

local bouncyBusy = false

local function runBouncyCourse()
    if bouncyBusy then
        window:Notify({ title = "Bouncy Ball", content = "Already running.", duration = 3 })
        return
    end
    bouncyBusy = true
    acquireTrip("bouncy")
    local root = getRoot()
    local startCFrame = root and root.CFrame

    local ok, err = pcall(function()
        local progress = bouncyProgress()

        -- 1) Key: the game needs a Bouncy Key to enter
        if not progress.key and not onCourse() then
            if progress.slime < SLIME_PER_KEY then
                window:Notify({ title = "Bouncy Ball", content = "You need a Bouncy Key: " .. SLIME_PER_KEY .. " Slime (you have " .. progress.slime .. ").", duration = 6 })
                return
            end
            local crafted = bouncyCall("CraftKey")
            print("[HustlHub] Bouncy Ball: craft key ->", crafted.Success and "ok" or tostring(crafted.Reason))
            task.wait(0.5)
        end

        -- 2) Enter the course
        if not onCourse() then
            local entered = bouncyCall("Enter")
            if entered.Success ~= true then
                window:Notify({ title = "Bouncy Ball", content = "Couldn't enter: " .. tostring(entered.Reason), duration = 5 })
                return
            end
            local t = os.clock()
            while not onCourse() and os.clock() - t < 6 do task.wait(0.2) end
        end
        local runStart = os.clock()
        task.wait(1.5) -- let the course stream in

        -- 3) Every checkpoint in order
        local total = workspace:GetAttribute("BouncyObbyCheckpoints")
        local checkpoints, finish = scanCourse()
        if type(total) ~= "number" then
            total = 0
            for index in pairs(checkpoints) do total = math.max(total, index) end
        end
        print("[HustlHub] Bouncy Ball: " .. total .. " checkpoints")

        -- Spread the checkpoints over the run so the finish lands just after the 45s minimum
        local perCheckpoint = (MIN_FINISH + FINISH_MARGIN) / math.max(total + 1, 1)
        for index = bouncyProgress().checkpoint + 1, total do
            if not onCourse() then break end
            local part = checkpoints[index] or select(1, scanCourse())[index]
            if part then
                local stepStart = os.clock()
                standOn(part)
                -- Make sure the server saved it (the touch normally does this)
                if bouncyProgress().checkpoint < index then
                    local reached = bouncyCall("Reach", { Index = index })
                    if reached.Success ~= true then
                        print("[HustlHub] Bouncy Ball: checkpoint " .. index .. " not saved (" .. tostring(reached.Reason) .. ")")
                    end
                end
                local spare = perCheckpoint - (os.clock() - stepStart)
                if spare > 0 then task.wait(spare) end
            else
                print("[HustlHub] Bouncy Ball: checkpoint " .. index .. " not found")
            end
        end

        -- 4) Finish (after the minimum time)
        local remaining = MIN_FINISH + FINISH_MARGIN - (os.clock() - runStart)
        if remaining > 0 then task.wait(remaining) end
        finish = finish or select(2, scanCourse())
        if finish then standOn(finish) end
        task.wait(0.5)
        local result = bouncyCall("Finish")
        if result.Success == true then
            local msg = result.First and "License earned!" or
                ("Finished in " .. string.format("%.1f", tonumber(result.Time) or 0) .. "s (best " .. string.format("%.1f", tonumber(result.Best) or 0) .. "s)")
            print("[HustlHub] Bouncy Ball: " .. msg)
            window:Notify({ title = "Bouncy Ball", content = msg, duration = 6 })
        elseif LocalPlayer:GetAttribute("BouncyObbyFinalTime") ~= nil then
            print("[HustlHub] Bouncy Ball: finished (the touch already counted it)")
        else
            window:Notify({ title = "Bouncy Ball", content = "Finish rejected: " .. tostring(result.Reason), duration = 6 })
        end

        -- 5) Leave the course
        task.wait(2)
        if onCourse() then bouncyCall("Leave") end
        task.wait(1)
    end)
    if not ok then warn("[HustlHub] Bouncy Ball error:", err) end

    root = getRoot()
    if root and startCFrame then
        window.hubReturnTo(startCFrame)
    end
    releaseTrip("bouncy")
    bouncyBusy = false
end

automationTab:CreateButton({
    name = "Run Bouncy Ball Course",
    description = "Crafts a key if needed (20 Slime), runs every checkpoint, finishes just after the 45s minimum",
    callback = function()
        task.spawn(runBouncyCourse)
    end,
})
end

---------------------------------------------------------------- Auto Fish (v1.4.59)
-- From the game's FishingController / FishingConfig (read live): FishingService remotes Cast(rodId, bait, load, {X, Z, T}),
-- Reel(rodId), Collect() (empties the bowl), Buy(shopId), ClaimGift(). Rods keep fishing on their own after a cast
-- (a bait catches a fish every Interval seconds), Reel brings the catch into the bowl, Collect claims the bowl.
do -- own scope (keeps the top level under Luau's 200-local limit)
    local FishCfg
    pcall(function() FishCfg = require(ReplicatedStorage.Shared.Minigames.Fishing.FishingConfig) end)
    local FishRF = Remotes:FindFirstChild("FishingService") and Remotes.FishingService:FindFirstChild("RF")
    local fishOn, fishRun = false, 0
    local fishBaits = { "Worm" } -- (v1.4.60) every ticked bait, in the order picked; rod N casts with baits[N]
    local fishStatus
    local fstate = {}
    connections.autoFish = { Disconnect = function() fishOn = false end }
    local BAITS = { "Worm", "Cricket", "Shrimp", "Firefly", "GoldenWorm", "RainbowSquid" }

    local function fdata()
        local r = getReplica()
        local f = r and r.Data and r.Data.Fishing
        return type(f) == "table" and f or nil
    end
    local function call(name, ...)
        local rf = FishRF and FishRF:FindFirstChild(name)
        if not rf then return nil end
        local args = table.pack(...)
        local ok, res = pcall(function() return safeInvoke(rf, table.unpack(args, 1, args.n)) end)
        return ok and res or nil
    end
    local function reason(res)
        if type(res) ~= "table" then return tostring(res) end
        return tostring(res.Error or res.Reason or res.Message or "no reason")
    end
    local function baitCount(f, name) return tonumber(f.Bait and f.Bait[name]) or 0 end
    local function bowlCount(f)
        local n = 0
        for _, v in pairs(type(f.Bowl) == "table" and f.Bowl or {}) do
            n += type(v) == "number" and v or 1
        end
        return n
    end
    local function bowlCap(d)
        local ok, size = pcall(FishCfg.BowlSize, d)
        if ok and type(size) == "number" and size > 0 then return size end
        return tonumber(FishCfg.BowlBase) or 10
    end
    local function setStatus(t) pcall(function() fishStatus:Set(t) end) end

    -- the spot's position (its model is only loaded near it): the model, else any tagged spot part
    local function spotInfo(spot)
        local model
        pcall(function() model = FishCfg.FindSpotModel(spot) end)
        if not model then pcall(function() model = FishCfg.FindSpotModel(spot.Id) end) end
        if not model then
            for _, inst in ipairs(game:GetService("CollectionService"):GetTagged(FishCfg.Tag or "FishingSpot")) do
                local id = inst:GetAttribute("Id") or inst:GetAttribute("SpotId") or inst.Name
                if id == spot.Id then model = inst break end
            end
        end
        if not model then return nil end
        local ok, pos = pcall(function() return model:GetPivot().Position end)
        return ok and { model = model, pos = pos } or nil
    end
    local function mountPos(info, slot)
        local pos = info.pos
        pcall(function()
            local m = FishCfg.FindRodMount(info.model, slot)
            if typeof(m) == "Instance" then pos = m:GetPivot().Position
            elseif typeof(m) == "CFrame" then pos = m.Position
            elseif typeof(m) == "Vector3" then pos = m end
        end)
        return pos
    end

    -- buy bait of the picked kind when it runs low (the shop's rotating offers; ones not on sale just answer an error)
    local buyBlocked = {}
    local function buyBaitKind(want)
        local max = FishCfg.Cast and FishCfg.Cast.Load or 10
        local offers = {}
        for id, o in pairs(FishCfg.Shop and FishCfg.Shop.ById or {}) do
            if o.Bait == want and not o.Currency then table.insert(offers, o) end
        end
        table.sort(offers, function(a, b) return (a.Amount or 0) > (b.Amount or 0) end)
        for _ = 1, 6 do -- keep buying until this bait is back at the max a cast can load
            local cur = fdata()
            if not cur or baitCount(cur, want) >= max then return end
            local bought = false
            for _, o in ipairs(offers) do
                if (buyBlocked[o.Id] or 0) < os.clock() then
                    local res = call("Buy", o.Id)
                    if type(res) == "table" and res.Success then
                        print("[HustlHub] Auto Fish: bought " .. tostring(o.Amount) .. " " .. want)
                        bought = true
                        task.wait(0.3)
                        break
                    end
                    buyBlocked[o.Id] = os.clock() + 120
                end
            end
            if not bought then return end
        end
    end
    local function buyBait(f)
        for _, want in ipairs(fishBaits) do buyBaitKind(want) end
    end

    local castSpots = {} -- rodId -> the offset that worked last time
    local function castRod(f, rodId, info, slot)
        -- bait: the free Lucky Worm gift first, then the picked one, then anything you have
        -- (v1.4.60) the rod's own pick (slot 1 -> first ticked bait, slot 2 -> second, ...), then any other ticked one
        local bait
        if baitCount(f, "LuckyWorm") > 0 then bait = "LuckyWorm" end
        if not bait and #fishBaits > 0 then
            local own = fishBaits[((slot or 1) - 1) % #fishBaits + 1]
            if baitCount(f, own) > 0 then bait = own end
        end
        if not bait then
            for _, b in ipairs(fishBaits) do if baitCount(f, b) > 0 then bait = b break end end
        end
        if not bait then
            for _, b in ipairs(FishCfg.BaitOrder or {}) do if baitCount(f, b) > 0 then bait = b break end end
        end
        if not bait then return false, "no bait" end
        local load = math.min(baitCount(f, bait), FishCfg.Cast.Load or 10)
        local base = mountPos(info, slot)
        local tries = {}
        if castSpots[rodId] then table.insert(tries, castSpots[rodId]) end
        for _, dist in ipairs({ 16, 22, 12, 28, 8 }) do
            for a = 0, 330, 30 do table.insert(tries, { a, dist }) end
        end
        local last
        for _, t in ipairs(tries) do
            if not fishOn then return false, "stopped" end
            local r = math.rad(t[1])
            local res = call("Cast", rodId, bait, load, { X = base.X + math.cos(r) * t[2], Z = base.Z + math.sin(r) * t[2], T = workspace:GetServerTimeNow() })
            if type(res) == "table" and res.Success then
                castSpots[rodId] = t
                return true, bait
            end
            last = reason(res)
            if last:lower():find("bait") or last:lower():find("busy") or last:lower():find("reel") or last:lower():find("far") then break end
            task.wait(0.15)
        end
        return false, last or "no answer"
    end

    -- (v1.4.60) a rod that's cast with less than the max load while you now own enough bait to fill it gets reeled and
    -- recast. The rod entry's field names aren't known here, so look for a numeric load/remaining-style field (and log
    -- the entry once, so the real names show up in the console).
    local loggedRod = false
    local function rodLow(f, entry)
        if type(entry) ~= "table" then return false end
        local max = FishCfg.Cast and FishCfg.Cast.Load or 10
        if not loggedRod then
            loggedRod = true
            local parts = {}
            for k, v in pairs(entry) do table.insert(parts, tostring(k) .. "=" .. tostring(v)) end
            print("[HustlHub] Auto Fish: rod entry { " .. table.concat(parts, ", ") .. " }")
        end
        local have = 0
        for _, b in ipairs(fishBaits) do have = math.max(have, baitCount(f, b)) end
        have = math.max(have, baitCount(f, "LuckyWorm"))
        for k, v in pairs(entry) do
            if type(v) == "number" and type(k) == "string" then
                local lk = k:lower()
                if lk:find("load") or lk:find("remain") or lk:find("left") or lk:find("uses") or lk:find("bait") then
                    return v < max and have >= max
                end
            end
        end
        return false
    end

    local function fishRound(myRun)
        local f = fdata()
        if not f or not FishCfg or not FishRF then setStatus("Waiting for your fishing data") return end
        pcall(function() call("ClaimGift") end)
        pcall(buyBait, f)
        f = fdata() or f
        local d = getReplica().Data
        local msgs = {}
        -- bowl: claim it once it is full (or has been holding fish a while)
        -- (v1.4.60) it goes to the fishing spot to claim it, then returns to what it was doing
        local count, cap = bowlCount(f), bowlCap(d)
        local bowlDue = count >= cap or (count > 0 and os.clock() - (fstate.lastCollect or 0) > 600)
        local collected = false
        local function collectBowl()
            local n = bowlCount(fdata() or f)
            local res = call("Collect")
            fstate.lastCollect = os.clock()
            collected = true
            table.insert(msgs, (type(res) == "table" and res.Success) and ("claimed the bowl (" .. n .. ")") or ("bowl: " .. reason(res)))
        end
        -- rods: reel anything hooked, then cast empty rods
        for _, spot in pairs(FishCfg.Spots or {}) do
            local island = spot.Island
            local unlocked = d.Progression and d.Progression.UnlockedIslands
            if not island or type(unlocked) ~= "table" or unlocked[island] == true then
                local need = false
                local rods = type(f.Rods) == "table" and f.Rods or {}
                for slot = 1, spot.Slots or 1 do
                    local rodId = FishCfg.RodId(spot.Id, slot)
                    if rods[rodId] == nil or os.clock() - (fstate["reel" .. rodId] or 0) > 90 or rodLow(f, rods[rodId]) then need = true end
                end
                if bowlDue and not collected then need = true end
                if need and not (window.hubHatchInfo and window.hubHatchInfo().running) then
                    acquireTrip("fish")
                    local root = getRoot()
                    local home = root and root.CFrame
                    local ok, err = pcall(function()
                        local info = spotInfo(spot)
                        if not info then
                            if spot.Island then
                                pcall(function() safeInvoke(Remotes.IslandService.RF.Travel, { ["Island"] = spot.Island, ["Source"] = "Portal" }) end)
                            end
                            local t0 = os.clock()
                            repeat task.wait(0.5) info = spotInfo(spot) until info or os.clock() - t0 > 10
                        end
                        if not info then table.insert(msgs, spot.Name .. ": couldn't load the spot") return end
                        teleportAndTouch(CFrame.new(mountPos(info, 1) + Vector3.new(0, 4, 0)))
                        task.wait(0.5)
                        for slot = 1, spot.Slots or 1 do
                            if not (fishOn and fishRun == myRun) then break end
                            local rodId = FishCfg.RodId(spot.Id, slot)
                            local res = call("Reel", rodId)
                            fstate["reel" .. rodId] = os.clock()
                            if type(res) == "table" and res.Success then table.insert(msgs, "reeled " .. rodId) end
                            task.wait(0.4)
                            f = fdata() or f
                            if (type(f.Rods) == "table" and f.Rods[rodId]) == nil then
                                local okc, why = castRod(f, rodId, info, slot)
                                table.insert(msgs, okc and ("cast " .. rodId .. " with " .. tostring(why)) or (rodId .. ": " .. tostring(why)))
                                task.wait(0.8)
                                f = fdata() or f
                            end
                        end
                        if bowlDue and not collected and fishOn then collectBowl() end
                    end)
                    if not ok then warn("[HustlHub] Auto Fish error:", err) end
                    local back = getRoot()
                    if back and home then window.hubReturnTo(home) end
                    task.wait(0.3)
                    releaseTrip("fish")
                end
            end
        end
        if bowlDue and not collected and fishOn then collectBowl() end -- couldn't reach a spot: claim from here
        f = fdata() or f
        local owned = {}
        for _, b in ipairs(BAITS) do
            local n = baitCount(f, b)
            if n > 0 then table.insert(owned, b .. " x" .. n) end
        end
        setStatus(string.format("Bowl %d/%d | Bait: %s%s", bowlCount(f), bowlCap(d), #owned > 0 and table.concat(owned, ", ") or "none",
            #msgs > 0 and ("\n" .. table.concat(msgs, ", ")) or ""))
        if #msgs > 0 then print("[HustlHub] Auto Fish: " .. table.concat(msgs, ", ")) end
    end

    automationTab:CreateSection({ name = "Fishing" })
    automationTab:CreateDropdown({
        name = "Fishing Bait",
        description = "Tick every bait you want: Auto Fish keeps each one topped up to the max and rod 1 casts the first, rod 2 the second, rod 3 the third (it wraps if you tick fewer). Lucky Worm gifts are always used first.",
        options = BAITS,
        multiSelect = true,
        value = { "Worm" },
        callback = function(selected)
            table.clear(fishBaits)
            for _, b in ipairs(type(selected) == "table" and selected or { selected }) do table.insert(fishBaits, b) end
            if #fishBaits == 0 then table.insert(fishBaits, "Worm") end
        end,
    })
    automationTab:CreateToggle({
        name = "Auto Fish",
        description = "Claims your fishing bowl when it is full, buys the picked bait when it runs low (and claims the free Lucky Worm gift), reels in finished catches and casts your rods again. Pops over to the fishing spot and back.",
        callback = function(value)
            fishOn = false
            fishRun += 1
            if not value then setStatus("Off") return end
            if not (FishCfg and FishRF) then
                window:Notify({ title = "Auto Fish", content = "Couldn't find the game's fishing.", duration = 5 })
                return
            end
            fishOn = true
            local myRun = fishRun
            task.spawn(function()
                while fishOn and fishRun == myRun and getgenv().HustlHubRun == HH_RUN do
                    local ok, err = pcall(fishRound, myRun)
                    if not ok then warn("[HustlHub] Auto Fish error:", err) setStatus("Error: " .. tostring(err)) end
                    task.wait(20)
                end
            end)
        end,
    })
    fishStatus = automationTab:CreateText({ name = "Auto Fish Status", text = "Off" })
end

---------------------------------------------------------------- Auto Memory Match
do -- own scope (keeps the top level under Luau's 200-local limit)
-- From the game's MemoryMatchController / MemoryMatchConfig:
--   * 12 cards = 6 pairs, 12 attempts, a free game every 30 min (state.NextPlay)
--   * must be at workspace.MemoryMatch (standing on its TouchToPlay pad opens the board)
--   * MemoryMatchService: Open(play) -> state, Flip(state.Id, cardIndex) -> state
--   * state.Cards[i] = { Pet = name when face up, Matched = true/false }; after a miss you can't
--     flip again until state.UnlockAt; flips at least 0.18s apart
-- Plays through the game's own controller so you see the board, and remembers every card seen.
local FLIP_GAP = 0.25
local CARD_COUNT = 12

local function timedRequire(module, seconds)
    local result, done = nil, false
    task.spawn(function()
        local ok, r = pcall(require, module)
        if ok then result = r end
        done = true
    end)
    local start = os.clock()
    while not done and os.clock() - start < (seconds or 3) do task.wait() end
    return result
end

local Minigames = ReplicatedStorage.Controllers:FindFirstChild("Minigames")
local MatchController = Minigames and Minigames:FindFirstChild("MemoryMatchController")
    and timedRequire(Minigames.MemoryMatchController)

local function matchRemote(name)
    return Remotes:FindFirstChild("MemoryMatchService") and Remotes.MemoryMatchService.RF:FindFirstChild(name)
end

local currentState -- latest board state from the server

-- Each action goes through the game's controller (shows the board); falls back to the server call
local function matchOpen(play)
    local result
    if MatchController then
        local ok, r = pcall(function()
            if play then return MatchController:Play() end
            return MatchController:Open()
        end)
        result = ok and r or nil
        if not result then
            local ok2, s = pcall(function() return MatchController:GetState() end)
            result = ok2 and s or nil
        end
    end
    if not result and matchRemote("Open") then
        local ok, r = pcall(function() return safeInvoke(matchRemote("Open"), play) end)
        result = ok and r or nil
    end
    if type(result) == "table" and not result.Error then currentState = result end
    return result
end

local function matchFlip(index)
    local result
    if MatchController then
        local ok, r = pcall(function() return MatchController:Flip(index) end)
        result = ok and r or nil
    end
    if not result and currentState and matchRemote("Flip") then
        local ok, r = pcall(function() return safeInvoke(matchRemote("Flip"), currentState.Id, index) end)
        result = ok and r or nil
    end
    if type(result) == "table" and not result.Error then currentState = result end
    return result
end

local function waitForUnlock()
    while currentState and workspace:GetServerTimeNow() < (currentState.UnlockAt or 0) do
        task.wait(0.05)
    end
end

-- Plays one full game, remembering every pet it sees
local function solveBoard(stillRunning)
    local known = {} -- card index -> pet name
    local function learn(state)
        for i = 1, CARD_COUNT do
            local card = state and state.Cards and state.Cards[i]
            if card and card.Pet then known[i] = card.Pet end
        end
    end
    local function isMatched(i)
        local card = currentState and currentState.Cards and currentState.Cards[i]
        return card and card.Matched == true
    end
    local function knownPair()
        local seen = {}
        for i = 1, CARD_COUNT do
            if not isMatched(i) and known[i] then
                if seen[known[i]] then return seen[known[i]], i end
                seen[known[i]] = i
            end
        end
    end
    local function partnerOf(a)
        for i = 1, CARD_COUNT do
            if i ~= a and not isMatched(i) and known[i] and known[i] == known[a] then return i end
        end
    end
    local function firstUnknown(except)
        for i = 1, CARD_COUNT do
            if i ~= except and not isMatched(i) and not known[i] then return i end
        end
        for i = 1, CARD_COUNT do -- nothing unknown left: any unmatched card
            if i ~= except and not isMatched(i) then return i end
        end
    end
    local function flip(i)
        if not i then return end
        waitForUnlock()
        for _ = 1, 3 do
            local r = matchFlip(i)
            if type(r) == "table" and not r.Error then learn(r) break end
            task.wait(0.3)
        end
        task.wait(FLIP_GAP)
    end

    learn(currentState)
    local guard = 0
    while stillRunning() and currentState and currentState.Outcome == "Playing" and guard < 40 do
        guard += 1
        local a, b = knownPair()
        if a then
            flip(a); flip(b)
        else
            a = firstUnknown()
            flip(a)
            if currentState.Outcome ~= "Playing" then break end
            flip(partnerOf(a) or firstUnknown(a))
        end
    end
    return currentState and currentState.Outcome
end

---------------- Toggle
local matchRunning = false
local matchRunId = 0
local nextPlayAt = 0 -- server time when the next free game is available
connections.memoryMatch = { Disconnect = function() matchRunning = false end }

local function matchSpot()
    local ok, pad = pcall(function() return workspace.MemoryMatch.TouchToPlay end)
    if not ok or not pad then return nil end
    return pad.CFrame + Vector3.new(0, pad.Size.Y / 2 + 3, 0)
end

automationTab:CreateToggle({
    name = "Auto Memory Match",
    description = "Plays the matching game every 30 min and remembers every card to find all 6 pairs",
    callback = function(value)
        matchRunning = false
        if not value then return end
        matchRunning = true
        matchRunId += 1
        local myRun = matchRunId
        local function alive() return matchRunning and matchRunId == myRun end

        task.spawn(function()
            local lastMsg
            while alive() do
                pcall(function()
                    local now = workspace:GetServerTimeNow()
                    if now < nextPlayAt then
                        local msg = "[HustlHub] Memory Match ready in " .. math.ceil((nextPlayAt - now) / 60) .. " min"
                        if msg ~= lastMsg then print(msg); lastMsg = msg end
                        return
                    end
                    lastMsg = nil

                    local spot = matchSpot()
                    if not spot then
                        print("[HustlHub] Memory Match table not found (workspace.MemoryMatch)")
                        return
                    end

                    -- Trip: go to the table, play, come back
                    acquireTrip("memoryMatch")
                    local root = getRoot()
                    if not root then releaseTrip("memoryMatch") return end
                    local startCFrame = root.CFrame
                    teleportAndTouch(spot)
                    task.wait(0.5)

                    local state = matchOpen(false)
                    if type(state) == "table" and state.Outcome ~= "Playing" then
                        if workspace:GetServerTimeNow() >= (state.NextPlay or 0) then
                            state = matchOpen(true) -- start a new free game
                        else
                            nextPlayAt = state.NextPlay
                        end
                    end

                    if type(state) == "table" and state.Outcome == "Playing" then
                        print("[HustlHub] Memory Match: playing")
                        local outcome = solveBoard(alive)
                        local pairsFound = currentState and currentState.Pairs or "?"
                        print("[HustlHub] Memory Match: " .. tostring(outcome) .. " (" .. tostring(pairsFound) .. "/6 pairs)")
                        if currentState and currentState.NextPlay then nextPlayAt = currentState.NextPlay end
                        task.wait(2) -- let the result show
                    elseif type(state) == "table" and state.Error then
                        print("[HustlHub] Memory Match: " .. tostring(state.Error))
                    end

                    root = getRoot()
                    if root then
                        window.hubReturnTo(startCFrame)
                    end
                    task.wait(0.5)
                    releaseTrip("memoryMatch")
                end)
                releaseTrip("memoryMatch")
                task.wait(10)
            end
        end)
    end,
})
end

---------------------------------------------------------------- Auto Mine
do -- own scope (keeps the top level under Luau's 200-local limit)
-- From the game's MiningController / MiningConfig / MiningWorld / MineSave:
--   * portal in Crystal Cave (MiningWorld.Portal()); entering gives a state with Id, Seed, Tool,
--     Removed (encoded mined cells), Count/Capacity (backpack)
--   * the mine is a grid of 4-stud blocks inside workspace.MineArea.MineArea, Depth 50; cell
--     (x, y, z) with y = 0 the top layer. A block is mineable if it's on top or next to a mined cell
--   * MiningService: Hit(Id, x, y, z) every tool Interval within tool Range (server-checked),
--     CollectDrop(Id, dropId), Surface("Sell"), Sell(), Leave()
--   * MiningConfig.Ore(seed, x, y, z) -> oreType (.value), stats (.pickaxeRequirement)
--   * the client draws blocks in workspace.LocalMiningBlocks, named "x:y:z"
local function timedRequire(module, seconds)
    local result, done = nil, false
    task.spawn(function()
        local ok, r = pcall(require, module)
        if ok then result = r end
        done = true
    end)
    local start = os.clock()
    while not done and os.clock() - start < (seconds or 3) do task.wait() end
    return result
end

local MiningShared = ReplicatedStorage.Shared:FindFirstChild("Minigames") and ReplicatedStorage.Shared.Minigames:FindFirstChild("Mining")
local MiningConfig = MiningShared and timedRequire(MiningShared:FindFirstChild("MiningConfig"))
local MiningWorld = MiningShared and timedRequire(MiningShared:FindFirstChild("MiningWorld"))
local MineSave = MiningShared and timedRequire(MiningShared:FindFirstChild("MineSave"))
local Minigames = ReplicatedStorage.Controllers:FindFirstChild("Minigames")
local MiningController = Minigames and Minigames:FindFirstChild("MiningController") and timedRequire(Minigames.MiningController)

local function mineCall(name, ...)
    local remote = Remotes:FindFirstChild("MiningService") and Remotes.MiningService.RF:FindFirstChild(name)
    if not remote then return nil end
    local args = table.pack(...)
    local ok, result = pcall(function() return safeInvoke(remote, table.unpack(args, 1, args.n)) end)
    return ok and result or nil
end

local function inMine()
    return LocalPlayer:GetAttribute("MiningActive") == true
end

local mineRunning = false
local mineRunId = 0
connections.autoMine = { Disconnect = function() mineRunning = false end }
local autoBuyUpgrades = { Pickaxe = false, Backpack = false } -- set by the dropdown next to Auto Mine

-- One mining session: enter, mine until stopped, selling whenever the backpack fills
-- Crystal Cave island spot: the portal (and the mine) only load when you're near them
local CRYSTAL_CAVE = CFrame.new(27.495803833007812, 5451.531250000000000, -1668.031616210937500)

local function waitFor(getter, seconds, stillRunning)
    local start = os.clock()
    repeat
        local value = getter()
        if value then return value end
        task.wait(0.25)
    until os.clock() - start > seconds or not stillRunning()
    return nil
end

local function mineSession(stillRunning)
    -- 1) Enter through the portal (the game's own controller handles the entry)
    if not inMine() then
        local portal = MiningWorld.Portal()
        if not portal then
            -- Not loaded yet: go to Crystal Cave first and wait for the portal to stream in
            print("[HustlHub] Auto Mine: going to Crystal Cave")
            teleportAndTouch(CRYSTAL_CAVE)
            portal = waitFor(MiningWorld.Portal, 8, stillRunning)
        end
        if not portal then
            print("[HustlHub] Auto Mine: mining portal not found (is Crystal Cave unlocked?)")
            return
        end
        teleportAndTouch(portal.CFrame)
        waitFor(inMine, 8, stillRunning)
        if not inMine() then
            local entered = mineCall("Enter") -- fallback: enter directly
            if type(entered) ~= "table" or not entered.Active then
                print("[HustlHub] Auto Mine: couldn't enter the mine (" .. tostring(type(entered) == "table" and entered.Error or "no answer") .. ")")
                return
            end
            waitFor(inMine, 5, stillRunning)
        end
    end

    -- The mine itself streams in once you're inside
    local marker = waitFor(MiningWorld.Marker, 10, stillRunning)
    if not marker then
        print("[HustlHub] Auto Mine: in the mine, but the mine area didn't load")
        return
    end
    task.wait(1.5)

    -- 2) Read the mine state
    local state = MiningController and MiningController.GetState and MiningController:GetState()
    if type(state) ~= "table" or not state.Id then
        state = mineCall("Enter")
    end
    if type(state) ~= "table" or not state.Id or not state.Seed then
        print("[HustlHub] Auto Mine: couldn't read the mine state")
        return
    end
    local width, depth, length = MiningConfig.Dimensions(marker)
    local removed = MineSave.Decode(state.Removed, width, depth, length) or {}
    print("[HustlHub] Auto Mine: in the mine (" .. width .. "x" .. depth .. "x" .. length .. ")")

    local function tool() return MiningConfig.Tools[state.Tool] or MiningConfig.Tools[1] end
    local key = MiningConfig.Key
    local blocksFolder = workspace:FindFirstChild("LocalMiningBlocks")

    -- Mineable = not mined, and on the top layer or next to a mined cell
    local function exposed(x, y, z)
        if y == 0 then return true end
        for _, n in ipairs(MiningConfig.Neighbors) do
            if removed[key(x + n.X, y + n.Y, z + n.Z)] then return true end
        end
        return false
    end

    -- An open cell next to the block to stand in (or the air above the top layer)
    local function standSpot(x, y, z)
        local above = MiningConfig.Position(marker, x, y, z) + marker.CFrame.UpVector * MiningConfig.BlockSize
        if y == 0 then return above + marker.CFrame.UpVector * 2 end
        for _, n in ipairs(MiningConfig.Neighbors) do
            if removed[key(x + n.X, y + n.Y, z + n.Z)] then
                return MiningConfig.Position(marker, x + n.X, y + n.Y, z + n.Z)
            end
        end
        return above
    end

    -- Best target: most valuable mineable block the pickaxe can break, closest first on ties
    local function pickTarget()
        local root = getRoot()
        local power = tool().Power
        local best, bestScore
        for x = 0, width - 1 do
            for z = 0, length - 1 do
                for y = 0, depth - 1 do
                    local k = key(x, y, z)
                    if not removed[k] and exposed(x, y, z) then
                        local ore, stats = MiningConfig.Ore(state.Seed, x, y, z)
                        if stats and (stats.pickaxeRequirement or 0) <= power then
                            local value = ore and ore.value or 0
                            local dist = root and (MiningConfig.Position(marker, x, y, z) - root.Position).Magnitude or 0
                            local score = value * 1000 - dist
                            if not bestScore or score > bestScore then
                                best, bestScore = Vector3.new(x, y, z), score
                            end
                        end
                        break -- nothing below an unmined block is exposed through it
                    end
                    if not removed[k] then break end
                end
            end
        end
        return best
    end

    -- Buys the next pickaxe / bag (whichever are selected) once you have the mining coins for it.
    -- Uses the same requests as the game's shop: Purchase("BuyTool"/"BuyStorage", name), then equips it.
    local lastBuyCheck = 0
    local function buyUpgrades()
        if not (autoBuyUpgrades.Pickaxe or autoBuyUpgrades.Backpack) then return end
        if os.clock() - lastBuyCheck < 10 then return end
        lastBuyCheck = os.clock()
        local replica = getReplica()
        local mining = replica and replica.Data and replica.Data.Mining
        if type(mining) ~= "table" then return end

        local kinds = {
            { on = autoBuyUpgrades.Pickaxe, list = MiningConfig.Tools, current = mining.Tool, buy = "BuyTool", equip = "EquipTool", label = "pickaxe" },
            { on = autoBuyUpgrades.Backpack, list = MiningConfig.Bags, current = mining.Backpack, buy = "BuyStorage", equip = "EquipStorage", label = "bag" },
        }
        for _, kind in ipairs(kinds) do
            local nextItem = kind.on and kind.list[(tonumber(kind.current) or 1) + 1]
            local coins = tonumber(replica.Data.Mining.Coins) or 0
            if nextItem and coins >= (nextItem.Price or math.huge) then
                print("[HustlHub] Auto Mine: buying " .. nextItem.Name .. " for " .. tostring(nextItem.Price) .. " mining coins")
                mineCall("Surface", "Shop") -- the shop is up top, like the sell pad
                task.wait(1.2)
                local bought = mineCall("Purchase", kind.buy, nextItem.Name)
                if type(bought) == "table" and not bought.Error then
                    if bought.Id then state = bought end
                    task.wait(0.3)
                    -- Make sure the new one is the one in use
                    local after = replica.Data.Mining
                    if tonumber(kind == kinds[1] and after.Tool or after.Backpack) ~= (tonumber(kind.current) or 1) + 1 then
                        local equipped = mineCall("Purchase", kind.equip, nextItem.Name)
                        if type(equipped) == "table" and equipped.Id then state = equipped end
                    end
                    print("[HustlHub] Auto Mine: now using " .. nextItem.Name)
                else
                    print("[HustlHub] Auto Mine: couldn't buy " .. nextItem.Name .. " (" .. tostring(type(bought) == "table" and bought.Error or "no answer") .. ")")
                end
                task.wait(0.5)
            end
        end
    end

    local function sellIfFull()
        if (state.Count or 0) < (state.Capacity or math.huge) then return end
        print("[HustlHub] Auto Mine: backpack full, selling")
        mineCall("Surface", "Sell")
        task.wait(1.5)
        local sold = mineCall("Sell")
        if type(sold) == "table" and not sold.Error then
            state = sold
            print("[HustlHub] Auto Mine: sold " .. tostring(sold.Sold or 0))
        end
        task.wait(0.5)
    end

    -- 3) Mine until stopped
    local misses = 0
    local lastYield = os.clock()
    while stillRunning() and inMine() do
        -- Let other features (chests, shrine, ...) take their trip, then carry on mining.
        -- Their trip brings you back to where you were, so mining picks up right where it left off.
        if othersWaitingForTrip() and os.clock() - lastYield > 20 then
            print("[HustlHub] Auto Mine: pausing so another feature can take its trip")
            releaseTrip("mine")
            task.wait(0.5)
            acquireTrip("mine")
            lastYield = os.clock()
            print("[HustlHub] Auto Mine: resuming")
        end
        sellIfFull()
        buyUpgrades()
        local target = pickTarget()
        if not target then
            print("[HustlHub] Auto Mine: nothing left this pickaxe can mine")
            break
        end
        local x, y, z = target.X, target.Y, target.Z
        local blockPos = MiningConfig.Position(marker, x, y, z)
        local root = getRoot()
        if root and (root.Position - blockPos).Magnitude > tool().Range * 0.8 then
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = CFrame.new(standSpot(x, y, z))
            task.wait(0.15)
        end

        -- Hit until it breaks
        local broke = false
        for _ = 1, 60 do
            if not (stillRunning() and inMine()) then break end
            local result = mineCall("Hit", state.Id, x, y, z)
            if type(result) ~= "table" or result.Error then
                misses += 1
                if type(result) == "table" and result.Error then
                    print("[HustlHub] Auto Mine: " .. tostring(result.Error))
                end
                break
            end
            if result.State then state = result.State end
            if result.Broken then
                broke = true
                local k = result.Key or key(x, y, z)
                removed[k] = true
                local block = blocksFolder and blocksFolder:FindFirstChild(k)
                if block then block:Destroy() end -- clear the local model so it doesn't block us
                if result.Drop and result.Drop.Id then
                    task.spawn(mineCall, "CollectDrop", state.Id, result.Drop.Id)
                end
                break
            end
            task.wait(tool().Interval)
        end
        if broke then misses = 0 end
        if misses >= 5 then
            print("[HustlHub] Auto Mine: too many failed hits, re-entering")
            break
        end
        task.wait(0.05)
    end
end

automationTab:CreateDropdown({
    name = "Auto Buy Mining Upgrades",
    description = "Buys the next pickaxe / bag while Auto Mine runs, once you have the mining coins",
    options = { "Pickaxe", "Backpack" },
