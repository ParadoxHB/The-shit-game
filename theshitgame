---------------- Equip Best (by stat or by enchant)
-- From the game's EnchantConfig / EnchantFormula / InventoryController:
--   * the game's own Equip Best button: PetActionRequested { Action = "EquipBest", Mode = "Clicks" | "Gems" | "Luck" }
--   * enchants (pet.Enchant / pet.Enchant2) like "Alchemist III", "Lucky II", "Golden Touch"
--   * every pet with an enchant counts toward its stat, so "best Alchemist" = as many of your
--     strongest Alchemist pets as your pet slots hold
-- How it equips for an enchant: the game's Equip Best for that enchant's stat first (Luck for
-- Lucky / Alchemist / Collector, Gems for Fortune..., Taps for Power...), then your best pets with
-- the enchant are swapped in for the weakest equipped pets.
local EnchantConfig, PetPower
pcall(function() EnchantConfig = require(ReplicatedStorage.Shared.Pets.EnchantConfig) end)
pcall(function() PetPower = require(ReplicatedStorage.Shared.Pets.PetPower) end)
local PetAction = Remotes.PetService.RE.PetActionRequested
local GAME_MODES = { -- label -> the game's Equip Best mode
    ["Best Taps (game's Equip Best)"] = "Clicks",
    ["Best Gems (game's Equip Best)"] = "Gems",
    ["Best Luck (game's Equip Best)"] = "Luck",
}
local MODE_FOR_AFFINITY = { Clicks = "Clicks", Gems = "Gems", Luck = "Luck", Secret = "Luck" }

local function petPower(pet)
    if PetPower then
        local ok, value = pcall(PetPower.Get, pet)
        if ok and type(value) == "number" then return value end
    end
    return tonumber(pet.Power) or 0
end
local function enchantDef(name)
    return EnchantConfig and EnchantConfig.Enchants and EnchantConfig.Enchants[name]
end
-- best rank of an enchant family on a pet (0 = doesn't have it)
-- (shared with the crafting team code: follows the game's enchant renames, e.g. "Crafter II" = "Alchemist II")
local function familyRank(pet, family)
    return CraftTeam.enchantRank(pet, family)
end

-- the dropdown: game modes first, then every enchant family / special enchant, with how many
-- of your pets have it, e.g. "Alchemist - Better craft odds (4 pets)"
local familyInfo = {} -- label -> { family, affinity }
local function bestOptions()
    local options = { "Best Taps (game's Equip Best)", "Best Gems (game's Equip Best)", "Best Luck (game's Equip Best)" }
    table.clear(familyInfo)
    if not (EnchantConfig and EnchantConfig.Enchants) then return options end
    local families, owned = {}, {}
    for _, def in pairs(EnchantConfig.Enchants) do
        local family = def.Family or def.Type
        if family and not families[family] then
            families[family] = { affinity = def.Affinity, short = EnchantConfig.ShortFor and EnchantConfig.ShortFor(family) or def.Short }
        end
    end
    for _, pet in pairs(getOwnedPets()) do
        if type(pet) == "table" then
            for family in pairs(families) do
                if familyRank(pet, family) > 0 then owned[family] = (owned[family] or 0) + 1 end
            end
        end
    end
    local names = {}
    for family in pairs(families) do table.insert(names, family) end
    table.sort(names, function(a, b)
        if (owned[a] or 0) > 0 ~= ((owned[b] or 0) > 0) then return (owned[a] or 0) > 0 end -- ones you have first
        return a < b
    end)
    for _, family in ipairs(names) do
        local info = families[family]
        local label = family .. (info.short and (" - " .. info.short) or "") .. " (" .. (owned[family] or 0) .. " pets)"
        familyInfo[label] = { family = family, affinity = info.affinity }
        table.insert(options, label)
    end
    return options
end

local selectedBest = { "Best Luck (game's Equip Best)" } -- labels, in the order you picked them
local function labelFamily(label)
    return label:match("^(.-) %- ") or label:match("^(.-) %(")
end
-- labels can go stale (pet counts in them change): map each pick to its current label
local function currentPicks()
    bestOptions()
    local picks = {}
    for _, label in ipairs(selectedBest) do
        if GAME_MODES[label] then
            table.insert(picks, label)
        else
            local family = labelFamily(label)
            for current, info in pairs(familyInfo) do
                if info.family == family then table.insert(picks, current) break end
            end
        end
    end
    return picks
end

