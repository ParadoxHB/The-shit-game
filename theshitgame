				Parent = rail,
			})
			corner(search, 4)
			new("UIPadding", {PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), Parent = search})

			hub.railList = new("ScrollingFrame", {
				Name = "Tabs",
