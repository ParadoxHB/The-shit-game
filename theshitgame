-- hatch `egg` until done(d) is true (at most ~25s per round)
local function hatchUntil(myRun, egg, done, what)
    local d = data()
    if done(d) then return end
    local price = eggPrice(d, egg)
    if price == math.huge then log("Unknown egg: " .. tostring(egg)) task.wait(3) return end
    -- an egg on an island you haven't unlocked: unlock the island first
    local island = LaunchEggConfig[egg] and LaunchEggConfig[egg].Island
    local unlocked = d.Progression and d.Progression.UnlockedIslands or {}
    if island and unlocked[island] ~= true and IslandCfg and IslandCfg.Islands[island] then
        reachIsland(myRun, data(), island, IslandCfg.Islands[island])
        return
    end
    if not saveFor(d, price, "the " .. egg .. " egg") then return end
    if not standAt(egg) then log("Can't find the " .. egg .. " egg") task.wait(2) return end
    log(what)
    local before = selectedEgg
    selectedEgg = egg
    startHatching(true, false) -- stops by itself when out of coins / storage full
    local start = os.clock()
    while alive(myRun) and hatchRunning and os.clock() - start < 25 and not done(data()) do task.wait(0.3) end
    stopHatching()
    if hatchStopReason then log(egg .. " egg: " .. tostring(hatchStopReason)) task.wait(1) end
    selectedEgg = before
end

