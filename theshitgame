-- Auto Hatch itself, kept as a function so it can also be started later (see the watcher below)
window.hubHatchToggle = function(value)
    if window.hubFeatureBusy() then
        -- Auto Index / Mastery / Progress is hatching right now: don't cut it short or start a second copy.
        -- The switch stays where you put it, and Auto Hatch takes over by itself once they are done.
        window.hubHatchQueued = value == true
        if value then
            window:Notify({ title = "Auto Hatch", content = "Waiting: another automation is hatching. Auto Hatch starts by itself when it is done.", duration = 5 })
        end
        return
    end
    if value and hatchCraft.tripBusy then
        -- a storage-full craft trip is running: it goes back to the egg and restarts hatching itself when it's done.
        -- Starting hatching now ran it alongside the trip (hatching at the egg while the trip crafted "from" there).
        return
    end
    window.hubHatchQueued = false
    window.hubWalkPause = false
    stopHatching()
    hatchCraft.session += 1 -- ends a craft trip from an earlier run
        if not value then return end
        selectedEgg = selectedEgg or firstOption(eggDropdown.value)
        if not selectedEgg then
            window:Notify({ title = "Auto Hatch", content = "Pick an egg first.", duration = 3 })
            return
        end
        print("[HustlHub] Auto Hatch started with Egg =", selectedEgg)

        -- Go stand at the selected egg first (hatching only works within range)
        local egg = EggWorld.load(selectedEgg) -- goes to its island first if it isn't loaded
        if egg then
            -- Just in front of the egg, outside its bounding box, facing it.
            -- Measure the "Egg" part itself (like the game does), not signs/platforms around it.
            local body = egg:FindFirstChild("Egg") or egg
            local boxCFrame, size
            if body:IsA("BasePart") then
                boxCFrame, size = body.CFrame, body.Size
            else
                boxCFrame, size = body:GetBoundingBox()
            end
            local center = boxCFrame.Position
            local standAt = window.hubEggSpot(center, boxCFrame.LookVector, size)
            hatchCraft.home = CFrame.lookAt(standAt, Vector3.new(center.X, standAt.Y, center.Z))
            teleportAndTouch(hatchCraft.home)
        else
            hatchCraft.home = nil
            warn("[HustlHub] Couldn't find workspace.Eggs." .. tostring(selectedEgg) .. " to teleport to")
        end
        -- keeps going until you walk away from the egg; anything else that moves you gets you sent back
        startHatching(false, true, true)
        -- always watch (the switch is checked live, so turning it on later works too)
        if hatchCraft.run then task.spawn(hatchCraft.run, hatchCraft.session) end
end

-- If Auto Hatch is on while another automation uses the hatching, it carries on afterwards
do
    local watching = true
    local lastMoved = os.clock()
    connections.hatchQueue = { Disconnect = function() watching = false end }
    task.spawn(function()
        while watching do
            task.wait(2)
            local root = getRoot()
            if root and root.AssemblyLinearVelocity.Magnitude > 2 then lastMoved = os.clock() end
            if hatchToggle and hatchToggle.value then
                if window.hubFeatureBusy() then
                    window.hubHatchQueued = true
                elseif window.hubHatchQueued and not hatchRunning and tripOwner == nil
                    and (not window.hubWalkPause or os.clock() - lastMoved > 5) then
                    window.hubHatchQueued = false
                    window.hubWalkPause = false
                    pcall(window.hubHatchToggle, true)
                end
            else
                window.hubHatchQueued = false
            end
        end
    end)
end

