mainTab:CreateToggle({
    name = "Auto Shrine",
    description = "Keeps your chosen blessing active (re-picks it after rejoining). Never resets your tier.",
    callback = function(value)
        shrineRunning = false
        if not value then return end
        shrineRunning = true
        shrineRunId += 1
        local myRun = shrineRunId
        local function alive() return shrineRunning and shrineRunId == myRun end

        task.spawn(function()
            local lastMsg
            while alive() do
                pcall(function()
                    local wanted = SHRINE_BLESSINGS[selectedBlessingLabel]
                    local have = currentBlessing()
                    if have == wanted then
                        local tier = LocalPlayer:GetAttribute("ShrineTier") or 1
                        local msg = "[HustlHub] Shrine: " .. tostring(have) .. " blessing active (Tier " .. (TIER_NAMES[tier] or tier) .. ")"
                        if msg ~= lastMsg then print(msg); lastMsg = msg end
                        return
                    end

                    local choose = Remotes:FindFirstChild("ShrineService") and Remotes.ShrineService.RF:FindFirstChild("Choose")
                    if not choose then
                        print("[HustlHub] Shrine: couldn't find the game's shrine remote")
                        return
                    end

                    -- Trip: go to the shrine, choose, come back. The shrine only exists while Autumn
                    -- is loaded (that's why it used to say "not found" from other islands), so go to
                    -- where it was last seen, or to Autumn, and wait for it to load in.
                    acquireTrip("shrine")
                    local root = getRoot()
                    if not root then releaseTrip("shrine") return end
                    local startCFrame = root.CFrame
                    local spot = shrineSpot()
                    if not spot then
                        local target = lastShrineSpot or AUTUMN_SPOT
                        task.spawn(function() pcall(function() LocalPlayer:RequestStreamAroundAsync(target.Position, 5) end) end) -- (can hang: never wait on it)
                        teleportAndTouch(target)
                        local t0 = os.clock()
                        repeat task.wait(0.25); spot = shrineSpot() until spot or os.clock() - t0 > 10
                    end
                    if not spot then
                        print("[HustlHub] Shrine: couldn't load the shrine (is Autumn unlocked?)")
                        teleportAndTouch(startCFrame)
                        task.wait(0.5)
                        releaseTrip("shrine")
                        return
                    end
                    lastShrineSpot = spot
                    teleportAndTouch(spot)
                    local ok, result = pcall(function() return safeInvoke(choose, wanted) end)
                    task.wait(0.5)
                    if currentBlessing() == wanted then
                        print("[HustlHub] Shrine: chose the " .. wanted .. " blessing")
                        lastMsg = nil
                    else
                        local reason = ok and type(result) == "table" and (result.Reason or result.Error) or tostring(result)
                        print("[HustlHub] Shrine: couldn't choose " .. wanted .. ":", reason)
                    end
                    teleportAndTouch(startCFrame) -- (waits for the ground to load: it can be far away)
                    task.wait(0.5)
                    releaseTrip("shrine")
                end)
                releaseTrip("shrine")
                task.wait(10)
            end
        end)
    end,
})

-- Equip Best Pets (under Auto Shrine): the game's own Equip Best for one stat. PetActionRequested { Action = "EquipBest",
-- Mode = "Luck" | "Clicks" | "Gems" }; Coins is the game's "Clicks" mode (pets with the Clicks affinity). While it is on
-- the pick is also what the hatch/craft code equips afterwards (window.hubEquipBestMode), so nothing swaps it back to Clicks.
do
    local EQUIP_MODES = { Luck = "Luck", Coins = "Clicks", Gems = "Gems" }
    local equipType, equipOn, equipRun = "Luck", false, 0
    connections.equipBestStat = { Disconnect = function() equipOn = false window.hubEquipBestMode = nil end }
    local LaunchPetConfigMain
    pcall(function() LaunchPetConfigMain = require(ReplicatedStorage.Shared.Pets.LaunchPetConfig) end)
    local function isSecretPet(pet)
        local cfg = LaunchPetConfigMain and LaunchPetConfigMain[pet.Name]
        return tostring(pet.Rarity or (cfg and cfg.Rarity) or ""):find("Secret", 1, true) ~= nil
    end
    -- The game's Equip Best puts your strongest pets on the team, Secrets included. So: run it, then take every Secret off
    -- the team and put the best non-Secret pets in their place (the ones with the picked affinity first, then by power).
    -- Also used by the hatch / craft code while Equip Best Pets is on (window.hubEquipBestMode).
    window.hubEquipBestNoSecrets = function(mode)
        local petService = Remotes:FindFirstChild("PetService")
        local re = petService and petService:FindFirstChild("RE") and petService.RE:FindFirstChild("PetActionRequested")
        if not re then return end
        pcall(function() re:FireServer({ ["Action"] = "EquipBest", ["Mode"] = mode }) end)
        task.wait(1.2)
        pcall(function()
            local data = getReplica().Data
            local owned = data.Pets.Owned
            local onTeam, secrets = {}, {}
            for _, id in pairs(data.Pets.Equipped or {}) do
                local pet = owned[id]
                if type(id) == "string" and type(pet) == "table" then
                    onTeam[id] = true
                    if isSecretPet(pet) then table.insert(secrets, id) end
                end
            end
            if #secrets == 0 then return end
            for _, id in ipairs(secrets) do
                re:FireServer({ ["Action"] = "Unequip", ["PetId"] = id })
                task.wait(0.25)
            end
            local candidates = {}
            for id, pet in pairs(owned) do
                if type(pet) == "table" and not onTeam[id] and pet.Frozen == nil and not isSecretPet(pet) then
                    table.insert(candidates, { id = id, match = pet.Affinity == mode, power = tonumber(pet.Power) or 0 })
                end
            end
            table.sort(candidates, function(a, b)
                if a.match ~= b.match then return a.match end
                return a.power > b.power
            end)
            for i = 1, #secrets do
                if candidates[i] then
                    re:FireServer({ ["Action"] = "Equip", ["PetId"] = candidates[i].id })
                    task.wait(0.25)
                end
            end
            print("[HustlHub] Equip Best: took " .. #secrets .. " Secret pets off the team")
        end)
    end
    local function equipNow()
        if window.hubTeamSwapActive then return end -- (Swap Teams For Rebirth owns the team while it runs)
        window.hubEquipBestNoSecrets(EQUIP_MODES[equipType])
    end
    mainTab:CreateDropdown({
        name = "Equip Best Type",
        description = "What Equip Best Pets equips your best pets for: Luck (egg luck), Coins (the game's Clicks pets) or Gems.",
        options = { "Luck", "Coins", "Gems" },
        value = "Luck",
        callback = function(selected)
            equipType = firstOption(selected) or "Luck"
            if equipOn then
                window.hubEquipBestMode = EQUIP_MODES[equipType]
                task.spawn(equipNow) -- (switching the type equips the new best straight away)
            end
        end,
    })
    mainTab:CreateToggle({
        name = "Equip Best Pets",
        description = "Equips your best pets for the type picked in Equip Best Type (the game's own Equip Best), right away and again every minute so new pets are included. Secret pets are never left on the team: they are taken off and the best non-Secret pets go in their place. Off by default.",
        callback = function(value)
            equipOn = value
            equipRun += 1
            window.hubEquipBestMode = value and EQUIP_MODES[equipType] or nil
            if not value then return end
            local myRun = equipRun
            task.spawn(function()
