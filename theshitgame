-- game tier name -> index version name
local TIER_VERSION = { Normal = "Normal", Golden = "Golden", Diamond = "Diamond", Shiny = "Rainbow" }
local safeTeleport -- defined below (used by goToMachine)

-- The game only lets you use a machine while you stand INSIDE its interaction box: a part tagged
-- "InteractionPoint" named "Golden" / "Diamond" / "Rainbow" (MachineController.updateMachineProximity).
local CollectionService = game:GetService("CollectionService")
-- a point can be a Part or a whole Model (the game handles both)
local function pointBox(point)
    if point:IsA("BasePart") then return point.CFrame, point.Size end
    if point:IsA("Model") then return point:GetBoundingBox() end
    return nil
end
-- the machine box with this name closest to nearPos (only within 80 studs of it)
local function machinePoint(pointName, nearPos)
    local candidates = {}
    local folder = workspace:FindFirstChild("InteractionPoints")
    local official = folder and folder:FindFirstChild(pointName)
    if official then table.insert(candidates, official) end
    for _, point in ipairs(CollectionService:GetTagged("InteractionPoint")) do
        if point.Name == pointName then table.insert(candidates, point) end
    end
    local best, bestDist
    for _, point in ipairs(candidates) do
        local cf = pointBox(point)
        if cf then
            local dist = (cf.Position - nearPos).Magnitude
            if dist <= 80 and (not best or dist < bestDist) then best, bestDist = point, dist end
        end
    end
    return best
end
-- the game's own test: inside the box plus 3 studs sideways / 2 up-down
local function insidePoint(point)
    local root = getRoot()
    if not (root and point and point.Parent) then return false end
    local cf, size = pointBox(point)
    if not cf then return false end
    local rel = cf:PointToObjectSpace(root.Position)
    local half = size / 2 + Vector3.new(3, 2, 3)
    return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
end
-- stop the character drifting (never anchors: an anchored character's position doesn't reach
-- the server). Also undoes the anchoring an older version of this script used.
local function holdStill()
    local root = getRoot()
    if root then
        root.Anchored = false
        root.AssemblyLinearVelocity = Vector3.zero
    end
end
-- go to the machine's spot, then step into its box (the spot itself if the box can't be found)
local function goToMachine(pointName, spotCF)
    safeTeleport(spotCF) -- frozen until the area has loaded
    local point
    local waited = os.clock()
    repeat
        point = machinePoint(pointName, spotCF.Position)
        if not point then task.wait(0.2) end
    until point or os.clock() - waited > 3
    if not point then
        print("[HustlHub] Auto Index: no", pointName, "machine box found, crafting from the saved spot")
        holdStill(true)
        task.wait(0.6)
        return false
    end
    local cf = pointBox(point)
    safeTeleport(CFrame.new(cf.Position)) -- the middle of the box
    task.wait(0.6) -- let the server see the new position
    return insidePoint(point)
end

-- Teleport without falling: until the area has loaded and there's ground under the spot, the
-- character is put back at the spot every frame (NOT anchored: an anchored character's position
-- doesn't reach the server, which then says "too far" / "must be near the machine").
safeTeleport = function(cf)
    if getgenv().HustlHubRun ~= HH_RUN then return false end -- a replaced copy never moves you (see HH_RUN)
    waitForDefenseRound()
    local root = getRoot()
    if not root then return false end
    root.Anchored = false
    root.AssemblyLinearVelocity = Vector3.zero
    root.CFrame = cf
    task.spawn(function()
        pcall(function() LocalPlayer:RequestStreamAroundAsync(cf.Position, 3) end)
    end)
    local start = os.clock()
    while os.clock() - start < 4 and not window.hubFloorBelow(cf.Position, LocalPlayer.Character) do
        root = getRoot()
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = cf
        end
        RunService.Heartbeat:Wait()
    end
    root = getRoot()
    if root then
        window.hubEnsureFloor(cf, LocalPlayer.Character)
        root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = cf
    end
    task.wait(0.3) -- settle on the ground, so the server sees you there
    return root ~= nil
end

-- Where to stand in front of each egg (worked out once while the egg is loaded, then remembered,
-- so a far-away egg that isn't loaded can't send you into the void)
local eggSpots = {}
local function eggStandSpot(model)
    if eggSpots[model.Name] then return eggSpots[model.Name] end
    -- load the egg's area first (in the background: this request can take a while)
    task.spawn(function()
        pcall(function() LocalPlayer:RequestStreamAroundAsync(model:GetPivot().Position, 3) end)
    end)
    local start = os.clock()
    local body
    repeat
        local egg = model:FindFirstChild("Egg")
        if egg and egg:IsA("BasePart") then body = egg
        elseif model:FindFirstChildWhichIsA("BasePart", true) then body = egg or model end
        if not body then task.wait(0.2) end
    until body or os.clock() - start > 4
    if not body then return nil end
    local boxCFrame, size
    if body:IsA("BasePart") then
        boxCFrame, size = body.CFrame, body.Size
    else
        boxCFrame, size = body:GetBoundingBox()
    end
    if size.Magnitude < 1 then return nil end
    local center = boxCFrame.Position
    local standAt = window.hubEggSpot(center, boxCFrame.LookVector, size)
    local spot = CFrame.lookAt(standAt, Vector3.new(center.X, standAt.Y, center.Z))
    eggSpots[model.Name] = spot
    return spot
end

-- stand just in front of an egg, like Auto Hatch does (hatching only works within range)
local function standAtEgg(model)
    local spot = eggStandSpot(model)
    if not spot then
        print("[HustlHub] Auto Index: couldn't load the", model.Name, "egg to stand at")
        return false
    end
    return safeTeleport(spot)
end

---------------- Auto Hatch: craft trip when storage is full (Main tab "Craft When Storage Is Full")
-- While Auto Hatch runs, once storage is (nearly) full: stop hatching, go to the machines nearest
-- the egg, craft every full set (guaranteed counts), then go back to the egg and hatch again.
do
    -- every known machine (October update: Golden on 4 islands, Rainbow on 2; see window.hubMachineSpots)
    local MACHINE_SPOTS = {
        Golden = window.hubMachineSpots.Golden,
        Diamond = window.hubMachineSpots.Diamond,
        Rainbow = window.hubMachineSpots.Rainbow,
    }

    -- the machine closest to the egg: the known spots plus any machine box loaded right now, only on
    -- islands this account has unlocked (a machine on a locked island answers "must be near")
    local function nearestMachine(pointName, fromPos)
        local best, bestDist
        local function consider(cf)
            if not window.hubSpotUnlocked(cf.Position) then return end
            local d = (cf.Position - fromPos).Magnitude
            if not best or d < bestDist then best, bestDist = cf, d end
        end
        for _, cf in ipairs(MACHINE_SPOTS[pointName]) do consider(cf) end
        for _, point in ipairs(CollectionService:GetTagged("InteractionPoint")) do
            if point.Name == pointName then
                local cf = pointBox(point)
                if cf then consider(CFrame.new(cf.Position)) end
            end
        end
        return best
    end

    local function storageInfo()
        local count, limit = 0, math.huge
        pcall(function()
            local data = getReplica().Data
            for _ in pairs(data.Pets.Owned) do count += 1 end
            limit = tonumber(data.Pets.StorageLimit) or math.huge
        end)
        return count, limit
    end

    -- the next craft for this machine, using the Crafting tab's Pets Per Craft slider for it.
    -- Pets: the egg you're hatching (all its pets, so what fills your storage always moves up
    -- the chain Normal -> Golden -> Diamond -> Rainbow) plus anything you ticked in that machine's
    -- dropdown in the Crafting tab
    local SOURCE = { Golden = "Normal", Diamond = "Golden", Shiny = "Diamond" } -- machine -> pets it takes
    local tripEgg -- the egg Auto Hatch is on
    local skipNames = {} -- "Machine|Name" the server refused this trip
    local TIER_OF = { Golden = "Golden", Diamond = "Diamond", Shiny = "Rainbow" } -- machine -> Storage Full Crafts option
    local MACHINE_RANK = { Golden = 1, Diamond = 2, Shiny = 3 }
    local RULE_RANK = { ["Don't Craft"] = 0, Golden = 1, Diamond = 2, Rainbow = 3 }
    -- may this pet go into this machine? A per-pet rule ("Craft Pets Up To") wins; pets without
    -- one follow "Storage Full Crafts" and must be from the egg or ticked in the Crafting tab
    local function petAllowed(machineKey, name, allowed)
        local rule = hatchCraft.rules[name]
        if rule then return (RULE_RANK[rule] or 0) >= MACHINE_RANK[machineKey] end
        return hatchCraft.tiers[TIER_OF[machineKey]] == true and allowed[name] == true
    end
    local function nextSet(machineKey)
        local settings = machineState[machineKey] and machineState[machineKey].settings
        if not settings then return nil end
        local allowed = table.clone(settings.picker.names)
        for _, name in ipairs(eggPets(tripEgg)) do allowed[name] = true end
        -- Craft Every Pet (Crafting tab): every pet you own, not just this egg's and your picks
        if hatchCraft.craftAll then setmetatable(allowed, { __index = function() return true end }) end
        local need, groups, now = settings.perCraft(), {}, os.clock()
        for id, pet in pairs(getOwnedPets()) do
            if type(pet) == "table" and petAllowed(machineKey, pet.Name, allowed) and canUseFor(pet, SOURCE[machineKey])
                and not (recentlySent[id] and now - recentlySent[id] < 3) and not skipNames[machineKey .. "|" .. pet.Name] then
                local g = groups[pet.Name] or {}
                groups[pet.Name] = g
                table.insert(g, id)
            end
        end
        -- the first pet with a full set; its strongest copy leads the craft
        local names = {}
        for name, g in pairs(groups) do if #g >= need then table.insert(names, name) end end
        table.sort(names)
        if names[1] then return hatchCraft.pickSet(groups[names[1]], need, machineKey), names[1] end
        return nil
    end

    -- send one machine request and wait for the server's answer
    local function send(machineKey, ids, action, craftId, alive)
        local state = machineState[machineKey]
        local now = os.clock()
        for _, id in ipairs(ids or {}) do recentlySent[id] = now end
        state.waiting, state.failReason = true, nil
        CraftRemote:FireServer({ ["PetIds"] = ids, ["Machine"] = machineKey, ["Action"] = action, ["CraftId"] = craftId })
        local sentAt = os.clock()
        while state.waiting and os.clock() - sentAt < 10 and alive() do task.wait(0.03) end
        if state.waiting and not state.failReason then
            state.waiting = false
            state.failReason = "no answer from the server" -- (no reply is NOT a craft: it used to be counted as one)
        end
        if state.failReason then
            for _, id in ipairs(ids or {}) do recentlySent[id] = nil end
            return false, tostring(state.failReason)
        end
        return true
    end

    -- Golden / Diamond: craft every full set at the nearest machine
    local function craftAt(machineKey, alive, eggPos, made)
        local ids, name = nextSet(machineKey)
        if not (ids and alive()) then return end
        local cf = nearestMachine(machineKey, eggPos)
        if not goToMachine(machineKey, cf) then
            print("[HustlHub] Hatch craft: couldn't get inside the", machineKey, "machine's area, trying anyway")
        end
        local fails, cooldowns = 0, 0
        while ids and alive() do
            local ok, reason = send(machineKey, ids, "Craft", nil, alive)
            if ok then
                made[machineKey] = (made[machineKey] or 0) + 1
                fails, cooldowns = 0, 0 -- (only failures in a row end the trip, not a stray one in a long trip)
            elseif reason:lower():find("wait") and cooldowns < 30 then
                cooldowns += 1
                -- "Please wait before crafting again": the game's short cooldown between crafts, not a problem with
                -- the pets. Pause and send the same set again. (It used to count as a failure AND mark the pet as
                -- uncraftable for the rest of the trip, so a few cooldowns ended the trip with most sets uncrafted.)
                task.wait(1)
            else
                fails += 1
                print("[HustlHub] Hatch craft:", machineKey, name, "rejected:", reason)
                if reason:lower():find("near") then
                    goToMachine(machineKey, cf)
                else
                    skipNames[machineKey .. "|" .. tostring(name)] = true -- this pet can't be crafted here: try the next kind
                end
                if fails >= 5 then return end
                task.wait(0.5)
            end
            task.wait(0.15) -- let the inventory update
            ids, name = nextSet(machineKey)
        end
    end

    -- Rainbow (game key "Shiny"): claim finished crafts, start 5-Diamond (30s) crafts while there's
    -- room in the queue, and wait for the short ones to finish so they can be claimed too
    local function rainbowAt(alive, eggPos, made)
        local function queue()
            local q
            pcall(function() q = getReplica().Data.Machines.Shiny.Queue end)
            return type(q) == "table" and q or {}
        end
        local function hasFinished()
            local now = workspace:GetServerTimeNow()
            for _, e in pairs(queue()) do
                if type(e) == "table" and e.EndTime and e.EndTime <= now then return true end
            end
            return false
        end
        if not alive() or not (nextSet("Shiny") or hasFinished()) then return end
        goToMachine("Rainbow", nearestMachine("Rainbow", eggPos))
        local deadline, nearMisses = os.clock() + 180, 0
        while alive() and os.clock() < deadline do
            local now, pending, queued = workspace:GetServerTimeNow(), false, 0
            for craftId, e in pairs(queue()) do
                queued += 1
                if type(e) == "table" and e.EndTime then
                    if e.EndTime <= now then
                        send("Shiny", nil, "Claim", craftId, alive)
                        queued -= 1
                    elseif e.EndTime - now <= 40 then
                        pending = true -- one of the 30s crafts: worth waiting for
                    end
                end
            end
            local ids = nextSet("Shiny")
            if ids and queued < RAINBOW_QUEUE then
                local ok, reason = send("Shiny", ids, "Start", nil, alive)
                if ok then
                    made.Rainbow = (made.Rainbow or 0) + 1
                elseif tostring(reason):lower():find("near") then
                    -- not at the machine (moved, or the teleport didn't land): go back, and stop after 3 tries instead of
                    -- retrying from wherever you are for 3 minutes (it sent 60+ refused crafts from the egg)
                    nearMisses += 1
                    if nearMisses > 3 then break end
                    goToMachine("Rainbow", nearestMachine("Rainbow", eggPos))
                else
                    task.wait(0.5)
                end
                task.wait(0.3)
            elseif pending then
                task.wait(1)
            else
                break -- nothing left to start or claim (or the queue is full of long crafts)
            end
        end
    end

    hatchCraft.run = function(session)
        if hatchCraft.watching == session then return end -- (this session already has a watcher)
        hatchCraft.watching = session
        local eggName = selectedEgg
        tripEgg = eggName
        local function hatchOn() return hatchCraft.session == session end
        -- a trip keeps going while the Auto Hatch SWITCH is on (not just this exact session: Auto Hatch
        -- being switched on again mid-trip, e.g. by live sync or a config load, used to end the trip
        -- after one Golden / Diamond craft and send you back to the egg with storage still full)
        local function switchOn()
            local el = window.elementsByFlag and window.elementsByFlag["Auto Hatch"]
            return el == nil or el.value == true
        end
        -- this copy of the script is still the current one (re-running the script replaces it: a trip that was running
        -- then used to carry on forever in the background, with its reply listener already gone, firing a craft every
        -- 10 seconds from wherever you were)
        local function current() return getgenv().HustlHubRun == HH_RUN end
        local function alive() return current() and hatchCraft.enabled and (hatchOn() or switchOn()) end
        local noWorkNoted, offNoted, nextTripAt = false, false, 0
        print("[HustlHub] Auto Hatch: watching storage (Craft When Storage Is Full is " .. (hatchCraft.enabled and "on" or "off") .. ")")
        while hatchOn() and current() do
            task.wait(1)
            -- hatching paused (another feature's trip, you walked off...): keep watching while the switch
            -- is on; only stop when Auto Hatch is really switched off
            if not hatchRunning then
                if not switchOn() then break end
                continue
            end
            local okCheck, full, count, limit, hasWork = pcall(function()
                local c, l = storageInfo()
                local isFull = c >= l - 8 or hatchWaitReason == FATAL_HATCH_ERRORS.StorageFull
                local work = isFull and hatchCraft.enabled and os.clock() >= nextTripAt
                    and (nextSet("Golden") or nextSet("Diamond") or nextSet("Shiny")) ~= nil
                return isFull, c, l, work
            end)
            if not okCheck then
                warn("[HustlHub] Craft When Storage Is Full check error:", full)
                task.wait(4)
                continue
            end
            if not full then
                noWorkNoted, offNoted = false, false
                continue
            end
            if not hatchCraft.enabled then
                if not offNoted then
                    offNoted = true
                    print("[HustlHub] Auto Hatch: storage full, but \"Craft When Storage Is Full\" is off")
                end
                continue
            end
            if os.clock() < nextTripAt then continue end
            if hatchCraft.tripBusy then continue end -- (another watcher's trip is still running)
            if not hasWork then
                if not noWorkNoted then
                    noWorkNoted = true
                    print("[HustlHub] Auto Hatch: storage full, but there's no full set of pets to craft")
                    window:Notify({ title = "Auto Hatch", content = "Storage is full but there's no full set of pets to craft (Pets Per Craft in the Crafting tab).", duration = 6 })
                end
                continue
            end
            noWorkNoted = false

            -- the trip
            local model = EggsFolder:FindFirstChild(eggName)
            local root = getRoot()
            local eggPos = (model and model:GetPivot().Position) or (root and root.Position) or Vector3.zero
            if model then eggStandSpot(model) end -- remember the spot while the egg is loaded
            print(string.format("[HustlHub] Auto Hatch: storage full (%d/%s), going to craft", count, tostring(limit)))
            window:Notify({ title = "Auto Hatch", content = "Storage full: crafting, then back to the egg.", duration = 4 })
            acquireTrip("hatchCraft")
            hatchCraft.tripBusy = true
            stopHatching() -- must stop before leaving, or the server answers "TooFar"
            setCraftUiHidden("HatchCraft", true)
            local made = {}
            local ok, err = pcall(function()
                CraftTeam.start("HatchCraft") -- your best Alchemist pets
                -- craft EVERYTHING before going back: Golden -> Diamond -> Rainbow passes until a whole
                -- pass makes nothing (Goldens made this trip become Diamonds in the next pass, and so on)
                for pass = 1, 8 do
                    if not alive() then break end
                    local before = (made.Golden or 0) + (made.Diamond or 0) + (made.Rainbow or 0)
                    craftAt("Golden", alive, eggPos, made)
                    craftAt("Diamond", alive, eggPos, made)
                    if hatchCraft.tiers.Rainbow or nextSet("Shiny") then rainbowAt(alive, eggPos, made) end
                    if (made.Golden or 0) + (made.Diamond or 0) + (made.Rainbow or 0) == before then break end
                end
            end)
            hatchCraft.tripBusy = false
            if not ok then warn("[HustlHub] Hatch craft error:", err) end
            setCraftUiHidden("HatchCraft", false)
            CraftTeam.stop("HatchCraft")
            table.clear(skipNames)
            local summary = string.format("%d Golden, %d Diamond, %d Rainbow", made.Golden or 0, made.Diamond or 0, made.Rainbow or 0)
            print("[HustlHub] Auto Hatch: crafted " .. summary)
            if (made.Golden or 0) + (made.Diamond or 0) + (made.Rainbow or 0) == 0 then
                nextTripAt = os.clock() + 60 -- nothing worked: don't bounce straight back
            end

            -- a replaced copy (the script was run again) must NOT go back to the egg and start its own hatching: that
            -- old hatching can't see the new copy's trip lock, so it dragged you back to the egg mid-trip (seen live)
            if not current() then releaseTrip("hatchCraft") break end
            -- back to the egg (only if Auto Hatch is still on)
            if switchOn() and model then pcall(standAtEgg, model) task.wait(ARRIVE) end
            releaseTrip("hatchCraft")
            if not switchOn() then break end
            window:Notify({ title = "Auto Hatch", content = "Crafted " .. summary .. ". Back to hatching.", duration = 4 })
            selectedEgg = eggName
            startHatching(false, true, true)
            if not hatchOn() then
                -- Auto Hatch was switched on again during the trip: carry on watching under its session
                -- (its own watcher may have quit while hatching was paused for this trip)
                task.spawn(hatchCraft.run, hatchCraft.session)
                break
            end
        end
        if hatchCraft.watching == session then hatchCraft.watching = nil end
    end
end

local indexToggle
indexToggle = indexTab:CreateToggle({
    name = "Auto Index", -- remembered between runs (it used to be forgotten on purpose)
    description = "Hatches the egg, crafts Golden / Diamond / Rainbow versions, and DELETES every pet it hatched or crafted once it's no longer needed. Pets you already owned are never deleted (and only crafted if \"Use Pets I Already Own\" is on).",
    callback = function(value)
        if value and window.hubRefuse("Auto Index") then return end
        stopIndex()
        setCraftUiHidden("Index", value)
        if not value then
            showProgress("Off")
            return
        end
        if not (EggConfig and getReplica() and EggsFolder) then
            window:Notify({ title = "Auto Index", content = "Couldn't read the game's egg / index data.", duration = 5 })
            setCraftUiHidden("Index", false)
            return
        end

        -- every pet you own right now is off limits
        local keep = {}
        for id in pairs(getOwnedPets()) do keep[id] = true end
        -- Rainbow crafts you already had running: still claimed once finished (so they can't block the
        -- queue), but the pets they give are added to `keep`, so they're never deleted
        local keepCrafts = {}
        for craftId in pairs(rainbowQueue()) do keepCrafts[craftId] = true end
        indexKeepCrafts = keepCrafts
        -- crafts the server keeps refusing: "Machine|Name" (or "Claim|craftId") -> retry after this time.
        -- Without this a refused craft is picked again forever and hatching never resumes.
        local blockedUntil = {}
        local function isBlocked(key) return (blockedUntil[key] or 0) > os.clock() end

        local eggs = indexEggChoice == ALL_EGGS and INDEX_EGGS or { indexEggChoice }
        local ourNames = {}
        for _, egg in ipairs(eggs) do
            for _, name in ipairs(eggPets(egg)) do ourNames[name] = true end
        end

        indexRunning = true
        indexRunId += 1
        local myRun = indexRunId
        local function alive() return indexRunning and indexRunId == myRun end
        local previousEgg = selectedEgg
        local deletedAt = {}
        local crafts, deleted = 0, 0
        -- When storage fills up, only ONE pet kind (the focus) keeps collecting Normals for its
        -- crafts; the others' spare Normals get deleted so hatching can continue. Cleared when done.
        local focusName
        local storageStuck = false
        local hatchFails = 0 -- failed hatch trips in a row
        holdStill() -- in case an older version left the character frozen
        equippedIndexTeam = nil -- equip the picked teams again on the first trips
        pcall(refreshTeamDropdowns)
        -- remember your team, so it can be put back when Auto Index stops
        local teamBefore = (indexHatchTeam ~= NO_TEAM or indexCraftTeam ~= NO_TEAM) and CraftTeam.snapshot() or nil
        do
            local versions, rarities = {}, {}
            for v, on in pairs(indexVersions) do if on then table.insert(versions, v) end end
            for r, on in pairs(indexRarities) do if on then table.insert(rarities, r) end end
            print("[HustlHub] Auto Index started:", table.concat(eggs, ", "), "| versions:", table.concat(versions, ","),
                "| rarities:", table.concat(rarities, ","))
        end

        local function emptyHave() return { Normal = {}, Golden = {}, Diamond = {}, Shiny = {} } end
        -- usable pets for crafting / deleting: byName[name][tier] = { ids }
        -- With "Use Pets I Already Own" on, your existing pets of these kinds count too and can be
        -- crafted (never locked, equipped or frozen ones). They're listed FIRST, so anything over
        -- what's needed is taken from this run's hatches instead, and they're never deleted.
        local function ourPets()
            local byName = {}
            local owned = {}
            for id, pet in pairs(getOwnedPets()) do
                local sent = recentlySent[id] or deletedAt[id]
                if (useOwnedPets or not keep[id]) and type(pet) == "table" and ourNames[pet.Name] and pet.Locked ~= true
                    and pet.Frozen == nil and not pet.Equip and not (sent and os.clock() - sent < 3) then
                    byName[pet.Name] = byName[pet.Name] or emptyHave()
                    local list = byName[pet.Name][pet.Tier]
                    if list then
                        if keep[id] then
                            owned[list] = (owned[list] or 0) + 1
                            table.insert(list, owned[list], id) -- your pets go in front
                        else
                            table.insert(list, id)
                        end
                    end
                end
            end
            return byName
        end

        -- how many of each tier to keep for a pet; anything above that gets deleted
        local function plan(name, have, index, tiers)
            local m = missing(name, index, tiers)
            local wantDiamond = math.max(m.Diamond and 1 or 0, (m.Rainbow and not rainbowPending(name)) and RAINBOW_COST or 0)
            local diamondsShort = math.max(0, wantDiamond - #have.Diamond)
            local wantGolden = math.max(m.Golden and 1 or 0, diamondsShort * DIAMOND_COST)
            local goldensShort = math.max(0, wantGolden - #have.Golden)
            local wantNormal = goldensShort * GOLDEN_COST
            if focusName and name ~= focusName then
                -- not the focus: keep what's already crafted, stop collecting Normals for now
                wantNormal = 0
                wantGolden = math.min(wantGolden, #have.Golden)
                wantDiamond = math.min(wantDiamond, #have.Diamond)
            end
            return { Normal = wantNormal, Golden = wantGolden, Diamond = wantDiamond, Shiny = 0 }, m
        end
        -- the pet kind closest to its next craft becomes the focus when storage is full
        local function pickFocus()
            local index, tiers = indexData()
            local best, bestScore
            for name, have in pairs(ourPets()) do
                if next(missing(name, index, tiers)) then
                    local score = #have.Normal + #have.Golden * GOLDEN_COST + #have.Diamond * GOLDEN_COST * DIAMOND_COST
                    if not bestScore or score > bestScore then best, bestScore = name, score end
                end
            end
            return best
        end

        local function deleteIds(ids)
            for i = 1, #ids, 50 do
                local batch = table.move(ids, i, math.min(i + 49, #ids), 1, {})
                local now = os.clock()
                for _, id in ipairs(batch) do deletedAt[id] = now end
                IndexPetRemote:FireServer({ ["Action"] = "Delete", ["PetIds"] = batch })
                deleted += #batch
            end
        end

        -- delete what this run made that isn't needed for a craft any more, but ONLY pets whose
        -- version is already discovered in your index (an undiscovered one is never deleted)
        local function cleanup()
            local index, tiers = indexData()
            local toDelete = {}
            for name, have in pairs(ourPets()) do
                local want = plan(name, have, index, tiers)
                for tier, ids in pairs(have) do
                    local version = TIER_VERSION[tier]
                    if version and hasVersion(name, version, index, tiers) then
                        for i = (want[tier] or 0) + 1, #ids do
                            -- pets you owned before turning Auto Index on are never deleted
                            if not keep[ids[i]] then table.insert(toDelete, ids[i]) end
                        end
                    end
                end
            end
            if #toDelete > 0 then deleteIds(toDelete) end
            -- focus finished: everyone collects again
            if focusName and not next(missing(focusName, index, tiers)) then
                print("[HustlHub] Auto Index: focus", focusName, "done")
                focusName = nil
            end
        end

        -- next craft for a machine: (ids, pet name), or nil. Pets the server just refused are skipped.
        local function nextGolden()
            local index, tiers = indexData()
            for name, have in pairs(ourPets()) do
                local want = plan(name, have, index, tiers)
                if want.Golden > #have.Golden and #have.Normal >= GOLDEN_COST and not isBlocked("Golden|" .. name) then
                    return table.move(have.Normal, 1, GOLDEN_COST, 1, {}), name
                end
            end
        end
        local function nextDiamond()
            local index, tiers = indexData()
            for name, have in pairs(ourPets()) do
                local want = plan(name, have, index, tiers)
                if want.Diamond > #have.Diamond and #have.Golden >= DIAMOND_COST and not isBlocked("Diamond|" .. name) then
                    return table.move(have.Golden, 1, DIAMOND_COST, 1, {}), name
                end
            end
        end
        local function nextRainbow()
            local index, tiers = indexData()
            for name, have in pairs(ourPets()) do
                local _, m = plan(name, have, index, tiers)
                if m.Rainbow and not rainbowPending(name) and #have.Diamond >= RAINBOW_COST and not isBlocked("Shiny|" .. name) then
                    return table.move(have.Diamond, 1, RAINBOW_COST, 1, {}), name
                end
            end
        end
        -- Rainbow crafts in the queue: finished ones (ids, ready to claim) and how many are still
        -- cooking. Every craft in the queue counts (a craft that was started but whose id was missed
        -- used to never be claimed, which left Auto Index "waiting for 0 Rainbow crafts" forever).
        local function ourRainbowCrafts()
            local now, ready, cooking = workspace:GetServerTimeNow(), {}, 0
            for craftId, entry in pairs(rainbowQueue()) do
                if type(entry) == "table" then
                    if entry.EndTime and entry.EndTime <= now then
                        if not isBlocked("Claim|" .. tostring(craftId)) then table.insert(ready, craftId) end
                    elseif not keepCrafts[craftId] then
                        cooking += 1 -- (never wait on a craft you started yourself: it can take hours)
                    end
                end
            end
            return ready, cooking
        end
        local function goldenCraftsReady()
            local index, tiers = indexData()
            local count = 0
            for name, have in pairs(ourPets()) do
                local want = plan(name, have, index, tiers)
                count += math.min(math.max(0, want.Golden - #have.Golden), math.floor(#have.Normal / GOLDEN_COST))
            end
            return count
        end
        -- does this egg still need hatching (missing Normals, or not enough Normals to craft with)?
        local function needsHatching(egg)
            local index, tiers = indexData()
            local pets = ourPets()
            for _, name in ipairs(eggPets(egg)) do
                local have = pets[name] or emptyHave()
                local want, m = plan(name, have, index, tiers)
                if m.Normal or want.Normal > #have.Normal then return true end
            end
            return false
        end

        -- send one craft and wait for the server's answer (like the crafting tab does)
        -- action: "Craft" (Golden / Diamond), "Start" / "Claim" (Rainbow, game key "Shiny")
        -- name: the pet kind being crafted (a refused craft blocks that kind on this machine for 60s)
        local function craft(machineKey, ids, action, craftId, name)
            local state = machineState[machineKey]
            local now = os.clock()
            for _, id in ipairs(ids or {}) do recentlySent[id] = now end
            state.waiting = true
            state.failReason = nil
            CraftRemote:FireServer({ ["PetIds"] = ids, ["Machine"] = machineKey, ["Action"] = action or "Craft", ["CraftId"] = craftId })
            local sentAt = os.clock()
            while state.waiting and os.clock() - sentAt < 10 and alive() do task.wait(0.03) end
            local failReason = state.failReason
            if not failReason and state.waiting and alive() then
                -- no answer within 10s: check what actually happened instead of assuming it worked
                -- (assuming it worked made the same craft repeat forever without ever hatching)
                task.wait(0.5)
                local owned = getOwnedPets()
                for _, id in ipairs(ids or {}) do
                    if owned[id] then failReason = "no answer from the server (pets weren't used)" break end
                end
                if craftId and rainbowQueue()[craftId] then failReason = "no answer from the server (craft still there)" end
            end
            if failReason then
                print("[HustlHub] Auto Index:", machineKey, action or "Craft", name or "", "rejected:", failReason)
                -- the pets weren't used: make them visible to the planner again right away
                for _, id in ipairs(ids or {}) do recentlySent[id] = nil end
                if craftId then
                    blockedUntil["Claim|" .. tostring(craftId)] = os.clock() + 60
                elseif name then
                    -- a lost chance craft (fewer pets than guaranteed) uses the pets up: no need to block
                    task.wait(0.3)
                    local owned, stillThere = getOwnedPets(), false
                    for _, id in ipairs(ids or {}) do if owned[id] then stillThere = true break end end
                    if stillThere then blockedUntil[machineKey .. "|" .. name] = os.clock() + 60 end
                end
                return false, tostring(failReason)
            end
            crafts += 1
            print("[HustlHub] Auto Index:", machineKey, action or "Craft", "OK")
            return true
        end

        -- one log line per pet of the egg: what's missing, what we have, what we're keeping
        -- e.g. "Chick [Common] missing Diamond,Rainbow | have N12 G3 D0 | keep N150 G25 D5"
        local lastPlanLog = {}
        local function logPlan(egg)
            local index, tiers = indexData()
            local pets = ourPets()
            for _, name in ipairs(eggPets(egg)) do
                local have = pets[name] or emptyHave()
                local want, m = plan(name, have, index, tiers)
                local miss = {}
                for _, v in ipairs(VERSIONS) do if m[v] then table.insert(miss, v) end end
                local line = string.format("%s [%s] missing %s | have N%d G%d D%d | keep N%d G%d D%d%s",
                    name, rarityOf(name), #miss > 0 and table.concat(miss, ",") or "nothing",
                    #have.Normal, #have.Golden, #have.Diamond, want.Normal, want.Golden, want.Diamond,
                    rainbowPending(name) and " | Rainbow crafting" or "")
                if lastPlanLog[name] ~= line then
                    lastPlanLog[name] = line
                    print("[HustlHub] Index plan:", line)
                end
            end
        end

        ---------------- The game's own auto-delete (set on the egg's billboard) deletes pets the moment
        -- they hatch, before Auto Index can craft them. Two kinds (Data.Eggs):
        --   AutoDelete[egg] = ticked pets (keys: "Name" for Normal, "Name_Golden", ...)
        --     -> the pets Auto Index needs are taken off the list while it runs, then it's put back
        --   AutoDeleteBelow[egg] = 1/2/3 ("Commons" / "Rare & below" / "Epic & below")
        --     -> can't be changed from here; you get told to switch it Off for that egg
        local autoDeleteRemote = Remotes.EggService.RE:FindFirstChild("AutoDeleteRequested")
        local savedAutoDelete = {} -- egg -> your original ticked list
        local warnedBelow = {}
        local RANK = { Basic = 1, Common = 1, Rare = 2, Epic = 3, Legendary = 4, Mythical = 5 }
        local BELOW_NAMES = { "Commons", "Rare & below", "Epic & below" }
        local function protectFromAutoDelete(egg)
            local eggsData = getReplica() and getReplica().Data.Eggs
            if not eggsData then return end
            local index, tiers = indexData()
            local needed = {} -- names whose Normals we're collecting
            for _, name in ipairs(eggPets(egg)) do
                local want = plan(name, emptyHave(), index, tiers)
                if want.Normal > 0 then needed[name] = true end
            end
            -- ticked pets
            local list = eggsData.AutoDelete and eggsData.AutoDelete[egg]
            if autoDeleteRemote and type(list) == "table" then
                local kept, removed = {}, {}
                for _, key in ipairs(list) do
                    if needed[key] then table.insert(removed, key) else table.insert(kept, key) end
                end
                if #removed > 0 then
                    if not savedAutoDelete[egg] then savedAutoDelete[egg] = table.clone(list) end
                    autoDeleteRemote:FireServer({ ["Egg"] = egg, ["Entries"] = kept })
                    print("[HustlHub] Auto Index: paused the game's auto-delete for", table.concat(removed, ", "), "on", egg)
                end
            end
            -- "delete below rarity"
            local below = eggsData.AutoDeleteBelow and eggsData.AutoDeleteBelow[egg]
            if type(below) == "number" and below > 0 and not warnedBelow[egg] then
                for name in pairs(needed) do
                    if (RANK[rarityOf(name)] or 1) <= below then
                        warnedBelow[egg] = true
                        local msg = egg .. " egg has auto-delete \"" .. (BELOW_NAMES[below] or "on")
                            .. "\" on, which deletes the " .. name .. "s Auto Index needs. Set it to Off on the egg."
                        print("[HustlHub] Auto Index:", msg)
                        window:Notify({ title = "Auto Index", content = msg, duration = 10 })
                        break
                    end
                end
            end
        end
        local function restoreAutoDelete()
            for egg, list in pairs(savedAutoDelete) do
                pcall(function() autoDeleteRemote:FireServer({ ["Egg"] = egg, ["Entries"] = list }) end)
                print("[HustlHub] Auto Index: restored your auto-delete list on", egg)
            end
            table.clear(savedAutoDelete)
        end

        ---------------- HATCH trip: stand at the egg until there's a batch of crafts to do
        local function hatchTrip(egg)
            showProgress("Planning the " .. egg .. " egg")
            logPlan(egg)
            local okProtect, protectErr = pcall(protectFromAutoDelete, egg)
            if not okProtect then print("[HustlHub] Auto Index: auto-delete check failed:", tostring(protectErr)) end
            showProgress("Loading the " .. egg .. " egg's island")
            local model = EggWorld.load(egg)
            if not model then
                print("[HustlHub] Auto Index:", egg, "egg not found in workspace.Eggs")
                showProgress("Couldn't load the " .. egg .. " egg (retrying)")
                return false
            end
            showProgress("Equipping the hatching team (" .. tostring(indexHatchTeam) .. ")")
            equipIndexTeam(indexHatchTeam)
            print("[HustlHub] Auto Index: going to the", egg, "egg")
            showProgress("Going to the " .. egg .. " egg")
            if not standAtEgg(model) then
                showProgress("Couldn't stand at the " .. egg .. " egg (retrying)")
                return false
            end
            task.wait(ARRIVE)
            selectedEgg = egg
            print("[HustlHub] Auto Index: at the", egg, "egg, starting to hatch")
            showProgress("Starting to hatch the " .. egg .. " egg")
            startHatching(true)
            print("[HustlHub] Auto Index: hatching", egg, focusName and ("(focus: " .. focusName .. ")") or "")
            local start, lastClean, stoppedItself = os.clock(), 0, false
            while alive() do
                if not hatchRunning then stoppedItself = true break end
                if os.clock() - lastClean > 1.5 then
                    cleanup() -- delete what's not needed while still hatching (frees storage)
                    lastClean = os.clock()
                    showProgress(string.format("Hatching %s%s  (%d crafts, %d deleted)", egg,
                        focusName and (", focus " .. focusName) or "", crafts, deleted))
                end
                -- go craft once every pet still needed from this egg is in hand (or a Diamond /
                -- Rainbow craft is ready); no fixed number: whatever the index still needs
                local queued = 0
                for _ in pairs(rainbowQueue()) do queued += 1 end
                if not needsHatching(egg) or nextDiamond() or (nextRainbow() and queued < RAINBOW_QUEUE)
                    or #(ourRainbowCrafts()) > 0 then
                    break
                end
                if storageAlmostFull() then
                    cleanup()
                    task.wait(1) -- let the deletes go through
                    if goldenCraftsReady() > 0 or nextDiamond() or nextRainbow() then break end -- crafting frees room
                    if storageAlmostFull() then
                        if focusName then
                            -- already focused and still full: your own pets fill the storage
                            storageStuck = true
                            break
                        end
                        focusName = pickFocus()
                        print("[HustlHub] Auto Index: storage full, focusing on", tostring(focusName))
                        if not focusName then storageStuck = true break end
                        cleanup()
                        task.wait(1)
                    end
                end
                task.wait(0.1)
            end
            stopHatching() -- must stop before leaving, or the server answers "TooFar"
            return not stoppedItself
        end

        ---------------- CRAFT trip: Golden machine, then Diamond machine (only where needed)
        local function craftRun(machineKey, cf, label, nextIds)
            local ids, name = nextIds()
            if not ids or not alive() then return end
            showProgress("Crafting " .. label .. " pets")
            if not goToMachine(machineKey, cf) then
                print("[HustlHub] Auto Index: couldn't get inside the", label, "machine's area")
            end
            local fails = 0
            while ids and alive() do
                local ok, reason = craft(machineKey, ids, nil, nil, name)
                if ok then
                    fails = 0
                else
                    fails += 1
                    if fails >= 3 then
                        print("[HustlHub] Auto Index: giving up on the", label, "machine this trip")
                        return
                    end
                    if reason and reason:lower():find("near") then goToMachine(machineKey, cf) end
                    task.wait(0.5)
                end
                task.wait(0.15) -- let the inventory update
                ids, name = nextIds()
            end
        end
        -- Rainbow machine: claim every finished craft, start new ones (5 Diamond = 30s, max 3 queued)
        local function rainbowTrip()
            local ready = ourRainbowCrafts()
            local ids, name = nextRainbow()
            local queued = 0
            for _ in pairs(rainbowQueue()) do queued += 1 end
            if not alive() or not (#ready > 0 or (ids and queued < RAINBOW_QUEUE)) then return end
            showProgress("Rainbow machine")
            goToMachine("Rainbow", INDEX_RAINBOW_CF)
            for _, craftId in ipairs(ready) do
                if not alive() then return end
                local yours = keepCrafts[craftId]
                local before = yours and table.clone(getOwnedPets()) or nil
                local claimed, why
                for attempt = 1, 3 do
                    if attempt > 1 then blockedUntil["Claim|" .. tostring(craftId)] = nil end
                    claimed, why = craft("Shiny", nil, "Claim", craftId)
                    if claimed or not alive() then break end
                    local lower = tostring(why):lower()
                    if lower:find("storage") or lower:find("full") or lower:find("space") or lower:find("inventory") then
                        -- the claimed Rainbow pet needs a free slot: delete what Auto Index doesn't need
                        print("[HustlHub] Auto Index: no room to claim the Rainbow pet, freeing storage")
                        cleanup()
                        task.wait(1.5)
                    elseif lower:find("near") or lower:find("far") or lower:find("machine") then
                        goToMachine("Rainbow", INDEX_RAINBOW_CF) -- claiming only works at the machine
                    else
                        task.wait(1)
                    end
                end
                if not claimed then
                    showProgress("Couldn't claim a Rainbow pet: " .. tostring(why) .. " (retrying in 60s)")
                    window:Notify({ title = "Auto Index", content = "Couldn't claim a Rainbow pet: " .. tostring(why), duration = 6 })
                elseif yours then
                    -- a craft you had running before Auto Index: its Rainbow pet is yours, never delete it
                    task.wait(0.5)
                    for id in pairs(getOwnedPets()) do
                        if not before[id] then keep[id] = true end
                    end
                    keepCrafts[craftId] = nil
                end
            end
            queued = 0
            for _ in pairs(rainbowQueue()) do queued += 1 end
            while ids and queued < RAINBOW_QUEUE and alive() do
                if not craft("Shiny", ids, "Start", nil, name) then task.wait(0.5) end
                task.wait(0.5) -- let the queue update, so rainbowPending sees the new craft
                queued = 0
                for _ in pairs(rainbowQueue()) do queued += 1 end
                ids, name = nextRainbow()
            end
        end
        local function craftTrip()
            -- crafting team first (equipped pets are never crafted), only if there's something to craft
            if nextGolden() or nextDiamond() or nextRainbow() or #(ourRainbowCrafts()) > 0 then
                equipIndexTeam(indexCraftTeam)
            end
            craftRun("Golden", INDEX_GOLDEN_CF, "Golden", nextGolden)
            craftRun("Diamond", INDEX_DIAMOND_CF, "Diamond", nextDiamond)
            rainbowTrip()
            cleanup()
        end

        task.spawn(function()
            local skippedEggs = {}
            local okRun, runErr = pcall(function()
            for _, egg in ipairs(eggs) do
                if not alive() then break end
                if not EggWorld.exists(egg) then
                    print("[HustlHub] Auto Index: skipping", egg, "(egg not found / not unlocked)")
                    if not eggDone(egg) then table.insert(skippedEggs, egg) end
                    continue
                end
                if not eggDone(egg) then showProgress("Working on the " .. egg .. " egg") end
                while alive() and not eggDone(egg) do
                    local ok, err = pcall(function()
                        if needsHatching(egg) then
                            local hatched = hatchTrip(egg)
                            if not alive() then return end
                            local canCraft = nextGolden() or nextDiamond() or nextRainbow()
                            if storageStuck and not canCraft then
                                -- give the deletes a moment to land before deciding it's really your own pets
                                cleanup()
                                task.wait(3)
                                if storageAlmostFull() and not (nextGolden() or nextDiamond() or nextRainbow()) then
                                    window:Notify({ title = "Auto Index stopped", content = "Pet storage is full of your own pets. Free some space and turn it on again.", duration = 8 })
                                    print("[HustlHub] Auto Index stopped: storage full")
                                    indexRunning = false
                                    return
                                end
                            end
                            storageStuck = false
                            if not hatched and not canCraft then
                                -- Hatching stopped by itself. Only a locked island is a real dead end; storage
                                -- full, out of coins, or being moved off the egg by another feature (Auto Shrine,
                                -- chests, Pet Defense...) used to count too and turned Auto Index off for good.
                                local reason = hatchStopReason
                                if reason == FATAL_HATCH_ERRORS.IslandLocked then
                                    hatchFails += 1
                                    print("[HustlHub] Auto Index: hatch trip failed (" .. tostring(reason) .. "), try " .. hatchFails .. "/3")
                                    if hatchFails >= 3 then
                                        window:Notify({ title = "Auto Index stopped", content = reason, duration = 6 })
                                        print("[HustlHub] Auto Index stopped:", tostring(reason))
                                        indexRunning = false
                                        return
                                    end
                                elseif reason == FATAL_HATCH_ERRORS.StorageFull then
                                    print("[HustlHub] Auto Index: storage full while hatching, freeing room")
                                    cleanup()
                                    task.wait(1)
                                    if storageAlmostFull() and not focusName then
                                        focusName = pickFocus()
                                        print("[HustlHub] Auto Index: focusing on", tostring(focusName))
                                    elseif storageAlmostFull() then
                                        storageStuck = true -- checked again (with a wait) on the next trip
                                    end
                                elseif reason == FATAL_HATCH_ERRORS.NotEnoughCoins then
                                    showProgress("Not enough coins for the " .. egg .. " egg: waiting 30s, then trying again")
                                    print("[HustlHub] Auto Index: not enough coins, waiting")
                                    task.wait(30)
                                else
                                    print("[HustlHub] Auto Index: hatching stopped (" .. tostring(reason) .. "), going back to the egg")
                                    eggSpots[egg] = nil -- work out the spot again
                                end
                                task.wait(2)
                                return
                            end
                            hatchFails = 0
                        end
                        craftTrip()
                        if alive() and not needsHatching(egg) and not nextGolden() and not nextDiamond() and not nextRainbow() then
                            -- only Rainbow crafts left: wait for them (30s each), then claim
                            local _, cooking = ourRainbowCrafts()
                            if cooking > 0 then
                                showProgress(string.format("Waiting for %d Rainbow craft(s) on %s", cooking, egg))
                            else
                                -- nothing cooking and nothing craftable: a craft the server refused is
                                -- on its 60s cooldown (see the "rejected:" lines in the console)
                                showProgress(string.format("Retrying refused crafts on %s soon (check console)", egg))
                            end
                            task.wait(5)
                        end
                    end)
                    if not ok then
                        warn("[HustlHub] Auto Index error:", err)
                        showProgress("Error on the " .. egg .. " egg (retrying): " .. tostring(err))
                        task.wait(2)
                    end
                end
                if alive() then
                    print("[HustlHub] Auto Index:", egg, "complete")
                    window:Notify({ title = "Auto Index", content = egg .. " egg complete!", duration = 4 })
                end
            end
            end)
            if not okRun then
                -- an error outside the per-trip retry used to kill the run silently (toggle stayed ON,
                -- progress said "Off"): report it and shut down properly
                warn("[HustlHub] Auto Index crashed:", runErr)
                window:Notify({ title = "Auto Index stopped", content = "Error: " .. tostring(runErr), duration = 10 })
            end
            stopHatching()
            holdStill(false)
            restoreAutoDelete() -- put your egg auto-delete settings back exactly as they were
            if teamBefore then
                pcall(CraftTeam.restoreTo, teamBefore) -- and your pet team
                equippedIndexTeam = nil
            end
            selectedEgg = previousEgg
            local finished = alive() and okRun
            indexRunning = false
            setCraftUiHidden("Index", false)
            print(string.format("[HustlHub] Auto Index finished: %d crafts, %d pets deleted", crafts, deleted))
            if finished and #skippedEggs > 0 then
                -- not really finished: some eggs couldn't be reached
                local msg = "Stopped: couldn't reach " .. table.concat(skippedEggs, ", ") .. " (not unlocked / not found)"
                showProgress(msg)
                window:Notify({ title = "Auto Index", content = msg, duration = 8 })
            else
                showProgress(finished and "Done" or (okRun and "Off" or ("Stopped by an error: " .. tostring(runErr))))
                if finished then window:Notify({ title = "Auto Index", content = "Finished!", duration = 5 }) end
            end
            -- flip the switch off so it never looks on while nothing runs
            if indexRunId == myRun and indexToggle and indexToggle.Set then
                if okRun then
                    pcall(indexToggle.Set, indexToggle, false, true) -- finished, or stopped for a real reason (told to you)
                else
                    -- it hit an error: keep the switch on and start again in 10 seconds instead of switching off
                    task.delay(10, function()
                        if indexToggle.value and not indexRunning and indexRunId == myRun then
                            pcall(indexToggle.Set, indexToggle, true)
                        end
                    end)
                end
            end
        end)
    end,
})

-- keep the progress card up to date while nothing's running
task.spawn(function()
    while progressLoop do
        if not indexRunning then showProgress() end
        task.wait(10)
    end
end)

