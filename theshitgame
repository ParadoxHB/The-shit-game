-- SOLID footing for every teleport. The old "wait until there is ground" check counted any part (decoration you can fall
-- through, far-away floors), let go too early, and the character dropped under the map. Now:
--   * floorBelow only counts parts you can really stand on (CanCollide, queried with RespectCanCollide),
--   * ensureFloor, after the wait, puts an invisible solid pad right under the spot when there still is none
--     (the area did not stream in, or the ground there is not solid), and removes it at the next teleport / unload.
window.hubFloorBelow = function(pos, character)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character }
    params.RespectCanCollide = true
    return workspace:Raycast(pos, Vector3.new(0, -40, 0), params)
end
window.hubEnsureFloor = function(cf, character)
    window.hubStandGuard = { cf = cf, t = os.clock() } -- (where the last teleport put you: the watchdog below uses it)
    pcall(function() if window.hubFloorPart then window.hubFloorPart:Destroy() end end)
    window.hubFloorPart = nil
    -- an egg stand spot: a flat invisible pad exactly at the surface that was measured, so the character cannot
    -- slide off a sloped pedestal edge (it did: 5 studs off the Volcanic pedestal onto the ground)
    local eggPad = window.hubEggPad
    window.hubEggPad = nil
    -- coming BACK to an egg spot after a trip: the platform measured the last time we were here
    local last = window.hubLastPlatform
    if not eggPad and last and math.abs(last.x - cf.Position.X) < 1.5 and math.abs(last.z - cf.Position.Z) < 1.5
        and math.abs(cf.Position.Y - (last.y + 3.5)) < 2 then
        eggPad = { x = last.x, z = last.z, y = last.y, t = os.clock() }
    end
    if eggPad and os.clock() - eggPad.t < 60 and math.abs(eggPad.x - cf.Position.X) < 1.5 and math.abs(eggPad.z - cf.Position.Z) < 1.5 then
        window.hubStandGuard.pad = { x = eggPad.x, z = eggPad.z, y = eggPad.y } -- (so the watchdog can rebuild this exact platform)
        window.hubLastPlatform = { x = eggPad.x, z = eggPad.z, y = eggPad.y }
        local flat = Instance.new("Part")
        flat.Name = "HustlHubFloor"
        flat.Anchored = true
        flat.CanCollide = true
        flat.CanQuery = true
        flat.CanTouch = false
        flat.Transparency = 1
        flat.Size = Vector3.new(10, 1, 10)
        flat.CFrame = CFrame.new(cf.Position.X, eggPad.y - 0.5, cf.Position.Z) -- top surface = the platform height
        flat.Parent = workspace
        window.hubFloorPart = flat
        return true
    end
    local hit = window.hubFloorBelow(cf.Position, character)
    if hit then
        -- solid ground exists, but the ground here can be a very thin slab (0.3 to 0.6 studs at the eggs): a crowd or a
        -- fall can go straight through it. Put a thick flat pad exactly on that surface. (Not when the spot is high
        -- above the ground on purpose.)
        if (cf.Position.Y - 3) - hit.Position.Y > 8 then return false end
        local thick = Instance.new("Part")
        thick.Name = "HustlHubFloor"
        thick.Anchored = true
        thick.CanCollide = true
        thick.CanQuery = true
        thick.CanTouch = false
        thick.Transparency = 1
        thick.Size = Vector3.new(12, 1, 12)
        thick.CFrame = CFrame.new(cf.Position.X, hit.Position.Y - 0.5, cf.Position.Z)
        thick.Parent = workspace
        window.hubFloorPart = thick
        return true
    end
    local pad = Instance.new("Part")
    pad.Name = "HustlHubFloor"
    pad.Anchored = true
    pad.CanCollide = true
    pad.CanQuery = true
    pad.CanTouch = false
    pad.Transparency = 1
    pad.Size = Vector3.new(16, 1, 16)
    pad.CFrame = CFrame.new(cf.Position.X, cf.Position.Y - 3.5, cf.Position.Z) -- top surface = feet level of the spot
    pad.Parent = workspace
    window.hubFloorPart = pad
    print("[HustlHub] Teleport: no solid ground loaded at the spot, put a floor pad under it")
    return true
end
-- going BACK to a spot after a trip (chests, breakables, minigames, digging): same floor pad + watchdog target as a normal
-- teleport. (These used to just set the position: no pad, so the return could land on the thin slab with nothing
-- under it, and the watchdog still pointed at the trip's spot.)
window.hubReturnTo = function(cf)
    local root = getRoot()
    if not root then return end
    window.hubEnsureFloor(cf, game:GetService("Players").LocalPlayer.Character)
    root.AssemblyLinearVelocity = Vector3.zero
