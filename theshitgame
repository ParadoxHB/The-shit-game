local function waitForChange(before, timeout)
    local start = os.clock()
    repeat task.wait(0.1) until table.concat(equippedIds(), ",") ~= before or os.clock() - start > (timeout or 1.5)
end
local function familyCap(family)
    if EnchantConfig and EnchantConfig.Enchants then
        for _, def in pairs(EnchantConfig.Enchants) do
            if (def.Family or def.Type) == family then return math.huge end -- no cap: every pet with it counts
        end
    end
    return math.huge
end

local equippingBest = false
enchantTab:CreateButton({
    name = "Equip Best",
    description = "Equips the best pets for everything picked above: the game's Equip Best for the stat first, then your best pets for each picked enchant (3 each, in the order you picked them) swapped in for your weakest pets. Never more than your pet slots.",
    callback = function()
        if equippingBest then return end
        equippingBest = true
        local ok, err = pcall(function()
            local picks = currentPicks()
            local mode, families = nil, {}
            for _, label in ipairs(picks) do
                if GAME_MODES[label] then
                    mode = mode or GAME_MODES[label] -- first game mode picked
                elseif familyInfo[label] then
                    table.insert(families, familyInfo[label])
                end
            end
            if not mode and #families == 0 then
                window:Notify({ title = "Equip Best", content = "Pick what to equip for first.", duration = 3 })
                return
            end

            -- 1) the game's own Equip Best: the picked mode, or the stat of the first picked enchant
            local gameMode = mode or MODE_FOR_AFFINITY[families[1].affinity] or "Luck"
            local before = table.concat(equippedIds(), ",")
            PetAction:FireServer({ ["Action"] = "EquipBest", ["Mode"] = gameMode })
            waitForChange(before)
            local modeName = gameMode == "Clicks" and "Taps" or gameMode
            if #families == 0 then
                window:Notify({ title = "Equip Best", content = "Equipped your best " .. modeName .. " pets.", duration = 3 })
                return
            end

            -- 2) per picked enchant: its best pets (highest level, then strongest), 3 each,
            --    never more than your pet slots in total; a pet is only used once
            local owned = getOwnedPets()
            local limit = equipLimit()
            local chosen, chosenSet, summary = {}, {}, {}
            for _, info in ipairs(families) do
                local candidates = {}
                for id, pet in pairs(owned) do
                    if type(pet) == "table" and pet.Frozen == nil and not chosenSet[id] then
                        local rank = familyRank(pet, info.family)
                        if rank > 0 then table.insert(candidates, { id = id, rank = rank, power = petPower(pet) }) end
                    end
                end
                table.sort(candidates, function(a, b)
                    if a.rank ~= b.rank then return a.rank > b.rank end
                    return a.power > b.power
                end)
                local take = math.min(familyCap(info.family), #candidates, limit - #chosen)
                for i = 1, take do
                    table.insert(chosen, candidates[i].id)
                    chosenSet[candidates[i].id] = true
                end
                table.insert(summary, { family = info.family, count = take, wanted = #candidates })
                if #chosen >= limit then break end
            end

            -- 3) swap them in for the weakest equipped pets that aren't chosen
            for _, id in ipairs(chosen) do
                local equipped = equippedIds()
                if not table.find(equipped, id) then
                    if #equipped >= limit then
                        local weakest, weakestPower
                        for _, eid in ipairs(equipped) do
                            local pet = owned[eid]
                            if not chosenSet[eid] and pet then
                                local power = petPower(pet)
                                if not weakest or power < weakestPower then weakest, weakestPower = eid, power end
                            end
                        end
                        if weakest then
                            local b = table.concat(equipped, ",")
                            PetAction:FireServer({ ["Action"] = "Unequip", ["PetId"] = weakest })
                            waitForChange(b)
                        end
                    end
                    local b = table.concat(equippedIds(), ",")
                    PetAction:FireServer({ ["Action"] = "Equip", ["PetId"] = id })
                    waitForChange(b)
                end
            end

            -- report what's equipped now
            local equippedNow = {}
            for _, id in ipairs(equippedIds()) do equippedNow[id] = true end
            local parts = {}
            local skipped = {}
            for _, s in ipairs(summary) do
                if s.wanted == 0 then
                    table.insert(skipped, s.family .. " (none owned)")
                else
                    table.insert(parts, s.count .. " " .. s.family)
                end
            end
            for _, info in ipairs(families) do
                local listed = false
                for _, s in ipairs(summary) do if s.family == info.family then listed = true end end
                if not listed then table.insert(skipped, info.family .. " (no slots left)") end
            end
            local have = 0
            for _, id in ipairs(chosen) do if equippedNow[id] then have += 1 end end
            local text = string.format("Best %s team with %s.", modeName, #parts > 0 and table.concat(parts, ", ") or "no enchant pets")
            if #skipped > 0 then text = text .. " Skipped: " .. table.concat(skipped, ", ") .. "." end
            print(string.format("[HustlHub] Equip Best: %s | %d/%d picked pets equipped (slots: %d) | %s",
                gameMode, have, #chosen, limit, text))
            window:Notify({ title = "Equip Best", content = text, duration = 5 })
        end)
        equippingBest = false
        if not ok then warn("[HustlHub] Equip Best error:", err) end
    end,
})

---------------- Auto Enchant
-- From the game's EnchantController / EnchantWindow / EnchantConfig:
--   * a roll = EnchantService.Enchant { PetId, Slot, RequestId } -> Pending { Token, Enchant, ... }
--     then EnchantService.Resolve { Token, UseNew = true } puts the new enchant on (the game's own
--     button always does exactly this). 1 gem per roll. You must stand at the Enchant machine
--     (an InteractionPoint named "Enchant").
--   * every pet rolls from every pool (Taps / Gems / Luck). Slot 2 only exists on pets the game
--     gives 2 slots (EnchantConfig.GetSlotCount: ultimate pets, or one that already has Enchant2);
--     there's no remote to unlock it, so the hub can't add a slot.
-- Auto Enchant rolls the chosen pet over and over until it lands one of the enchants you picked.
enchantTab:CreateSection({ name = "Auto Enchant" })

local EnchantRemotes = Remotes:FindFirstChild("EnchantService")
local EnchantRF = EnchantRemotes and EnchantRemotes:FindFirstChild("RF")
local EnchantRE = EnchantRemotes and EnchantRemotes:FindFirstChild("RE")
local AutoEventRE = EnchantRE and EnchantRE:FindFirstChild("AutoEvent") -- the game's auto enchant reports every roll / stop here
-- Every pet rolls from every pool now (EnchantConfig.GetPool walks Clicks, Gems and Luck for any
-- pet), so there's no affinity filter: any pet, any target enchant.
local EQUIPPED_OPTION = "★ My Equipped Pets"
local slotTargets = { {}, {} } -- [slot] = set of enchant names to stop on in that slot
local enchantUseEquipped = false
local unlockSlot2 = false    -- "Unlock Slot 2 First"
local enchantRunning, enchantRunId = false, 0
local enchantStatus

local function slotCount(pet)
    if EnchantConfig and EnchantConfig.GetSlotCount then
        local ok, n = pcall(EnchantConfig.GetSlotCount, pet)
        if ok and type(n) == "number" then return n end
    end
    return pet.Enchant2 ~= nil and 2 or 1
end
local function cleanEnchant(value)
    if value == false or value == "" then return nil end
    return value
end
-- what's on a pet, for labels: "Lucky II", "Lucky II + Golden Touch", "no enchant"
local function enchantText(pet)
    local a, b = cleanEnchant(pet.Enchant), cleanEnchant(pet.Enchant2)
    if a and b then return a .. " + " .. b end
    if a or b then return a or ("slot 2: " .. b) end
    return nil
end

-- every enchant there is, best first (all three pools), plus the secret ones
local function targetOptions()
    local list, seen, entries = {}, {}, {}
    for _, pool in pairs(EnchantConfig and EnchantConfig.Pools or {}) do
        for _, e in ipairs(pool) do
            if e.Name and not seen[e.Name] then
                seen[e.Name] = true
                table.insert(entries, e)
            end
        end
    end
    table.sort(entries, function(a, b)
        if (a.Rank or 0) ~= (b.Rank or 0) then return (a.Rank or 0) > (b.Rank or 0) end
        return a.Name < b.Name
    end)
    -- your favourites first, in this order, then everything else (best first, secrets last)
    local TOP = { "Secret Hunter", "Lucky III", "Golden Touch", "Celestial Bond", "Prismatic Surge", "Four-Leaf" }
    local all, rest = {}, {}
    for _, e in ipairs(entries) do all[e.Name] = true table.insert(rest, e.Name) end
    for _, name in ipairs(EnchantConfig and EnchantConfig.SecretNames or {}) do
        if not all[name] then all[name] = true table.insert(rest, name) end
    end
    for _, name in ipairs(TOP) do
        -- (secret enchants are always offered, even if this game version doesn't list them)
        if all[name] or (EnchantConfig and EnchantConfig.Enchants and EnchantConfig.Enchants[name]) then
            table.insert(list, name)
            seen[name] = "top"
        end
    end
    for _, name in ipairs(rest) do
        -- (Hog Heaven can't be rolled: it only comes from a diving pig in Pigs could fly!)
        local granted = EnchantConfig and EnchantConfig.IsGranted and EnchantConfig.IsGranted(name) == true
        if seen[name] ~= "top" and not granted then table.insert(list, name) end
    end
    return list
end

-- your pets, STACKED: identical pets (same pet, tier and enchants) are one option, and the label
-- shows what they have, e.g. "Golem [Golden] - Lucky II + Golden Touch x3". "★ My Equipped Pets"
-- at the top = whatever you have equipped when Auto Enchant starts.
local stacks = {}      -- label -> { ids }
local stackKeyOf = {}  -- label -> "Name|Tier|Enchant|Enchant2" (stays the same when the count changes)
local pickedStacks = {} -- set of keys you ticked
local function petOptions()
    table.clear(stacks)
    table.clear(stackKeyOf)
    local groups, order = {}, {}
    for id, pet in pairs(getOwnedPets()) do
        if type(pet) == "table" and pet.Frozen == nil then
            local e1, e2 = cleanEnchant(pet.Enchant), cleanEnchant(pet.Enchant2)
            local key = table.concat({ tostring(pet.Name), tostring(pet.Tier or "Normal"), tostring(e1 or ""), tostring(e2 or "") }, "|")
            if not groups[key] then
                groups[key] = { name = pet.Name, tier = pet.Tier, text = enchantText(pet), slots = slotCount(pet), ids = {} }
                table.insert(order, key)
            end
            table.insert(groups[key].ids, id)
        end
    end
    table.sort(order, function(a, b)
        local ga, gb = groups[a], groups[b]
        if ga.name ~= gb.name then return ga.name < gb.name end
        if tostring(ga.tier) ~= tostring(gb.tier) then return tostring(ga.tier) < tostring(gb.tier) end
        if (ga.text == nil) ~= (gb.text == nil) then return ga.text == nil end -- not enchanted first
        return tostring(ga.text) < tostring(gb.text)
    end)
    local options = { EQUIPPED_OPTION }
    stackKeyOf[EQUIPPED_OPTION] = EQUIPPED_OPTION
    for _, key in ipairs(order) do
        local g = groups[key]
        table.sort(g.ids) -- same order every time
        local tier = (g.tier and g.tier ~= "Normal") and (" [" .. (g.tier == "Shiny" and "Rainbow" or g.tier) .. "]") or ""
        local label = g.name .. tier .. (g.slots >= 2 and " (2 slots)" or "") .. (g.text and (" - " .. g.text) or "")
            .. (#g.ids > 1 and (" x" .. #g.ids) or "")
        stacks[label] = g.ids
        stackKeyOf[label] = key
        table.insert(options, label)
    end
    return options
end
-- every pet id to enchant: the ticked stacks (re-read, so new copies are included) plus your
-- equipped pets if that's ticked
local function pickedPetIds()
    local ids, seen = {}, {}
    local function add(id) if not seen[id] then seen[id] = true table.insert(ids, id) end end
    if enchantUseEquipped then
        pcall(function()
            for _, id in ipairs(window.hubCraftTeam.snapshot()) do add(id) end
        end)
    end
    for label, key in pairs(stackKeyOf) do
        if pickedStacks[key] and stacks[label] then
            for _, id in ipairs(stacks[label]) do add(id) end
        end
    end
    return ids
end

