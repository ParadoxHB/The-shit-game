    local UserInputService = game:GetService("UserInputService")
    local cfgTab = window.tabByName["Config"]
    if cfgTab then
        cfgTab:CreateSection({ name = "Hotkeys" })
        cfgTab:CreateText({
            name = "How hotkeys work",
            text = "Click a key button, then press the key you want. Esc cancels, Backspace / Delete removes it. "
                .. "The menu key opens and closes the menu (it can be changed but not removed). A tab key opens the menu on that tab. "
                .. "A switch slot turns the switch you pick on or off with its key.",
        })

        local tabKeys = {}  -- key name -> tab name
        local slotSwitch, slotKey = {}, {} -- slot number -> switch name / key name
        local SLOTS = 5

        cfgTab:CreateKeybind({
            name = "Open / Close Menu",
            description = "The key that opens and closes the menu (Right Shift by default).",
            value = "RightShift",
            callback = function(key)
                local code = (key ~= "" and Enum.KeyCode[key]) or Enum.KeyCode.RightShift
                library.toggleKey = code
            end,
        })

        for _, tabName in ipairs(window:TabNames()) do
            cfgTab:CreateKeybind({
                name = tabName .. " Tab",
                description = "Opens the menu on the " .. tabName .. " tab.",
                value = "",
                allowClear = true,
                callback = function(key)
                    for k, t in pairs(tabKeys) do
                        if t == tabName then tabKeys[k] = nil end
                    end
                    if key ~= "" then tabKeys[key] = tabName end
                end,
            })
        end

        -- every switch you can bind (the real switches, not the Config tab copies)
        local switchNames = {}
        local switchByName = {}
        for _, el in ipairs(window.elements) do
            if el.isToggle and not switchByName[el.name] then
                switchByName[el.name] = el
                table.insert(switchNames, el.name)
            end
        end
        table.sort(switchNames)

        for i = 1, SLOTS do
            cfgTab:CreateDropdown({
                name = "Switch Slot " .. i,
                description = "Pick the switch that Switch Slot " .. i .. "'s key turns on / off.",
                options = switchNames,
                placeholder = "None",
                callback = function(selected) slotSwitch[i] = selected[1] end,
            })
            cfgTab:CreateKeybind({
                name = "Switch Slot " .. i .. " Key",
                description = "Press this key to turn the picked switch on or off.",
                value = "",
                allowClear = true,
                callback = function(key) slotKey[i] = (key ~= "") and key or nil end,
            })
        end

        cfgTab:CreateButton({
            name = "Reset Hotkeys",
            description = "Menu key back to Right Shift, every other hotkey removed.",
            buttonText = "Reset",
            callback = function()
                for _, el in ipairs(cfgTab.keybinds) do
                    el:Set(el.defaultValue or "")
                end
                window:Notify({ title = "Hotkeys", content = "Hotkeys reset.", duration = 3 })
            end,
        })

        connections.hubHotkeys = UserInputService.InputBegan:Connect(function(input, processed)
            if processed or window.keybindListening or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            local name = input.KeyCode.Name
            local tabName = tabKeys[name]
            if tabName then
                window:ShowTab(tabName)
                return
            end
            for i = 1, SLOTS do
                if slotKey[i] == name and slotSwitch[i] then
                    local el = switchByName[slotSwitch[i]]
                    if el then
                        el.userNext = true el.clickNext = true
                        el:Set(not el.value)
                        window:Notify({ title = "Hotkey", content = slotSwitch[i] .. " is now " .. (el.value and "ON" or "OFF"), duration = 2 })
                    end
                    return
                end
            end
        end)
    end
end

---------------------------------------------------------------- All Accounts (Config tab): switch something on / off on every account at once
-- One account writes a small command file in the shared workspace folder; every account running HustlHub checks it every few
-- seconds and applies the newest command. (Needs all your accounts to use the same executor workspace folder.)
do -- own scope (keeps the top level under Luau's 200-local limit)
    local HttpService = game:GetService("HttpService")
    local cfgTab = window.tabByName["Config"]
    if cfgTab then
        local COMMAND_FILE = "TapSimHub/AllAccounts_command.json"
        local alive = true
        connections.hubAllAccounts = { Disconnect = function() alive = false end }

        local switchByName, switchNames = {}, {}
        for _, el in ipairs(window.elements) do
            if el.isToggle and not switchByName[el.name] then
                switchByName[el.name] = el
                table.insert(switchNames, el.name)
            end
        end
        table.sort(switchNames)

        local function readCommand()
            local ok, cmd = pcall(function()
                if not isfile(COMMAND_FILE) then return nil end
                return HttpService:JSONDecode(readfile(COMMAND_FILE))
            end)
            if ok and type(cmd) == "table" and cmd.id and (cmd.switch or cmd.setting or cmd.action) then return cmd end
            return nil
        end

        local lastSeen
        do
            local current = readCommand()
            lastSeen = current and current.id or nil -- a command that was already there when this account started is not replayed
        end

        -- every dropdown setting that can be set on all accounts (Egg, teams, ...)
        local settingByName, settingNames = {}, {}
        for flag, el in pairs(window.elementsByFlag) do
            if not el.isToggle and type(el.options) == "table" and el.Set
                and not flag:find("^Switch Slot") and not flag:find("^All Accounts") then
                settingByName[flag] = el
                table.insert(settingNames, flag)
            end
        end
        table.sort(settingNames)

        local function apply(cmd)
            if cmd.action == "DeleteNow" then
                if window.hubNeverOn or window.hubPaused or not window.hubDeleteNow then return false end -- (all-off and paused accounts keep their pets)
                local n = window.hubDeleteNow()
                window:Notify({ title = "Delete Pets", content = "Deleted " .. n .. " pets (Delete Now from " .. tostring(cmd.from or "another account") .. ").", duration = 4 })
                return false
            end
            if cmd.setting then
                local setting = settingByName[cmd.setting]
                if not setting or type(cmd.values) ~= "table" then return false end
                setting:Set(cmd.values)
                -- a running Auto Hatch has to walk to the new egg: switch it off and on again
                local hatch = switchByName["Auto Hatch"]
                if cmd.setting == "Egg" and hatch and hatch.value then
                    task.spawn(function()
                        hatch:Set(false)
                        task.wait(1.5)
                        hatch:Set(true)
                    end)
                end
                return true
            end
            local el = switchByName[cmd.switch]
            if not el then return false end
            if el.value ~= (cmd.value == true) then
                el.userNext = true el.clickNext = true
                el:Set(cmd.value == true)
            end
            return true
        end

        -- send an action (like Delete Now) to every other account: true when the command file was written
        window.hubBroadcastAction = function(action)
            local id = tostring(os.time()) .. "-" .. tostring(math.random(100000, 999999))
            local ok = pcall(function()
                if not isfolder("TapSimHub") then makefolder("TapSimHub") end
                writefile(COMMAND_FILE, HttpService:JSONEncode({ id = id, action = action, from = LocalPlayer.Name, t = os.time() }))
            end)
            if ok then lastSeen = id end
            return ok
        end

        local firstRow = #cfgTab.rows + 1
        cfgTab:CreateSection({ name = "All Accounts" })
        cfgTab:CreateText({
            name = "How it works",
            text = "Pick a switch and press ON or OFF: every account running HustlHub that follows commands applies it within a few seconds. "
                .. "All accounts must use the same executor workspace folder.",
        })

        local follow = true
        window.hubFollow = true -- (the live sync below also checks this)
        local followEl = cfgTab:CreateToggle({
            name = "Follow All-Account Commands",
            description = "While on, this account takes part in the all-accounts features: it applies the ON / OFF commands and live-syncs its settings with the other accounts. Turn it OFF to take this account out completely: it stops copying the other accounts AND stops sharing its own changes with them.",
            value = true,
            callback = function(value)
                follow = value
                window.hubFollow = value
                -- not following = this account's own settings (own autosave file; live sync off), following = the
                -- shared config again unless "Use Shared Config" was turned off on this account (v1.4.43)
                if value then
                    local own = false
                    pcall(function() own = isfile(window.hubModeFile) and readfile(window.hubModeFile) == "own" end)
                    window.hubShared = not own
                else
                    window.hubShared = false
                end
            end,
        })
        local followRow = cfgTab.rows[#cfgTab.rows] -- (this switch's own row: hidden below, it lives in the title bar)
        if window.hubStartFollow ~= nil then
            followEl:Set(window.hubStartFollow)
            -- the saved settings load later and could set it back: put it right once they're in
            task.spawn(function()
                local t0 = os.clock()
                while not window.hubSettingsLoaded and os.clock() - t0 < 90 do task.wait(0.5) end
                if followEl.value ~= window.hubStartFollow then followEl:Set(window.hubStartFollow) end
            end)
        end

        -- "Accounts That Follow" (v1.4.42): choose from ONE account which accounts follow (Follow All-Account Commands).
        -- Every account reports its state in TapSimHub/follow/status_<name>.json (every 5 s, and right after a change);
        -- the list shows the accounts running HustlHub (seen in the last 45 s), ticked = following. Ticking / unticking
        -- writes TapSimHub/follow/command.json, and every listed account switches its own Follow to match within ~2 s.
        -- (Read even by accounts that don't follow, so they can be brought back from here.)
        pcall(function()
            local FDIR = "TapSimHub/follow"
            local me = LocalPlayer.Name
            local function fread(path)
                local v
                pcall(function() if isfile(path) then v = HttpService:JSONDecode(readfile(path)) end end)
                return type(v) == "table" and v or nil
            end
            local function fwrite(path, v)
                pcall(function()
                    if not isfolder("TapSimHub") then makefolder("TapSimHub") end
                    if not isfolder(FDIR) then makefolder(FDIR) end
                    writefile(path, HttpService:JSONEncode(v))
                end)
            end
            local function report() fwrite(FDIR .. "/status_" .. me .. ".json", { name = me, follow = followEl.value == true, t = os.time() }) end
            local function online()
                local list = {}
                pcall(function()
                    for _, path in ipairs(listfiles(FDIR)) do
                        if tostring(path):match("status_[^/\\]+%.json$") then
                            local s = fread(path)
                            if s and s.name and os.time() - (tonumber(s.t) or 0) <= 45 then table.insert(list, s) end
                        end
                    end
                end)
                table.sort(list, function(a, b) return tostring(a.name) < tostring(b.name) end)
                return list
            end
            local followDrop
            local listed = {}
            local function refresh()
                local names, ticked = {}, {}
                table.clear(listed)
                for _, s in ipairs(online()) do
                    table.insert(names, s.name)
                    listed[s.name] = true
                    if s.follow then table.insert(ticked, s.name) end
                end
                followDrop:Refresh(names)
                followDrop:Set(ticked, true)
            end
            followDrop = cfgTab:CreateDropdown({
                name = "Accounts That Follow",
                description = "Every account running HustlHub, ticked = it follows All-Account Commands (live sync and the ON / OFF commands). Tick or untick accounts here and they switch within a couple of seconds, so you don't have to go to each one. Accounts that aren't running HustlHub aren't listed and aren't changed.",
                options = {},
                multiSelect = true, value = {}, forgetState = true,
                onOpen = function() pcall(refresh) end,
                callback = function(selected)
                    local want = {}
                    for _, name in ipairs(type(selected) == "table" and selected or { selected }) do want[name] = true end
                    local map = {}
                    for name in pairs(listed) do map[name] = want[name] == true end
                    local cur = fread(FDIR .. "/command.json") or {}
                    fwrite(FDIR .. "/command.json", { rev = (tonumber(cur.rev) or 0) + 1, from = me, t = os.time(), follow = map })
                    local n = 0 for _, v in pairs(map) do if v then n += 1 end end
                    window:Notify({ title = "All Accounts", content = n .. " account(s) follow, the rest don't (switching now).", duration = 3 })
                end,
            })
            -- what an account that runs HustlHub for the first time does (shared by all accounts, read at its start)
            local nd = fread(FDIR .. "/new_default.json")
            cfgTab:CreateToggle({
                name = "New Accounts Follow",
                description = "On: an account that runs HustlHub for the first time follows like the others (it copies the shared settings). Off: it starts NOT following, with its own fresh settings, so you can set it up to progress on its own; tick it in Accounts That Follow later if you want it to follow.",
                value = not (nd and nd.follow == false),
                forgetState = true,
                callback = function(value)
                    if not window.hubSettingsLoaded then return end -- (only your clicks change it, never the startup reset)
                    fwrite(FDIR .. "/new_default.json", { follow = value == true, from = me, t = os.time() })
                end,
            })
            local followAlive = true
            connections.hubFollowControl = { Disconnect = function() followAlive = false end }
            table.insert(followEl.mirrors, function() task.defer(report) end) -- (report a change right away)
            task.spawn(function()
                local seenRev = tonumber((fread(FDIR .. "/command.json") or {}).rev) or 0 -- (an old command isn't replayed at start)
                local lastReport = 0
                while followAlive and getgenv().HustlHubRun == HH_RUN do
                    pcall(function()
                        if os.clock() - lastReport >= 5 then lastReport = os.clock() report() end
                        local cmd = fread(FDIR .. "/command.json")
                        local rev = cmd and tonumber(cmd.rev) or 0
                        if cmd and rev > seenRev then
                            seenRev = rev
                            local want = type(cmd.follow) == "table" and cmd.follow[me]
                            if want ~= nil and (followEl.value == true) ~= (want == true) then
                                followEl:Set(want == true)
                                print("[HustlHub] All Accounts: Follow turned " .. (want and "ON" or "OFF") .. " from " .. tostring(cmd.from))
                                report()
                            end
                        end
                    end)
                    task.wait(2)
                end
            end)
        end)

        -- the switch lives in the title bar now (next to the minimise button); the Config row is hidden, the switch
        -- itself (saved state, live sync) is the same one
        pcall(function()
            local rowEntry = followRow -- (not "the last row": the Accounts That Follow list was added after it, v1.4.43)
            if rowEntry and rowEntry.row then
                local hiddenRow = rowEntry.row
                hiddenRow.Visible = false
                hiddenRow:GetPropertyChangedSignal("Visible"):Connect(function() -- (the search box must not bring it back)
                    if hiddenRow.Visible then hiddenRow.Visible = false end
                end)
            end
            local titleBar = window.root:FindFirstChild("TitleBar")
            local title = titleBar and titleBar:FindFirstChild("Title")
            if title then title.Size = UDim2.new(1, -112, 1, 0) end
            local btn = Instance.new("TextButton")
            btn.Name = "FollowAllAccounts"
            btn.Text = "Follow"
            btn.AutoButtonColor = false
            btn.Size = UDim2.new(0, 46, 0, 18)
            btn.AnchorPoint = Vector2.new(1, 0.5)
            btn.Position = UDim2.new(1, -32, 0.5, -1)
            btn.Font = Enum.Font.GothamBold
            btn.TextSize = 11
            btn.BorderSizePixel = 0
            btn.ZIndex = 5
            btn.Parent = titleBar
            local round = Instance.new("UICorner")
            round.CornerRadius = UDim.new(0, 4)
            round.Parent = btn
            local function paint()
                local on = followEl.value == true
                btn.BackgroundColor3 = on and Color3.fromRGB(40, 160, 90) or Color3.fromRGB(70, 70, 75)
                btn.TextColor3 = on and Color3.new(1, 1, 1) or Color3.fromRGB(170, 170, 175)
            end
            paint()
            table.insert(followEl.mirrors, paint)
            btn.MouseButton1Click:Connect(function()
                followEl.userNext = true
                followEl:Set(not followEl.value)
                window:Notify({ title = "All Accounts", content = "Follow All-Account Commands is now " .. (followEl.value and "ON" or "OFF"), duration = 2 })
            end)
        end)

        -- "Pause" button next to Follow: pauses hatching and every automation switch on THIS account only (nothing is
        -- sent to other accounts), and Resume turns back on exactly the ones that were on. While paused nothing is saved
        -- (the saved config keeps the state from before the pause) and other accounts' commands can't switch things on.
        pcall(function()
            local titleBar = window.root:FindFirstChild("TitleBar")
            local title = titleBar and titleBar:FindFirstChild("Title")
            if not titleBar then return end
            if title then title.Size = UDim2.new(1, -168, 1, 0) end
            local origSave = window.Save
            window.Save = function(self, ...)
                if window.hubPaused then return end
                return origSave(self, ...)
            end
            local function eligible(el)
                return el.isToggle and el.Set and el.tab ~= "Misc" and el.tab ~= "Config" and el.tab ~= "Webhook"
                    and el.tab ~= "Trading" and el.name ~= "Anti-AFK"
            end
            local snapshot = {}
            local btn = Instance.new("TextButton")
            btn.Name = "PauseAutomation"
            btn.AutoButtonColor = false
            btn.Size = UDim2.new(0, 50, 0, 18)
            btn.AnchorPoint = Vector2.new(1, 0.5)
            btn.Position = UDim2.new(1, -82, 0.5, -1)
            btn.Font = Enum.Font.GothamBold
            btn.TextSize = 11
            btn.BorderSizePixel = 0
            btn.ZIndex = 5
            btn.Parent = titleBar
            local round = Instance.new("UICorner")
            round.CornerRadius = UDim.new(0, 4)
            round.Parent = btn
            local function paint()
                local on = window.hubPaused == true
                btn.Text = on and "Resume" or "Pause"
                btn.BackgroundColor3 = on and Color3.fromRGB(200, 140, 30) or Color3.fromRGB(70, 70, 75)
                btn.TextColor3 = on and Color3.new(1, 1, 1) or Color3.fromRGB(170, 170, 175)
            end
            paint()
            btn.MouseButton1Click:Connect(function()
                if not window.hubPaused then
                    window.hubPaused = true
                    snapshot = {}
                    for _, el in ipairs(window.elements) do
                        if eligible(el) and el.value == true then table.insert(snapshot, el) end
                    end
                    for _, el in ipairs(snapshot) do
                        el.userNext = false
                        pcall(el.Set, el, false)
                    end
                    paint()
                    window:Notify({ title = "Paused", content = "Paused " .. #snapshot .. " switches on this account. Press Resume to turn them back on.", duration = 4 })
                    task.spawn(function()
                        while window.hubPaused do
                            task.wait(1.5)
                            if window.hubPaused then
                                for _, el in ipairs(window.elements) do
                                    if eligible(el) and el.value == true then
                                        el.userNext = false
                                        pcall(el.Set, el, false) -- (something switched it on during the pause)
                                    end
                                end
                            end
                        end
                    end)
                else
                    window.hubPaused = false
                    paint()
                    for _, el in ipairs(snapshot) do
                        el.userNext = false
                        pcall(el.Set, el, true)
                        task.wait(0.05)
                    end
                    window:Notify({ title = "Resumed", content = "Turned " .. #snapshot .. " switches back on.", duration = 3 })
                    snapshot = {}
                end
            end)
        end)

        local picked
        cfgTab:CreateDropdown({
            name = "All Accounts Switch",
            description = "The switch the buttons below turn on or off on every account.",
            options = switchNames,
            placeholder = "Pick a switch",
            callback = function(selected) picked = selected[1] end,
        })

        local function send(value)
            if not picked or not switchByName[picked] then
                window:Notify({ title = "All Accounts", content = "Pick a switch first.", duration = 3 })
                return
            end
            local id = tostring(os.time()) .. "-" .. tostring(math.random(100000, 999999))
            local cmd = { id = id, switch = picked, value = value, from = LocalPlayer.Name, t = os.time() }
            local ok, err = pcall(function()
                if not isfolder("TapSimHub") then makefolder("TapSimHub") end
                writefile(COMMAND_FILE, HttpService:JSONEncode(cmd))
            end)
            if not ok then
                window:Notify({ title = "All Accounts", content = "Couldn't write the command file: " .. tostring(err), duration = 5 })
                return
            end
            lastSeen = id
            apply(cmd) -- this account too, straight away
            window:Notify({ title = "All Accounts", content = picked .. " " .. (value and "ON" or "OFF") .. " sent to every account.", duration = 4 })
        end

        cfgTab:CreateButton({
            name = "Turn ON On All Accounts",
            description = "Turns the picked switch on for this account and every other account that follows commands.",
            buttonText = "ON",
            callback = function() send(true) end,
        })
        cfgTab:CreateButton({
            name = "Turn OFF On All Accounts",
            description = "Turns the picked switch off for this account and every other account that follows commands.",
            buttonText = "OFF",
            callback = function() send(false) end,
        })

        ---------------- setting a dropdown (for example the egg) on every account
        local pickedSetting, pickedValue
        local valueDropdown
        cfgTab:CreateDropdown({
            name = "All Accounts Setting",
            description = "A dropdown setting to set on every account, for example Egg (the egg Auto Hatch opens). Pick it, then pick its value below.",
            options = settingNames,
            placeholder = "Pick a setting",
            callback = function(selected)
                pickedSetting = selected[1]
                local setting = pickedSetting and settingByName[pickedSetting]
                pickedValue = nil
                if valueDropdown then
                    valueDropdown:Refresh(setting and setting.options or {})
                    valueDropdown:Set({}, true)
                end
            end,
        })
        valueDropdown = cfgTab:CreateDropdown({
            name = "All Accounts Value",
            description = "The value to set (the list shows what this account offers for the setting above).",
            options = {},
            placeholder = "Pick a value",
            forgetState = true,
            onOpen = function()
                local setting = pickedSetting and settingByName[pickedSetting]
                if setting then valueDropdown:Refresh(setting.options) end
            end,
            callback = function(selected) pickedValue = selected[1] end,
        })
        cfgTab:CreateButton({
            name = "Set On All Accounts",
            description = "Sets the picked setting to the picked value on this account and every other account that follows commands. For the Egg, a running Auto Hatch is restarted so it walks to the new egg.",
            buttonText = "Set",
            callback = function()
                if not pickedSetting or not settingByName[pickedSetting] or not pickedValue then
                    window:Notify({ title = "All Accounts", content = "Pick a setting and a value first.", duration = 3 })
                    return
                end
                local id = tostring(os.time()) .. "-" .. tostring(math.random(100000, 999999))
                local cmd = { id = id, setting = pickedSetting, values = { pickedValue }, from = LocalPlayer.Name, t = os.time() }
                local ok, err = pcall(function()
                    if not isfolder("TapSimHub") then makefolder("TapSimHub") end
                    writefile(COMMAND_FILE, HttpService:JSONEncode(cmd))
                end)
                if not ok then
                    window:Notify({ title = "All Accounts", content = "Couldn't write the command file: " .. tostring(err), duration = 5 })
                    return
                end
                lastSeen = id
                apply(cmd)
                window:Notify({ title = "All Accounts", content = pickedSetting .. " = " .. tostring(pickedValue) .. " sent to every account.", duration = 4 })
            end,
        })


        -- this section is built last, but it is shown first in the tab
        for i = firstRow, #cfgTab.rows do
            cfgTab.rows[i].row.LayoutOrder = -1000 + (i - firstRow)
        end

        task.spawn(function()
            while alive do
                task.wait(3)
                if follow then
                    local cmd = readCommand()
                    if cmd and cmd.id ~= lastSeen then
                        lastSeen = cmd.id
                        if apply(cmd) then
                            window:Notify({
                                title = "All Accounts",
                                content = (cmd.setting and (tostring(cmd.setting) .. " = " .. tostring(cmd.values and cmd.values[1]))
                                    or (tostring(cmd.switch) .. " " .. (cmd.value and "ON" or "OFF")))
                                    .. " (sent from " .. tostring(cmd.from or "another account") .. ")",
                                duration = 3,
                            })
                        end
                    end
                end
            end
        end)
    end
end

---------------------------------------------------------------- Auto save
do -- own scope (keeps the top level under Luau's 200-local limit)
-- Each account auto-saves to its own config (Account_<name>_<id>) and gets it back on every execution.
-- Files live in your executor's workspace: TapSimHub/ (the same place as before, so old settings carry over)
-- Load the saved settings once the egg/pet/rebirth lists have been filled in (they refresh at 3s),
-- then keep saving them every 5 seconds. An account that has never used the script starts fresh.
window:ReorderTabs(window.hubTabOrder)
window:SelectTab(window.tabByName["Main"])
local configSaving = false
connections.configSave = { Disconnect = function()
    if configSaving then pcall(function() window:Save(window.hubConfigName()) end) end -- final save before re-running
    configSaving = false
end }

-- every switch starts OFF (saved dropdown / slider / text settings still load, saved switch states are ignored)
-- Switch states are remembered from your last run. The first time after this feature was added there is
-- nothing trustworthy saved yet, so that one run just uses the defaults below.
window.hubVersionFile = "TapSimHub/Remember_" .. window.hubAccountConfig .. ".txt"
window.skipToggles = true -- (v1.4.59: saved switch states are never loaded at launch: every switch starts OFF)
-- these switches are turned ON at launch (everything else starts off)
window.hubDefaultOnOld = { -- (the old launch defaults, no longer used since v1.4.59)
    ["Auto Tap"] = true,
    ["Auto Shrine"] = true,
    ["Skip Hatch Animation"] = true,
    ["Craft When Storage Is Full"] = true,
    ["Best Base For Golden Crafts"] = true,
    ["Best Base For Diamond Crafts"] = true,
