	function Tab:CreateToggle(o)
		local lib = library.options
		local name = o.name
		local flag = o.flag or name
		local row = makeRow(self, name, o.description, 28, "toggle")
		rowLabel(row, name, 52)

		local pill = new("Frame", {
			Name = "Checkmark",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.new(0, 36, 0, 18),
			BackgroundColor3 = lib.btncolor,
			BorderSizePixel = 0,
			Parent = row,
		})
		corner(pill, 9)
		local pillStroke = stroke(pill, lib.bordercolor)

		local knob = new("Frame", {
			Name = "Knob",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 3, 0.5, 0),
			Size = UDim2.new(0, 12, 0, 12),
			BackgroundColor3 = Color3.fromRGB(200, 200, 200),
			BorderSizePixel = 0,
			Parent = pill,
		})
		corner(knob, 6)

		local element = {value = o.value == true, isToggle = true, name = name, tab = self.name, flag = flag, mirrors = {}, description = o.description, keepOn = o.keepOn}

		local function pillColor()
			return element.value and library.options.accent or lib.btncolor
		end

		local function strokeColor()
			return element.value and library.options.accent or lib.bordercolor
		end

		local onBar = new("Frame", {
			Name = "OnBar",
			BackgroundColor3 = lib.accent,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 3, 0.5, -8),
			Size = UDim2.new(0, 3, 0, 16),
			Visible = false,
			ZIndex = 3,
			Parent = row,
		})
		corner(onBar, 2)
		bindAccent(onBar, "BackgroundColor3", function() return library.options.accent end)

		local function render(animate)
			onBar.Visible = element.value
			local t = animate and 0.15 or 0
			tween(pill, {BackgroundColor3 = pillColor()}, t)
			tween(pillStroke, {Color = strokeColor()}, t)
			tween(knob, {
				Position = element.value and UDim2.new(1, -15, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
				BackgroundColor3 = element.value and WHITE or Color3.fromRGB(200, 200, 200),
			}, t)
		end

		render(false)
		bindAccent(pill, "BackgroundColor3", pillColor)
		bindAccent(pillStroke, "Color", strokeColor)

		local flags = self.hub.Flags
		local hub = self.hub

		function element:Set(value, skipCallback)
			local was = element.value
			local byUser = element.userNext == true
			element.userNext = false
			-- a real click on THIS account's switch (live sync / all-account commands also count as byUser)
			element.lastByClick = element.clickNext == true
			element.clickNext = false
			element.value = value == true
			flags[flag] = element.value
			render(true)

			-- every real change is remembered (who did it: you, or the script) for the Status tab and alerts
			if was ~= element.value and not o.noRegister then -- (the Config tab copies are not logged)
				table.insert(hub.changeLog, 1, { name = name, value = element.value, byUser = byUser, t = os.time() })
				if #hub.changeLog > 40 then table.remove(hub.changeLog) end
				if hub.onToggle then pcall(hub.onToggle, element, byUser) end
			end

			for _, m in ipairs(element.mirrors) do
				pcall(m, element.value)
			end

			if not skipCallback and o.callback then
				task.spawn(function()
					local v = element.value
					local ok, err = pcall(o.callback, v)

					if not ok then
						warn("[HustlHub] " .. tostring(name) .. " switch error:", err)
					end

					-- the switch was flipped again while this was still starting up (e.g. turned on, then straight
					-- off): apply the latest state so a slow start can never overrule the off
					if element.value ~= v then
						pcall(o.callback, element.value)
					end
				end)
			end
		end

		rowHit(row).MouseButton1Click:Connect(function()
			element.userNext = true
			element.clickNext = true
			element:Set(not element.value)
		end)

		if not o.noRegister then
			register(self, flag, element, o.forgetState, o.liveSync)
		end
		return element
	end

	-- a button that shows a key: click it, then press the key you want (Esc cancels, Backspace / Delete clears)
	function Tab:CreateKeybind(o)
		local lib = library.options
		local name = o.name
		local flag = o.flag or name
		local row = makeRow(self, name, o.description, 34, "keybind")
		rowLabel(row, name, 150)
		local hub = self.hub
		self.keybinds = self.keybinds or {}

		local btn = new("TextButton", {
			Name = "Key",
			Text = "",
			AutoButtonColor = false,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.new(0, 130, 0, 24),
			BackgroundColor3 = lib.btncolor,
			TextColor3 = lib.textcolor,
			Font = lib.font,
			TextSize = lib.fontsize - 1,
			ZIndex = 3,
			Parent = row,
		})
		corner(btn, 4)
		local btnStroke = stroke(btn, lib.bordercolor)
		hover(btn, lib.btncolor, shade(lib.btncolor, 0.08))

		local element = {value = o.value or "", defaultValue = o.value or ""}
		local listening = false

		local function paint()
			if listening then
				btn.Text = "Press a key..."
				btnStroke.Color = library.options.accent
			else
				btn.Text = element.value ~= "" and element.value or "None"
				btnStroke.Color = lib.bordercolor
			end
		end

		local flags = hub.Flags

		function element:Set(value, skipCallback)
			if type(value) ~= "string" or (value ~= "" and not pcall(function() return Enum.KeyCode[value] end)) then
				value = o.value or ""
			end

			element.value = value
			flags[flag] = value
			paint()

			if not skipCallback and o.callback then
				task.spawn(o.callback, value)
			end
		end

		btn.MouseButton1Click:Connect(function()
			if listening then
				return
			end

			listening = true
			hub.keybindListening = true
			paint()

			local conn
			conn = UIS.InputBegan:Connect(function(input)
				if input.UserInputType ~= Enum.UserInputType.Keyboard or input.KeyCode == Enum.KeyCode.Unknown then
					return
				end

				conn:Disconnect()
				listening = false
				task.defer(function() hub.keybindListening = false end) -- this same press must not trigger anything

				local key = input.KeyCode

				if key == Enum.KeyCode.Escape then
					paint()
				elseif key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Delete then
					if o.allowClear then
						element:Set("")
					else
						paint()
					end
				else
					element:Set(key.Name)
				end
			end)
		end)

		paint()
		table.insert(self.keybinds, element)
		register(self, flag, element, o.forgetState)
		return element
	end

	function Tab:CreateButton(o)
		local lib = library.options
		local row = makeRow(self, o.name, o.description, 28, "button")
		rowLabel(row, o.name, 70)

		local btn = new("TextButton", {
