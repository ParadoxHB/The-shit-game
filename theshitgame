-- Clicks the "Tap!" critical bubbles (the game names them "CriticalActive", 10x damage each).
-- Uses a real mouse click at the bubble's center, exactly like clicking it yourself.
local VirtualInputManager = game:GetService("VirtualInputManager")
local GuiService = game:GetService("GuiService")
local clickedAt = {} -- bubble -> time we clicked it

-- Where on the screen a GUI position really is. GUI positions (AbsolutePosition) start below the
-- top bar, simulated mouse clicks use the whole screen, and the top bar's height differs between
-- Roblox versions (36 / 58 px). So it's measured instead of guessed: move the mouse somewhere, and
-- compare where the screen says it is (GetMouseLocation) with where the GUI says it is (Mouse.Y).
local UserInputService = game:GetService("UserInputService")
local measuredInset
local function measureInset()
    if measuredInset then return measuredInset end
    local ok = pcall(function()
        local cam = workspace.CurrentCamera
        local x, y = math.floor(cam.ViewportSize.X / 2), math.floor(cam.ViewportSize.Y * 0.8)
        VirtualInputManager:SendMouseMoveEvent(x, y, game)
        task.wait(0.1)
        local screen = UserInputService:GetMouseLocation()
        local mouse = LocalPlayer:GetMouse()
        local inset = Vector2.new(screen.X - mouse.X, screen.Y - mouse.Y)
        if inset.Y > 0 and inset.Y < 200 then measuredInset = inset end
    end)
    if not (ok and measuredInset) then
        -- couldn't measure: the larger of the two known top bar heights
        local inset = GuiService:GetGuiInset()
        local okTop, topbar = pcall(function() return GuiService.TopbarInset end)
        local y = (okTop and typeof(topbar) == "Rect") and math.max(inset.Y, topbar.Max.Y) or inset.Y
        measuredInset = Vector2.new(inset.X, y)
    end
    print("[HustlHub] Pet Defense: screen offset for clicks", tostring(measuredInset))
    return measuredInset
end
local function guiScreenOffset(screenGui)
    if screenGui and screenGui.IgnoreGuiInset then return Vector2.zero end
    return measureInset()
end

-- A real mouse click on the bubble, so the game handles it exactly like your own click.
-- (Firing the button's event from the script could start the game's handler in a way that broke
-- part-way: the bubble then counted as "hit", never did the damage, and stayed on screen.)
-- It never clicks blind: the mouse is moved first, and it only clicks once the bubble itself says
-- the mouse is over it (its GuiState turns Hover). A click that misses could hit the HUD buttons
-- next to it (e.g. open your inventory). The offset that worked is remembered.
local workingOffset
local function clickGuiButton(button)
    pcall(function()
        local center = button.AbsolutePosition + button.AbsoluteSize / 2
        local screenGui = button:FindFirstAncestorOfClass("ScreenGui")
        local tries = {}
        if workingOffset then table.insert(tries, workingOffset) end
        if screenGui and screenGui.IgnoreGuiInset then table.insert(tries, Vector2.zero) end
        table.insert(tries, guiScreenOffset(screenGui))
        for _, y in ipairs({ 58, 36, 0 }) do table.insert(tries, Vector2.new(0, y)) end
        for _, offset in ipairs(tries) do
            if not button.Parent then return end
            local at = center + offset
            VirtualInputManager:SendMouseMoveEvent(at.X, at.Y, game)
            task.wait(0.05)
            if button.GuiState == Enum.GuiState.Hover or button.GuiState == Enum.GuiState.Press then
                VirtualInputManager:SendMouseButtonEvent(at.X, at.Y, 0, true, game, 0)
                task.wait(0.04)
                VirtualInputManager:SendMouseButtonEvent(at.X, at.Y, 0, false, game, 0)
                if workingOffset ~= offset then
                    workingOffset = offset
                    print("[HustlHub] Pet Defense: crit clicks land with screen offset", tostring(offset))
                end
                return
            end
        end
        -- nothing lined up: don't click at all (better a missed crit than a wrong click)
    end)
end

local function clickCriticals()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return end
    for _, obj in ipairs(gui:GetDescendants()) do
        if obj.Name == "CriticalActive" and obj:IsA("GuiObject") and obj.Visible then
            local button = obj:FindFirstChild("Button")
            local last = clickedAt[obj]
            if button and button.AbsoluteSize.X > 0 and not (last and os.clock() - last < 0.4) then
                clickedAt[obj] = os.clock()
                task.spawn(clickGuiButton, button)
            end
        end
    end
    -- forget bubbles that are gone
    for bubble in pairs(clickedAt) do
        if not bubble.Parent then clickedAt[bubble] = nil end
    end
end

---------------- Toggle
-- The relic at the end (ColosseumRewardsController): the offer is
-- Replication.Data.PendingMinigameReward { SlotName, NewRelic { Name, Boosts { { Type, Value } } } },
-- your current one is Replication.Data.Relics[SlotName]; answered with
-- Network:InvokeServer("ClaimMinigameReward", "keep" / "replace").
-- All the rings (ColosseumRelicConfig): Bronze, Silver (Walkspeed, Click Multiplier), Gold (Click,
-- Critical Chance, Hatch Speed), Platinum (+ Rebirth Multiplier), Diamond (Crit, Hatch, Rebirth,
-- Secret Luck). Stats have very different ranges (Secret Luck tops out at 3%, Click at 18%), so each
-- boost counts as "how close to the best roll of that stat" x how much the stat helps you progress.
-- Better ring = higher total.
local RELIC_WEIGHTS = {
    ClickMultiplier = 10, RebirthMultiplier = 10, SecretLuck = 6, Luck = 6,
    CriticalChance = 4, HatchSpeed = 3, Walkspeed = 0.5,
}
local RELIC_BEST = { -- the best roll of each stat on any ring (read from the game below; these are the defaults)
    Walkspeed = 0.15, ClickMultiplier = 0.18, CriticalChance = 0.05, HatchSpeed = 0.18, RebirthMultiplier = 0.05, SecretLuck = 0.03,
}
pcall(function()
    local relicConfig = require(ReplicatedStorage.Shared.Minigames.ColosseumRelicConfig)
    for _, slot in pairs(relicConfig.Slots) do
        for _, ring in pairs(slot.Relics) do
            for _, boost in ipairs(ring.Boosts or {}) do
                local top = type(boost.Value) == "table" and boost.Value[2] or tonumber(boost.Value)
                if top and top > (RELIC_BEST[boost.Type] or 0) then RELIC_BEST[boost.Type] = top end
            end
        end
    end
end)
local function relicScore(relic)
    local score = 0
    for _, boost in ipairs(type(relic) == "table" and relic.Boosts or {}) do
        local value = tonumber(boost.Value) or 0
        local best = RELIC_BEST[boost.Type] or value
        score += (RELIC_WEIGHTS[boost.Type] or 2) * (best > 0 and value / best or 0)
    end
    return score
end
local function describeRelic(relic)
    local parts = {}
    for _, boost in ipairs(type(relic) == "table" and relic.Boosts or {}) do
        local v = tonumber(boost.Value) or 0
        table.insert(parts, tostring(boost.Type) .. " " .. (v >= 1 and ("+" .. v) or ("+" .. math.floor(v * 100 + 0.5) .. "%")))
    end
    return tostring(relic and relic.Name) .. " (" .. table.concat(parts, ", ") .. ")"
end
-- answer the relic offer, if there is one; waits up to `timeout` seconds for it to show up
local function chooseRelic(timeout)
    local replication = Adapter and Adapter.Replication
    local network = Adapter and Adapter.Network
    if not (replication and network) then return end
    local start = os.clock()
    local pending
    repeat
        pending = replication.Data and replication.Data.PendingMinigameReward
        if not pending then task.wait(0.5) end
    until pending or os.clock() - start > (timeout or 0)
    if type(pending) ~= "table" or type(pending.NewRelic) ~= "table" then return end
    local old = replication.Data.Relics and replication.Data.Relics[pending.SlotName]
    local choice = (old == nil or relicScore(pending.NewRelic) > relicScore(old)) and "replace" or "keep"
    local ok, result = pcall(function() return network:InvokeServer("ClaimMinigameReward", choice) end)
    local text = choice == "replace" and ("took the new " .. describeRelic(pending.NewRelic) .. (old and (" over " .. describeRelic(old)) or ""))
        or ("kept " .. describeRelic(old) .. " over the new " .. describeRelic(pending.NewRelic))
    print("[HustlHub] Pet Defense relic: " .. text .. ((ok and result) and "" or " (the game didn't confirm)"))
    window:Notify({ title = "Pet Defense", content = (choice == "replace" and "Took the new relic." or "Kept your relic.") .. " See the log for the stats.", duration = 5 })
end

