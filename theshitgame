			new("UIPadding", {
				PaddingLeft = UDim.new(0, 4),
				PaddingRight = UDim.new(0, 4),
				PaddingTop = UDim.new(0, 2),
				Parent = hub.railList,
			})

			search:GetPropertyChangedSignal("Text"):Connect(function()
				hub.query = search.Text
				hub:ApplyFilter()
			end)
		end

		hub.pages = new("Frame", {
			Name = "Pages",
			BackgroundTransparency = 1,
			Position = UDim2.new(0, railW > 0 and railW + 6 or 0, 0, 0),
			Size = UDim2.new(1, -(railW > 0 and railW + 6 or 0), 1, 0),
			ClipsDescendants = true,
			Parent = body,
		})

		table.insert(hubs, hub)
