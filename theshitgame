local function claimQuests(d)
    if not (QuestCfg and ClaimQuestRF and type(d.Quests) == "table") then return end
    for qid, entry in pairs(d.Quests) do
        local def = QuestCfg.Definitions and QuestCfg.Definitions[qid]
        if def and def.AutoClaim ~= true and type(entry) == "table" and entry.Claimed ~= true
            and (entry.Completed == true or (tonumber(entry.Amount) or 0) >= (def.Goal or 1)) then
            local ok, result = pcall(function() return safeInvoke(ClaimQuestRF, { ["Quest"] = qid }) end)
            if ok and type(result) == "table" and result.Success then print("[HustlHub] Auto Progress: claimed quest", qid) end
            task.wait(0.3)
        end
    end
end
-- which egg a quest is about: the 2nd step of an egg quest ("Open 5 Sky eggs!") doesn't name its
-- egg, only its group does ("EggSky" -> Sky)
local function questEgg(def)
    if def.Egg then return def.Egg end
    local fromGroup = type(def.Group) == "string" and def.Group:match("^Egg(%a+)$")
    if fromGroup and LaunchEggConfig and LaunchEggConfig[fromGroup] then return fromGroup end
    return nil
end
local IslandQuestCfg
pcall(function() IslandQuestCfg = require(ReplicatedStorage.Shared.Quests.IslandQuestConfig) end)

-- every open quest the hub can work on, as { kind, egg, desc, done(d) }; cheapest egg first:
--   * main quests: open eggs, turn pets golden
--   * island quest boards (Autumn, Mushroom, ...): open eggs; wave defense is left to Auto Pet Defense
local function openQuest(d)
    local best, bestPrice
    local function consider(q, price)
        if not bestPrice or price < bestPrice then best, bestPrice = q, price end
    end
    if QuestCfg and type(d.Quests) == "table" then
        for qid, entry in pairs(d.Quests) do
            local def = QuestCfg.Definitions and QuestCfg.Definitions[qid]
            local goal = def and def.Goal or 1
            if def and type(entry) == "table" and entry.Claimed ~= true and entry.Completed ~= true
                and (tonumber(entry.Amount) or 0) < goal then
                local done = function(dd)
                    local e = dd.Quests[qid]
                    return not e or e.Claimed == true or e.Completed == true or (tonumber(e.Amount) or 0) >= goal
                end
                local egg = questEgg(def)
                local desc = string.format("Quest: %s (%d / %d)", tostring(def.Description), tonumber(entry.Amount) or 0, goal)
                if egg then
                    consider({ kind = "egg", egg = egg, desc = desc, done = done }, eggPrice(d, egg))
                elseif def.Group == "GoldenPet" then
                    consider({ kind = "golden", desc = desc, done = done }, 0)
                end
            end
        end
    end
    if IslandQuestCfg and type(d.IslandQuests) == "table" then
        local unlocked = d.Progression and d.Progression.UnlockedIslands or {}
        for island, board in pairs(IslandQuestCfg.Boards or {}) do
            local entry = d.IslandQuests[island]
            if unlocked[island] == true and not (type(entry) == "table" and entry.Claimed == true) then
                for _, q in ipairs(board.Quests) do
                    local function progress(dd)
                        local e = dd.IslandQuests and dd.IslandQuests[island]
                        return type(e) == "table" and type(e.Progress) == "table" and (tonumber(e.Progress[q.Id]) or 0) or 0
                    end
                    if q.Kind == "Hatch" and q.Egg and progress(d) < q.Goal then
                        consider({
                            kind = "egg", egg = q.Egg,
                            desc = string.format("%s quest: %s (%d / %d)", island, tostring(q.Text), progress(d), q.Goal),
                            done = function(dd) return progress(dd) >= q.Goal end,
                        }, eggPrice(d, q.Egg))
                    end
                end
            end
        end
    end
    return best
end

