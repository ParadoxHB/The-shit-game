    ------------------------------------------------ Texture Delete (FPS boost)
    -- Client side only. Deleted textures can't come back until you rejoin; the lighting / water /
    -- quality changes are put back when you turn it off.
    local TD = {
        on = false,
        conn = nil,
        sweepId = 0,
        saved = nil,
        opts = { RemoveTextures = true, SimplifyMaterials = true, DisableParticles = true, DisableVisualEffects = true, LowQuality = true },
    }

    local function optimizeObject(obj)
        local o = TD.opts
        if o.RemoveTextures then
            if obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("SurfaceAppearance") then
                obj:Destroy()
                return
            elseif obj:IsA("MeshPart") then
                obj.TextureID = ""
            elseif obj:IsA("SpecialMesh") then
                obj.TextureId = ""
            end
        end
        if o.SimplifyMaterials and obj:IsA("BasePart") then
            obj.Material = Enum.Material.Plastic
            obj.Reflectance = 0
        end
        if o.DisableParticles then
            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
                obj.Enabled = false
            end
        end
        if o.DisableVisualEffects then
            if obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("SpotLight")
                or obj:IsA("PointLight") or obj:IsA("SurfaceLight") then
                obj.Enabled = false
            elseif obj:IsA("Explosion") then
                obj.Visible = false
            end
        end
    end

    local function sweep()
        TD.sweepId += 1
        local myId = TD.sweepId
        local count = 0
        for _, root in ipairs({ Workspace, Lighting }) do
            for _, obj in ipairs(root:GetDescendants()) do
                if not TD.on or TD.sweepId ~= myId then return end
                pcall(optimizeObject, obj)
                count += 1
                if count % 300 == 0 then task.wait() end -- never freeze the game
            end
        end
        print("[HustlHub] Texture Delete: finished cleaning the map")
    end

    local function applyGlobal()
        if not TD.opts.LowQuality then return end
        if not TD.saved then
            TD.saved = {
                shadows = Lighting.GlobalShadows, fog = Lighting.FogEnd, brightness = Lighting.Brightness,
                post = {},
            }
            pcall(function() TD.saved.quality = settings().Rendering.QualityLevel end)
            if Terrain then
                TD.saved.water = { Terrain.WaterWaveSize, Terrain.WaterWaveSpeed, Terrain.WaterReflectance, Terrain.WaterTransparency }
            end
        end
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 1e9
        if Terrain then
            Terrain.WaterWaveSize, Terrain.WaterWaveSpeed, Terrain.WaterReflectance, Terrain.WaterTransparency = 0, 0, 0, 1
        end
        for _, effect in ipairs(Lighting:GetDescendants()) do
            if effect:IsA("PostEffect") and effect.Enabled then
                TD.saved.post[effect] = true
                effect.Enabled = false
            end
        end
    end

    local function restoreGlobal()
        local s = TD.saved
        if not s then return end
        TD.saved = nil
        pcall(function() if s.quality then settings().Rendering.QualityLevel = s.quality end end)
        pcall(function()
            Lighting.GlobalShadows, Lighting.FogEnd, Lighting.Brightness = s.shadows, s.fog, s.brightness
            if Terrain and s.water then
                Terrain.WaterWaveSize, Terrain.WaterWaveSpeed, Terrain.WaterReflectance, Terrain.WaterTransparency = table.unpack(s.water)
            end
            for effect in pairs(s.post) do
                if effect.Parent then effect.Enabled = true end
            end
        end)
    end

    local function setTextureDelete(on)
        TD.on = on
        if TD.conn then TD.conn:Disconnect(); TD.conn = nil end
        if not on then
            TD.sweepId += 1
            restoreGlobal()
            return
        end
        applyGlobal()
        TD.conn = Workspace.DescendantAdded:Connect(function(obj)
            task.defer(function()
                if TD.on and obj and obj.Parent then pcall(optimizeObject, obj) end
            end)
        end)
        task.spawn(sweep)
    end
    connections.hubTextureDelete = { Disconnect = function() setTextureDelete(false) end }

    miscTab:CreateToggle({
        name = "Texture Delete (FPS Boost)",
        description = "Deletes textures / decals, flattens materials, turns off particles and lights, and lowers graphics quality to raise your FPS. Visual only. Deleted textures only come back when you rejoin.",
        value = false,
        callback = function(value)
            setTextureDelete(value)
        end,
    })
end

---------------------------------------------------------------- Webhook tab: Secret hatch alerts
do -- own scope (keeps the top level under Luau's 200-local limit)
    local HttpService = game:GetService("HttpService")
    local webhookTab = window:CreateTab({ name = "Webhook" })
    local hook = { url = "", discordId = "", alive = true, alerts = {} }
    -- the game's own pet tables (for rarity) and power formula
    local LaunchPetConfig, PetCatalog, IndexCatalog, PetPowerMod
    pcall(function() LaunchPetConfig = require(ReplicatedStorage.Shared.Pets.LaunchPetConfig) end)
    pcall(function() PetCatalog = require(ReplicatedStorage.Shared.Pets.OriginalPetCatalog) end)
    pcall(function() IndexCatalog = require(ReplicatedStorage.Shared.Pets.PetIndexCatalog) end)
    pcall(function() PetPowerMod = require(ReplicatedStorage.Shared.Pets.PetPower) end)
    connections.hubWebhook = { Disconnect = function() hook.alive = false end }

    local function httpRequest()
        return (syn and syn.request) or request or http_request or (http and http.request)
    end

    local function validUrl(url)
        if type(url) ~= "string" then return false end
        for _, host in ipairs({ "discord.com", "discordapp.com", "ptb.discord.com", "canary.discord.com" }) do
            local prefix = "https://" .. host .. "/api/webhooks/"
            if url:sub(1, #prefix) == prefix and #url > #prefix + 10 then return true end
        end
        return false
    end

    local function cleanId(text)
        local id = tostring(text or ""):gsub("[^%d]", "")
        if #id >= 15 and #id <= 22 then return id end
        return ""
    end

    local SUFFIX = { { 1e18, "Qi" }, { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }
    local function short(n)
        n = tonumber(n)
        if not n then return "?" end
        for _, u in ipairs(SUFFIX) do
            if n >= u[1] then return string.format("%.3g", n / u[1]) .. u[2] end
        end
        return tostring(math.floor(n))
    end
    local function commas(n)
        local s = tostring(math.floor(tonumber(n) or 0))
        local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
        return (out:gsub("^,", ""))
    end

    -- finds a number in the player's data by key name (the game's field names aren't fixed in this script)
    local SKIP = { Pets = true, Inventory = true, Index = true, Quests = true, Eggs = true }
    local function scan(tbl, test, depth, seen)
        if depth > 4 or seen[tbl] then return nil end
        seen[tbl] = true
        for k, v in pairs(tbl) do
            if type(k) == "string" and type(v) == "number" and test(k:lower()) then return v end
        end
        for k, v in pairs(tbl) do
            if type(v) == "table" and not (type(k) == "string" and SKIP[k]) then
                local found = scan(v, test, depth + 1, seen)
                if found then return found end
            end
        end
        return nil
    end
    local function findStat(tests)
        local replica = getReplica()
        local data = replica and replica.Data
        if type(data) == "table" then
            for _, test in ipairs(tests) do
                local ok, value = pcall(scan, data, test, 0, {})
                if ok and value then return value end
            end
        end
        -- leaderboard values on the player
        local stats = LocalPlayer:FindFirstChild("leaderstats")
        if stats then
            for _, test in ipairs(tests) do
                for _, v in ipairs(stats:GetChildren()) do
                    if v:IsA("ValueBase") and type(v.Value) == "number" and test(v.Name:lower()) then return v.Value end
                end
            end
        end
        return nil
    end

    local function totalPetPower()
        local total = 0
        local ok = pcall(function()
            local d = getReplica().Data
            for _, id in pairs(d.Pets.Equipped or {}) do
                local pet = d.Pets.Owned[id]
                if type(pet) == "table" then
                    local p = tonumber(pet.Power) or 0
                    if PetPowerMod then
                        local okP, v = pcall(PetPowerMod.Get, pet)
                        if okP and type(v) == "number" then p = v end
                    end
                    total += p
                end
            end
        end)
        return ok and total > 0 and total or nil
    end

    local function petRarity(pet)
        local r = pet.Rarity
        if not r and IndexCatalog and IndexCatalog.Rarity then
            local ok, v = pcall(IndexCatalog.Rarity, pet.Name)
            if ok and type(v) == "string" then r = v end
        end
        if not r and LaunchPetConfig and LaunchPetConfig[pet.Name] then r = LaunchPetConfig[pet.Name].Rarity end
        if not r and PetCatalog and PetCatalog[pet.Name] then r = PetCatalog[pet.Name].Rarity end
        return tostring(r or "Unknown")
    end

    local function send(payload)
        local req = httpRequest()
        if not req then return false, "your executor has no request function" end
        local ok, res = pcall(req, {
            Url = hook.url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(payload),
        })
        if not ok then return false, tostring(res) end
        local code = res and (res.StatusCode or res.status_code)
        if code and (code < 200 or code >= 300) then return false, "Discord answered " .. tostring(code) end
        return true
    end

    -- the HustlHub picture, built into the script: set as the webhook's own icon (Discord's "modify webhook"
    -- call takes the image directly), so no link or upload is needed
    local ICON_B64 = [=[]=]
    local iconSetFor
    local function setWebhookIcon(force)
        if iconSetFor == hook.url and not force then return true end
        local req = httpRequest()
        if not req then return false end
        local ok, res = pcall(req, {
            Url = hook.url,
            Method = "PATCH",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({ name = "HustlHub", avatar = "data:image/png;base64," .. ICON_B64 }),
        })
        local code = ok and res and (res.StatusCode or res.status_code)
        if ok and code and code >= 200 and code < 300 then
            iconSetFor = hook.url
            return true
        end
        warn("[HustlHub] Webhook: couldn't set the icon (" .. tostring(ok and code or res) .. ")")
        return false
    end

    -- The colour of the embed's side bar. Discord gives an embed ONE solid colour (no gradients, no animation), so:
    -- by version first (Golden = gold, Diamond = ice blue, Rainbow = a different rainbow colour on every alert, stepping
    -- red, orange, yellow, green, blue, purple), otherwise by the secret's tier (Secret I red, II purple, III pink, X white).
    local TIER_COLORS = { Golden = 0xFFC107, Diamond = 0x4FC3F7 }
    local RARITY_COLORS = { ["Secret I"] = 0xE74C3C, ["Secret II"] = 0x9B59B6, ["Secret III"] = 0xE91E63, ["Secret X"] = 0xFFFFFF }
    local RAINBOW_COLORS = { 0xFF3B30, 0xFF9500, 0xFFD60A, 0x34C759, 0x0A84FF, 0xAF52DE }
    local rainbowStep = 0
    local function barColor(rarity, tier)
        if tier == "Shiny" or tier == "Rainbow" then -- (Rainbow is the "Shiny" tier in the game's data)
            rainbowStep = rainbowStep % #RAINBOW_COLORS + 1
            return RAINBOW_COLORS[rainbowStep]
        end
        return TIER_COLORS[tier] or RARITY_COLORS[rarity] or 15158332
    end

    local function buildPayload(pet, test)
        local name = LocalPlayer.Name
        local id = cleanId(hook.discordId)
        local rarity = pet and petRarity(pet) or "Secret"
        local petName = pet and tostring(pet.Name) or "Test Pet"
        local tier = pet and tostring(pet.Tier or "Normal") or "Normal"
        local mutation = pet and type(pet.Mutation) == "string" and pet.Mutation ~= "" and pet.Mutation or nil
        local shown = (mutation and mutation .. " " or "") .. (tier ~= "Normal" and (tier == "Shiny" and "Rainbow" or tier) .. " " or "") .. petName
        -- the odds of this exact secret: the game's own PetOdds (OneIn = the pet's base "1 in N" on its egg, Variant =
        -- times the tier / mutation factor, e.g. a Golden one is rarer); falls back to the egg's Secrets table
        local oneIn
        if pet then
            pcall(function()
                local PetOdds = require(ReplicatedStorage.Shared.Pets.PetOdds)
                local base = PetOdds.OneIn(pet.Name)
                if base then oneIn = PetOdds.Variant(base, pet.Tier, pet.Mutation) end
            end)
            if not oneIn then
                pcall(function()
                    local eggCfg = require(ReplicatedStorage.Shared.Pets.LaunchEggConfig)[pet.SourceEgg]
                    oneIn = eggCfg and eggCfg.Secrets and eggCfg.Secrets[pet.Name]
                end)
            end
        end
        local function oneInText(n) -- 4750000 -> "4.75M" (two decimals, trailing zeros dropped)
            local units, i = { "", "K", "M", "B", "T" }, 1
            while n >= 1000 and i < #units do n = n / 1000 i += 1 end
            local t = string.format("%.2f", n)
            t = t:gsub("0+$", "")
            t = t:gsub("%.$", "")
            return t .. units[i]
        end
        local rarityText = rarity .. (type(oneIn) == "number" and oneIn > 0 and (" 1 in " .. oneInText(oneIn)) or "") -- one line: "Secret I 1 in 25M"

        -- the game's own counters: Statistics.EggsOpened / Statistics.Rebirths / Statistics.EggHatches[egg]
        -- (findStat alone picked Achievements.Progress.Eggs, a different, lower number)
        local function stat(key, tests)
            local v
            pcall(function() v = tonumber(getReplica().Data.Statistics[key]) end)
            return v or findStat(tests)
        end
        local eggs = stat("EggsOpened", {
            function(k) return k == "eggsopened" or k == "totaleggs" or k == "eggshatched" or k == "totaleggsopened" end,
            function(k) return k:find("egg") and (k:find("open") or k:find("hatch")) end,
        })
        local rebirths = stat("Rebirths", {
            function(k) return k == "rebirths" or k == "totalrebirths" or k == "rebirth" end,
        })
        local power = totalPetPower()
        -- how many eggs you have hatched on the egg you are hatching right now
        local eggName, eggCount = hatchRunning and selectedEgg and tostring(selectedEgg), nil
        if eggName then
            pcall(function()
                local per = getReplica().Data.Statistics.EggHatches
                for _, key in ipairs({ eggName, (eggName:gsub(" Egg$", "")), eggName .. " Egg" }) do
                    if per[key] then eggCount = tonumber(per[key]) break end
                end
            end)
        end

        -- your row on the game's leaderboard board (PlayerGui.<Board>.Main.Self): name, rank and score as shown there
        local function boardEntry(boardName, fallbackScore)
            local name, rank, score
            pcall(function()
                local self = LocalPlayer.PlayerGui[boardName].Main.Self
                local function text(child) local l = self:FindFirstChild(child) return l and l.Text ~= "" and l.Text or nil end
                name, rank, score = text("Username"), text("Rank"), text("Amount")
            end)
            return "Name: " .. (name or LocalPlayer.Name) .. "\nRank: " .. (rank or "Not found")
                .. "\nScore: " .. (score or (fallbackScore and short(fallbackScore)) or "Not found")
        end
        local clicks = stat("ActualTaps", {
            function(k) return k == "clicks" or k == "totalclicks" end,
            function(k) return k:find("click") and not k:find("multi") and not k:find("critical") end,
            function(k) return k == "taps" or k == "totaltaps" or k == "actualtaps" end,
        })
        local lines = {}
        if clicks then table.insert(lines, "Clicks: " .. short(clicks)) end
        if rebirths then table.insert(lines, "Rebirths: " .. short(rebirths)) end
        if power then table.insert(lines, "Pet Power: " .. short(power)) end

        -- three columns, two rows: eggs | time | rarity, then leaderboard stats | pet power | rebirths
        local fields = {
            { name = "Total Eggs Opened", value = eggs and commas(eggs) or "Not found", inline = true },
            { name = "Time", value = "<t:" .. os.time() .. ":T>", inline = true },
            { name = "Rarity", value = rarityText, inline = true },
            { name = "Leaderboard Stats", value = #lines > 0 and table.concat(lines, "\n") or "Not found", inline = true },
            { name = "Total Pet Power", value = boardEntry("PetPowerLeaderboard", power), inline = true },
            { name = "Total Rebirths", value = boardEntry("RebirthsLeaderboard", rebirths), inline = true },
        }
        if eggName then
            table.insert(fields, { name = eggName .. " Egg Hatched", value = eggCount and commas(eggCount) or "Not found", inline = true })
        end
        -- the pet's mutation (pet.Mutation: Ghost, Bloodmoon, Shiny, Galaxy, ...), separate from its version (Normal / Golden /
        -- Diamond / Rainbow); "None" when it has none
        table.insert(fields, { name = "Mutation", value = mutation or "None", inline = true })

        local payload = {
            username = "HustlHub",
            embeds = { {
                title = test and (name .. " test alert: a SECRET would show here") or (name .. " just hatched a SECRET " .. shown .. "!"),
                color = barColor(rarity, tier),
                fields = fields,
                footer = { text = "HustlHub" },
                timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
            } },
        }
        if id ~= "" then
            payload.content = "<@" .. id .. ">" .. (test and " (test)" or "")
            payload.allowed_mentions = { users = { id } }
        else
            payload.allowed_mentions = { parse = {} }
        end
        return payload
    end

    -- the webhook info is saved in its own file, shared by all your accounts, and it's live: every account
    -- re-reads it every 2 seconds and follows the newest change (rev), so a switch turned on or off on ANY
    -- account applies to all of them. (Before, the other accounts read it only at start and kept sending,
    -- and could save their old "on" back into the file.) These switches aren't part of the normal settings
    -- or live sync (forgetState).
    local WEBHOOK_FILE = "TapSimHub/HustlHub_webhook.json"
    local function readInfo()
        local info
        pcall(function()
            if isfile(WEBHOOK_FILE) then info = HttpService:JSONDecode(readfile(WEBHOOK_FILE)) end
        end)
        return type(info) == "table" and info or {}
    end
    local fileRev = 0
    local restored = false
    local enabled = false
    local function saveInfo()
        if not restored then return end -- never overwrite the file while it is still being loaded
        pcall(function()
            if not isfolder("TapSimHub") then makefolder("TapSimHub") end
            fileRev = math.max(fileRev, tonumber(readInfo().rev) or 0) + 1
            writefile(WEBHOOK_FILE, HttpService:JSONEncode({
                rev = fileRev, from = LocalPlayer.Name,
                url = hook.url, discordId = hook.discordId, enabled = enabled, alerts = hook.alerts,
            }))
        end)
    end

    webhookTab:CreateSection({ name = "Secret Hatch Alert" })
    webhookTab:CreateText({
        name = "How it works",
        text = "Paste your Discord webhook link, put your Discord user ID to get pinged, and turn the switch on. When a Secret pet shows up in your pets, HustlHub posts which pet it was and its rarity.",
    })
    local urlInput = webhookTab:CreateInput({
        name = "Webhook URL",
        forgetState = true,
        description = "Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL. Anyone with this link can post in that channel, so keep it private.",
        placeholder = "https://discord.com/api/webhooks/...",
        callback = function(text)
            hook.url = (tostring(text or ""):gsub("%s", ""))
            saveInfo()
        end,
    })
    local idInput = webhookTab:CreateInput({
        name = "Discord ID",
        forgetState = true,
        description = "Your numeric Discord user ID (Discord Settings > Advanced > Developer Mode, then right click yourself > Copy User ID). Leave empty to post without a ping.",
        placeholder = "123456789012345678",
        callback = function(text)
            hook.discordId = cleanId(text)
            saveInfo()
        end,
    })

    local webhookToggle = webhookTab:CreateToggle({
        name = "Secret Hatch Webhook",
        forgetState = true,
        description = "Sends a Discord message (and pings your Discord ID) whenever you get a Secret pet.",
        value = false,
        callback = function(value)
            if value and not validUrl(hook.url) then
                window:Notify({ title = "Webhook", content = "Put a valid Discord webhook URL first.", duration = 5 })
            end
            enabled = value
            saveInfo()
            if value and validUrl(hook.url) then task.spawn(setWebhookIcon) end
        end,
    })
    webhookTab:CreateButton({
