local UNLOCK_SPOTS = {
    ["Sky Island"] = Vector3.new(16.619375228881836, -58.315959930419922, -1795.620727539062500),
    Autumn = Vector3.new(-30.438989639282227, 873.267211914062500, -1706.748291015625000),
    Mushroom = Vector3.new(-133.328628540039062, 2021.062988281250000, -1685.251586914062500),
    Desert = Vector3.new(-90.745613098144531, 3614.173339843750000, -1650.009399414062500),
    ["Crystal Cave"] = Vector3.new(30.977464675903320, 5451.565429687500000, -1664.016113281250000),
    ["Shadow Realm"] = Vector3.new(-158.786514282226562, 7676.944824218750000, -1641.902709960937500),
}
local walkInTries = {} -- island -> { count, since }
-- How the game really unlocks an island for free ("WalkIn"): the server works out which island you
-- are on from your position (IslandRegions.Resolve: workspace.IslandParts has one flat part per
-- island; you're "on" it when you're inside its footprint and above it, highest one wins) and
-- unlocks a locked island when you MOVE into its region from the island below - the climb crosses
-- the bottom of the new island's region. A teleport that lands you straight inside doesn't count.
-- So: hover just under the new island's region (still the island below), let the server see you
-- there, then rise smoothly up across the boundary onto the landing spot, double jumping.
local REGION_PARTS = { -- workspace.IslandParts (from the place file; read live when it's loaded)
    ["Sky Island"] = { pos = Vector3.new(-42.015, -103.2, -1864.813), size = Vector3.new(186, 2, 198) },
    Autumn = { pos = Vector3.new(-24.83, 854.8, -1804.798), size = Vector3.new(300, 2, 438) },
    Mushroom = { pos = Vector3.new(-114.662, 1976.8, -1871.165), size = Vector3.new(492, 2, 456) },
    Desert = { pos = Vector3.new(-66.953, 3571.8, -1880.342), size = Vector3.new(354, 2, 630) },
    ["Crystal Cave"] = { pos = Vector3.new(-57.368, 5374.8, -1868.76), size = Vector3.new(408, 2, 492) },
    ["Shadow Realm"] = { pos = Vector3.new(-15.608, 7617.8, -1863.465), size = Vector3.new(468, 2, 516) },
}
local function regionOf(name)
    local folder = workspace:FindFirstChild("IslandParts")
    local part = folder and folder:FindFirstChild(name)
    if part and part:IsA("BasePart") then return { pos = part.Position, size = part.Size } end
    return REGION_PARTS[name]
end
local function walkIn(myRun, name)
    -- the game's climbs need a double jump
    local d0 = data()
    local jumps = d0 and type(d0.PhysicalUpgrades) == "table" and tonumber(d0.PhysicalUpgrades.DoubleJump) or 0
    if jumps < 1 then
        log("Need a double jump before climbing to " .. name .. " (700 gems at the spawn machine)")
        return false
    end
    local tries = walkInTries[name]
    -- 3 tries in a row, then a 1 minute break
    if tries and tries.count >= 3 and os.clock() - tries.since < 60 then return false end
    if not tries or os.clock() - tries.since >= 60 then tries = { count = 0, since = os.clock() } walkInTries[name] = tries end
    tries.count += 1
    local region = regionOf(name)
    if not region then log("Don't know where " .. name .. " is") return false end
    local bottom = region.pos.Y - region.size.Y / 2
    -- where to come up: the measured landing spot if it's inside the region, else the region's middle
    local spot = UNLOCK_SPOTS[name]
    local rel = spot and (spot - region.pos)
    if not (rel and math.abs(rel.X) <= region.size.X / 2 - 2 and math.abs(rel.Z) <= region.size.Z / 2 - 2 and spot.Y > bottom) then
        spot = Vector3.new(region.pos.X, bottom + 20, region.pos.Z)
    end
    -- each try comes up a little to the side, in case something's in the way
    local angle = tries.count * 2.1
    local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * (4 * (tries.count - 1))
    local below = Vector3.new(spot.X, bottom - 6, spot.Z) + offset   -- just under the boundary
    local above = Vector3.new(spot.X, math.max(spot.Y, bottom + 6) + 3, spot.Z) + offset
    log(string.format("Climbing up into %s (try %d)", name, tries.count))
    local function currentIsland() return LocalPlayer:GetAttribute("CurrentIsland") end
    local beforeIsland, afterIsland
    acquireTrip("climb")
    local ok, err = pcall(function()
        local root = getRoot()
        local hum = root and root.Parent:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        task.spawn(function() pcall(function() LocalPlayer:RequestStreamAroundAsync(spot, 3) end) end)
        -- 1) hover just under the new island's region, until the server has you on the island below
        local start = os.clock()
        repeat
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = CFrame.new(below)
            RunService.Heartbeat:Wait()
        until (os.clock() - start > 1.5 and currentIsland() ~= name) or os.clock() - start > 4
        beforeIsland = tostring(currentIsland())
        -- 2) rise up across the boundary like a climb (no jump in position), double jumping
        pressJump()
        local y = below.Y
        while y < above.Y and os.clock() - start < 12 do
            y = math.min(above.Y, y + 1) -- about 60 studs a second
            root.CFrame = CFrame.new(below.X, y, below.Z)
            root.AssemblyLinearVelocity = Vector3.new(0, 45, 0)
            if math.abs(y - (below.Y + 4)) < 1 then pressJump() end -- the double jump, mid-climb
            RunService.Heartbeat:Wait()
        end
        -- 3) land on the spot and stand there
        hum:MoveTo(spot)
        local t = os.clock()
        repeat task.wait(0.1) until hum.FloorMaterial ~= Enum.Material.Air or os.clock() - t > 4
        t = os.clock()
        repeat task.wait(0.2) until currentIsland() == name or os.clock() - t > 4
        afterIsland = tostring(currentIsland())
    end)
    releaseTrip("climb")
    if not ok then warn("[HustlHub] Island climb error:", err) end
    print(string.format("[HustlHub] Island climb %s: server had you on %s, then %s", name, tostring(beforeIsland), tostring(afterIsland)))
    local t = os.clock()
    while ok and alive(myRun) and os.clock() - t < 6 do
        local d = data()
        if d and d.Progression.UnlockedIslands[name] == true then
            log("Climbed into " .. name .. ": unlocked for free!")
            walkInTries[name] = nil
            return true
        end
        task.wait(0.25)
    end
    log("Climbing into " .. name .. " didn't unlock it (try " .. tries.count .. ")")
    return false
end

