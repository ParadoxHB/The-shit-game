-- Max gems per roll (like Enchant Mastery's Max Cost). The game prices a roll per pet:
-- 25,000 x 1.015 ^ (rolls that pet has had), so a pet that's been rolled a lot gets very expensive.
-- A pet whose next roll would cost your cap or more is skipped (or stopped mid-way) instead of
-- burning gems on a rare enchant like Secret Hunter that you may never afford to land.
window.hubEnchantAuto.maxCost = 0 -- 0 = no cap
function window.hubEnchantAuto.formatGems(n)
    if n < 0 then return "-" .. window.hubEnchantAuto.formatGems(-n) end
    for _, u in ipairs({ { 1e18, "Qi" }, { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }) do
        if n >= u[1] then return string.format("%.3g", n / u[1]) .. u[2] end
    end
    return string.format("%d", math.floor(n))
end
-- what this pet's next roll costs (nil if the game's formula isn't there)
function window.hubEnchantAuto.nextPrice(pet)
    if type(pet) ~= "table" or not EnchantConfig then return nil end
    if EnchantConfig.GetRollPrice then
        local ok, price = pcall(EnchantConfig.GetRollPrice, pet)
        if ok and type(price) == "number" then return price end
    end
    local count = 0
    if EnchantConfig.GetRollCount then
        local ok, n = pcall(EnchantConfig.GetRollCount, pet)
        if ok and type(n) == "number" then count = n end
    end
    return math.round((EnchantConfig.RollPrice or 25000) * (EnchantConfig.RollPriceGrowth or 1.015) ^ count)
end
-- true (and the price) when this pet's next roll is at or over your cap
function window.hubEnchantAuto.overCap(pet)
    local cap = window.hubEnchantAuto.maxCost
    if not cap or cap <= 0 then return false end
    local price = window.hubEnchantAuto.nextPrice(pet)
    return price ~= nil and price >= cap, price
end
enchantTab:CreateInput({
    name = "Max Gems Per Roll",
    placeholder = "e.g. 5M (empty = no limit)",
    description = "Auto Enchant skips a pet once its next roll would cost this many gems or more (each roll on a pet costs 1.5% more than the last). Leave empty for no limit. Accepts K, M, B, T (e.g. 2.5M).",
    callback = function(text)
        text = tostring(text or ""):gsub(",", ""):gsub("%s", ""):lower()
        if text == "" or text == "0" then
            window.hubEnchantAuto.maxCost = 0
            return
        end
        local num, suffix = text:match("^([%d%.e%+%-]+)(%a*)$")
        local n = tonumber(num or "")
        local mult = ({ k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, qi = 1e18 })[suffix] or (suffix == "" and 1 or nil)
        if not (n and mult) then
            window:Notify({ title = "Auto Enchant", content = "Couldn't read \"" .. tostring(text) .. "\" as a gem amount.", duration = 4 })
            return
        end
        window.hubEnchantAuto.maxCost = n * mult
        window:Notify({ title = "Auto Enchant", content = "Max " .. window.hubEnchantAuto.formatGems(n * mult) .. " gems per roll.", duration = 3 })
    end,
})

