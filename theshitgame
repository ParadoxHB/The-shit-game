			})
			corner(rail, 5)
			local railStroke = stroke(rail, o.bordercolor)
			railStroke.Transparency = 0.4

			local search = new("TextBox", {
				Name = "Search",
				Text = "",
				PlaceholderText = "Search...",
				PlaceholderColor3 = o.placeholdercolor,
				ClearTextOnFocus = false,
				Position = UDim2.new(0, 5, 0, 5),
				Size = UDim2.new(1, -10, 0, 22),
				BackgroundColor3 = o.btncolor,
				TextColor3 = o.textcolor,
