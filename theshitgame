	----------------------------------------------------------------
	-- saving
	----------------------------------------------------------------
	function Hub:Register(flag, element)
		if flag then
			self.elementsByFlag[flag] = element
		end
	end

	local function cfgPath(self, name)
		return self.configFolder .. "/" .. (name or self.defaultConfig) .. ".json"
	end

	function Hub:Save(name)
		pcall(function()
			if not isfolder(self.configFolder) then
				makefolder(self.configFolder)
			end
		end)

		local data = {}

		for flag, element in pairs(self.elementsByFlag) do
			data[flag] = element.value
		end

		-- the autosave runs every few seconds: only touch the disk when something actually changed
		local path = cfgPath(self, name)
		local json = HttpService:JSONEncode(data)
		self.lastSaved = self.lastSaved or {}

		if self.lastSaved[path] == json then
			return
		end

		writefile(path, json)
		self.lastSaved[path] = json
	end

	-- settings first (egg / pet picks, sliders, text), toggles last: a toggle like Auto Hatch starts
	-- working the moment it is switched on, so the choices it uses must already be set
	function Hub:Load(name)
		local data = HttpService:JSONDecode(readfile(cfgPath(self, name)))
		local toggles = {}

		for flag, value in pairs(data) do
			local element = self.elementsByFlag[flag]

			if element and element.Set then
				if element.isToggle then
					if not self.skipToggles then toggles[flag] = value end
				else
					pcall(element.Set, element, value)
				end
			end
		end

		task.wait(0.5)

		for flag, value in pairs(toggles) do
			local element = self.elementsByFlag[flag]

			if element then
				pcall(element.Set, element, value)
			end
		end

		return data
	end

	function Hub:ListConfigs()
		local names = {}
		local ok, files = pcall(listfiles, self.configFolder)

		if ok and type(files) == "table" then
			for _, file in ipairs(files) do
				local n = tostring(file):match("([^/\\]+)%.json$")

				if n then
					table.insert(names, n)
				end
			end
		end

		return names
	end

	function Hub:DeleteConfig(name)
		delfile(cfgPath(self, name))
	end

	function Hub:Get(flag)
		local e = self.elementsByFlag[flag]
		return e and e.value
	end

	function Hub:Set(flag, value)
		local e = self.elementsByFlag[flag]

		if e then
			e:Set(value)
			return true
		end

		return false
	end

