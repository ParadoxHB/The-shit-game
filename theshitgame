mainTab:CreateToggle({
    name = "Auto Place Totems & Dials",
    description = "While Auto Hatch or Auto Index is hatching and you're at that egg: places the picked totems at the egg and uses the picked weather dials. Does nothing while you're away from the egg (craft trips, teleports).",
    callback = function(value)
        placeRunning = false
        placeRunId += 1
        if not value then
            pcall(function() placeStatus:Set("Off") end)
            return
        end
        placeRunning = true
        local myRun = placeRunId
        local function alive() return placeRunning and placeRunId == myRun end
        local placeRF = Remotes:FindFirstChild("ItemService") and Remotes.ItemService.RF:FindFirstChild("PlaceTotem")
        local dialRF = Remotes:FindFirstChild("WeatherDialService") and Remotes.WeatherDialService:FindFirstChild("RF")
        local retryAt = {} -- totem / dial -> don't try again before this time (after a refusal)
        task.spawn(function()
            local lastStatus
            while alive() do
                local status
                local ok, err = pcall(function()
                    local egg, root = hatchingEgg()
                    if not egg then
                        if not placeAnywhere then
                            status = "Waiting: start Auto Hatch / Auto Index and stand at the egg"
                            return
                        end
                        -- Use Totems & Dials Even When Not Hatching: no egg needed, totems go on the ground where you stand
                        root = getRoot()
                        if not root then
                            status = "Waiting for your character"
                            return
                        end
                        egg = "here"
                    end
                    local placed, missing = {}, {}
                    -- totems
                    for _, name in ipairs(pickedTotems) do
                        if not alive() then return end
                        local pos = root.Position
                        -- keep up to 3 of this kind on you (the game's max of one kind at once)
                        local covering, kindOut, mine = totemState(name, pos)
                        local why
                        while alive() and covering < MAX_PER_KIND do
                            if ownedItem(name) <= 0 then why = "none left" break end
                            if kindOut >= MAX_PER_KIND then why = MAX_PER_KIND .. " already out somewhere else" break end
                            if mine >= 5 then why = "5 of your totems already out" break end
                            if not placeRF or os.clock() < (retryAt[name] or 0) then break end
                            -- on the ground at your feet (like the game's Place button), each copy nudged a
                            -- little so they don't sit inside each other; all stay well within range
                            local angle = covering * (2 * math.pi / MAX_PER_KIND)
                            local feet = Vector3.new(pos.X + math.cos(angle) * 1.5, pos.Y - 3, pos.Z + math.sin(angle) * 1.5)
                            local res = safeInvoke(placeRF, { ["TotemName"] = name, ["Position"] = feet })
                            if type(res) == "table" and res.Success == true then
                                print("[HustlHub] Totems: placed", totemLabel[name], "(" .. (covering + 1) .. "/" .. MAX_PER_KIND .. ") at the", egg, "egg")
                                task.wait(1) -- let it show up in workspace.Totems
                                local newCovering
                                newCovering, kindOut, mine = totemState(name, pos)
                                covering = math.max(newCovering, covering + 1)
                            else
                                why = type(res) == "table" and tostring(res.Error or res.Reason) or "no answer"
                                print("[HustlHub] Totems: couldn't place", totemLabel[name], "-", why)
                                retryAt[name] = os.clock() + 30
                                break
                            end
                        end
                        if covering > 0 then table.insert(placed, totemLabel[name] .. " x" .. covering) end
                        if covering < MAX_PER_KIND and why then
                            table.insert(missing, totemLabel[name] .. " " .. covering .. "/" .. MAX_PER_KIND .. " (" .. why .. ")")
                        end
                    end
                    -- weather dials
                    for _, dial in ipairs(pickedDials) do
                        if not alive() then return end
                        if dialRF and ownedItem(dial.item) > 0 and os.clock() >= (retryAt[dial.item] or 0) then
                            local can = safeInvoke(dialRF.CanUse, dial.kind)
                            if type(can) == "table" and can.Success == true then
                                local res = safeInvoke(dialRF.Use, dial.kind)
                                if type(res) == "table" and res.Success == true then
                                    print("[HustlHub] Weather dials: used a", dial.item)
                                else
                                    print("[HustlHub] Weather dials: couldn't use", dial.item, "-", type(res) == "table" and tostring(res.Reason) or "no answer")
                                end
                            end
                            retryAt[dial.item] = os.clock() + 20 -- (AlreadyActive or used: check again in a bit)
                        end
                    end
                    status = (egg == "here" and "Not hatching (using where you stand)" or ("At the " .. egg .. " egg")) .. " | active: " .. (#placed > 0 and table.concat(placed, ", ") or "none")
                        .. (#missing > 0 and ("\nNot placed: " .. table.concat(missing, ", ")) or "")
                end)
                if not ok then status = "Error: " .. tostring(err) end
                if status and status ~= lastStatus then
                    lastStatus = status
                    pcall(function() placeStatus:Set(status) end)
                end
                task.wait(3)
            end
        end)
    end,
})
