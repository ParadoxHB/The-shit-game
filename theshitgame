-- the fight window from the game's own schedule (every IntervalSeconds, FightSeconds long)
local function bossTimes()
    local cfg = H.BossCfg
    if not (cfg and cfg.CurrentStart) then return nil end
    local t = now()
    local start = cfg.CurrentStart(t)
    local fightEnd = start + (cfg.FightSeconds or 420)
    return start, fightEnd, cfg.NextStart(t + 1)
end
local function bossFighting()
    local start, fightEnd = bossTimes()
    if not start then return false end
    local t = now()
    return t >= start + (H.BossCfg.IntroSeconds or 4) and t < fightEnd
end
local function platform()
    for _, p in ipairs(CollectionService:GetTagged((H.BossCfg and H.BossCfg.PlatformTag) or "BossPlatform")) do
        if p:IsA("BasePart") and p:IsDescendantOf(workspace) then
            return { pos = p.Position + Vector3.new(0, p.Size.Y / 2, 0), half = math.min(p.Size.X, p.Size.Z) / 2 }
        end
    end
    local fallback = H.BOSS_PLATFORM
    return { pos = fallback.pos + Vector3.new(0, 0.55, 0), half = fallback.half }
end
-- the spot on the platform farthest from every bomb target (stays inside the platform)
local function safeSpot(targets, plat)
    local best, bestScore
    local reach = plat.half * 0.8
    for gx = -2, 2 do
        for gz = -2, 2 do
            local p = plat.pos + Vector3.new(gx * reach / 2, 3, gz * reach / 2)
            local score = math.huge
            for _, t in ipairs(targets) do
                local d = Vector3.new(p.X - t.X, 0, p.Z - t.Z).Magnitude
                if d < score then score = d end
            end
            if not bestScore or score > bestScore then best, bestScore = p, score end
        end
    end
    return best
end

